@model LoginViewModel
@inject IWebHostEnvironment Environment
@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Yakult Systems Portal";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - @title</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .login-body {
            min-height: 100vh;
            background:
                linear-gradient(90deg, rgba(255, 255, 255, 0.58) 0%, rgba(255, 255, 255, 0.24) 43%, rgba(255, 255, 255, 0.05) 100%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(4, 9, 24, 0.24)),
                url('@Url.Content("~/images/Yakult_background.jpg")') center center / cover no-repeat fixed;
            overflow: hidden;
        }
        [data-theme="light"] .login-body {
            background:
                linear-gradient(90deg, rgba(255, 255, 255, 0.66) 0%, rgba(255, 255, 255, 0.3) 43%, rgba(255, 255, 255, 0.08) 100%),
                linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(4, 9, 24, 0.18)),
                url('@Url.Content("~/images/Yakult_background.jpg")') center center / cover no-repeat fixed;
        }
        .login-page {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            padding: clamp(24px, 6vw, 72px);
            position: relative;
            z-index: 1;
        }
        .login-stage {
            position: absolute;
            width: min(1120px, calc(100vw - 56px));
            height: clamp(500px, 68vh, 680px);
            min-height: 500px;
            border-radius: 18px;
            background:
                radial-gradient(circle at 54% 50%, rgba(255, 255, 255, 0.2), transparent 38%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.27), rgba(255, 255, 255, 0.08)),
                linear-gradient(90deg, rgba(13, 23, 45, 0.46), rgba(13, 23, 45, 0.2));
            border: 1px solid rgba(255, 255, 255, 0.32);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.28),
                inset 0 -1px 0 rgba(255, 255, 255, 0.08),
                0 38px 110px rgba(4, 9, 24, 0.26);
            backdrop-filter: blur(13px) saturate(132%);
            -webkit-backdrop-filter: blur(13px) saturate(132%);
            overflow: hidden;
        }
        .login-stage::before,
        .login-stage::after {
            content: '';
            position: absolute;
            border-radius: 999px;
            filter: blur(2px);
            opacity: 0.34;
        }
        .login-stage::before {
            width: 340px;
            height: 120px;
            left: -72px;
            bottom: -28px;
            border: 54px solid rgba(255, 255, 255, 0.14);
            transform: rotate(22deg);
        }
        .login-stage::after {
            width: 250px;
            height: 74px;
            right: -62px;
            bottom: 28px;
            background: linear-gradient(90deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.08));
            box-shadow: -170px -16px 0 24px rgba(255, 255, 255, 0.14);
        }
        .login-card {
            width: 100%;
            max-width: 410px;
            margin-inline: auto;
            background: linear-gradient(180deg, rgba(18, 29, 48, 0.78), rgba(18, 29, 48, 0.64));
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 18px;
            padding: 40px 38px;
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.24),
                0 34px 78px rgba(4, 9, 24, 0.34);
            backdrop-filter: blur(24px) saturate(150%);
            -webkit-backdrop-filter: blur(24px) saturate(150%);
            position: relative;
            overflow: hidden;
            z-index: 3;
        }
        .login-card::before {
            content: '';
            position: absolute;
            inset: -90px -40px auto auto;
            width: 170px;
            height: 170px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.12);
            filter: blur(4px);
            opacity: 0.7;
        }
        .login-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            margin-bottom: 24px;
        }
        .login-brand-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            box-shadow: 0 14px 30px rgba(220, 38, 38, 0.32);
            position: relative;
        }
        .login-brand-icon::after {
            content: '';
            position: absolute;
            inset: 10px;
            border: 2px solid rgba(255, 255, 255, 0.86);
            border-radius: 999px;
        }
        .login-brand-text {
            font-size: 1.32rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0;
        }
        .login-brand-text span {
            font-weight: 700;
            color: rgba(255, 255, 255, 0.74);
        }
        .login-welcome {
            text-align: center;
            margin-bottom: 26px;
        }
        .login-welcome h1 {
            font-size: 1.34rem;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 6px;
        }
        .login-welcome p {
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.72);
            margin: 0;
        }
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 17px;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .form-group label {
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.92);
            text-transform: none;
            letter-spacing: 0;
        }
        .form-group input {
            min-height: 44px;
            padding: 12px 14px;
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.95);
            border: 1px solid rgba(255, 255, 255, 0.58);
            color: #1e2b71;
            font-size: 0.92rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            width: 100%;
            box-sizing: border-box;
        }
        .form-group input:focus {
            border-color: rgba(248, 113, 113, 0.95);
            box-shadow: 0 0 0 3px rgba(248, 113, 113, 0.22);
        }
        .form-group input:hover {
            border-color: rgba(255, 255, 255, 0.86);
        }
        .form-group input::placeholder {
            color: rgba(30, 43, 113, 0.42);
        }
        .password-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }
        .password-wrap input {
            padding-right: 36px;
        }
        .password-toggle {
            position: absolute;
            right: 9px;
            background: none;
            border: none;
            color: rgba(30, 43, 113, 0.42);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4px;
        }
        .password-toggle:hover {
            color: #1e2b71;
        }
        .password-toggle:focus-visible {
            outline: 2px solid rgba(220, 38, 38, 0.5);
            outline-offset: 2px;
            border-radius: 6px;
        }
        .form-remember {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0;
        }
        .form-remember input[type="checkbox"] {
            width: 17px;
            height: 17px;
            accent-color: #dc2626;
            cursor: pointer;
        }
        .form-remember label {
            font-size: 0.84rem;
            color: rgba(255, 255, 255, 0.82);
            cursor: pointer;
            user-select: none;
        }
        .login-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            min-height: 44px;
            padding: 12px 18px;
            border-radius: 8px;
            border: none;
            font-weight: 700;
            font-size: 0.94rem;
            color: white;
            background: #dc2626;
            cursor: pointer;
            letter-spacing: 0;
            transition: all 0.25s ease;
            margin-top: 4px;
        }
        .login-button:hover {
            background: #b91c1c;
            transform: translateY(-2px);
        }
        .login-button:focus-visible {
            outline: 3px solid rgba(248, 113, 113, 0.35);
            outline-offset: 3px;
        }
        .login-button:disabled {
            cursor: progress;
            opacity: 0.72;
            transform: none;
        }
        .admin-preview-form {
            margin-top: 10px;
        }
        .admin-preview-button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            width: 100%;
            min-height: 36px;
            padding: 8px 12px;
            border: 1px dashed rgba(255, 255, 255, 0.24);
            border-radius: 8px;
            background: rgba(255, 255, 255, 0.06);
            color: rgba(255, 255, 255, 0.72);
            font: inherit;
            font-size: 0.72rem;
            font-weight: 750;
            cursor: pointer;
            transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
        }
        .admin-preview-button:hover {
            border-color: rgba(248, 113, 113, 0.52);
            background: rgba(220, 38, 38, 0.1);
            color: #ffffff;
        }
        .admin-preview-button svg {
            width: 14px;
            height: 14px;
        }
        .login-error {
            background: rgba(239, 68, 68, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 6px;
            padding: 10px 12px;
            color: #ffffff;
            font-size: 0.76rem;
            text-align: center;
        }
        .login-footer {
            text-align: center;
            margin-top: 24px;
            padding-top: 22px;
            border-top: 1px solid rgba(255, 255, 255, 0.14);
        }
        .login-footer p {
            font-size: 0.78rem;
            color: rgba(255, 255, 255, 0.68);
            margin: 0;
        }
        .login-footer .login-register-prompt {
            margin-bottom: 9px;
            color: rgba(255, 255, 255, 0.82);
        }
        .login-register-prompt a {
            color: #fca5a5;
            font-weight: 800;
            text-underline-offset: 3px;
        }
        .login-register-prompt a:hover {
            color: #ffffff;
        }
        .login-theme-toggle {
            background: rgba(255, 255, 255, 0.14);
            border-color: rgba(255, 255, 255, 0.22);
            color: #ffffff;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .login-back-link {
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 50;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            min-height: 38px;
            padding: 0 13px 0 10px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.22);
            background: rgba(255, 255, 255, 0.14);
            color: #ffffff;
            font-size: 0.82rem;
            font-weight: 750;
            line-height: 1;
            text-decoration: none;
            box-shadow: 0 16px 42px rgba(4, 9, 24, 0.18);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
        }
        .login-back-link:hover {
            transform: translateY(-1px);
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.34);
            color: #ffffff;
        }
        .login-back-link:focus-visible {
            outline: 3px solid rgba(248, 113, 113, 0.35);
            outline-offset: 3px;
        }
        .login-back-link svg {
            width: 17px;
            height: 17px;
            flex: 0 0 auto;
        }
        [data-theme="light"] .login-stage {
            background:
                radial-gradient(circle at 54% 50%, rgba(255, 255, 255, 0.34), transparent 38%),
                linear-gradient(135deg, rgba(255, 255, 255, 0.46), rgba(255, 255, 255, 0.18)),
                linear-gradient(90deg, rgba(255, 255, 255, 0.34), rgba(255, 255, 255, 0.14));
            border-color: rgba(255, 255, 255, 0.5);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.5),
                inset 0 -1px 0 rgba(255, 255, 255, 0.16),
                0 34px 92px rgba(15, 23, 42, 0.18);
        }
        [data-theme="light"] .login-card {
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(255, 255, 255, 0.62));
            border-color: rgba(255, 255, 255, 0.72);
            box-shadow:
                inset 0 1px 0 rgba(255, 255, 255, 0.68),
                0 30px 70px rgba(15, 23, 42, 0.18);
        }
        [data-theme="light"] .login-card::before {
            background: rgba(220, 38, 38, 0.1);
        }
        [data-theme="light"] .login-brand-text,
        [data-theme="light"] .login-welcome h1 {
            color: #1f2937;
        }
        [data-theme="light"] .login-brand-text span,
        [data-theme="light"] .login-welcome p,
        [data-theme="light"] .form-remember label,
        [data-theme="light"] .login-footer p {
            color: #4b5563;
        }
        [data-theme="light"] .login-register-prompt a {
            color: #b91c1c;
        }
        [data-theme="light"] .admin-preview-button {
            border-color: rgba(100, 116, 139, 0.35);
            background: rgba(248, 250, 252, 0.68);
            color: #64748b;
        }
        [data-theme="light"] .admin-preview-button:hover {
            border-color: rgba(220, 38, 38, 0.42);
            background: rgba(254, 226, 226, 0.72);
            color: #991b1b;
        }
        [data-theme="light"] .form-group label {
            color: #374151;
        }
        [data-theme="light"] .form-group input {
            background: rgba(255, 255, 255, 0.9);
            border-color: rgba(148, 163, 184, 0.42);
            color: #1f2937;
        }
        [data-theme="light"] .form-group input:hover {
            border-color: rgba(220, 38, 38, 0.38);
        }
        [data-theme="light"] .form-group input::placeholder {
            color: rgba(75, 85, 99, 0.58);
        }
        [data-theme="light"] .password-toggle {
            color: rgba(75, 85, 99, 0.58);
        }
        [data-theme="light"] .password-toggle:hover {
            color: #1f2937;
        }
        [data-theme="light"] .login-footer {
            border-top-color: rgba(148, 163, 184, 0.34);
        }
        [data-theme="light"] .login-error {
            background: rgba(254, 226, 226, 0.86);
            border-color: rgba(248, 113, 113, 0.32);
            color: #991b1b;
        }
        [data-theme="light"] .login-theme-toggle {
            background: rgba(255, 255, 255, 0.66);
            border-color: rgba(148, 163, 184, 0.35);
            color: #1f2937;
        }
        [data-theme="light"] .login-back-link {
            background: rgba(255, 255, 255, 0.66);
            border-color: rgba(148, 163, 184, 0.35);
            color: #1f2937;
        }
        [data-theme="light"] .login-back-link:hover {
            background: rgba(255, 255, 255, 0.82);
            border-color: rgba(220, 38, 38, 0.28);
            color: #991b1b;
        }
        .login-card,
        .login-stage,
        .login-theme-toggle,
        .login-back-link {
            animation: loginFloatIn 420ms ease both;
        }
        .login-stage {
            animation-delay: 40ms;
        }
        .login-card {
            animation-delay: 100ms;
        }
        @@keyframes loginFloatIn {
            from {
                opacity: 0;
                transform: translateY(14px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        @@media (max-width: 820px) {
            .login-body,
            [data-theme="light"] .login-body {
                background:
                    linear-gradient(180deg, rgba(4, 9, 24, 0.62), rgba(4, 9, 24, 0.76)),
                    url('@Url.Content("~/images/Yakult_background.jpg")') center center / cover no-repeat fixed;
            }
            .login-page {
                justify-content: center;
                padding: 22px;
            }
            .login-stage {
                width: calc(100vw - 26px);
                height: calc(100vh - 44px);
                min-height: 560px;
            }
            .login-card {
                max-width: 410px;
                padding: 34px 26px;
            }
        }
        @@media (max-width: 520px) {
            .login-back-link {
                top: 14px;
                left: 14px;
                min-height: 36px;
                padding-inline: 10px 11px;
            }
            .login-back-link span {
                display: none;
            }
            .login-stage {
                display: none;
            }
            .login-card {
                max-width: 100%;
                border-radius: 14px;
            }
        }
        @@media (prefers-reduced-motion: reduce) {
            .login-card,
            .login-stage,
            .login-theme-toggle,
            .login-back-link {
                animation: none;
            }
        }
    </style>
    <script>
        (function() {
            var theme = localStorage.getItem('yakultTheme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body class="login-body">
    <div class="hero-decoration hero-decoration-1"></div>
    <div class="hero-decoration hero-decoration-2"></div>

    <a class="login-back-link" asp-controller="Public" asp-action="Services" aria-label="Back to public services">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/><path d="M20 12H9"/></svg>
        <span>Back</span>
    </a>

    <button type="button" class="theme-toggle login-theme-toggle" id="themeToggle" title="Toggle theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
    </button>
    <div class="login-page">
        <div class="login-stage" aria-hidden="true">
        </div>
        <div class="login-card">
            <div class="login-brand">
                <div class="login-brand-icon"></div>
                <span class="login-brand-text">Yakult<span>Portal</span></span>
            </div>

            <div class="login-welcome">
                <h1>Welcome back</h1>
                <p>Sign in to access internal systems</p>
            </div>

            <form asp-action="Login" asp-controller="Home" method="post" class="login-form" autocomplete="off" id="loginForm">
                <input type="hidden" asp-for="ReturnUrl" />
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-error">
                        @Html.ValidationSummary(false)
                    </div>
                }

                <div class="form-group">
                    <label asp-for="Username">Username</label>
                    <input asp-for="Username" placeholder="Enter your username" autocomplete="username" autofocus />
                </div>

                <div class="form-group">
                    <label asp-for="Password">Password</label>
                    <div class="password-wrap">
                        <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" id="passwordInput" />
                        <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password" aria-pressed="false">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            <svg id="eyeOffIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.22-5.22m3.78-1.72A10.07 10.07 0 0 1 12 4c7 0 11 8 11 8a18.45 18.45 0 0 1-2.67 3.35"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                        </button>
                    </div>
                </div>

                <div class="form-remember">
                    <input asp-for="RememberMe" type="checkbox" />
                    <label asp-for="RememberMe">Remember me</label>
                </div>

                <button type="submit" class="login-button" id="loginSubmit">Sign In</button>
            </form>

            @if (Environment.IsDevelopment())
            {
                <form asp-action="AdminPreview" asp-controller="Home" method="post" class="admin-preview-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-preview-button" title="Development only — not available after publishing">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3 4 7v5c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V7l-8-4Z"/><path d="M9 12h6m-3-3v6"/></svg>
                        Admin preview <span>· Development only</span>
                    </button>
                </form>
            }

            <div class="login-footer">
                <p class="login-register-prompt">New to the portal? <a asp-controller="Home" asp-action="Register">Request an account</a></p>
                <p>Yakult Systems Portal. Internal use only.</p>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var toggle = document.getElementById('themeToggle');
            if (toggle) {
                toggle.addEventListener('click', function() {
                    var html = document.documentElement;
                    var current = html.getAttribute('data-theme') || 'dark';
                    var next = current === 'dark' ? 'light' : 'dark';
                    html.setAttribute('data-theme', next);
                    localStorage.setItem('yakultTheme', next);
                });
            }

            // Password visibility toggle
            (function() {
                var toggleBtn = document.getElementById('togglePassword');
                var passwordInput = document.getElementById('passwordInput');
                var eyeIcon = document.getElementById('eyeIcon');
                var eyeOffIcon = document.getElementById('eyeOffIcon');
                var loginForm = document.getElementById('loginForm');
                var loginSubmit = document.getElementById('loginSubmit');

                if (toggleBtn && passwordInput) {
                    toggleBtn.addEventListener('click', function() {
                        var isPassword = passwordInput.type === 'password';
                        passwordInput.type = isPassword ? 'text' : 'password';
                        toggleBtn.setAttribute('aria-pressed', isPassword ? 'true' : 'false');
                        toggleBtn.setAttribute('aria-label', isPassword ? 'Hide password' : 'Show password');
                        if (eyeIcon) eyeIcon.style.display = isPassword ? 'none' : 'inline';
                        if (eyeOffIcon) eyeOffIcon.style.display = isPassword ? 'inline' : 'none';
                    });
                }

                // Enter key focus flow (username -> password)
                var usernameInput = document.querySelector('input[name="Username"]');
                if (usernameInput && passwordInput) {
                    usernameInput.addEventListener('keydown', function(e) {
                        if (e.key === 'Enter') {
                            e.preventDefault();
                            passwordInput.focus();
                        }
                    });
                }

                if (loginForm && loginSubmit) {
                    loginForm.addEventListener('submit', function() {
                        loginSubmit.disabled = true;
                        loginSubmit.textContent = 'Signing in...';
                    });
                }
            })();
        });
    </script>
</body>
</html>
