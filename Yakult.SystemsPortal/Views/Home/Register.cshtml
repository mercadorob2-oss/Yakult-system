@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "Request an account - Yakult Systems Portal";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        * { box-sizing: border-box; }
        .register-body {
            min-height: 100vh;
            margin: 0;
            overflow-x: hidden;
            color: #f8fafc;
            background:
                linear-gradient(105deg, rgba(7, 14, 29, .92), rgba(15, 23, 42, .72) 50%, rgba(10, 18, 32, .84)),
                url('@Url.Content("~/images/Yakult_background.jpg")') center / cover fixed;
        }
        .register-body::before {
            content: '';
            position: fixed;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 78% 14%, rgba(239, 68, 68, .18), transparent 30%);
        }
        .register-shell {
            position: relative;
            z-index: 1;
            width: min(1180px, calc(100% - 40px));
            min-height: 100vh;
            margin: auto;
            padding: 34px 0;
            display: grid;
            grid-template-columns: minmax(280px, .8fr) minmax(560px, 1.45fr);
            gap: clamp(28px, 5vw, 72px);
            align-items: center;
        }
        .register-aside { padding: 24px 0; }
        .register-brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            color: #fff;
            text-decoration: none;
            font-size: 1.35rem;
            font-weight: 850;
        }
        .register-brand__mark {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: linear-gradient(135deg, #ef4444, #b91c1c);
            box-shadow: 0 14px 32px rgba(220, 38, 38, .35);
            position: relative;
        }
        .register-brand__mark::after {
            content: '';
            position: absolute;
            inset: 10px;
            border: 2px solid rgba(255,255,255,.86);
            border-radius: 50%;
        }
        .register-brand span span { color: rgba(255,255,255,.68); }
        .register-aside h1 {
            max-width: 590px;
            margin: 58px 0 16px;
            font-size: clamp(2.15rem, 4.2vw, 4.1rem);
            line-height: 1.02;
            letter-spacing: -.045em;
        }
        .register-aside h1 em { color: #f87171; font-style: normal; }
        .register-aside > p {
            max-width: 500px;
            margin: 0;
            color: rgba(226,232,240,.78);
            font-size: 1rem;
            line-height: 1.7;
        }
        .register-trust {
            display: grid;
            gap: 14px;
            margin-top: 38px;
        }
        .register-trust__item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(241,245,249,.86);
            font-size: .88rem;
        }
        .register-trust__icon {
            display: grid;
            place-items: center;
            width: 32px;
            height: 32px;
            flex: 0 0 32px;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 9px;
            background: rgba(255,255,255,.09);
        }
        .register-trust__icon svg { width: 16px; height: 16px; }
        .register-card {
            min-height: 650px;
            padding: clamp(26px, 4vw, 42px);
            border: 1px solid rgba(255,255,255,.27);
            border-radius: 22px;
            background: linear-gradient(145deg, rgba(17,27,47,.88), rgba(15,23,42,.76));
            box-shadow: 0 34px 90px rgba(2,6,23,.42), inset 0 1px rgba(255,255,255,.16);
            backdrop-filter: blur(24px) saturate(140%);
            -webkit-backdrop-filter: blur(24px) saturate(140%);
        }
        .register-card__top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }
        .register-card h2 { margin: 0 0 7px; font-size: 1.5rem; letter-spacing: -.02em; }
        .register-card__subtitle { margin: 0; color: rgba(203,213,225,.72); font-size: .9rem; }
        .demo-badge {
            flex: none;
            padding: 7px 10px;
            border: 1px solid rgba(251,191,36,.35);
            border-radius: 999px;
            background: rgba(245,158,11,.12);
            color: #fcd34d;
            font-size: .7rem;
            font-weight: 800;
            letter-spacing: .07em;
            text-transform: uppercase;
        }
        .register-stepper {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 9px;
            margin-bottom: 32px;
        }
        .register-stepper__item {
            min-width: 0;
            color: rgba(148,163,184,.72);
            font-size: .74rem;
            font-weight: 750;
        }
        .register-stepper__line {
            display: block;
            height: 4px;
            margin-bottom: 9px;
            overflow: hidden;
            border-radius: 99px;
            background: rgba(148,163,184,.18);
        }
        .register-stepper__line::after {
            content: '';
            display: block;
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: #ef4444;
            transition: width .25s ease;
        }
        .register-stepper__item.is-active,
        .register-stepper__item.is-done { color: #f8fafc; }
        .register-stepper__item.is-active .register-stepper__line::after,
        .register-stepper__item.is-done .register-stepper__line::after { width: 100%; }
        .register-panel { display: none; animation: panelIn .26s ease both; }
        .register-panel.is-active { display: block; }
        @@keyframes panelIn { from { opacity: 0; transform: translateY(7px); } }
        .panel-heading { margin-bottom: 24px; }
        .panel-heading h3 { margin: 0 0 7px; font-size: 1.14rem; }
        .panel-heading p { margin: 0; color: rgba(203,213,225,.7); font-size: .86rem; line-height: 1.5; }
        .register-fields { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 17px; }
        .register-field { display: grid; gap: 7px; }
        .register-field--full { grid-column: 1 / -1; }
        .register-field label { color: rgba(241,245,249,.9); font-size: .78rem; font-weight: 750; }
        .register-input-wrap { position: relative; }
        .register-field input {
            width: 100%;
            min-height: 48px;
            padding: 12px 14px;
            border: 1px solid rgba(148,163,184,.27);
            border-radius: 10px;
            outline: 0;
            background: rgba(255,255,255,.94);
            color: #172033;
            font: inherit;
            font-size: .9rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .register-field input:focus { border-color: #f87171; box-shadow: 0 0 0 3px rgba(248,113,113,.2); }
        .register-field input.is-invalid { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,.16); }
        .register-field small { color: rgba(148,163,184,.8); font-size: .72rem; line-height: 1.4; }
        .field-error { display: none; color: #fca5a5 !important; }
        .field-error.is-visible { display: block; }
        .register-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; margin-top: 27px; }
        .register-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 44px;
            padding: 11px 17px;
            border: 1px solid transparent;
            border-radius: 9px;
            font: inherit;
            font-size: .84rem;
            font-weight: 800;
            cursor: pointer;
            text-decoration: none;
            transition: transform .2s, background .2s, border-color .2s;
        }
        .register-button:hover { transform: translateY(-1px); }
        .register-button--primary { background: #dc2626; color: #fff; box-shadow: 0 12px 28px rgba(220,38,38,.22); }
        .register-button--primary:hover { background: #b91c1c; }
        .register-button--secondary { border-color: rgba(148,163,184,.26); background: rgba(255,255,255,.07); color: #e2e8f0; }
        .register-button svg { width: 16px; height: 16px; }
        .verified-banner {
            display: flex;
            gap: 11px;
            align-items: center;
            margin-bottom: 20px;
            padding: 12px 14px;
            border: 1px solid rgba(34,197,94,.3);
            border-radius: 10px;
            background: rgba(34,197,94,.09);
            color: #bbf7d0;
            font-size: .8rem;
            font-weight: 700;
        }
        .verified-banner svg { width: 18px; height: 18px; flex: none; }
        .employee-card {
            margin-bottom: 22px;
            padding: 18px;
            border: 1px solid rgba(148,163,184,.2);
            border-radius: 12px;
            background: rgba(8,15,29,.3);
        }
        .employee-card__header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
        .employee-avatar { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 10px; background: rgba(239,68,68,.16); color: #fca5a5; font-weight: 850; }
        .employee-card__header strong, .employee-card__header span { display: block; }
        .employee-card__header strong { font-size: .93rem; }
        .employee-card__header span { margin-top: 3px; color: rgba(148,163,184,.8); font-size: .74rem; }
        .employee-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
        .employee-detail span, .employee-detail strong { display: block; overflow-wrap: anywhere; }
        .employee-detail span { color: rgba(148,163,184,.75); font-size: .66rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
        .employee-detail strong { margin-top: 4px; color: #e2e8f0; font-size: .79rem; line-height: 1.35; }
        .password-meter { display: flex; gap: 5px; margin-top: 1px; }
        .password-meter span { height: 3px; flex: 1; border-radius: 99px; background: rgba(148,163,184,.23); }
        .password-meter[data-strength="1"] span:nth-child(-n+1) { background: #ef4444; }
        .password-meter[data-strength="2"] span:nth-child(-n+2) { background: #f59e0b; }
        .password-meter[data-strength="3"] span:nth-child(-n+3) { background: #22c55e; }
        .review-list { overflow: hidden; border: 1px solid rgba(148,163,184,.2); border-radius: 12px; background: rgba(8,15,29,.28); }
        .review-row { display: flex; justify-content: space-between; gap: 22px; padding: 13px 16px; border-bottom: 1px solid rgba(148,163,184,.13); font-size: .81rem; }
        .review-row:last-child { border-bottom: 0; }
        .review-row span { color: rgba(148,163,184,.8); }
        .review-row strong { color: #f1f5f9; text-align: right; overflow-wrap: anywhere; }
        .demo-notice { margin-top: 18px; padding: 12px 14px; border-radius: 10px; background: rgba(245,158,11,.09); color: #fde68a; font-size: .74rem; line-height: 1.5; }
        .success-state { display: none; min-height: 390px; text-align: center; place-content: center; }
        .success-state.is-visible { display: grid; }
        .success-icon { display: grid; place-items: center; width: 68px; height: 68px; margin: 0 auto 20px; border-radius: 20px; background: rgba(34,197,94,.13); color: #4ade80; box-shadow: 0 0 0 9px rgba(34,197,94,.05); }
        .success-icon svg { width: 32px; height: 32px; }
        .success-state h3 { margin: 0 0 9px; font-size: 1.4rem; }
        .success-state p { max-width: 410px; margin: 0 auto; color: rgba(203,213,225,.72); font-size: .86rem; line-height: 1.6; }
        .success-reference { display: inline-block; margin: 20px auto 24px; padding: 8px 12px; border-radius: 8px; background: rgba(255,255,255,.07); color: #f8fafc; font: 800 .78rem ui-monospace, monospace; }
        .register-back {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-top: 26px;
            color: rgba(226,232,240,.74);
            font-size: .81rem;
            font-weight: 700;
            text-decoration: none;
        }
        .register-back:hover { color: #fff; }
        .register-back svg { width: 15px; height: 15px; }
        .register-theme-toggle { top: 20px; right: 20px; background: rgba(15,23,42,.62); border-color: rgba(255,255,255,.2); color: #fff; }
        [data-theme="light"] .register-body {
            color: #1f2937;
            background: linear-gradient(105deg, rgba(255,255,255,.86), rgba(255,255,255,.62)), url('@Url.Content("~/images/Yakult_background.jpg")') center / cover fixed;
        }
        [data-theme="light"] .register-aside h1, [data-theme="light"] .register-brand { color: #172033; }
        [data-theme="light"] .register-brand span span { color: #64748b; }
        [data-theme="light"] .register-aside > p, [data-theme="light"] .register-trust__item { color: #475569; }
        [data-theme="light"] .register-trust__icon { border-color: #e2e8f0; background: rgba(255,255,255,.65); }
        [data-theme="light"] .register-card { border-color: rgba(255,255,255,.8); background: rgba(255,255,255,.86); box-shadow: 0 30px 80px rgba(15,23,42,.18); }
        [data-theme="light"] .register-card__subtitle, [data-theme="light"] .panel-heading p, [data-theme="light"] .register-field small { color: #64748b; }
        [data-theme="light"] .register-stepper__item.is-active, [data-theme="light"] .register-stepper__item.is-done, [data-theme="light"] .register-field label { color: #1f2937; }
        [data-theme="light"] .employee-card, [data-theme="light"] .review-list { border-color: #e2e8f0; background: #f8fafc; }
        [data-theme="light"] .employee-detail strong, [data-theme="light"] .review-row strong { color: #1f2937; }
        [data-theme="light"] .review-row { border-color: #e2e8f0; }
        [data-theme="light"] .register-button--secondary { border-color: #dbe2ea; background: #f8fafc; color: #334155; }
        [data-theme="light"] .register-theme-toggle { background: rgba(255,255,255,.76); border-color: #e2e8f0; color: #1f2937; }
        [data-theme="light"] .register-back { color: #475569; }
        @@media (max-width: 940px) {
            .register-shell { width: min(720px, calc(100% - 32px)); grid-template-columns: 1fr; gap: 22px; padding: 24px 0 40px; }
            .register-aside { padding: 0; }
            .register-aside h1 { margin: 28px 0 12px; font-size: 2.25rem; }
            .register-aside > p { max-width: 650px; }
            .register-trust { display: none; }
        }
        @@media (max-width: 620px) {
            .register-shell { width: calc(100% - 20px); padding-top: 72px; }
            .register-aside { display: none; }
            .register-card { min-height: 0; padding: 24px 18px; border-radius: 16px; }
            .register-card__top { display: block; }
            .demo-badge { display: inline-block; margin-top: 12px; }
            .register-stepper__item { font-size: .64rem; }
            .register-fields, .employee-grid { grid-template-columns: 1fr; }
            .register-field--full { grid-column: auto; }
            .register-actions { align-items: stretch; flex-direction: column-reverse; }
            .register-button { width: 100%; }
            .review-row { align-items: flex-start; flex-direction: column; gap: 4px; }
            .review-row strong { text-align: left; }
        }
        @@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>
    <script>
        (function() {
            var theme = localStorage.getItem('yakultTheme') || 'dark';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body class="register-body">
    <button type="button" class="theme-toggle register-theme-toggle" id="themeToggle" title="Toggle theme" aria-label="Toggle color theme">
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
    </button>

    <main class="register-shell">
        <aside class="register-aside">
            <a class="register-brand" asp-controller="Home" asp-action="Login" aria-label="Return to Yakult Portal login">
                <span class="register-brand__mark" aria-hidden="true"></span>
                <span>Yakult<span>Portal</span></span>
            </a>
            <h1>Your systems access starts with a <em>verified identity.</em></h1>
            <p>Request one secure account for Yakult's internal tools. Your organization details come from the employee directory and cannot be changed here.</p>
            <div class="register-trust">
                <div class="register-trust__item"><span class="register-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span>Employee-directory verification</div>
                <div class="register-trust__item"><span class="register-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>Requests reviewed by IT</div>
                <div class="register-trust__item"><span class="register-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>Access based on your assigned role</div>
            </div>
            <a class="register-back" asp-controller="Home" asp-action="Login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>Back to sign in</a>
        </aside>

        <section class="register-card" aria-labelledby="registerTitle">
            <div id="registerFlow">
                <div class="register-card__top">
                    <div><h2 id="registerTitle">Request an account</h2><p class="register-card__subtitle">Verify your employee identity, create credentials, and submit for IT review.</p></div>
                    <span class="demo-badge">Requester access</span>
                </div>

                @Html.AntiForgeryToken()

                <div class="register-stepper" aria-label="Registration progress">
                    <div class="register-stepper__item is-active" data-step-indicator="1"><span class="register-stepper__line"></span>Verify identity</div>
                    <div class="register-stepper__item" data-step-indicator="2"><span class="register-stepper__line"></span>Create account</div>
                    <div class="register-stepper__item" data-step-indicator="3"><span class="register-stepper__line"></span>Review request</div>
                </div>

                <section class="register-panel is-active" data-step="1">
                    <div class="panel-heading"><h3>First, confirm your employee record</h3><p>Use your official employee number and work email. Personal email addresses are not accepted.</p></div>
                    <div class="register-fields">
                        <div class="register-field">
                            <label for="employeeNumber">Employee number</label>
                            <input id="employeeNumber" autocomplete="off" placeholder="Enter employee number" />
                            <small>Printed on your employee ID.</small>
                        </div>
                        <div class="register-field">
                            <label for="workEmail">Work email</label>
                            <input id="workEmail" type="email" autocomplete="email" placeholder="name@yakult.ph" />
                            <small>Must match the employee directory.</small>
                        </div>
                    </div>
                    <div class="demo-notice" id="identityNotice"><strong>Identity check:</strong> The employee number and work email must match an active employee record.</div>
                    <div class="register-actions"><button type="button" class="register-button register-button--primary" id="verifyEmployee">Verify employee <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button></div>
                </section>

                <section class="register-panel" data-step="2">
                    <div class="verified-banner"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>Employee record verified. Organization details are read-only.</div>
                    <div class="employee-card">
                        <div class="employee-card__header"><div class="employee-avatar" id="employeeAvatar">—</div><div><strong id="employeeName">Employee record</strong><span id="employeeRecordNumber">Verification required</span></div></div>
                        <div class="employee-grid">
                            <div class="employee-detail"><span>Company</span><strong id="employeeCompany">—</strong></div>
                            <div class="employee-detail"><span>Branch</span><strong id="employeeBranch">—</strong></div>
                            <div class="employee-detail"><span>Department</span><strong id="employeeDepartment">—</strong></div>
                            <div class="employee-detail"><span>Section</span><strong id="employeeSection">—</strong></div>
                            <div class="employee-detail"><span>Position</span><strong id="employeePosition">—</strong></div>
                            <div class="employee-detail"><span>Title</span><strong id="employeeTitle">—</strong></div>
                        </div>
                    </div>
                    <div class="panel-heading"><h3>Create your sign-in details</h3><p>Your username must be unique. Use at least eight characters for the password.</p></div>
                    <div class="register-fields">
                        <div class="register-field register-field--full"><label for="username">Username</label><input id="username" autocomplete="username" placeholder="Choose a username" /><small>Letters, numbers, dots, hyphens, and underscores only.</small></div>
                        <div class="register-field"><label for="newPassword">Password</label><input id="newPassword" type="password" autocomplete="new-password" placeholder="At least 8 characters" /></div>
                        <div class="register-field"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" type="password" autocomplete="new-password" placeholder="Enter password again" /></div>
                    </div>
                    <div class="register-actions"><button type="button" class="register-button register-button--secondary" data-back="1">Back</button><button type="button" class="register-button register-button--primary" id="continueReview">Continue to review <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button></div>
                </section>

                <section class="register-panel" data-step="3">
                    <div class="panel-heading"><h3>Review your account request</h3><p>Check the information below before sending it to IT for approval.</p></div>
                    <div class="review-list">
                        <div class="review-row"><span>Employee</span><strong id="reviewEmployee">—</strong></div>
                        <div class="review-row"><span>Organization</span><strong id="reviewOrganization">—</strong></div>
                        <div class="review-row"><span>Position</span><strong id="reviewPosition">—</strong></div>
                        <div class="review-row"><span>Work email</span><strong id="reviewEmail">—</strong></div>
                        <div class="review-row"><span>Requested username</span><strong id="reviewUsername">—</strong></div>
                        <div class="review-row"><span>Initial access</span><strong>Requester</strong></div>
                    </div>
                    <div class="demo-notice" id="accountNotice"><strong>Approval required:</strong> IT will review this request. Approved accounts receive the Requester role by default.</div>
                    <div class="register-actions"><button type="button" class="register-button register-button--secondary" data-back="2">Edit details</button><button type="button" class="register-button register-button--primary" id="submitRequest">Submit request <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></button></div>
                </section>
            </div>

            <div class="success-state" id="successState">
                <div><div class="success-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m20 6-11 11-5-5"/></svg></div><h3>Request submitted</h3><p>Your request is pending IT approval. You can sign in after the account is approved.</p><a class="register-button register-button--secondary" asp-controller="Home" asp-action="Login">Return to sign in</a></div>
            </div>
        </section>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var verifiedEmployee = null;
            var employeeNumber = document.getElementById('employeeNumber');
            var workEmail = document.getElementById('workEmail');
            var identityNotice = document.getElementById('identityNotice');
            var verifyButton = document.getElementById('verifyEmployee');
            var username = document.getElementById('username');
            var newPassword = document.getElementById('newPassword');
            var confirmPassword = document.getElementById('confirmPassword');
            var accountNotice = document.getElementById('accountNotice');
            var submitButton = document.getElementById('submitRequest');

            function showStep(step) {
                document.querySelectorAll('[data-step]').forEach(function(panel) { panel.classList.toggle('is-active', Number(panel.dataset.step) === step); });
                document.querySelectorAll('[data-step-indicator]').forEach(function(item) {
                    var value = Number(item.dataset.stepIndicator);
                    item.classList.toggle('is-active', value === step);
                    item.classList.toggle('is-done', value < step);
                });
                document.querySelector('.register-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function setNotice(message, isError) {
                identityNotice.innerHTML = message;
                identityNotice.style.background = isError ? 'rgba(239,68,68,.10)' : 'rgba(245,158,11,.09)';
                identityNotice.style.color = isError ? '#fecaca' : '#fde68a';
            }

            function valueOrDash(value) {
                return value && String(value).trim() ? value : '—';
            }

            function avatarFor(name) {
                var parts = (name || '').trim().split(/\s+/).filter(Boolean);
                if (parts.length === 0) return '—';
                if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
                return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
            }

            function fillEmployeeRecord(employee) {
                document.getElementById('employeeAvatar').textContent = avatarFor(employee.name);
                document.getElementById('employeeName').textContent = valueOrDash(employee.name);
                document.getElementById('employeeRecordNumber').textContent = employee.employeeNumber ? 'Employee #' + employee.employeeNumber : 'Employee number unavailable';
                document.getElementById('employeeCompany').textContent = valueOrDash(employee.company);
                document.getElementById('employeeBranch').textContent = valueOrDash(employee.branch);
                document.getElementById('employeeDepartment').textContent = valueOrDash(employee.department);
                document.getElementById('employeeSection').textContent = valueOrDash(employee.section);
                document.getElementById('employeePosition').textContent = valueOrDash(employee.position);
                document.getElementById('employeeTitle').textContent = valueOrDash(employee.title);
                document.getElementById('reviewEmployee').textContent = employee.employeeNumber ? valueOrDash(employee.name) + ' (' + employee.employeeNumber + ')' : valueOrDash(employee.name);
                document.getElementById('reviewOrganization').textContent = [employee.company, employee.branch, employee.department].filter(function(value) { return value && String(value).trim(); }).join(' · ') || '—';
                document.getElementById('reviewPosition').textContent = [employee.position, employee.title].filter(function(value) { return value && String(value).trim(); }).join(' · ') || '—';
                document.getElementById('reviewEmail').textContent = valueOrDash(employee.workEmail || workEmail.value.trim());
            }

            verifyButton.addEventListener('click', async function() {
                var number = employeeNumber.value.trim();
                var email = workEmail.value.trim();

                employeeNumber.classList.toggle('is-invalid', !number);
                if (!number) {
                    setNotice('<strong>Employee number required:</strong> Enter the employee number to fetch the employee record.', true);
                    return;
                }

                verifyButton.disabled = true;
                verifyButton.textContent = 'Verifying...';

                try {
                    var url = '@Url.Action("FindEmployeeRecord", "Home")' + '?employeeNumber=' + encodeURIComponent(number) + '&workEmail=' + encodeURIComponent(email);
                    var response = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    var payload = await response.json().catch(function() { return {}; });

                    if (!response.ok || !payload.success) {
                        setNotice('<strong>Employee not found:</strong> ' + (payload.message || 'Check the employee number and work email.'), true);
                        return;
                    }

                    verifiedEmployee = payload.employee;
                    fillEmployeeRecord(verifiedEmployee);
                    setNotice('<strong>Employee record verified:</strong> Organization details are read-only.', false);
                    showStep(2);
                } catch (error) {
                    setNotice('<strong>Verification failed:</strong> Unable to reach employee lookup.', true);
                } finally {
                    verifyButton.disabled = false;
                    verifyButton.innerHTML = 'Verify employee <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>';
                }
            });

            document.getElementById('continueReview').addEventListener('click', function() {
                var validUsername = /^[A-Za-z0-9._-]{3,100}$/.test(username.value.trim());
                var validPassword = newPassword.value.length >= 8 && newPassword.value.length <= 128 && newPassword.value === confirmPassword.value;
                username.classList.toggle('is-invalid', !validUsername);
                newPassword.classList.toggle('is-invalid', !validPassword);
                confirmPassword.classList.toggle('is-invalid', !validPassword);
                if (!validUsername || !validPassword) {
                    window.alert(!validUsername
                        ? 'Enter a valid username with at least 3 characters.'
                        : 'Passwords must match and contain between 8 and 128 characters.');
                    return;
                }
                if (verifiedEmployee) fillEmployeeRecord(verifiedEmployee);
                document.getElementById('reviewUsername').textContent = username.value.trim();
                showStep(3);
            });

            document.querySelectorAll('[data-back]').forEach(function(button) { button.addEventListener('click', function() { showStep(Number(button.dataset.back)); }); });
            submitButton.addEventListener('click', async function() {
                if (!verifiedEmployee) {
                    showStep(1);
                    setNotice('<strong>Verification required:</strong> Verify the employee record before creating an account.', true);
                    return;
                }

                submitButton.disabled = true;
                submitButton.textContent = 'Submitting request...';
                accountNotice.innerHTML = '<strong>Please wait:</strong> Securely submitting the account request for IT review.';

                try {
                    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                    var response = await fetch('@Url.Action("CreateAccount", "Home")', {
                        method: 'POST',
                        headers: {
                            'Accept': 'application/json',
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            employeeNumber: employeeNumber.value.trim(),
                            workEmail: workEmail.value.trim(),
                            username: username.value.trim(),
                            password: newPassword.value
                        })
                    });
                    var payload = await response.json().catch(function() { return {}; });
                    if (!response.ok || !payload.success) {
                        accountNotice.innerHTML = '<strong>Account not created:</strong> ' + (payload.message || 'Please review the details and try again.');
                        accountNotice.style.background = 'rgba(239,68,68,.10)';
                        accountNotice.style.color = '#fecaca';
                        return;
                    }

                    document.getElementById('registerFlow').style.display = 'none';
                    document.getElementById('successState').classList.add('is-visible');
                } catch (error) {
                    accountNotice.innerHTML = '<strong>Account not created:</strong> Unable to reach the registration service.';
                    accountNotice.style.background = 'rgba(239,68,68,.10)';
                    accountNotice.style.color = '#fecaca';
                } finally {
                    submitButton.disabled = false;
                    submitButton.innerHTML = 'Submit request <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';
                }
            });

            document.getElementById('themeToggle').addEventListener('click', function() {
                var current = document.documentElement.getAttribute('data-theme') || 'dark';
                var next = current === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', next);
                localStorage.setItem('yakultTheme', next);
            });
        });
    </script>
</body>
</html>
