@using Yakult.SystemsPortal.Services
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService Authorization
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentUser = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Administrator" : User.Identity!.Name!;
    var isDeveloper = User.HasClaim("IsDeveloper", "true");
    var canManagePortal = isDeveloper || User.IsInRole("PortalAdmin");
    var canManageContent = (await Authorization.AuthorizeAsync(User, null, "ContentEditor")).Succeeded;
    var canManageResources = (await Authorization.AuthorizeAsync(User, null, "EmployeeResourceEditor")).Succeeded;
    var demoMode = Context.RequestServices.GetRequiredService<IDemoModeService>();
    var canUseDemoMode = demoMode.IsAvailable && demoMode.CanUse(Context);
    var isDemoModeEnabled = demoMode.IsEnabled(Context);
    var returnUrl = Context.Request.PathBase + Context.Request.Path + Context.Request.QueryString;
    var initials = string.Concat(currentUser.Split(new[] { ' ', '.', '_', '@' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    var roleLabel = isDeveloper ? "Developer" : User.IsInRole("PortalAdmin") ? "Portal administrator" : canManageContent ? "Content editor" : "Resource editor";
    var homeController = canManagePortal ? "Admin" : canManageContent ? "ContentAdmin" : "EmployeeResourcesAdmin";
    var homeAction = canManagePortal ? "Dashboard" : "Index";
    var pageGroup = currentController != "Admin" ? "Content" : currentAction switch
    {
        "Dashboard" => "Workspace",
        "Cards" or "Health" => "Operations",
        "AccountRequests" or "Audit" => "Administration",
        _ => "System"
    };
    var navigation = new[]
    {
        new { Group = "Workspace", Label = "Overview", Controller = "Admin", Action = "Dashboard", Icon = "overview", Visible = canManagePortal },
        new { Group = "Workspace", Label = "Services & Portals", Controller = "Admin", Action = "Cards", Icon = "services", Visible = canManagePortal },
        new { Group = "Workspace", Label = "Service Health", Controller = "Admin", Action = "Health", Icon = "health", Visible = canManagePortal },
        new { Group = "Administration", Label = "Account Requests", Controller = "Admin", Action = "AccountRequests", Icon = "accounts", Visible = canManagePortal },
        new { Group = "Administration", Label = "Activity Log", Controller = "Admin", Action = "Audit", Icon = "activity", Visible = canManagePortal },
        new { Group = "Content", Label = "Learning Content", Controller = "ContentAdmin", Action = "Index", Icon = "learning", Visible = canManageContent },
        new { Group = "Content", Label = "Employee Resources", Controller = "EmployeeResourcesAdmin", Action = "Index", Icon = "resources", Visible = canManageResources },
        new { Group = "Content", Label = "FAQ & Company Policy", Controller = "CompanyInfoAdmin", Action = "Index", Icon = "policy", Visible = canManageContent },
        new { Group = "System", Label = "Portal Notice", Controller = "Admin", Action = "Settings", Icon = "notice", Visible = isDeveloper },
        new { Group = "System", Label = "Database Connection", Controller = "Admin", Action = "ConnectionProperties", Icon = "database", Visible = isDeveloper }
    };
    bool IsCurrent(string controller, string action) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (controller != "Admin" || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            || action == "ConnectionProperties" && currentAction == "UnlockConnectionPage");
}
@functions {
    Microsoft.AspNetCore.Html.IHtmlContent NavIcon(string name)
    {
        var paths = name switch
        {
            "overview" => "<rect x='3' y='3' width='7' height='7' rx='1.5'/><rect x='14' y='3' width='7' height='7' rx='1.5'/><rect x='3' y='14' width='7' height='7' rx='1.5'/><rect x='14' y='14' width='7' height='7' rx='1.5'/>",
            "services" => "<rect x='3' y='4' width='18' height='12' rx='2'/><path d='M8 20h8M12 16v4M7 8h4M7 12h8'/>",
            "health" => "<path d='M3 12h4l3-8 4 16 3-8h4'/>",
            "accounts" => "<path d='M15 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M19 8v6M16 11h6'/><circle cx='8.5' cy='7' r='4'/>",
            "activity" => "<path d='M3 11a9 9 0 1 1 2.6 7M3 4v7h7M12 7v5l3 2'/>",
            "learning" => "<path d='m2 8 10-5 10 5-10 5L2 8ZM6 10v6c3 3 9 3 12 0v-6M22 8v8'/>",
            "resources" => "<path d='M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z'/><path d='M8 12h8M8 16h5'/>",
            "policy" => "<path d='M5 3h10l4 4v14H5V3ZM14 3v5h5M9 12h6M9 16h6'/>",
            "notice" => "<path d='m3 11 16-6v14l-16-6v-2ZM7 14l2 7h4l-2-6M19 10h3'/>",
            "database" => "<ellipse cx='12' cy='5' rx='8' ry='3'/><path d='M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0'/>",
            "menu" => "<path d='M4 6h16M4 12h16M4 18h16'/>",
            "close" => "<path d='m6 6 12 12M6 18 18 6'/>",
            "external" => "<path d='M14 3h7v7M21 3 11 13M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5'/>",
            "chevron" => "<path d='m9 6 6 6-6 6'/>",
            "logout" => "<path d='M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9'/>",
            _ => "<path d='M3 21h18M5 21V5l7-3 7 3v16M9 8h.01M15 8h.01M9 12h.01M15 12h.01M10 21v-5h4v5'/>"
        };
        return new Microsoft.AspNetCore.Html.HtmlString("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' focusable='false'>" + paths + "</svg>");
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal Admin</title>
    <link rel="icon" type="image/svg+xml" href="~/images/admin-mark.svg" asp-append-version="true" />
    <script>
        document.documentElement.classList.add('admin-shell-js');
        try {
            if (localStorage.getItem('yakult.admin.sidebar.collapsed') === 'true') {
                document.documentElement.classList.add('admin-nav-collapsed');
            }
        } catch (_) { }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/demo-data.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-secondary.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <script src="~/js/admin-shell.js" asp-append-version="true" defer></script>
</head>
<body class="admin-portal admin-portal--official admin-workspace-layout">
    <a class="skip-link admin-skip-link" href="#admin-main-content">Skip to main content</a>

    <aside class="portal-admin-sidebar" id="portalAdminSidebar" aria-label="Administration navigation" tabindex="-1">
        <div class="portal-admin-sidebar__brand-row">
            <a class="portal-admin-brand" asp-controller="@homeController" asp-action="@homeAction" aria-label="Yakult administration home">
                <span class="portal-admin-brand__mark" aria-hidden="true">Y<span></span></span>
                <span class="portal-admin-brand__text"><strong>Yakult<span>®</span></strong><small>Services administration</small></span>
            </a>
            <button class="portal-admin-icon-button portal-admin-sidebar__close" id="adminSidebarClose" type="button" aria-label="Close navigation">@NavIcon("close")</button>
        </div>

        <nav class="portal-admin-nav" id="adminNavigation" aria-label="Admin navigation">
            @foreach (var group in navigation.Where(item => item.Visible).GroupBy(item => item.Group))
            {
                <section class="portal-admin-nav__group" aria-label="@group.Key">
                    <h2 class="portal-admin-nav__heading">@group.Key</h2>
                    @foreach (var item in group)
                    {
                        var active = IsCurrent(item.Controller, item.Action);
                        <a class="portal-admin-nav__link @(active ? "is-active" : string.Empty)"
                           asp-controller="@item.Controller" asp-action="@item.Action"
                           aria-current="@(active ? "page" : null)" aria-label="@item.Label" data-nav-label="@item.Label">
                            <span class="portal-admin-nav__icon">@NavIcon(item.Icon)</span>
                            <span class="portal-admin-nav__text">@item.Label</span>
                            @if (active)
                            {
                                <span class="portal-admin-nav__indicator" aria-hidden="true"></span>
                            }
                        </a>
                    }
                </section>
            }
        </nav>

        <div class="portal-admin-sidebar__footer">
            <span class="portal-admin-sidebar__company-icon">@NavIcon("company")</span>
            <span class="portal-admin-sidebar__company"><strong>Yakult Philippines</strong><small>Internal administration</small></span>
        </div>
    </aside>
    <div class="portal-admin-backdrop" id="adminSidebarBackdrop" hidden aria-hidden="true"></div>
    <div class="portal-admin-tooltip" id="adminNavTooltip" role="tooltip" hidden></div>

    <div class="portal-admin-frame" id="adminWorkspaceFrame">
        <header class="portal-admin-topbar">
            <div class="portal-admin-topbar__context">
                <button class="portal-admin-icon-button portal-admin-toggle" id="adminMenuButton" type="button" aria-controls="portalAdminSidebar" aria-expanded="true" aria-label="Collapse sidebar">
                    @NavIcon("menu")
                </button>
                <div class="portal-admin-breadcrumb" aria-label="Current section">
                    <span>Administration</span><span class="portal-admin-breadcrumb__divider" aria-hidden="true">/</span><strong>@pageGroup</strong>
                </div>
            </div>
            <div class="portal-admin-topbar__actions">
                <a class="portal-admin-public-link" asp-controller="Public" asp-action="Services" aria-label="Open public portal">@NavIcon("external")<span>Public portal</span></a>
                <span class="portal-admin-topbar__divider" aria-hidden="true"></span>
                <details class="portal-admin-account" id="adminPortalDropdown">
                    <summary aria-label="Account menu for @currentUser">
                        <span class="portal-admin-avatar" aria-hidden="true">@initials</span>
                        <span class="portal-admin-account__identity"><strong>@currentUser</strong><small>@roleLabel</small></span>
                        <span class="portal-admin-account__chevron">@NavIcon("chevron")</span>
                    </summary>
                    <div class="portal-admin-account__panel">
                        <div class="portal-admin-account__heading"><strong>@currentUser</strong><small>@roleLabel</small></div>
                        <a class="portal-admin-account__item" asp-controller="Public" asp-action="Services">@NavIcon("external")<span>Open public portal</span></a>
                        @if (canUseDemoMode)
                        {
                            <form asp-controller="Public" asp-action="SetDemoMode" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input type="hidden" name="enabled" value="@(isDemoModeEnabled ? "false" : "true")" />
                                <button class="portal-admin-account__item" type="submit" aria-pressed="@isDemoModeEnabled">@NavIcon("overview")<span>@(isDemoModeEnabled ? "Exit demo view" : "View demo data")</span></button>
                            </form>
                        }
                        <form class="portal-admin-account__logout" asp-controller="Home" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button class="portal-admin-account__item" type="submit">@NavIcon("logout")<span>Sign out</span></button>
                        </form>
                    </div>
                </details>
            </div>
        </header>

        <main class="admin-main" id="admin-main-content" tabindex="-1">
            @if (ViewData["UseCustomPageHeading"] as bool? != true)
            {
            <section class="admin-page-heading">
                <div class="admin-container">
                    <span class="eyebrow">@pageGroup</span>
                    <h1>@ViewData["Title"]</h1>
                </div>
            </section>
            }
            <div class="admin-container admin-content">
                @RenderBody()
            </div>
        </main>
        <footer class="portal-admin-page-footer"><span>Yakult Philippines Incorporated</span><span>Systems &amp; Services Portal</span></footer>
    </div>
    <div class="toast-region" id="toastRegion" aria-live="polite" aria-atomic="true"></div>
    @RenderSection("Scripts", required: false)
</body>
</html>
