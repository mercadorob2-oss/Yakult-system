@model CompanyPolicyListViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Company Policy";
}

<header class="faq-hero faq-hero--policy">
    <div class="portal-container faq-hero__inner">
        <div>
            <span class="portal-eyebrow">Governance</span>
            <h1>Company Policy</h1>
            <p>Official company policies and workplace guidelines for employees.</p>
            <form class="faq-search" asp-controller="Public" asp-action="CompanyPolicies" method="get" role="search">
                <label class="sr-only" for="policySearch">Search policies</label>
                <input id="policySearch" name="q" type="search" autocomplete="off" placeholder="Search policies" value="@Context.Request.Query["q"]" />
                <button type="submit">Search</button>
            </form>
        </div>
        <aside class="faq-hero__summary" aria-label="Policy summary">
            <span><strong>@Model.Items.Count</strong>Policies</span>
            <span><strong>@Model.Categories.Count</strong>Topics</span>
        </aside>
    </div>
</header>

<main class="faq-library">
    <div class="portal-container">
        @if (Model.IsDemoData)
        {
            <p><span class="dummy-data-badge">DUMMY DATA · FRONTEND SAMPLE</span></p>
        }
        @if (Model.Items.Count == 0)
        {
            <div class="portal-empty portal-empty--large"><span aria-hidden="true">○</span><h2>No policies found</h2><p>Try a different search, or browse all policies.</p><p><a asp-action="CompanyPolicies">Browse all policies</a> <button type="button" class="portal-button portal-button--outline" id="policyClearSearch">Clear search</button></p></div>
        }
        else
        {
            <div class="policy-grid" id="policyGrid">
                @foreach (var item in Model.Items)
                {
                    <a class="policy-card" asp-controller="Public" asp-action="CompanyPolicyDetails" asp-route-slug="@item.Slug">
                        <small>@item.Category@(item.EffectiveDate.HasValue ? $" · Effective {item.EffectiveDate.Value:MMM d, yyyy}" : null)</small>
                        <strong>@item.Title</strong>
                        <span>@item.Summary</span>
                        <em>Read policy <span aria-hidden="true">→</span></em>
                    </a>
                }
            </div>
            <p class="faq-count" id="policyCount" role="status" aria-live="polite"></p>
        }
    </div>
</main>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var search = document.getElementById('policySearch');
        var cards = Array.from(document.querySelectorAll('#policyGrid .policy-card'));
        var count = document.getElementById('policyCount');
        var clearBtn = document.getElementById('policyClearSearch');
        function applyPolicyFilter() {
            var term = (search && search.value || '').trim().toLowerCase();
            var shown = 0;
            cards.forEach(function (card) {
                var show = !term || card.textContent.toLowerCase().includes(term);
                card.style.display = show ? '' : 'none';
                if (show) shown++;
            });
            if (count) count.textContent = term ? shown + ' polic' + (shown === 1 ? 'y' : 'ies') + ' found.' : '';
        }
        if (search) search.addEventListener('input', applyPolicyFilter);
        if (clearBtn && search) clearBtn.addEventListener('click', function () {
            search.value = '';
            applyPolicyFilter();
            search.focus();
        });
    });
</script>
}
