@model CompanyPolicyListViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Company Policy";
    var referenceItems = Model.Items.Where(item => PublicItInformationSamples.IsSampleSlug(item.Slug)).ToList();
    var standardPolicies = Model.Items.Where(item => !PublicItInformationSamples.IsSampleSlug(item.Slug)).ToList();
}
<link rel="stylesheet" href="~/css/it-information.css" asp-append-version="true" />

<header class="faq-hero faq-hero--policy">
    <div class="portal-container faq-hero__inner">
        <div>
            <span class="portal-eyebrow">Governance</span>
            <h1>Company Policy</h1>
            <p>Official company policies and workplace guidelines for employees.</p>
            <form class="faq-search" asp-controller="Public" asp-action="CompanyPolicies" method="get" role="search">
                <label class="sr-only" for="policySearch">Search policies</label>
                <input id="policySearch" name="q" type="search" autocomplete="off" placeholder="Search policies" value="@Context.Request.Query["q"]" />
                <button type="submit">Search</button>
            </form>
        </div>
        <aside class="faq-hero__summary" aria-label="Policy summary">
            <span><strong>@Model.Items.Count</strong>Policies</span>
            <span><strong>@Model.Categories.Count</strong>Topics</span>
        </aside>
    </div>
</header>

<main class="faq-library">
    <div class="portal-container">
        @if (Model.IsDemoData)
        {
            <p><span class="dummy-data-badge">DUMMY DATA · FRONTEND SAMPLE</span></p>
        }
        @if (Model.Items.Count == 0)
        {
            <div class="portal-empty portal-empty--large"><span aria-hidden="true">○</span><h2>No policies found</h2><p>Try a different search, or browse all policies.</p><p><a asp-action="CompanyPolicies">Browse all policies</a> <button type="button" class="portal-button portal-button--outline" id="policyClearSearch">Clear search</button></p></div>
        }
        else
        {
            @if (referenceItems.Count > 0)
            {
                <div class="it-information it-info-library">
                    <p class="it-info-preview" role="status"><span>DEMO PREVIEW</span> Selected employee references from the supplied IT documents.</p>
                    <div class="it-info-resource-grid">
                        @foreach (var item in referenceItems)
                        {
                            var resource = PublicItInformationSamples.Find(item.Slug)!;
                            <article class="it-info-resource it-info-resource--@resource.Accent" data-policy-search-card>
                                <div class="it-info-resource__top"><span>@resource.Kind</span><span class="it-info-resource__number" aria-hidden="true">@(resource.Accent == "policy" ? "01" : "02")</span></div>
                                <div class="it-info-resource__symbol" aria-hidden="true">
                                    @if (resource.Accent == "policy")
                                    {
                                        <svg viewBox="0 0 64 64" fill="none"><path d="M16 10h24l10 10v34H16z" /><path d="M39 10v12h11M25 32h16M25 40h16M25 48h10" /></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="18" r="8" /><path d="M18 48v-7c0-8 6-13 14-13s14 5 14 13v7zM13 22a6 6 0 0 0 0 12M51 22a6 6 0 0 1 0 12M12 39c-4 1-6 5-6 10h7M52 39c4 1 6 5 6 10h-7" /></svg>
                                    }
                                </div>
                                <h3><a asp-action="CompanyPolicyDetails" asp-route-slug="@resource.Slug">@resource.Title</a></h3>
                                <p>@resource.Summary</p>
                                <ul class="it-info-topic-tags" aria-label="Topics included">@foreach (var topic in resource.Sections) { <li>@topic.Title</li> }</ul>
                                <div class="it-info-resource__footer"><span>@resource.Sections.Count topics · Employee reference</span><a asp-action="CompanyPolicyDetails" asp-route-slug="@resource.Slug">Read reference <span aria-hidden="true">↗</span><span class="sr-only">: @resource.Title</span></a></div>
                            </article>
                        }
                    </div>
                </div>
            }
            @if (standardPolicies.Count > 0)
            {
            <div class="policy-grid" id="policyGrid">
                @foreach (var item in standardPolicies)
                {
                    <a class="policy-card" asp-controller="Public" asp-action="CompanyPolicyDetails" asp-route-slug="@item.Slug">
                        <small>@item.Category@(item.EffectiveDate.HasValue ? $" · Effective {item.EffectiveDate.Value:MMM d, yyyy}" : null)</small>
                        <strong>@item.Title</strong>
                        <span>@item.Summary</span>
                        <em>Read policy <span aria-hidden="true">→</span></em>
                    </a>
                }
            </div>
            }
            <p class="faq-count" id="policyCount" role="status" aria-live="polite"></p>
        }
    </div>
</main>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var search = document.getElementById('policySearch');
        var cards = Array.from(document.querySelectorAll('#policyGrid .policy-card, [data-policy-search-card]'));
        var count = document.getElementById('policyCount');
        var clearBtn = document.getElementById('policyClearSearch');
        function applyPolicyFilter() {
            var term = (search && search.value || '').trim().toLowerCase();
            var shown = 0;
            cards.forEach(function (card) {
                var show = !term || card.textContent.toLowerCase().includes(term);
                card.style.display = show ? '' : 'none';
                if (show) shown++;
            });
            if (count) count.textContent = term ? shown + ' polic' + (shown === 1 ? 'y' : 'ies') + ' found.' : '';
        }
        if (search) search.addEventListener('input', applyPolicyFilter);
        if (clearBtn && search) clearBtn.addEventListener('click', function () {
            search.value = '';
            applyPolicyFilter();
            search.focus();
        });
    });
</script>
}
