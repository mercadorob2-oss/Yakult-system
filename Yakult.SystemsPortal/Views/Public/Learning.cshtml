@using System.Security.Claims
@model ContentListViewModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Learning & Awareness";
    var userKey = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? User.Identity?.Name;
    var pages = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
    var resume = Model.Items.FirstOrDefault(item => LearningCourseDocument.Parse(item.Body) == null && Model.ProgressByContentId.TryGetValue(item.ContentId, out var p) && !p.IsCompleted && p.ProgressPercent > 0);
}
<link rel="stylesheet" href="~/css/learning-academy.css" asp-append-version="true" />
<div class="learning-hub" id="learningHub" data-progress-prefix="@LearningCourseDocument.BrowserScope(userKey, Model.IsDemoData)">
    <header class="learning-hub-header">
        <div class="portal-container"><div><span class="academy-eyebrow">Yakult learning</span><h1>A little learning.<br />A more confident you.</h1><p>@Model.Description</p></div>
            @if (User.Identity?.IsAuthenticated == true) { <a class="academy-button academy-button--secondary" asp-action="MyLearning">My learning <span aria-hidden="true">↗</span></a> }
        </div>
    </header>
    <div class="portal-container learning-hub-main">
        @if (Model.IsDemoData)
        {
            <div class="demo-data-banner" role="status"><span class="dummy-data-badge">DUMMY DATA</span><div><strong>Explore the new learning experience</strong><p>These sample courses demonstrate modules, lessons, videos, walkthroughs, and practice questions. Your demo progress stays on this browser.</p></div></div>
        }
        <nav class="learning-hub-tracks" aria-label="Learning topics">
            <a asp-action="Learning" asp-route-q="@Model.Query" asp-route-type="@Model.SelectedType" asp-route-sort="@Model.Sort" aria-current="@(string.IsNullOrWhiteSpace(Model.SelectedTrack) ? "page" : "false")">All learning</a>
            @foreach (var track in Model.Tracks) { <a asp-action="Learning" asp-route-track="@track.Value" asp-route-q="@Model.Query" asp-route-type="@Model.SelectedType" asp-route-sort="@Model.Sort" aria-current="@(track.Value == Model.SelectedTrack ? "page" : "false")">@track.Label</a> }
        </nav>
        <section class="learning-hub-continue" id="learningContinue" hidden="@(resume == null)" aria-labelledby="learningContinueHeading">
            <div><span class="academy-eyebrow">Keep your momentum</span><h2 id="learningContinueHeading">@(resume?.Title ?? "Pick up where you left off")</h2><p id="learningContinueDetail">Your next lesson is waiting.</p></div><a class="academy-button" id="learningContinueLink" href="@(resume == null ? "#" : Url.Action("ContentDetails", new { slug = resume.Slug }))">Continue learning →</a>
        </section>
        <form class="learning-hub-tools" asp-action="Learning" method="get" role="search">
            <input type="hidden" name="track" value="@Model.SelectedTrack" />
            <label>Find your next lesson<input id="learningSearch" name="q" type="search" value="@Model.Query" maxlength="200" placeholder="Search a topic, skill, or system" /></label>
            <label>Format<select name="type"><option value="">All formats</option>
                @foreach (var type in Model.AvailableTypes) { <option value="@type" selected="@(type.Equals(Model.SelectedType, StringComparison.OrdinalIgnoreCase))">@type</option> }
                @if (!string.IsNullOrWhiteSpace(Model.SelectedType) && !Model.AvailableTypes.Contains(Model.SelectedType, StringComparer.OrdinalIgnoreCase)) { <option value="@Model.SelectedType" selected>@Model.SelectedType</option> }
            </select></label>
            <label>Sort by<select name="sort"><option value="recommended" selected="@(Model.Sort == "recommended")">Recommended</option><option value="newest" selected="@(Model.Sort == "newest")">Recently updated</option><option value="title" selected="@(Model.Sort == "title")">Title A–Z</option></select></label>
            <button type="submit" class="academy-button">Find learning</button>
        </form>
        <div class="learning-hub-results"><h2>@(string.IsNullOrWhiteSpace(Model.Query) ? "Explore the library" : "Search results")</h2><p role="status">@Model.TotalCount resource@(Model.TotalCount == 1 ? "" : "s")@(Model.TotalCount > 0 ? $" · Page {Model.Page} of {pages}" : "")</p></div>
        @if (Model.CatalogUnavailable)
        {
            <section class="academy-catalog-empty"><h2>The learning library is temporarily unavailable.</h2><p>Please try again shortly.</p><a class="academy-button academy-button--secondary" asp-action="Learning">Try again</a></section>
        }
        else if (Model.Items.Count == 0)
        {
            <section class="academy-catalog-empty"><h2>No learning resources found.</h2><p>Try another topic or clear your search and filters.</p><a class="academy-button academy-button--secondary" asp-action="Learning">Browse all learning</a></section>
        }
        else
        {
            <div class="learning-hub-grid">
                @foreach (var item in Model.Items)
                {
                    var document = LearningCourseDocument.Parse(item.Body);
                    var progress = document == null && Model.ProgressByContentId.TryGetValue(item.ContentId, out var saved) ? saved : null;
                    var readingMinutes = Math.Max(1, (int)Math.Ceiling(item.Body.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200.0));
                    var action = document != null ? "Explore course" : progress?.IsCompleted == true ? "Review" : progress?.ProgressPercent > 0 ? "Continue learning" : item.ContentType == "Course" ? "Start course" : item.ContentType == "Video" ? "Watch lesson" : "Read resource";
                    <a class="academy-card" asp-action="ContentDetails" asp-route-slug="@item.Slug" data-course-key="@(document == null ? null : LearningCourseDocument.BrowserKey(item, userKey))" data-lesson-count="@(document?.Lessons.Count())">
                        <div class="academy-card-cover">
                            @if (LearningCourseDocument.IsSafeUrl(item.ThumbnailUrl)) { <img src="@item.ThumbnailUrl" alt="" loading="lazy" /> }
                            else { <div><span>@item.CategoryName</span><strong aria-hidden="true">@(item.ContentType is "Video" or "Course" ? "▶" : "Aa")</strong></div> }
                            <small>@(item.IsDemo ? "DEMO COURSE" : document != null ? "Course" : item.ContentType)</small>
                        </div>
                        <div class="academy-card-content"><small>@item.CategoryName</small><h3>@item.Title</h3><p>@item.Summary</p>
                            <div class="academy-card-facts">
                                @if (document != null) { <span>@document.Lessons.Count() lessons</span><span>@document.Minutes min</span><span>@document.Level</span> }
                                else if (progress?.DurationSec > 0) { <span>@Math.Max(1, progress.DurationSec / 60) min video</span> }
                                else if (item.ContentType is not ("Course" or "Video")) { <span>@readingMinutes min read</span> }
                            </div>
                            <div class="academy-card-footer"><span data-course-action>@action →</span><small data-course-status>@(progress?.IsCompleted == true ? "Completed" : progress?.ProgressPercent > 0 ? $"{progress.ProgressPercent}% watched" : item.IsFeatured ? "Featured" : "")</small></div>
                        </div>
                    </a>
                }
            </div>
            @if (pages > 1)
            {
                <nav class="academy-pagination" aria-label="Learning library pages">
                    @if (Model.Page > 1) { <a class="academy-button academy-button--secondary" asp-action="Learning" asp-route-track="@Model.SelectedTrack" asp-route-type="@Model.SelectedType" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page - 1)">← Previous</a> }
                    <span>Page @Model.Page of @pages</span>
                    @if (Model.Page < pages) { <a class="academy-button academy-button--secondary" asp-action="Learning" asp-route-track="@Model.SelectedTrack" asp-route-type="@Model.SelectedType" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-page="@(Model.Page + 1)">Next →</a> }
                </nav>
            }
        }
    </div>
</div>
@section Scripts { <script src="~/js/learning-library.js" asp-append-version="true" defer></script> }
