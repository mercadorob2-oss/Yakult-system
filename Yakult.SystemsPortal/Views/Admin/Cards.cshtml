@model AdminCardsViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Services & Portals";
    ViewData["UseCustomPageHeading"] = true;
    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };
    jsonOptions.Converters.Add(new JsonStringEnumConverter());
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-services.css" asp-append-version="true" />
}

<div class="services-page" id="servicesPage"
     data-save-url="@Url.Action("SaveCard", "Admin")"
     data-archive-url="@Url.Action("ArchiveCard", "Admin")"
     data-upload-url="@Url.Action("UploadInstaller", "Admin")">
<header class="services-heading">
    <div>
        <span class="services-eyebrow">Operations</span>
        <h1>Services &amp; Portals</h1>
        <p>Manage what employees see and how each service opens.</p>
    </div>
    <button type="button" class="admin-button admin-button--primary services-add" id="newCardBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
        Add service
    </button>
</header>

<div class="services-summary" role="group" aria-label="Filter service directory">
    <button type="button" class="services-filter is-active" data-service-filter="all" aria-pressed="true">All services <span id="totalCount">@Model.Cards.Count</span></button>
    <button type="button" class="services-filter" data-service-filter="visible" aria-pressed="false">Visible <span id="visibleCount">@Model.Cards.Count(card => card.IsVisible)</span></button>
    <button type="button" class="services-filter" data-service-filter="hidden" aria-pressed="false">Hidden <span id="hiddenCount">@Model.Cards.Count(card => !card.IsVisible)</span></button>
    <button type="button" class="services-filter services-filter--unsaved" data-service-filter="draft" aria-pressed="false" hidden>Unsaved <span id="draftCount">0</span></button>
    <button type="button" class="services-discard-all" id="resetDraftsBtn" hidden>Discard all edits</button>
</div>
@Html.AntiForgeryToken()
<noscript><p class="services-script-note">Enable JavaScript to select and edit services.</p></noscript>

<div class="upload-dialog-backdrop" id="installerUploadDialog" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="installerUploadDialogTitle">
    <div class="upload-dialog" id="installerUploadDialogPanel">
        <div class="upload-dialog__head">
            <span class="upload-dialog__spinner" aria-hidden="true"></span>
            <span class="upload-dialog__check" id="installerUploadDialogIcon" aria-hidden="true">✓</span>
            <div>
                <h3 id="installerUploadDialogTitle">Uploading installer</h3>
                <p id="installerUploadDialogMessage">Preparing upload...</p>
            </div>
        </div>
        <div class="upload-progress" aria-hidden="true"><span id="installerUploadDialogProgress"></span></div>
        <div class="upload-dialog__meta"><span id="installerUploadDialogFile">Selected file</span><span id="installerUploadDialogPercent">0%</span></div>
        <div class="upload-dialog__details" id="installerUploadDialogDetails" aria-live="polite"></div>
        <div class="upload-dialog__actions"><button type="button" class="admin-button admin-button--primary" id="installerUploadDialogClose">OK</button></div>
    </div>
</div>

<section class="admin-workspace services-workspace" aria-label="Service management workspace">
    <div class="admin-list-panel">
        <div class="admin-panel-header">
            <div>
                <h2>Service directory</h2>
                <p id="serviceResultCount" role="status">@Model.Cards.Count services</p>
            </div>
            <span class="services-directory-mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
        </div>

        <div class="admin-card-toolbar">
            <label class="services-search" for="cardSearch">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg>
                <span class="services-sr-only">Search services</span>
                <input type="search" id="cardSearch" placeholder="Search services…" autocomplete="off" />
            </label>
            <label class="services-status-filter" for="cardFilter">
                <span>Display status</span>
                <select id="cardFilter">
                    <option value="all">All statuses</option>
                    <option value="connected">Connected</option>
                    <option value="maintenance">Maintenance</option>
                    <option value="not-connected">Not connected</option>
                    <option value="disabled">Disabled</option>
                </select>
            </label>
            <button type="button" class="services-clear-filters" id="clearServiceFilters" hidden>Clear filters</button>
        </div>

        <div class="admin-card-list" id="adminCardList"></div>
    </div>

    <section class="admin-editor" id="adminEditor" aria-label="Service editor" tabindex="-1">
        <button type="button" class="services-back" id="backToServices">← Back to directory</button>
        <div class="admin-panel-header">
            <div>
                <span class="services-editor-eyebrow" id="selectedCardKey">Service settings</span>
                <h2 id="selectedCardName">Select a service</h2>
                <p id="editorSourceLabel">Select a service to edit.</p>
            </div>
        </div>
        <div class="services-editor-empty" id="serviceEditorEmpty" hidden>
            <span class="services-empty-icon" aria-hidden="true">＋</span>
            <h3>Your directory starts here</h3>
            <p>Add a service to set up its details, launch options, and employee visibility.</p>
            <button type="button" class="admin-button admin-button--ghost" id="emptyAddService">Add your first service</button>
        </div>
        <form class="admin-form" id="cardEditForm">
            <div class="admin-selected-card">
                <div class="admin-selected-card__chips">
                    <span class="admin-mini-chip" id="selectedLaunchChip">Launch</span>
                    <span class="admin-mini-chip" id="selectedVisibilityChip">Visibility</span>
                    <span class="admin-mini-chip" id="selectedStatusChip">Status</span>
                </div>
            </div>

            <fieldset class="services-editor-fields" id="serviceEditorFields">
            <legend class="services-sr-only">Service settings</legend>
            <div class="admin-editor-tabs" role="tablist" aria-label="Service editor sections">
                <button type="button" class="admin-tab is-active" id="serviceTab-content" data-tab="content" role="tab" aria-selected="true" aria-controls="servicePanel-content">General</button>
                <button type="button" class="admin-tab" id="serviceTab-launch" data-tab="launch" role="tab" aria-selected="false" aria-controls="servicePanel-launch" tabindex="-1">Launch &amp; downloads</button>
                <button type="button" class="admin-tab" id="serviceTab-maintenance" data-tab="maintenance" role="tab" aria-selected="false" aria-controls="servicePanel-maintenance" tabindex="-1">Maintenance</button>
                <button type="button" class="admin-tab" id="serviceTab-health" data-tab="health" role="tab" aria-selected="false" aria-controls="servicePanel-health" tabindex="-1">Monitoring</button>
            </div>

            <div class="admin-editor-body">
                <div class="admin-editor-main">
                    <section class="admin-tab-panel is-active" id="servicePanel-content" data-tab-panel="content" role="tabpanel" aria-labelledby="serviceTab-content" tabindex="0">
                        <div class="services-section-heading"><h3>Service details</h3><p>Give employees a clear name and a useful description.</p></div>
                        <label>
                            <span>Service name</span>
                            <input type="text" id="cardName" autocomplete="off" />
                        </label>
                        <label>
                            <span>Description</span>
                            <textarea id="cardDescription" rows="4"></textarea>
                        </label>
                        <div class="admin-form-grid">
                            <label>
                                <span>Category label</span>
                                <input type="text" id="cardBadge" autocomplete="off" />
                            </label>
                            <label>
                                <span>Display order</span>
                                <input type="number" id="cardSortOrder" min="0" step="1" />
                                <small class="admin-field-help">Lower numbers appear first.</small>
                            </label>
                        </div>
                        <div class="admin-form-grid">
                            <label>
                                <span>Card appearance</span>
                                <select id="cardTheme">
                                    <option value="">Default</option>
                                    <option value="inventory">Inventory</option>
                                    <option value="cadena">Cadena</option>
                                    <option value="yds">YDS</option>
                                    <option value="request">Request</option>
                                    <option value="borrow">Borrow</option>
                                    <option value="scanner">Scanner</option>
                                    <option value="itcm">ITCM</option>
                                </select>
                            </label>
                            <label>
                                <span>Icon</span>
                                <select id="cardIcon">
                                    <option value="package">Package</option>
                                    <option value="users">Users</option>
                                    <option value="bar-chart">Chart</option>
                                    <option value="clipboard">Clipboard</option>
                                    <option value="smartphone">Phone</option>
                                    <option value="tool">Tool</option>
                                    <option value="database">Database</option>
                                    <option value="book">Book</option>
                                    <option value="grid">Grid</option>
                                    <option value="layers">Layers</option>
                                </select>
                            </label>
                        </div>
                        <label class="admin-check-row services-visibility">
                            <input type="checkbox" id="cardIsVisible" />
                            <span><strong>Visible to employees</strong><small>Show this service in Services &amp; Portals.</small></span>
                        </label>
                        <input type="hidden" id="cardAllowedRoles" />
                        <input type="hidden" id="cardAllowedUserIds" />
                        <details class="services-advanced" id="serviceAdvancedSettings">
                            <summary>Service identifier</summary>
                            <label><span>Service key</span><input type="text" id="cardKey" autocomplete="off" /><small class="admin-field-help" id="serviceKeyHelp">A unique identifier that stays fixed after the service is saved.</small></label>
                        </details>
                    </section>

                    <section class="admin-tab-panel" id="servicePanel-launch" data-tab-panel="launch" role="tabpanel" aria-labelledby="serviceTab-launch" tabindex="0" hidden>
                        <div class="admin-form-section">
                            <div class="admin-form-section__head">
                                <div>
                                    <strong>Launch behavior</strong>
                                    <span>Control how the employee-facing service opens and what status it displays.</span>
                                </div>
                            </div>
                            <div class="admin-form-grid">
                                <label>
                                    <span>Launch type</span>
                                    <select id="cardLaunchType">
                                        <option value="url">Open web URL</option>
                                        <option value="rdp">RDP download</option>
                                        <option value="installer">Installer download</option>
                                        <option value="rdpInstaller">RDP + installer</option>
                                        <option value="disabled">Disabled / reserved</option>
                                    </select>
                                </label>
                                <label>
                                    <span>Display status</span>
                                    <select id="cardStatus">
                                        <option value="Connected">Connected</option>
                                        <option value="Maintenance">Maintenance</option>
                                        <option value="NotConnected">Not connected</option>
                                        <option value="Disabled">Disabled / planned</option>
                                    </select>
                                </label>
                            </div>
                            <p class="services-field-note">Display status is shown to employees. Monitoring results are managed separately.</p>
                            <label data-launch-field="url">
                                <span>URL</span>
                                <input type="text" id="cardUrl" autocomplete="off" placeholder="https://example.local or # for reserved" />
                            </label>
                        </div>

                        <div class="admin-form-section admin-form-section--installer admin-installer-fields" data-launch-field="installer">
                            <div class="admin-form-section__head">
                                <div>
                                    <strong>Installer package</strong>
                                    <span>Upload, version, and describe the package downloaded from the employee page.</span>
                                </div>
                            </div>
                            <label>
                                <span>Installer path</span>
                                <input type="text" id="cardInstallerPath" autocomplete="off" placeholder="installer\app-setup.apk" />
                            </label>
                            <span class="admin-mini-chip" id="selectedInstallerChip">No installer linked</span>
                            <div class="admin-form-grid">
                                <label>
                                    <span>Version</span>
                                    <input type="text" id="cardInstallerVersion" autocomplete="off" placeholder="Optional version" />
                                </label>
                                <label>
                                    <span>Upload installer</span>
                                    <input type="file" id="cardInstallerFile" accept=".apk,.exe,.msi,.zip" />
                                    <small class="admin-field-help" id="installerSelectedFile">No upload file selected.</small>
                                </label>
                            </div>
                            <label>
                                <span>Install notes</span>
                                <textarea id="cardInstallerNotes" rows="3" placeholder="Optional instructions shown to admins for this installer."></textarea>
                            </label>
                            <div class="admin-form-actions admin-form-actions--compact">
                                <span class="admin-save-status" id="installerUploadStatus">No installer uploaded in this session.</span>
                                <button type="button" class="admin-button admin-button--ghost" id="uploadInstallerBtn">Upload Installer</button>
                            </div>
                        </div>
                        <input type="hidden" id="cardDeepLink" />
                    </section>

                    <section class="admin-tab-panel" id="servicePanel-maintenance" data-tab-panel="maintenance" role="tabpanel" aria-labelledby="serviceTab-maintenance" tabindex="0" hidden>
                        <div class="services-section-heading"><h3>Maintenance schedule</h3><p>Set a service window and explain what employees should expect.</p></div>
                        <p class="services-timezone-note">All times below are Philippine time (PHT · UTC+8).</p>
                        <div class="admin-form-grid">
                            <label>
                                <span>Starts · PHT</span>
                                <input type="datetime-local" id="cardMaintenanceStartUtc" />
                            </label>
                            <label>
                                <span>Ends · PHT</span>
                                <input type="datetime-local" id="cardMaintenanceEndUtc" />
                            </label>
                        </div>
                        <label>
                            <span>Maintenance note</span>
                            <textarea id="cardMaintenanceNote" rows="3" placeholder="Optional note shown while in maintenance."></textarea>
                        </label>
                    </section>

                    <section class="admin-tab-panel" id="servicePanel-health" data-tab-panel="health" role="tabpanel" aria-labelledby="serviceTab-health" tabindex="0" hidden>
                        <div class="services-section-heading"><h3>Health monitoring</h3><p>Configure the endpoint used by manual service health checks.</p></div>
                        <label>
                            <span>Monitoring URL</span>
                            <input type="text" id="cardHealthCheckUrl" autocomplete="off" placeholder="Optional HTTP endpoint for status checks" />
                        </label>
                        <div class="admin-health-meta">
                            <span id="cardHealthStatusText">Not checked</span>
                            <span id="cardHealthCheckedText">No timestamp</span>
                        </div>
                        <a class="services-health-link" href="@Url.Action("Health", "Admin")">Open service health <span aria-hidden="true">↗</span></a>
                    </section>
                </div>

                <details class="services-preview" id="servicePreview">
                    <summary><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>Employee preview</span><span class="services-preview__expand">Expand preview <span aria-hidden="true">＋</span></span><span class="services-preview__collapse">Hide preview <span aria-hidden="true">−</span></span></summary>
                    <div class="services-preview__body">
                    <p>Preview of the selected service card. Unsaved edits appear here as you type.</p>
                    <div class="admin-preview-card" id="adminPreviewCard">
                        <div class="admin-preview-accent"></div>
                        <div class="admin-preview-top">
                            <div class="admin-preview-icon" id="adminPreviewIcon">P</div>
                            <div class="card-meta"><span class="system-badge"></span></div>
                        </div>
                        <h3 class="card-title"></h3>
                        <p class="card-desc"></p>
                        <div class="card-status">
                            <span class="status-dot"></span>
                            <span class="status-text"></span>
                        </div>
                        <div class="admin-preview-launch" id="adminPreviewLaunch">Open URL</div>
                        <p class="card-note"></p>
                    </div>
                    </div>
                </details>
            </div>
            </fieldset>

            <div class="admin-form-actions admin-editor-savebar" aria-live="polite">
                <span class="admin-save-status" id="saveStatus" role="status">All changes saved</span>
                <div class="admin-form-actions">
                    <button type="button" class="admin-button admin-button--ghost" id="resetCardBtn">Discard changes</button>
                    <button type="button" class="admin-button admin-button--primary" id="saveCardBtn">Save changes</button>
                </div>
            </div>
            <details class="services-more-actions"><summary>More actions</summary>
            <div class="admin-danger-zone">
                <div>
                    <strong>Archive service</strong>
                    <p>Hide this service from the public directory without deleting its audit history.</p>
                </div>
                <button type="button" class="admin-button admin-button--ghost" id="archiveCardBtn">Archive</button>
            </div>
            </details>
        </form>
    </section>
</section>
</div>

<script type="application/json" id="serviceCardsData">@Html.Raw(JsonSerializer.Serialize(Model.Cards, jsonOptions))</script>
@section Scripts {
    <script src="~/js/admin-services.js" asp-append-version="true"></script>
}
