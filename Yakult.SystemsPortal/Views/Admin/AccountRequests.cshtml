@model AccountRequestsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Account Requests";
    var pending = Model.Requests.Count(x => x.Status == "Pending");
    var approved = Model.Requests.Count(x => x.Status == "Approved");
    var rejected = Model.Requests.Count(x => x.Status == "Rejected");
}

@Html.AntiForgeryToken()

<section class="account-metrics" aria-label="Account request summary">
    <div class="account-metric"><strong>@pending</strong><span>Pending review</span></div>
    <div class="account-metric"><strong>@approved</strong><span>Approved requests</span></div>
    <div class="account-metric"><strong>@rejected</strong><span>Rejected requests</span></div>
    <div class="account-metric"><strong>@Model.Users.Count</strong><span>Managed accounts</span></div>
</section>

<div class="account-switcher" role="tablist" aria-label="Account administration views">
    <button type="button" class="is-active" data-account-tab="requests">Requests (@pending pending)</button>
    <button type="button" data-account-tab="users">User accounts (@Model.Users.Count)</button>
</div>

<section class="account-panel" data-account-panel="requests">
    <header class="account-panel__head">
        <div>
            <h2>Registration requests</h2>
            <p>Newest employee requests appear first.</p>
        </div>
    </header>
    <div class="account-toolbar" aria-label="Filter registration requests">
        <input type="search" id="requestSearch" placeholder="Search employee, username, email, department, or branch..." autocomplete="off" />
        <select id="requestStatusFilter">
            <option value="all">All statuses</option>
            <option value="pending">Pending (@pending)</option>
            <option value="approved">Approved (@approved)</option>
            <option value="rejected">Rejected (@rejected)</option>
        </select>
        <select id="requestDepartmentFilter">
            <option value="all">All departments</option>
            @foreach (var department in Model.Requests.Select(x => x.Department).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x))
            {
                <option value="@department">@department</option>
            }
        </select>
    </div>
    @if (Model.Requests.Count == 0)
    {
        <div class="account-empty">No account requests have been submitted.</div>
    }
    else
    {
        <div class="request-grid">
            @foreach (var item in Model.Requests)
            {
                var requestSearch = $"{item.EmployeeName} {item.EmployeeNumber} {item.WorkEmail} {item.Position} {item.Department} {item.Username} {item.Company} {item.Branch}".ToLowerInvariant();
                <article class="request-card" data-status="@item.Status.ToLowerInvariant()" data-department="@item.Department" data-request-search="@requestSearch">
                    <div class="request-card__person">
                        <span class="request-card__avatar request-card__avatar--blank" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5v.5H4v-.5z" /></svg></span>
                        <strong>@item.EmployeeName</strong>
                        <span>Employee #@item.EmployeeNumber &middot; @item.WorkEmail</span>
                        <span>@item.Position &middot; @item.Department</span>
                    </div>
                    <div class="request-card__details">
                        <strong>Requested username: @item.Username</strong>
                        <span>@item.Company &middot; @item.Branch</span>
                        <span>Submitted @item.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                        @if (!string.IsNullOrWhiteSpace(item.ReviewRemarks))
                        {
                            <span>Remarks: @item.ReviewRemarks</span>
                        }
                    </div>
                    <div class="request-card__review">
                        <span class="account-status-pill account-status-pill--@item.Status.ToLowerInvariant()">@item.Status</span>
                        @if (item.Status == "Pending")
                        {
                            <div class="request-actions request-actions--stacked">
                                <button type="button" class="account-btn account-btn--approve" data-review="approve" data-id="@item.AccountRequestId">Approve</button>
                                <button type="button" class="account-btn account-btn--reject" data-review="reject" data-id="@item.AccountRequestId">Reject</button>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
        <div class="pager" id="requestPager" aria-label="Registration requests pages">
            <button type="button" class="pager__btn" id="requestPrev">Previous</button>
            <span class="pager__numbers" id="requestPageNumbers"></span>
            <span class="pager__status" id="requestPageStatus"></span>
            <button type="button" class="pager__btn" id="requestNext">Next</button>
        </div>
    }
</section>

<section class="account-panel" data-account-panel="users" hidden>
    <header class="account-panel__head">
        <div>
            <h2>User account management</h2>
            <p>Manage status, roles, portal-admin access, and password resets.</p>
        </div>
    </header>
    <div class="account-toolbar" aria-label="Filter managed accounts">
        <input type="search" id="userSearch" placeholder="Search username, email, employee, or role..." autocomplete="off" />
        <select id="userStatusFilter">
            <option value="all">All account states</option>
            <option value="active">Active accounts</option>
            <option value="inactive">Inactive accounts</option>
        </select>
        <select id="userRoleFilter">
            <option value="all">All primary roles</option>
            @foreach (var role in Model.Roles)
            {
                <option value="@role">@role</option>
            }
        </select>
        <div class="account-switcher view-toggle" role="group" aria-label="User accounts layout">
            <button type="button" data-users-view="card" class="is-active">Card</button>
            <button type="button" data-users-view="table">Table</button>
        </div>
    </div>
    <div class="user-card-grid">
        @foreach (var user in Model.Users)
        {
            var selectedRole = user.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).FirstOrDefault() ?? "Requester";
            var roleList = user.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            var isPortalAdmin = roleList.Any(r => r.Equals("PortalAdmin", StringComparison.OrdinalIgnoreCase));
            var userSearch = $"{user.Username} {user.Email} {user.EmployeeName} {user.Roles}".ToLowerInvariant();
            var displayName = string.IsNullOrWhiteSpace(user.EmployeeName) ? user.Username : user.EmployeeName;
            <article class="user-card" data-user-id="@user.UserId" data-user-search="@userSearch" data-user-active="@user.IsActive.ToString().ToLowerInvariant()" data-user-role="@selectedRole">
                <header class="user-card__head">
                    <span class="user-card__avatar user-card__avatar--blank" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5v.5H4v-.5z" /></svg></span>
                    <div class="user-card__identity">
                        <strong>@user.Username</strong>
                        <span class="account-table__muted">@user.Email</span>
                    </div>
                    <span class="user-card__status @(user.IsActive ? "is-active" : "is-inactive")">@(user.IsActive ? "Active" : "Inactive")</span>
                </header>
                <p class="user-card__employee">@(string.IsNullOrWhiteSpace(user.EmployeeName) ? "No linked employee" : user.EmployeeName)@if(user.IsDeveloper){<span class="account-table__muted"> · Developer protected</span>}</p>
                <div class="user-card__chips" aria-label="Current roles">
                    @if (roleList.Count == 0)
                    {
                        <span class="role-chip">Requester</span>
                    }
                    else
                    {
                        @foreach (var roleName in roleList)
                        {
                            <span class="role-chip@(roleName.Equals("PortalAdmin", StringComparison.OrdinalIgnoreCase) ? " role-chip--admin" : "")">@roleName</span>
                        }
                    }
                </div>
                <div class="user-card__controls">
                    <label class="user-card__field">
                        <span>Primary role</span>
                        <select data-user-role disabled="@user.IsDeveloper">@foreach(var role in Model.Roles){<option value="@role" selected="@(role == selectedRole)">@role</option>}</select>
                    </label>
                    <label class="switch-field" title="Portal-only admin: admin dashboard without developer rights">
                        <span>Portal admin</span>
                        <span class="switch"><input type="checkbox" data-user-portaladmin checked="@isPortalAdmin" disabled="@user.IsDeveloper" /><span class="switch__track" aria-hidden="true"></span></span>
                    </label>
                    <label class="switch-field">
                        <span>Active</span>
                        <span class="switch"><input type="checkbox" data-user-active checked="@user.IsActive" disabled="@user.IsDeveloper" /><span class="switch__track" aria-hidden="true"></span></span>
                    </label>
                </div>
                <footer class="user-card__foot">
                    <div class="user-card__pw">
                        <span class="account-table__muted">@(user.MustChangePassword ? "Change required" : "Configured")</span>
                        <div class="request-actions request-actions--inline">
                            <button type="button" class="account-btn" data-reset-password="temporary" disabled="@(user.IsDeveloper || !user.IsActive)">Temporary</button>
                            <button type="button" class="account-btn" data-reset-password="manual" disabled="@(user.IsDeveloper || !user.IsActive)">Manual</button>
                        </div>
                    </div>
                    <button type="button" class="account-btn account-btn--approve" data-save-user disabled="@user.IsDeveloper">Save access</button>
                </footer>
            </article>
        }
    </div>
    <div class="pager" id="userPager" aria-label="User accounts pages">
        <button type="button" class="pager__btn" id="userPrev">Previous</button>
        <span class="pager__numbers" id="userPageNumbers"></span>
        <span class="pager__status" id="userPageStatus"></span>
        <button type="button" class="pager__btn" id="userNext">Next</button>
    </div>
    <div class="account-empty" id="userNoResults" hidden>No user accounts match the current filters.</div>
</section>

<div class="account-modal-backdrop" id="accountModal" hidden>
    <section class="account-modal" role="dialog" aria-modal="true" aria-labelledby="accountModalTitle" aria-describedby="accountModalMessage">
        <header class="account-modal__head">
            <div>
                <span class="eyebrow" id="accountModalEyebrow">Account administration</span>
                <h2 id="accountModalTitle">Confirm action</h2>
            </div>
            <button type="button" class="account-modal__close" id="accountModalClose" aria-label="Close dialog">&times;</button>
        </header>
        <div class="account-modal__body">
            <p id="accountModalMessage"></p>
            <label class="account-modal__field" id="accountRemarksGroup" hidden>
                <span id="accountRemarksLabel">Remarks</span>
                <textarea id="accountRemarks" rows="4"></textarea>
            </label>
            <label class="account-modal__field" id="accountPasswordGroup" hidden>
                <span>New password</span>
                <input type="password" id="accountPassword" autocomplete="new-password" />
            </label>
            <label class="account-modal__field" id="accountConfirmPasswordGroup" hidden>
                <span>Confirm password</span>
                <input type="password" id="accountConfirmPassword" autocomplete="new-password" />
            </label>
            <div class="account-generated-password" id="accountGeneratedPasswordGroup" hidden>
                <span>Temporary password</span>
                <div>
                    <input type="text" id="accountGeneratedPassword" readonly />
                    <button type="button" class="account-btn" id="accountCopyPassword">Copy</button>
                </div>
            </div>
            <div class="account-modal__error" id="accountModalError" hidden></div>
        </div>
        <footer class="account-modal__actions">
            <button type="button" class="admin-button admin-button--ghost" id="accountModalCancel">Cancel</button>
            <button type="button" class="admin-button admin-button--primary" id="accountModalConfirm">Confirm</button>
        </footer>
    </section>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    var modal = document.getElementById('accountModal');
    var modalTitle = document.getElementById('accountModalTitle');
    var modalEyebrow = document.getElementById('accountModalEyebrow');
    var modalMessage = document.getElementById('accountModalMessage');
    var modalError = document.getElementById('accountModalError');
    var modalConfirm = document.getElementById('accountModalConfirm');
    var modalCancel = document.getElementById('accountModalCancel');
    var modalClose = document.getElementById('accountModalClose');
    var remarksGroup = document.getElementById('accountRemarksGroup');
    var remarksInput = document.getElementById('accountRemarks');
    var remarksLabel = document.getElementById('accountRemarksLabel');
    var passwordGroup = document.getElementById('accountPasswordGroup');
    var passwordInput = document.getElementById('accountPassword');
    var confirmPasswordGroup = document.getElementById('accountConfirmPasswordGroup');
    var confirmPasswordInput = document.getElementById('accountConfirmPassword');
    var generatedGroup = document.getElementById('accountGeneratedPasswordGroup');
    var generatedPasswordInput = document.getElementById('accountGeneratedPassword');
    var copyPasswordButton = document.getElementById('accountCopyPassword');
    var activeModal = null;
    var requestSearch = document.getElementById('requestSearch');
    var requestStatusFilter = document.getElementById('requestStatusFilter');
    var requestDepartmentFilter = document.getElementById('requestDepartmentFilter');
    var userSearch = document.getElementById('userSearch');
    var userStatusFilter = document.getElementById('userStatusFilter');
    var userRoleFilter = document.getElementById('userRoleFilter');

    document.querySelectorAll('[data-account-tab]').forEach(function(button){
        button.addEventListener('click', function(){
            document.querySelectorAll('[data-account-tab]').forEach(function(x){ x.classList.toggle('is-active', x === button); });
            document.querySelectorAll('[data-account-panel]').forEach(function(panel){ panel.hidden = panel.dataset.accountPanel !== button.dataset.accountTab; });
        });
    });

    var requestPage = 0;
    var requestPageSize = 6;
    var requestPager = document.getElementById('requestPager');
    var requestPrev = document.getElementById('requestPrev');
    var requestNext = document.getElementById('requestNext');
    var requestPageNumbers = document.getElementById('requestPageNumbers');
    var requestPageStatus = document.getElementById('requestPageStatus');

    function renderRequestPager(totalPages) {
        if (requestPrev) requestPrev.disabled = requestPage <= 0;
        if (requestNext) requestNext.disabled = requestPage >= totalPages - 1;
        if (requestPageStatus) requestPageStatus.textContent = totalPages <= 1 ? '' : ('Page ' + (requestPage + 1) + ' of ' + totalPages);
        if (!requestPageNumbers) return;
        requestPageNumbers.innerHTML = '';
        if (totalPages <= 1) return;
        var windowSize = 5;
        var start = Math.max(0, Math.min(requestPage - Math.floor(windowSize / 2), totalPages - windowSize));
        var end = Math.min(totalPages, start + windowSize);
        for (var i = start; i < end; i++) {
            (function(index) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = String(index + 1);
                btn.className = 'pager__number' + (index === requestPage ? ' is-current' : '');
                btn.setAttribute('aria-label', 'Go to page ' + (index + 1));
                if (index === requestPage) btn.setAttribute('aria-current', 'page');
                btn.addEventListener('click', function() { requestPage = index; applyRequestFilters(false); });
                requestPageNumbers.appendChild(btn);
            })(i);
        }
    }

    function applyRequestFilters(resetPage) {
        if (resetPage) requestPage = 0;
        var term = (requestSearch?.value || '').toLowerCase().trim();
        var status = requestStatusFilter?.value || 'all';
        var department = requestDepartmentFilter?.value || 'all';
        var matched = [];
        document.querySelectorAll('.request-card').forEach(function(card) {
            var matchesTerm = !term || (card.dataset.requestSearch || '').includes(term);
            var matchesStatus = status === 'all' || card.dataset.status === status;
            var matchesDepartment = department === 'all' || String(card.dataset.department || '').toLowerCase() === department.toLowerCase();
            if (matchesTerm && matchesStatus && matchesDepartment) matched.push(card);
        });
        var totalPages = Math.max(Math.ceil(matched.length / requestPageSize), 1);
        requestPage = Math.min(Math.max(requestPage, 0), totalPages - 1);
        var visible = new Set(matched.slice(requestPage * requestPageSize, requestPage * requestPageSize + requestPageSize));
        document.querySelectorAll('.request-card').forEach(function(card) { card.hidden = !visible.has(card); });
        if (requestPager) requestPager.hidden = matched.length <= requestPageSize;
        renderRequestPager(totalPages);
    }

    var userPage = 0;
    var userPageSize = 6;
    var userPager = document.getElementById('userPager');
    var userPrev = document.getElementById('userPrev');
    var userNext = document.getElementById('userNext');
    var userPageNumbers = document.getElementById('userPageNumbers');
    var userPageStatus = document.getElementById('userPageStatus');
    var userNoResults = document.getElementById('userNoResults');

    function renderUserPager(totalPages) {
        if (userPrev) userPrev.disabled = userPage <= 0;
        if (userNext) userNext.disabled = userPage >= totalPages - 1;
        if (userPageStatus) userPageStatus.textContent = totalPages <= 1 ? '' : ('Page ' + (userPage + 1) + ' of ' + totalPages);
        if (!userPageNumbers) return;
        userPageNumbers.innerHTML = '';
        if (totalPages <= 1) return;
        var windowSize = 5;
        var start = Math.max(0, Math.min(userPage - Math.floor(windowSize / 2), totalPages - windowSize));
        var end = Math.min(totalPages, start + windowSize);
        for (var i = start; i < end; i++) {
            (function(index) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = String(index + 1);
                btn.className = 'pager__number' + (index === userPage ? ' is-current' : '');
                btn.setAttribute('aria-label', 'Go to page ' + (index + 1));
                if (index === userPage) btn.setAttribute('aria-current', 'page');
                btn.addEventListener('click', function() { userPage = index; applyUserFilters(false); });
                userPageNumbers.appendChild(btn);
            })(i);
        }
    }

    function applyUserFilters(resetPage) {
        if (resetPage) userPage = 0;
        var term = (userSearch?.value || '').toLowerCase().trim();
        var status = userStatusFilter?.value || 'all';
        var role = userRoleFilter?.value || 'all';
        var matched = [];
        document.querySelectorAll('[data-user-id]').forEach(function(row) {
            var matchesTerm = !term || (row.dataset.userSearch || '').includes(term);
            var matchesStatus = status === 'all' || row.dataset.userActive === (status === 'active' ? 'true' : 'false');
            var matchesRole = role === 'all' || String(row.dataset.userRole || '').toLowerCase() === role.toLowerCase();
            if (matchesTerm && matchesStatus && matchesRole) matched.push(row);
        });
        var totalPages = Math.max(Math.ceil(matched.length / userPageSize), 1);
        userPage = Math.min(Math.max(userPage, 0), totalPages - 1);
        var visible = new Set(matched.slice(userPage * userPageSize, userPage * userPageSize + userPageSize));
        document.querySelectorAll('[data-user-id]').forEach(function(row) { row.hidden = !visible.has(row); });
        if (userNoResults) userNoResults.hidden = matched.length !== 0;
        if (userPager) userPager.hidden = matched.length <= userPageSize;
        renderUserPager(totalPages);
    }

    [requestSearch, requestStatusFilter, requestDepartmentFilter].forEach(function(control) {
        control?.addEventListener('input', function() { applyRequestFilters(true); });
        control?.addEventListener('change', function() { applyRequestFilters(true); });
    });
    requestPrev?.addEventListener('click', function() { requestPage -= 1; applyRequestFilters(false); });
    requestNext?.addEventListener('click', function() { requestPage += 1; applyRequestFilters(false); });
    [userSearch, userStatusFilter, userRoleFilter].forEach(function(control) {
        control?.addEventListener('input', function() { applyUserFilters(true); });
        control?.addEventListener('change', function() { applyUserFilters(true); });
    });
    userPrev?.addEventListener('click', function() { userPage -= 1; applyUserFilters(false); });
    userNext?.addEventListener('click', function() { userPage += 1; applyUserFilters(false); });
    var userGrid = document.querySelector('.user-card-grid');
    var viewButtons = document.querySelectorAll('[data-users-view]');
    function setUsersView(mode) {
        var isTable = mode === 'table';
        userGrid?.classList.toggle('table-mode', isTable);
        viewButtons.forEach(function(btn) { btn.classList.toggle('is-active', btn.dataset.usersView === mode); });
        try { localStorage.setItem('yakultUsersView', mode); } catch (e) {}
    }
    viewButtons.forEach(function(btn) {
        btn.addEventListener('click', function() { setUsersView(btn.dataset.usersView); });
    });
    try {
        if (localStorage.getItem('yakultUsersView') === 'table') setUsersView('table');
    } catch (e) {}
    applyRequestFilters();
    applyUserFilters(true);

    async function post(url, body) {
        var response = await fetch(url, {
            method:'POST',
            credentials:'same-origin',
            headers:{'Content-Type':'application/json','Accept':'application/json','RequestVerificationToken':token},
            body:JSON.stringify(body)
        });
        var payload = await response.json().catch(function(){ return {}; });
        if (!response.ok || !payload.success) throw new Error(payload.message || 'The operation failed.');
        return payload;
    }

    function openAccountModal(options) {
        return new Promise(function(resolve) {
            activeModal = { options: options, resolve: resolve };
            modalTitle.textContent = options.title || 'Confirm action';
            modalEyebrow.textContent = options.eyebrow || 'Account administration';
            modalMessage.textContent = options.message || '';
            modalConfirm.textContent = options.confirmText || 'Confirm';
            modalConfirm.className = 'admin-button admin-button--primary';
            if (options.tone === 'danger') modalConfirm.classList.add('account-modal__danger');
            modalCancel.hidden = !!options.hideCancel;
            modalClose.hidden = !!options.hideCancel;
            modalError.hidden = true;
            modalError.textContent = '';
            remarksInput.value = options.initialValue || '';
            passwordInput.value = '';
            confirmPasswordInput.value = '';
            generatedPasswordInput.value = options.generatedPassword || '';
            remarksGroup.hidden = options.mode !== 'remarks';
            passwordGroup.hidden = options.mode !== 'password';
            confirmPasswordGroup.hidden = options.mode !== 'password';
            generatedGroup.hidden = options.mode !== 'generated';
            remarksLabel.textContent = options.label || 'Remarks';
            modal.hidden = false;
            document.body.classList.add('has-admin-modal');
            window.setTimeout(function() {
                if (options.mode === 'remarks') remarksInput.focus();
                else if (options.mode === 'password') passwordInput.focus();
                else if (options.mode === 'generated') generatedPasswordInput.focus();
                else modalConfirm.focus();
            }, 0);
        });
    }

    function closeAccountModal(value) {
        if (!activeModal) return;
        var resolver = activeModal.resolve;
        activeModal = null;
        modal.hidden = true;
        document.body.classList.remove('has-admin-modal');
        resolver(value);
    }

    function showModalError(message) {
        modalError.textContent = message;
        modalError.hidden = false;
    }

    modalConfirm.addEventListener('click', function() {
        if (!activeModal) return;
        var options = activeModal.options;
        if (options.mode === 'remarks') {
            var remarks = remarksInput.value.trim();
            if (options.required && !remarks) {
                showModalError(options.requiredMessage || 'This field is required.');
                return;
            }
            closeAccountModal(remarks);
            return;
        }
        if (options.mode === 'password') {
            var password = passwordInput.value;
            if (password !== confirmPasswordInput.value) {
                showModalError('Passwords do not match.');
                return;
            }
            if (password.length < 8 || password.length > 128) {
                showModalError('Password must contain between 8 and 128 characters.');
                return;
            }
            closeAccountModal(password);
            return;
        }
        closeAccountModal(true);
    });

    [modalCancel, modalClose].forEach(function(button) {
        button.addEventListener('click', function() { closeAccountModal(null); });
    });

    modal.addEventListener('click', function(event) {
        if (event.target === modal && !modalCancel.hidden) closeAccountModal(null);
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && !modal.hidden && !modalCancel.hidden) closeAccountModal(null);
    });

    copyPasswordButton.addEventListener('click', async function() {
        generatedPasswordInput.select();
        try {
            await navigator.clipboard.writeText(generatedPasswordInput.value);
            window.yakultToast?.('Temporary password copied.', 'success');
        } catch(error) {
            window.yakultToast?.('Select the password field and copy it manually.', 'warning');
        }
    });

    document.querySelectorAll('[data-review]').forEach(function(button){
        button.addEventListener('click', async function(){
            var action = button.dataset.review;
            var isReject = action === 'reject';
            var remarks = await openAccountModal({
                mode: 'remarks',
                title: isReject ? 'Reject account request' : 'Approve account request',
                message: isReject ? 'Add the reason for rejecting this employee account request.' : 'Add optional approval remarks for the employee account request.',
                label: isReject ? 'Rejection reason' : 'Approval remarks',
                confirmText: isReject ? 'Reject request' : 'Approve request',
                tone: isReject ? 'danger' : 'default',
                required: isReject,
                requiredMessage: 'A rejection reason is required.'
            });
            if (remarks === null) return;
            button.disabled = true;
            try {
                var url = action === 'approve' ? '@Url.Action("ApproveAccountRequest", "Admin")' : '@Url.Action("RejectAccountRequest", "Admin")';
                var result = await post(url, { accountRequestId:Number(button.dataset.id), remarks:remarks });
                window.yakultToast(result.message, 'success');
                window.location.reload();
            } catch(error) { window.yakultToast(error.message, 'error'); button.disabled = false; }
        });
    });

    document.querySelectorAll('[data-save-user]').forEach(function(button){
        button.addEventListener('click', async function(){
            var row = button.closest('[data-user-id]');
            button.disabled = true;
            try {
                var result = await post('@Url.Action("UpdateManagedUser", "Admin")', {
                    userId:Number(row.dataset.userId), isActive:row.querySelector('[data-user-active]').checked,
                    roleName:row.querySelector('[data-user-role]').value,
                    isPortalAdmin:row.querySelector('[data-user-portaladmin]').checked
                });
                window.yakultToast(result.message, 'success');
                window.location.reload();
            } catch(error) { window.yakultToast(error.message, 'error'); button.disabled = false; }
        });
    });

    document.querySelectorAll('[data-reset-password]').forEach(function(button){
        button.addEventListener('click', async function(){
            var row = button.closest('[data-user-id]');
            var username = row.querySelector('strong').textContent.trim();
            var mode = button.dataset.resetPassword;
            var password = null;
            if (mode === 'manual') {
                password = await openAccountModal({
                    mode: 'password',
                    title: 'Set manual password',
                    message: 'Enter a new password for ' + username + '.',
                    confirmText: 'Set password'
                });
                if (password === null) return;
            } else {
                var confirmed = await openAccountModal({
                    mode: 'confirm',
                    title: 'Generate temporary password',
                    message: 'Generate a temporary password for ' + username + '? The user must change it after signing in.',
                    confirmText: 'Generate password'
                });
                if (!confirmed) return;
            }
            button.disabled = true;
            try {
                var result = await post('@Url.Action("ResetManagedUserPassword", "Admin")', { userId:Number(row.dataset.userId), mode:mode, password:password });
                if (mode === 'temporary') {
                    await openAccountModal({
                        mode: 'generated',
                        title: 'Temporary password created',
                        message: 'Copy this password now. It will not be shown again after the page refreshes.',
                        confirmText: 'Done',
                        hideCancel: true,
                        generatedPassword: result.temporaryPassword || ''
                    });
                } else {
                    window.yakultToast(result.message, 'success');
                }
                window.location.reload();
            } catch(error) { window.yakultToast(error.message, 'error'); button.disabled = false; }
        });
    });
});
</script>
