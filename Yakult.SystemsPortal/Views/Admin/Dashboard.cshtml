@model AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Overview";
    ViewData["UseCustomPageHeading"] = true;
    var nowUtc = DateTime.UtcNow;
    var totalCount = Model.Cards.Count;
    var healthyCount = Model.Cards.Count(c => c.HealthState == "healthy");
    var failedCount = Model.Cards.Count(c => c.HealthState == "unhealthy");
    var uncheckedCount = Model.Cards.Count(c => c.HealthState == "unchecked");
    var configuredCount = Model.Cards.Count(c => !string.IsNullOrWhiteSpace(c.HealthCheckUrl));
    var missingCount = totalCount - configuredCount;
    var coverage = totalCount == 0 ? 0 : configuredCount * 100 / totalCount;
    var maintenanceCount = Model.Cards.Count(c => c.IsInMaintenance);
    var priorities = Model.Cards.Where(IsPriority).OrderBy(c => c.AttentionPriority).ThenBy(c => c.Name).ToList();
    var reminders = Model.Cards.Where(c => c.NeedsAttention && !IsPriority(c)).OrderBy(c => c.AttentionPriority).ThenBy(c => c.Name).ToList();
    var lastChecked = Model.Cards.Where(c => c.HealthState != "missing" && c.HealthState != "unchecked").Select(c => c.LastHealthCheckedAt).Max();
    var isNoticeActive = Model.Notice.IsActive(nowUtc);
    var noticeState = isNoticeActive ? "Active" : !Model.Notice.Enabled ? "Inactive"
        : Model.Notice.StartUtc > nowUtc ? "Scheduled" : Model.Notice.EndUtc < nowUtc ? "Expired" : "Incomplete";
    var canManageNotice = User.HasClaim("IsDeveloper", "true");
    var noticeTitle = string.IsNullOrWhiteSpace(Model.Notice.Title) ? "Portal announcement" : Model.Notice.Title;
    var noticeMessage = Model.Notice.Message ?? string.Empty;
    var recentEvents = Model.RecentEvents.OrderByDescending(e => e.Timestamp).Take(4).ToList();
}
@functions {
    bool IsPriority(AdminPortalCardViewModel card) => card.HealthState == "unhealthy" || card.IsInMaintenance
        || (!string.Equals(card.Status, "Connected", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(card.Status, "Disabled", StringComparison.OrdinalIgnoreCase));

    string PriorityLabel(AdminPortalCardViewModel card) => card.HealthState == "unhealthy" ? "Failed check"
        : card.IsInMaintenance || string.Equals(card.Status, "Maintenance", StringComparison.OrdinalIgnoreCase) ? "Maintenance" : "Not connected";

    string PriorityDescription(AdminPortalCardViewModel card)
    {
        if (card.HealthState == "unhealthy")
            return string.Equals(card.LastHealthStatus, "Unreachable", StringComparison.OrdinalIgnoreCase)
                ? "The last health check could not reach this service." : "The last health check returned an unsuccessful response.";
        if (card.IsInMaintenance || string.Equals(card.Status, "Maintenance", StringComparison.OrdinalIgnoreCase))
            return string.IsNullOrWhiteSpace(card.MaintenanceNote) ? "This service is currently marked for maintenance." : card.MaintenanceNote;
        return "This service is configured as not connected.";
    }

    string ActivityTitle(PortalAuditLogItem item)
    {
        var entity = item.EntityType switch
        {
            "PortalCard" => "Service settings",
            "PortalNotice" or "PortalSettings" => "Homepage notice",
            "PortalDownload" => "Service file",
            _ => string.IsNullOrWhiteSpace(item.EntityType) ? "Portal activity" : item.EntityType
        };
        var action = (item.Action ?? string.Empty).ToLowerInvariant() switch
        {
            "create" or "add" => "created",
            "update" or "save" => "updated",
            "archive" => "archived",
            "restore" => "restored",
            "download" => "downloaded",
            "approve" => "approved",
            "reject" => "rejected",
            _ => item.Action
        };
        return string.IsNullOrWhiteSpace(action) ? entity : entity + " · " + action;
    }

    Microsoft.AspNetCore.Html.IHtmlContent OverviewIcon(string name)
    {
        var paths = name switch
        {
            "services" => "<rect x='3' y='4' width='18' height='12' rx='2'/><path d='M8 20h8M12 16v4M7 8h4M7 12h8'/>",
            "check" => "<circle cx='12' cy='12' r='9'/><path d='m8 12 3 3 5-6'/>",
            "alert" => "<circle cx='12' cy='12' r='9'/><path d='M12 7v6M12 17h.01'/>",
            "maintenance" => "<path d='M14 6a5 5 0 0 0-6 6l-5 5a2.1 2.1 0 0 0 3 3l5-5a5 5 0 0 0 7-6l-3 3-3-3 3-3Z'/>",
            "refresh" => "<path d='M20 7v5h-5M4 17v-5h5'/><path d='M6 7a7 7 0 0 1 12-1l2 6M4 12l2 6a7 7 0 0 0 12-1'/>",
            "settings" => "<path d='M4 7h7M15 7h5M4 17h3M11 17h9'/><circle cx='13' cy='7' r='2'/><circle cx='9' cy='17' r='2'/>",
            "notice" => "<path d='m3 11 16-6v14l-16-6v-2ZM7 14l2 7h4l-2-6M19 10h3'/>",
            "chevron" => "<path d='m6 9 6 6 6-6'/>",
            _ => "<path d='M5 12h14m-5-5 5 5-5 5'/>"
        };
        return new Microsoft.AspNetCore.Html.HtmlString("<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true' focusable='false'>" + paths + "</svg>");
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true" />
}
<div class="overview-page" id="overviewPage">
    @Html.AntiForgeryToken()
    <header class="overview-heading">
        <div>
            <span class="overview-eyebrow">Workspace</span>
            <h1>Overview</h1>
            <p>Service status and the work that needs your attention.</p>
        </div>
        <button type="button" class="overview-run-button" id="dashboardHealthBtn"
                data-configured-count="@configuredCount"
                data-check-url="@Url.Action("CheckHealth", "Admin")"
                data-preview="@((ViewData["IsAdminPrototype"] as bool? == true).ToString().ToLowerInvariant())"
                disabled="@(configuredCount == 0)">
            @OverviewIcon("refresh")<span>Run health checks</span>
        </button>
    </header>
    @if (ViewData["IsAdminPrototype"] as bool? == true)
    {
        <p class="overview-preview-note">Admin preview · Connect a database to load service information.</p>
    }
    <div class="overview-freshness" data-overview-fragment="freshness">
        <span class="overview-freshness__dot" aria-hidden="true"></span>
        @if (lastChecked.HasValue)
        {
            <span>Most recent recorded check <time datetime="@PortalDisplayTime.Iso(lastChecked)">@PortalDisplayTime.Format(lastChecked)</time></span>
        }
        else
        {
            <span>No health checks recorded yet</span>
        }
        <a asp-controller="Admin" asp-action="Health">Service health @OverviewIcon("arrow")</a>
    </div>
    <p class="overview-run-status" id="dashboardHealthStatus" role="status" aria-live="polite" hidden></p>
    <details class="overview-run-details" id="overviewRunDetails" hidden>
        <summary>Results from this check</summary>
        <ul id="overviewRunResults"></ul>
    </details>

    <section class="overview-metrics" aria-label="Service summary" data-overview-fragment="metrics">
        <a class="overview-metric" asp-controller="Admin" asp-action="Cards" asp-route-filter="all" aria-label="View all @totalCount registered services">
            <span class="overview-metric__icon">@OverviewIcon("services")</span>
            <strong class="overview-metric__value">@totalCount</strong>
            <span class="overview-metric__label">Registered services</span>
            <span class="overview-metric__hint">Services &amp; portals @OverviewIcon("arrow")</span>
        </a>
        <a class="overview-metric" asp-controller="Admin" asp-action="Health" asp-route-filter="healthy" aria-label="View @healthyCount services healthy at their last check">
            <span class="overview-metric__icon overview-tone--success">@OverviewIcon("check")</span>
            <strong class="overview-metric__value">@healthyCount</strong>
            <span class="overview-metric__label">Healthy at last check</span>
            <span class="overview-metric__hint">Latest recorded results</span>
        </a>
        <a class="overview-metric @(failedCount > 0 ? "overview-metric--alert" : string.Empty)" asp-controller="Admin" asp-action="Health" asp-route-filter="unhealthy" aria-label="Review @failedCount failed health checks">
            <span class="overview-metric__icon @(failedCount > 0 ? "overview-tone--danger" : "overview-tone--muted")">@OverviewIcon("alert")</span>
            <strong class="overview-metric__value">@failedCount</strong>
            <span class="overview-metric__label">Failed health checks</span>
            <span class="overview-metric__hint">@(failedCount > 0 ? "Review service issues" : "No recorded failures")</span>
        </a>
        <a class="overview-metric" asp-controller="Admin" asp-action="Health" asp-route-filter="maintenance" aria-label="View @maintenanceCount active maintenance windows">
            <span class="overview-metric__icon @(maintenanceCount > 0 ? "overview-tone--warning" : "overview-tone--muted")">@OverviewIcon("maintenance")</span>
            <strong class="overview-metric__value">@maintenanceCount</strong>
            <span class="overview-metric__label">Active maintenance</span>
            <span class="overview-metric__hint">@(maintenanceCount > 0 ? "Scheduled windows active now" : "No active windows")</span>
        </a>
    </section>

    <div class="overview-columns">
        <div class="overview-primary">
            <section class="overview-panel" aria-labelledby="overviewPrioritiesTitle" data-overview-fragment="priorities">
                <header class="overview-panel-heading">
                    <h2 id="overviewPrioritiesTitle">Priorities <span class="overview-count">@priorities.Count</span></h2>
                    <span class="overview-panel-heading__meta">Most urgent first</span>
                </header>
                @if (totalCount == 0)
                {
                    <div class="overview-empty">
                        <span class="overview-empty__icon">@OverviewIcon("services")</span>
                        <strong>Start with your first service</strong>
                        <p>Register a service to see its status and monitoring reminders here.</p>
                        <a class="overview-text-link" asp-controller="Admin" asp-action="Cards">Open Services &amp; Portals @OverviewIcon("arrow")</a>
                    </div>
                }
                else if (priorities.Count == 0)
                {
                    <div class="overview-empty overview-empty--clear">
                        <span class="overview-empty__icon">@OverviewIcon("check")</span>
                        <strong>No operational issues flagged</strong>
                        <p>No failed checks or active service issues in the recorded data.</p>
                    </div>
                }
                else
                {
                    <div class="overview-priorities">
                        @foreach (var card in priorities.Take(5))
                        {
                            var label = PriorityLabel(card);
                            var tone = card.HealthState == "unhealthy" ? "danger" : "warning";
                            <article class="overview-priority" data-priority-service="@card.CardKey">
                                <span class="overview-priority__icon overview-tone--@tone">@OverviewIcon(label == "Maintenance" ? "maintenance" : "alert")</span>
                                <div class="overview-priority__main">
                                    <a class="overview-service-name" asp-controller="Admin" asp-action="Cards" asp-route-service="@card.CardKey">@card.Name</a>
                                    <p>@PriorityDescription(card)</p>
                                    @if (card.IsInMaintenance && label == "Maintenance")
                                    {
                                        <span>Window ends @PortalDisplayTime.Format(card.MaintenanceEndUtc)</span>
                                    }
                                    else
                                    {
                                        <span>Last checked: @PortalDisplayTime.Format(card.LastHealthCheckedAt)</span>
                                    }
                                </div>
                                <div class="overview-priority__actions">
                                    <span class="overview-badge overview-tone--@tone">@label</span>
                                    <a class="overview-row-action" asp-controller="Admin" asp-action="Cards" asp-route-service="@card.CardKey" aria-label="Review @card.Name">Review @OverviewIcon("arrow")</a>
                                </div>
                            </article>
                        }
                    </div>
                    <div class="overview-panel-footer">
                        <span>@(priorities.Count > 5 ? "Showing 5 of " + priorities.Count + " priorities" : "Recorded service issues and maintenance")</span>
                        <a class="overview-text-link" asp-controller="Admin" asp-action="Health" asp-route-filter="needs-action">Open service health @OverviewIcon("arrow")</a>
                    </div>
                }
                @if (reminders.Count > 0)
                {
                    <details class="overview-reminders" id="overviewSetupReminders">
                        <summary>@OverviewIcon("settings")<span>Setup reminders</span><span class="overview-reminders__count">@reminders.Count</span><span class="overview-reminders__chevron">@OverviewIcon("chevron")</span></summary>
                        <div class="overview-reminders__body">
                            @foreach (var card in reminders.Take(4))
                            {
                                <div class="overview-reminder" data-reminder-service="@card.CardKey">
                                    <div><strong>@card.Name</strong><p>@string.Join(" · ", card.AttentionReasons)</p></div>
                                    <a class="overview-row-action" asp-controller="Admin" asp-action="Cards" asp-route-service="@card.CardKey" aria-label="Review setup for @card.Name">Review @OverviewIcon("arrow")</a>
                                </div>
                            }
                            @if (reminders.Count > 4)
                            {
                                <p class="overview-reminders__more">Showing 4 of @reminders.Count reminders. <a asp-controller="Admin" asp-action="Health" asp-route-filter="needs-action">Open service health</a> to review all services.</p>
                            }
                        </div>
                    </details>
                }
            </section>

            <section class="overview-panel" aria-labelledby="overviewActivityTitle">
                <header class="overview-panel-heading"><h2 id="overviewActivityTitle">Recent activity</h2><a class="overview-text-link" asp-controller="Admin" asp-action="Audit">View all @OverviewIcon("arrow")</a></header>
                @if (recentEvents.Count == 0)
                {
                    <div class="overview-empty overview-empty--quiet"><p>No administration activity recorded yet.</p></div>
                }
                else
                {
                    <ol class="overview-timeline">
                        @foreach (var item in recentEvents)
                        {
                            <li>
                                <span class="overview-timeline__dot" aria-hidden="true"></span>
                                <div class="overview-timeline__main"><strong>@ActivityTitle(item)</strong><span>@(string.IsNullOrWhiteSpace(item.UserName) ? "System" : item.UserName)</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <p>@item.Notes</p>
                                    }
                                </div>
                                <time datetime="@PortalDisplayTime.Iso(item.Timestamp)">@PortalDisplayTime.Format(item.Timestamp)</time>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>

        <aside class="overview-context" aria-label="Portal context">
            <section class="overview-panel" aria-labelledby="overviewNoticeTitle">
                <header class="overview-panel-heading"><h2 id="overviewNoticeTitle">Homepage notice</h2><span class="overview-badge @(isNoticeActive ? "overview-tone--success" : noticeState == "Scheduled" || noticeState == "Expired" ? "overview-tone--warning" : "overview-tone--muted")">@noticeState</span></header>
                <div class="overview-notice">
                    <span class="overview-notice__icon">@OverviewIcon("notice")</span>
                    <strong>@(isNoticeActive || noticeState == "Scheduled" ? noticeTitle : "No active homepage notice")</strong>
                    @if (isNoticeActive || noticeState == "Scheduled")
                    {
                        <p class="overview-notice__excerpt">@(string.IsNullOrWhiteSpace(noticeMessage) ? "No message text set." : noticeMessage.Length > 160 ? noticeMessage.Substring(0, 160) + "…" : noticeMessage)</p>
                        @if (noticeState == "Scheduled")
                        {
                            <p class="overview-notice__schedule">Starts @PortalDisplayTime.Format(Model.Notice.StartUtc)</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(noticeMessage))
                        {
                            <details class="overview-notice-preview" id="overviewNoticePreview"><summary>Preview message @OverviewIcon("chevron")</summary><div>@noticeMessage</div></details>
                        }
                    }
                    else
                    {
                        <p>@(noticeState == "Expired" ? "The previous announcement has reached its end date." : noticeState == "Incomplete" ? "The enabled notice needs a title or message before it can appear." : "No announcement is currently displayed on the homepage.")</p>
                    }
                    @if (canManageNotice)
                    {
                        <a class="overview-text-link overview-notice__edit" asp-controller="Admin" asp-action="Settings">Manage notice @OverviewIcon("arrow")</a>
                    }
                </div>
            </section>

            <section class="overview-panel" aria-labelledby="overviewMonitoringTitle" data-overview-fragment="monitoring">
                <header class="overview-panel-heading"><h2 id="overviewMonitoringTitle">Monitoring setup</h2></header>
                <div class="overview-monitoring">
                    <div class="overview-monitoring__coverage"><strong>@configuredCount <span>of @totalCount</span></strong><span>services configured</span></div>
                    <div class="overview-monitoring__meter" role="progressbar" aria-label="Monitoring URL configuration" aria-valuenow="@coverage" aria-valuemin="0" aria-valuemax="100"><span style="width: @coverage%"></span></div>
                    <p>@(totalCount == 0 ? "Add your first service to begin monitoring." : missingCount == 0 ? "All registered services have a monitoring URL." : missingCount + (missingCount == 1 ? " service still needs" : " services still need") + " a monitoring URL.")</p>
                    <div class="overview-monitoring__links">
                        @if (missingCount > 0)
                        {
                            <a class="overview-text-link" asp-controller="Admin" asp-action="Health" asp-route-filter="missing">Review missing URLs @OverviewIcon("arrow")</a>
                        }
                        @if (uncheckedCount > 0)
                        {
                            <a class="overview-text-link" asp-controller="Admin" asp-action="Health" asp-route-filter="unchecked">@uncheckedCount awaiting first check @OverviewIcon("arrow")</a>
                        }
                    </div>
                    <span class="overview-monitoring__caption">Configuration coverage · not a measure of availability</span>
                </div>
            </section>
        </aside>
    </div>
</div>
@section Scripts {
    <script src="~/js/admin-dashboard.js" asp-append-version="true"></script>
}
