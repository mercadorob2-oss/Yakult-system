; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "Yakult Inventory Monitoring System"
#define MyAppVersion "1.0.0"
#define MyAppPublisher "Shawn Quin"
#define MyAppExeName "Yakult.Inventory.App.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{98EE8B2E-10D8-4524-A66B-FE50D449AEA4}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
DefaultDirName={localappdata}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
DisableProgramGroupPage=yes
; Uncomment the following line to run in non administrative install mode (install for current user only).
PrivilegesRequired=lowest
OutputDir=.
OutputBaseFilename=YakultInventory_Setup
SolidCompression=yes
WizardStyle=modern dynamic

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Publisher cert, trusted into the CURRENT USER's cert store during install (see [Run] below)
; so this exe stops being flagged as an unrecognized publisher -- no per-PC admin step needed.
Source: "CodeSigning\YakultCodeSigning.cer"; DestDir: "{tmp}"; Flags: ignoreversion
Source: "..\bin\Release\Yakult.Inventory.App.exe.config"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\bin\Release\appsettings.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\bin\Release\appsettings.Development.json"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\bin\Release\System.Runtime.CompilerServices.Unsafe.dll"; DestDir: "{app}"; Flags: ignoreversion
; === Reports ===
Source: "..\bin\Release\Reports\*"; DestDir: "{app}\Reports"; Flags: ignoreversion
Source: "..\bin\Release\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\bin\Release\Azure.Core.dll"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\bin\Release\Azure.Identity.dll"; DestDir: "{app}"; Flags: ignoreversion
