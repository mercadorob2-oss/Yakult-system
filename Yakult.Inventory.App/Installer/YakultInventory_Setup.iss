; === Images ===
Source: "..\bin\Release\Images\*"; DestDir: "{app}\Images"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
; Trust the Yakult publisher cert for this user only (-user, no admin required) so the
; signed exe isn't treated as an unrecognized publisher on this PC. Runs silently on every
; install; safe to repeat (-f overwrites any existing entry for the same cert).
Filename: "certutil.exe"; Parameters: "-f -user -addstore Root ""{tmp}\YakultCodeSigning.cer"""; Flags: runhidden; StatusMsg: "Registering Yakult publisher certificate..."
Filename: "certutil.exe"; Parameters: "-f -user -addstore TrustedPublisher ""{tmp}\YakultCodeSigning.cer"""; Flags: runhidden; StatusMsg: "Registering Yakult publisher certificate..."
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

