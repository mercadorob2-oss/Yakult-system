<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Yakult Release Desk" Width="1440" Height="900" MinWidth="960" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Segoe UI" FontSize="13" Foreground="#202C40" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#758196"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#28364C"/><Setter Property="BorderBrush" Value="#DFE4ED"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B9203C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B9203C"/><Setter Property="BorderBrush" Value="#B9203C"/><Setter Property="Foreground" Value="White"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E8EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,9"/><Setter Property="BorderBrush" Value="#DCE1EB"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" BorderThickness="2" BorderBrush="Transparent" CornerRadius="13"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#B9203C"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#FCEFF2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#F5F6FA"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#182438" Padding="20,28"><DockPanel LastChildFill="True">
   <StackPanel DockPanel.Dock="Top" Margin="4,0,0,30"><Border Background="#B9203C" CornerRadius="10" Width="42" Height="42" HorizontalAlignment="Left"><TextBlock Text="Y" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Release Desk" Foreground="White" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock Text="YOUR YAKULT WORKSPACE" Foreground="#91A0B8" FontSize="10"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#334159" Margin="0,16"/><TextBlock Text="CONNECTED FOLDERS" Foreground="#91A0B8" FontSize="10"/><TextBlock x:Name="SidebarStatus" Text="2 sources · recursive scan" Foreground="#E1E7F1" Margin="0,8,0,2"/><TextBlock Text="Everything in one place." Foreground="#91A0B8" FontSize="11"/></StackPanel>
   <StackPanel x:Name="Navigation">
    <Button x:Name="NavOverview" Content="Overview"/><Button x:Name="NavLibrary" Content="Scripts &amp; shortcuts"/><Button x:Name="NavFavorites" Content="Favorites"/><Button x:Name="NavGroups" Content="Grouped tools"/><Button x:Name="NavRecent" Content="Recently opened"/><Border Height="1" Background="#334159" Margin="0,12,8,20"/><Button x:Name="NavRelease" Content="Desktop release"/><Button x:Name="NavActivity" Content="Activity &amp; output"/><Button x:Name="NavFolders" Content="Folders &amp; preferences"/>
   </StackPanel>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Border Background="White" BorderBrush="#E5E8EF" BorderThickness="0,0,0,1" Padding="28,20"><DockPanel><Button x:Name="Refresh" DockPanel.Dock="Right" Content="↻  Refresh folders" VerticalAlignment="Center" Margin="16,0,0,0"/><StackPanel><TextBlock x:Name="PageTitle" Text="Your workspace, at a glance" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Build releases and find the tools you use every day." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
   <Grid Grid.Row="1" Margin="28,24">
    <ScrollViewer x:Name="Overview" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Background="#F9E9ED" CornerRadius="16" Padding="26" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ONE DESK. ALL YOUR TOOLS." Foreground="#A11B35" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="A calmer way to build and deploy." FontSize="25" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Find scripts, inspect shortcuts, and prepare your next release." Foreground="#6F5861"/></StackPanel><Button x:Name="Browse" Grid.Column="1" Content="Browse all tools  →" Style="{StaticResource Primary}" VerticalAlignment="Center" Margin="24,0,0,0"/></Grid></Border>
     <UniformGrid Columns="4" Margin="0,0,-12,20"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CATALOG ITEMS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="MetricTools" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="FAVORITES" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="MetricFavorites" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="LATEST RELEASE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="MetricRelease" Text="None yet" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PACKAGES TO VERIFY" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="MetricReady" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Desktop release packages" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Double-click a package to open its folder. Files present means the installer and metadata exist; verify before publication." Foreground="{StaticResource Muted}" Margin="0,6,0,18"/><ListBox x:Name="Packages" BorderThickness="0" MinHeight="160" MaxHeight="310"><ListBox.ItemTemplate><DataTemplate><Border Background="#F6F7FA" CornerRadius="8" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Version}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="PackageEmpty" Text="No local release packages yet. Start in Desktop release." Foreground="{StaticResource Muted}"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Grid x:Name="Library" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel x:Name="GroupBar" Visibility="Collapsed" Margin="0,0,0,14"><TextBlock Text="GROUPS BY PURPOSE" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><ComboBox x:Name="GroupFilter" Width="210" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,10,8" AutomationProperties.Name="Filter by group"/><TextBox x:Name="GroupName" Width="200" MaxLength="80" Margin="0,0,10,8" ToolTip="Name for a new group, or rename the selected group" AutomationProperties.Name="Group name"/><Button x:Name="CreateGroup" Content="New group"/><Button x:Name="RenameGroup" Content="Rename"/><Button x:Name="DeleteGroup" Content="Delete group"/></WrapPanel><TextBlock Text="Add related tools using the group picker in Tool details. Search and filters also apply here." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
     <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Grid><TextBox x:Name="Search" ToolTip="Search file names, folders, types, or descriptions" AutomationProperties.Name="Search tools"/><TextBlock Text="Search scripts, shortcuts, or folders...  (Ctrl+K)" Foreground="#8994A6" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox x:Name="StateFilter" Grid.Column="1" Margin="12,0,0,0" SelectedIndex="0"><ComboBoxItem Content="All copies"/><ComboBoxItem Content="Current tools"/><ComboBoxItem Content="Archived copies"/></ComboBox><ComboBox x:Name="SourceFilter" Grid.Column="2" Margin="12,0,0,0" SelectedIndex="0"><ComboBoxItem Content="Both folders"/><ComboBoxItem Content="Publish folder"/><ComboBoxItem Content="Installer folder"/></ComboBox></Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="340" MinWidth="260"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="ResultCount" Text="All tools" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/><ListBox x:Name="Tools" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#F9E9ED" CornerRadius="8" Padding="12" Margin="0,4,0,10"><DockPanel><TextBlock Text="{Binding ItemCount}" DockPanel.Dock="Right" Foreground="#A11B35"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#A11B35"/></DockPanel></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#F8E9EE" CornerRadius="9" Width="34" Height="34" VerticalAlignment="Top"><TextBlock Text="{Binding Badge}" Foreground="#B9203C" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,8" TextTrimming="CharacterEllipsis" MaxHeight="36"/><TextBlock Text="{Binding Location}" Foreground="#8994A6" FontSize="11"/><TextBlock Text="{Binding State}" Foreground="#A07136" FontSize="10" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="ToolsEmpty" Grid.Row="1" Text="No tools match this view. Try a different search or filter." Foreground="{StaticResource Muted}" Margin="12,30" Visibility="Collapsed"/></Grid>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DCE1EB"/><Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="TOOL DETAILS" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="DetailName" Text="Choose a tool" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock x:Name="DetailSummary" Text="Select a card to inspect its purpose, source, and file preview." Foreground="{StaticResource Muted}"/><TextBlock x:Name="DetailMeta" Foreground="#8D6371" FontSize="11" Margin="0,14,0,10"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBox x:Name="DetailPath" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#F5F6FA" FontSize="11"/><TextBlock Text="FILE PREVIEW" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,20,0,8"/><TextBox x:Name="Preview" VerticalContentAlignment="Top" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="180" FontFamily="Consolas" FontSize="11"/></StackPanel></ScrollViewer><StackPanel Grid.Row="2" Margin="0,16,0,0"><Button x:Name="LaunchTool" Content="Open tool" Style="{StaticResource Primary}" Margin="0,0,0,8" IsEnabled="False"/><UniformGrid Columns="2"><Button x:Name="Favorite" Content="☆  Favorite" IsEnabled="False"/><Button x:Name="Locate" Content="Show location" IsEnabled="False" Margin="0,0,0,8"/></UniformGrid><TextBlock Text="ADD TO A GROUP" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,6,0,6"/><ComboBox x:Name="TargetGroup" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="Tool destination group" Margin="0,0,0,8"/><UniformGrid Columns="2"><Button x:Name="AddToGroup" Content="Add to group" IsEnabled="False"/><Button x:Name="RemoveFromGroup" Content="Remove" ToolTip="Remove this tool from its group" IsEnabled="False" Margin="0,0,0,8"/></UniformGrid><Button x:Name="CopyPath" Content="Copy full path" IsEnabled="False" Margin="0"/></StackPanel></Grid></Border>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="Release" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="1. Prepare and build" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Draft fields below apply to new builds. Existing packages keep their saved release notes." Foreground="{StaticResource Muted}" Margin="0,8,0,24"/><TextBlock Text="Release version" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="Version" Width="230" HorizontalAlignment="Left"/><TextBlock Text="Release notes" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBox x:Name="Notes" VerticalContentAlignment="Top" MaxLength="16000" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><WrapPanel Margin="0,24,0,0"><Button x:Name="Build" Content="Build installer" Style="{StaticResource Primary}"/><Button x:Name="BuildPublish" Content="Build &amp; publish"/><Button x:Name="OpenReleases" Content="Open packages"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel>
<TextBlock Text="2. Verify a completed package" FontSize="22" FontWeight="SemiBold"/>
<TextBlock Text="Choose the exact version to inspect and publish. Verification is read-only." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/>
<ComboBox x:Name="PackageChoice" DisplayMemberPath="Version" AutomationProperties.Name="Completed package version" Width="230" HorizontalAlignment="Left"/>
<TextBlock x:Name="ReleaseSummary" Margin="0,14,0,12"/>
<Button x:Name="VerifyPackage" Content="Verify package and check feed" HorizontalAlignment="Left"/>
<TextBlock Text="3. Review and publish" FontSize="22" FontWeight="SemiBold" Margin="0,18,0,8"/>
<TextBlock x:Name="FeedSummary" Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
<TextBlock Text="Preview validates locally but does not test write permissions or executable rename rules. Publication performs the final checks." Foreground="{StaticResource Muted}" Margin="0,0,0,14"/>
<WrapPanel><Button x:Name="PreviewPublish" Content="Preview selected package"/><Button x:Name="Publish" Content="Publish selected package" Style="{StaticResource Primary}"/></WrapPanel>
</StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Release progress" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="JobStatus" Text="Ready when you are." Foreground="{StaticResource Muted}" Margin="0,10,0,14"/><ProgressBar x:Name="JobProgress" Height="5" IsIndeterminate="False" Foreground="#B9203C"/><Button x:Name="ViewOutput" Content="View activity &amp; output →" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <Grid x:Name="Activity" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="OpenLogs" Content="Open saved logs"/><Button x:Name="CopyOutput" Content="Copy live output"/></StackPanel><TextBlock Text="Live output and saved job history" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
<TextBox x:Name="Output" VerticalContentAlignment="Top" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" Background="#182438" Foreground="#DDE6F5" FontFamily="Consolas" FontSize="12" Padding="20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
<ComboBox x:Name="JobHistory" Grid.Row="2" DisplayMemberPath="Label" Margin="0,14,0,10" AutomationProperties.Name="Saved job history"/>
<TextBox x:Name="HistoryDetails" VerticalContentAlignment="Top" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Text="Select a saved job to read its log. Running records from an interrupted session remain available for diagnosis."/>
</Grid>
    <ScrollViewer x:Name="Folders" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your connected folders" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="The library includes nested folders and archived copies. Refresh to discover changes." Foreground="{StaticResource Muted}" Margin="0,8,0,24"/><TextBlock Text="Publish toolbox" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="PublishPath" IsReadOnly="True"/><WrapPanel Margin="0,12,0,22"><Button x:Name="ChangeFolder" Content="Change folder"/><Button x:Name="OpenPublish" Content="Open publish folder"/></WrapPanel><TextBlock Text="Installer tools" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox x:Name="InstallerPath" IsReadOnly="True"/><Button x:Name="OpenInstaller" Content="Open Installer folder" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Personal workspace" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Favorites, recent tools, folder choice, and window size are saved locally for your Windows account." Foreground="{StaticResource Muted}" Margin="0,8,0,0"/><TextBlock x:Name="PreferencesPath" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
   <Border Grid.Row="2" BorderBrush="#E5E8EF" BorderThickness="0,1,0,0" Background="White" Padding="28,7"><TextBlock x:Name="Status" Text="Ready" FontSize="11" Foreground="{StaticResource Muted}"/></Border>
  </Grid>
 </Grid>
</Window>
