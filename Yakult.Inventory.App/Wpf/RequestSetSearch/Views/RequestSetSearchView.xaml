<UserControl
    x:Class="Yakult.Inventory.App.Wpf.RequestSetSearch.Views.RequestSetSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:searchConv="clr-namespace:Yakult.Inventory.App.Wpf.Search.Converters"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.Wpf.RequestSetSearch.Converters"
    Background="#F0F3F7"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <!-- Visual design mirrors Wpf\Search\Views\SearchView.xaml (the Inventory System homepage
         search) — same states (Initial / Loading / NoResults / Results), same pill search box,
         same ResultCard style. Simplified: no split detail panel, pagination, or filter popup,
         since Request/Set results are fewer and each card navigates directly on click. -->
    <UserControl.Resources>
        <searchConv:BoolToVisConverter        x:Key="BoolToVis"/>
        <searchConv:NullOrEmptyToVisConverter x:Key="NullToVis"/>
        <conv:RequestSetTypeToBrushConverter      x:Key="TypeBrush"/>
        <conv:RequestSetTypeToLightBrushConverter x:Key="TypeLightBrush"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="MinHeight"       Value="110"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.07" Color="#0A1A2A" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ── STATE 1 : Initial — centered logo + pill search box ────────── -->
        <Grid Visibility="{Binding IsInitial, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-30,0,0">
                <Image x:Name="LogoImage" Width="300" Height="110" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <Grid Width="640" HorizontalAlignment="Center">
                    <Border Background="White" BorderBrush="#C8D4E4" BorderThickness="1.5" CornerRadius="32">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="#000000" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="20"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="#8A9AB8"/>

                            <Grid Grid.Column="1">
                                <TextBlock Text="Search requests or sets by name, employee, model, or set code…"
                                           Foreground="#A8B8CC" FontSize="15"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="CenterSearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="15" BorderThickness="0"
                                         Background="Transparent" Foreground="#1A2333"
                                         VerticalAlignment="Center" Height="56"
                                         VerticalContentAlignment="Center"
                                         CaretBrush="#3A8EF6"
                                         Padding="0,0,16,0"
                                         KeyDown="CenterSearchBox_KeyDown"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Text="Press Enter to search across requests and sets"
                           FontSize="12" Foreground="#A8B8CC"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── STATE 2 : Loading ───────────────────────────────────────────── -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Searching…" FontSize="15" Foreground="#5A6A7E" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ── STATE 3 : No results ────────────────────────────────────────── -->
        <Grid Visibility="{Binding IsNoResults, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔍" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding NoResultsMessage}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#5A6A7E" HorizontalAlignment="Center"/>
                <TextBlock Text="Try a different name, employee, model, or set code."
                           FontSize="12" Foreground="#A8B4C0"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── STATE 4 : Results — card grid ───────────────────────────────── -->
        <Grid Visibility="{Binding IsResults, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,10" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="← Back" Click="BackButton_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#3A6EA8"
                            FontSize="13" FontWeight="SemiBold" Cursor="Hand" Padding="10,6"/>
                    <TextBlock Grid.Column="1" Text="{Binding SearchText, StringFormat=Results for: {0}}"
                               FontSize="13" Foreground="#5A6A7E" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,14,14,14">
                <ItemsControl ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ResultCard}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Border Height="4" VerticalAlignment="Top" CornerRadius="10,10,0,0"
                                            Background="{Binding TypeKey, Converter={StaticResource TypeBrush}}"/>
                                    <StackPanel Margin="14,14,14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayTitle}"
                                                       FontSize="13.5" FontWeight="SemiBold" Foreground="#1A2333"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayTitle}"/>
                                            <Border Grid.Column="1"
                                                    Background="{Binding TypeKey, Converter={StaticResource TypeBrush}}"
                                                    CornerRadius="10" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11" Foreground="#5A6A7E"
                                                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0"
                                                   Visibility="{Binding DisplaySubtitle, Converter={StaticResource NullToVis}}"/>

                                        <Border Background="{Binding TypeKey, Converter={StaticResource TypeLightBrush}}"
                                                CornerRadius="5" Padding="7,2" Margin="0,8,0,0" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding TypeKey, Converter={StaticResource TypeBrush}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
