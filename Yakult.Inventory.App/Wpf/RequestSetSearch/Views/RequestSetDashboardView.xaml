<UserControl x:Class="Yakult.Inventory.App.Wpf.RequestSetSearch.Views.RequestSetDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="{DynamicResource YakultPageBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <!-- Analytics landing for the Request & Set Management portal — same card/label/table
         styling as Wpf\Dashboard\Views\AnalyticsDashboardView.xaml (the Inventory System's own
         Dashboard page) so both read as one visual family. Every number on this page comes from
         the SAME repository calls the portal's own pages use, so a drill-down always shows the
         exact rows the page would show. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/YakultPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DashCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource YakultBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <Style x:Key="MicroLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource YakultTextMutedBrush}"/>
            </Style>

            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1" CornerRadius="7">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultSurfaceMutedBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource YakultInputBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TableCellBase" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TableCellRight" TargetType="DataGridCell" BasedOn="{StaticResource TableCellBase}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style x:Key="TableHeaderBase" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource YakultTextMutedBrush}"/>
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="10,0,10,9"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="Transparent" BorderBrush="{StaticResource YakultBorderBrush}"
                                    BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Bottom"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TableHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TableHeaderBase}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <DataTemplate x:Key="StatusCellTemplate">
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1440" Margin="24,18,24,34" HorizontalAlignment="Center">
            <StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,24,0">
                        <TextBlock x:Name="TitleLabel" Style="{StaticResource MicroLabel}" Text="REQUEST &amp; SET ANALYTICS"/>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource YakultTextDarkBrush}" Text="Requests &amp; Sets"/>
                        <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="{StaticResource YakultTextMutedBrush}"
                                   Text="Click any tile or chart to see the underlying records in the table below."/>
                    </StackPanel>

                    <Button x:Name="BtnRefresh" Grid.Column="1" Style="{StaticResource QuietButton}"
                            VerticalAlignment="Top" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#8635;" FontSize="14" VerticalAlignment="Center" Margin="0,-1,7,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="StatusText" Margin="0,22,0,0" FontSize="13"
                           Foreground="{StaticResource YakultTextMutedBrush}" Text="Loading analytics…"/>

                <!-- KPI tiles (clickable — each one selects the records behind its number) -->
                <UniformGrid x:Name="KpiGrid" Columns="6" Margin="-7,20,-7,0" Visibility="Collapsed"/>

                <!-- Charts (2 rows x 3) -->
                <UniformGrid x:Name="ChartsGrid" Columns="3" Margin="-7,18,-7,0" Visibility="Collapsed"/>

                <!-- Records table — driven by whatever was clicked above -->
                <Border x:Name="TableCard" Style="{StaticResource DashCard}" Margin="0,18,0,0" Padding="0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="18,16,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="TableTitle" Grid.Column="0" Style="{StaticResource MicroLabel}"
                                       FontSize="12" VerticalAlignment="Center"/>

                            <StackPanel x:Name="FilterChipPanel" Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,0,0,0"/>

                            <TextBlock x:Name="TableCount" Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{StaticResource YakultTextMutedBrush}" Margin="12,0,12,0"/>

                            <Button x:Name="BtnOpenPage" Grid.Column="3" Style="{StaticResource QuietButton}"
                                    Padding="12,6" Content="Open full page →"/>
                        </Grid>

                        <DataGrid x:Name="TableGrid" Margin="12,0,12,14" MaxHeight="470"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Background="Transparent" BorderThickness="0" RowHeight="40"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                  CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeColumns="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="None"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  CellStyle="{StaticResource TableCellBase}"
                                  ColumnHeaderStyle="{StaticResource TableHeaderBase}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F2F2F4"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
