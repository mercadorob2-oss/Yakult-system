<Window x:Class="Yakult.Inventory.App.Wpf.Portal.ConsumableManagementPortalShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consumable Management Portal"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="1024"
        MinHeight="700"
        FontFamily="Segoe UI">
    <Window.Background>
        <SolidColorBrush Color="#F6F5F2"/>
    </Window.Background>
    <Window.Resources>
        <!-- Flat navy header band, matching the workspace top bars (was a navy-to-blue gradient). -->
        <SolidColorBrush x:Key="HeaderBack" Color="#182235"/>
        <SolidColorBrush x:Key="HeaderLine" Color="#2C3850"/>

        <!-- Quiet rail-style pill for the Back action: soft fill that brightens on hover. -->
        <Style x:Key="HeaderPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#29364D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A4760"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="{StaticResource HeaderBack}" Padding="28,0"
                BorderBrush="{StaticResource HeaderLine}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Consumable Management" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Choose a consumable system to manage." FontSize="11.5" Foreground="#9DAAC0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource HeaderPillStyle}"
                        CornerRadius="6"
                        Padding="14,8"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        MouseLeftButtonUp="BackBtn_MouseLeftButtonUp">
                    <TextBlock x:Name="BackBtnText" Text="← Back" FontSize="12" FontWeight="SemiBold" Foreground="#DDE3ED"/>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1"/>
    </Grid>
</Window>
