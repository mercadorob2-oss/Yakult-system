<Window x:Class="Yakult.Inventory.App.Wpf.Portal.ConsumableManagementPortalShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consumable Management Portal"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        MinWidth="1024"
        MinHeight="700"
        FontFamily="Segoe UI">
    <Window.Background>
        <SolidColorBrush Color="#F5F7FB"/>
    </Window.Background>
    <Window.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0F172A" Offset="0"/>
            <GradientStop Color="#1E4078" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Consumable Management" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Choose a consumable system to manage." FontSize="11.5" Foreground="#CBD5E1"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="#1CFFFFFF"
                        CornerRadius="6"
                        Padding="14,8"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        MouseLeftButtonUp="BackBtn_MouseLeftButtonUp">
                    <TextBlock x:Name="BackBtnText" Text="← Back" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Row="1"/>
    </Grid>
</Window>
