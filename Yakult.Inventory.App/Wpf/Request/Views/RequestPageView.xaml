<UserControl x:Class="Yakult.Inventory.App.WPF.Request.Views.RequestPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToCardBrushConverter x:Key="BoolToCardBrush"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="WrappedCenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ══ Page-local redesign styles (Requests page only — not shared) ═══ -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>

            <Style x:Key="StatCardShell" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="7"/>
                <Setter Property="Margin"          Value="0,0,8,0"/>
                <Setter Property="Width"           Value="112"/>
                <Setter Property="Height"          Value="44"/>
            </Style>

            <Style x:Key="StatValueText" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="StatLabelText" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="7"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin"          Value="0"/>
            </Style>

            <!-- Local override of the shared ListDataGridColumnHeader (ListPageStyles.xaml): wraps
                 header text (e.g. "Fixed Asset", "Employee #", "Date Requested") onto a second line
                 instead of clipping it in a narrow column. Redefining the same key here shadows the
                 merged dictionary's version for this page only — the sort-arrow behavior is
                 otherwise identical to the shared style, but the header is a lighter blue to
                 reduce visual saturation (kept blue, not a pale tint, since the sort arrow is a
                 hardcoded white Fill). -->
            <Style x:Key="ListDataGridColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background"                 Value="#6FAEFB"/>
                <Setter Property="Foreground"                 Value="White"/>
                <Setter Property="FontWeight"                 Value="SemiBold"/>
                <Setter Property="FontSize"                   Value="10.5"/>
                <Setter Property="Padding"                    Value="8,6"/>
                <Setter Property="MinHeight"                  Value="34"/>
                <Setter Property="BorderBrush"                Value="{StaticResource PrimaryHoverBrush}"/>
                <Setter Property="BorderThickness"            Value="0,0,1,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <DockPanel>
                                        <Path x:Name="SortArrow"
                                              DockPanel.Dock="Right"
                                              Width="8" Height="6"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              Fill="White" Opacity="0.4"
                                              Stretch="Uniform"
                                              Data="M 1,2.5 L 4,0 L 7,2.5 Z M 1,3.5 L 4,6 L 7,3.5 Z"/>
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"  Width="8" Cursor="SizeWE" Opacity="0"/>
                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortArrow" Property="Data"    Value="M 0,5 L 4,0 L 8,5 Z"/>
                                    <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortArrow" Property="Data"    Value="M 0,0 L 4,5 L 8,0 Z"/>
                                    <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="RequestsSelectColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource SelectColumnHeader}">
                <Setter Property="Background"  Value="#6FAEFB"/>
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
            </Style>

            <Style x:Key="RequestsGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ListDataGridCell}">
                <Setter Property="Padding" Value="10,9"/>
            </Style>

            <Style x:Key="DropdownMenuItemBtn" TargetType="Button">
                <Setter Property="Height"                     Value="32"/>
                <Setter Property="Padding"                    Value="10,0"/>
                <Setter Property="FontSize"                   Value="11"/>
                <Setter Property="Cursor"                     Value="Hand"/>
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="Foreground"                 Value="#1A2333"/>
                <Setter Property="BorderThickness"            Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F0F6FF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,20,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header: title (left) + compact summary cards (right) ═══════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#E9F2FF" Margin="0,0,12,0">
                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Requests" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Review, submit, archive, and manage item requests" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCardShell}" Cursor="Hand" Background="{Binding IsAllCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#4E9AFC"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueText}" Foreground="#4E9AFC"/>
                            <TextBlock Text="TOTAL" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Cursor="Hand" Background="{Binding IsUnderReviewCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding UnderReviewCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#3498DB"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding UnderReviewCount}" Style="{StaticResource StatValueText}" Foreground="#3498DB"/>
                            <TextBlock Text="UNDER REVIEW" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Cursor="Hand" Background="{Binding IsOnHoldCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding OnHoldCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#E67E22"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding OnHoldCount}" Style="{StaticResource StatValueText}" Foreground="#E67E22"/>
                            <TextBlock Text="ON HOLD" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Cursor="Hand" Background="{Binding IsSubmittedCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SubmittedCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#9B59B6"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding SubmittedCount}" Style="{StaticResource StatValueText}" Foreground="#9B59B6"/>
                            <TextBlock Text="SUBMITTED" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Margin="0" Cursor="Hand" Background="{Binding IsCompletedCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CompletedCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#2ECC71"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource StatValueText}" Foreground="#2ECC71"/>
                            <TextBlock Text="COMPLETED" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ Action bar: primary actions + Search + Advanced Filters (left), Refresh (right) ═ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddCommand}">
                        <TextBlock Text="➕  Add New"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding EditCommand}">
                        <TextBlock Text="✎  Edit"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding MarkSubmittedCommand}">
                        <TextBlock Text="📤  Mark Submitted"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding ArchiveCommand}" IsEnabled="{Binding HasAnySelectedOnPage}">
                        <TextBlock Text="📦  Archive"/>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}" Command="{Binding DeleteCommand}" IsEnabled="{Binding HasAnySelectedOnPage}">
                        <TextBlock Text="🗑  Delete"/>
                    </Button>

                    <shared:SelectedCountBadge Count="{Binding SelectedCount}" EntityLabel="requests"
                                                Click="SelectedBadge_Click" Margin="0,0,16,8"/>

                    <!-- More Actions dropdown: PDF (Selected), Bulk Add to Set -->
                    <ToggleButton x:Name="MoreActionsDropdownToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                  Width="130" Height="30" Margin="0,0,16,8" Content="More Actions"/>
                    <Popup PlacementTarget="{Binding ElementName=MoreActionsDropdownToggle}"
                           IsOpen="{Binding IsChecked, ElementName=MoreActionsDropdownToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                CornerRadius="6" Padding="4" MinWidth="190">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="#1A2333"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding ExportSelectedPdfCommand}" IsEnabled="{Binding HasAnySelectedOnPage}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🧾  PDF (Selected)"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding BulkAddToSetCommand}" IsEnabled="{Binding HasAnySelectedOnPage}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🧺  Bulk Add to Set"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Search -->
                    <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                            CornerRadius="5" Background="White" Height="30" Width="220" Margin="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#7A8A9A"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="11"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Employee, Item, Model, Serial, Category, Entry Type, Created By, Modified By..."/>
                        </Grid>
                    </Border>

                    <!-- Advanced Filters -->
                    <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                  Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                    <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                           IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                           HorizontalOffset="-830" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                CornerRadius="8" Padding="18" Width="960">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                                <StackPanel>

                                <!-- Row 1: Status / Filter By -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Status" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Filter By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding FilterByOptions}"
                                                  SelectedItem="{Binding SelectedFilterBy, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Category / Sort By -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Category" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ToggleButton x:Name="CategoryFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                                      HorizontalAlignment="Stretch" Content="{Binding CategoryFilterSummary}"/>
                                        <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                                               IsOpen="{Binding IsChecked, ElementName=CategoryFilterToggle, Mode=TwoWay}"
                                               StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8" MinWidth="200">
                                                <StackPanel>
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                              Padding="4,0" Margin="2,4" FontSize="11"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <Separator Margin="0,6,0,4"/>
                                                    <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                            Style="{StaticResource SmallBtn}" Margin="0"
                                                            Command="{Binding ClearCategoryFilterCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SortByCombo" Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding SortByOptions}"
                                                  SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Date Requested From / To -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Date Requested From" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="To" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Set Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Document #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Company" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="6">
                                        <TextBlock Text="Department" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="8">
                                        <TextBlock Text="Branch" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="10">
                                        <TextBlock Text="Employee" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 2: Reference Code | Parent Tag -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Reference Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Parent Tag" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Req ID -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Req ID" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                </StackPanel>
                                </ScrollViewer>

                                <Separator Margin="0,2,0,12"/>

                                <Button HorizontalAlignment="Right" Style="{StaticResource GhostBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                    <TextBlock Text="↺  Reset Filters"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- "Did you mean...?" banner — only shown when these rows came from the fuzzy fallback
             (FuzzyMatchRequests) rather than an exact search-text match, so typo-corrected guesses
             are never presented as if they were literal hits. -->
        <Border Grid.Row="2" Padding="14,9" Margin="0,0,0,10"
                Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#7A5C00" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,20">
            <DataGrid x:Name="RequestsGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      CellStyle="{StaticResource RequestsGridCell}"
                      MinRowHeight="42"
                      IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Sorting="RequestsGrid_Sorting"
                      MouseDoubleClick="RequestsGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" MinWidth="44" CanUserResize="False" CanUserSort="False" HeaderStyle="{StaticResource RequestsSelectColumnHeader}" CellStyle="{StaticResource SelectColumnCell}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.SelectAllState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Click="RowSelectCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ID" Binding="{Binding ReqId}" SortMemberPath="ReqId" Width="0.6*" MinWidth="60" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" SortMemberPath="EmployeeName" Width="1.4*" MinWidth="130" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Employee #" Binding="{Binding EmployeeNumber}" SortMemberPath="EmployeeNumber" Width="*" MinWidth="100" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" SortMemberPath="CompanyName" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" SortMemberPath="DepartmentName" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" SortMemberPath="BranchName" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" SortMemberPath="ItemName" Width="1.6*" MinWidth="150" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Model #" Binding="{Binding ModelNumber}" SortMemberPath="ModelNumber" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="*" MinWidth="100" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Fixed Asset" Binding="{Binding FixedAssetDisplay}" CanUserSort="False" Width="0.9*" MinWidth="90" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Serial #" Binding="{Binding SerialNumber}" SortMemberPath="SerialNumber" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" SortMemberPath="Quantity" Width="0.6*" MinWidth="70" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="*" MinWidth="110" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Date Requested" Binding="{Binding DateRequested, StringFormat='MM/dd/yyyy'}" SortMemberPath="DateRequested" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" SortMemberPath="CreatedByName" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Footer / paging ══════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="Transparent" Padding="0,0,0,16">
            <shared:PagingControl HorizontalAlignment="Left"
                                   FirstPageCommand="{Binding FirstPageCommand}"
                                   PrevPageCommand="{Binding PrevPageCommand}"
                                   NextPageCommand="{Binding NextPageCommand}"
                                   LastPageCommand="{Binding LastPageCommand}"
                                   PageInfoText="{Binding PageInfoText}"/>
        </Border>
    </Grid>
</UserControl>
