<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Yakult.Inventory.App.Wpf.RepairPortal">

    <local:RepairStatusToBrushConverter x:Key="RepairStatusToBrushConverter"/>
    <local:RepairPartStatusToBrushConverter x:Key="RepairPartStatusToBrushConverter"/>
    <local:RepairPriorityToBrushConverter x:Key="RepairPriorityToBrushConverter"/>
    <local:BoolToVisibilityInverseConverter x:Key="BoolToVisibilityInverseConverter"/>
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <local:AlternationIndexToVisibilityConverter x:Key="AlternationIndexToVisibilityConverter"/>
    <local:StringEqualsConverter x:Key="StringEqualsConverter"/>
    <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    <local:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter"/>
    <local:BytesToImageConverter x:Key="BytesToImageConverter"/>
    <local:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
    <local:ZeroToVisibilityConverter x:Key="ZeroToVisibilityConverter"/>
    <local:PartStatusMatchToBackgroundConverter x:Key="PartStatusMatchToBackgroundConverter"/>
    <local:PartStatusMatchToForegroundConverter x:Key="PartStatusMatchToForegroundConverter"/>

    <!-- ── Portal identity palette — Red = primary action/hero accent (echoes the header title
         and signature banners), Blue = secondary/interactive accent, Black = structural chrome
         (sidebar, dark chips), White = surfaces. Status/priority colors (RepairPortalConverters.cs)
         stay their own multi-hue palette on purpose — they encode 7 distinct states and must
         stay visually distinguishable, so they are not folded into this 4-color identity. ── -->
    <SolidColorBrush x:Key="RepairRedBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="RepairRedHoverBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="RepairAccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="RepairAccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="RepairBlackBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="RepairCardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="RepairPlaceholderBg" Color="#E5E9F0"/>

    <!-- ══ Header tiers ═════════════════════════════════════════════════════
         Tier 1 — Root shell (RepairPortalShellWindow only): the full signature — red/blue
         "flag" banners, monospace red title, full-width split stripe. Reserved for the single
         entry point so it stays a landmark instead of losing weight from repetition.

         Tier 2 — Popup / list windows opened from the shell (Reports, Attendance History, and
         similar owned windows): PopupHeaderBar/PopupTitleAccentBar/PopupTitleText/PopupSubtitleText
         below. A compact split accent bar echoes the identity without restaging the shell's hero
         banners — stacking two full signatures (shell behind, popup in front) reads as visual
         noise, not reinforcement.

         Tier 3 — Detail / content pages (Ticket Detail, cards): no colored header treatment at
         all — plain bold dark title inline with the content. Color is reserved for interactive
         elements (badges, primary buttons) at this depth. ══════════════════════════════════ -->
    <LinearGradientBrush x:Key="RepairIdentityAccentBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#DC2626" Offset="0"/>
        <GradientStop Color="#DC2626" Offset="0.5"/>
        <GradientStop Color="#2563EB" Offset="0.5"/>
        <GradientStop Color="#2563EB" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="PopupHeaderBar" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="20,16"/>
    </Style>

    <Style x:Key="PopupTitleAccentBar" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Background" Value="{StaticResource RepairIdentityAccentBrush}"/>
    </Style>

    <Style x:Key="PopupTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style x:Key="PopupSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ── Feed card (Gallery view) ─────────────────────────────────────── -->
    <Style x:Key="FeedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RepairCardBg}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08" Direction="270" Color="Black"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource RepairAccentBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Direction="270" Color="Black"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Status / priority badges ─────────────────────────────────────── -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{Binding Status, Converter={StaticResource RepairStatusToBrushConverter}}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="PriorityBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{Binding Priority, Converter={StaticResource RepairPriorityToBrushConverter}}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Part status pill — Status here is the 7-value Part domain, not the Ticket's. -->
    <Style x:Key="PartStatusBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{Binding Status, Converter={StaticResource RepairPartStatusToBrushConverter}}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Part severity pill — reuses the Priority palette (same Low/Medium/High/Critical domain). -->
    <Style x:Key="PartSeverityBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{Binding Severity, Converter={StaticResource RepairPriorityToBrushConverter}}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Static info pills (Category, Item ID) — unlike the Status/Priority badges above,
         background doesn't depend on a bound value. -->
    <Style x:Key="CategoryPillStyle" TargetType="Border">
        <Setter Property="Background" Value="#EDE9FE"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="CategoryPillTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6D28D9"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="ItemIdPillStyle" TargetType="Border">
        <Setter Property="Background" Value="#DBEAFE"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="ItemIdPillTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#1D4ED8"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ── Avatar placeholder (Segoe MDL2 person glyph) ─────────────────── -->
    <Style x:Key="AvatarPlaceholderStyle" TargetType="Border">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="#CBD5E1"/>
    </Style>

    <Style x:Key="AvatarGlyphStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="&#xE77B;"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#475569"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Equipment image placeholder ──────────────────────────────────── -->
    <Style x:Key="EquipmentImagePlaceholderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource RepairPlaceholderBg}"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style x:Key="EquipmentGlyphStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="&#xE722;"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ── Kanban column ─────────────────────────────────────────────────── -->
    <Style x:Key="KanbanColumnStyle" TargetType="Border">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="MinWidth" Value="230"/>
    </Style>

    <Style x:Key="KanbanColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="4,4,4,8"/>
        <Setter Property="Foreground" Value="#1E293B"/>
    </Style>

    <!-- ── Timeline ──────────────────────────────────────────────────────── -->
    <Style x:Key="TimelineDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Fill" Value="{StaticResource RepairAccentBrush}"/>
    </Style>

    <Style x:Key="TimelineConnectorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="2"/>
        <Setter Property="Fill" Value="#CBD5E1"/>
    </Style>

    <!-- ── View-switcher tab button ──────────────────────────────────────── -->
    <Style x:Key="ViewSwitchButtonStyle" TargetType="ToggleButton">
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- White pill + blue label carries the "selected" state; the thin red
                             underline is the identity accent tying the tab back to the header. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RepairRedBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource RepairAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary / secondary action buttons ───────────────────────────── -->
    <!-- Primary is Blue — create/update actions ("+ New Repair Ticket", "Open") read as routine,
         frequent operations, not alarms. Red is reserved for the title/identity mark and for
         actual danger (Delete, Unrepairable/Critical badges) so it keeps that warning weight
         instead of being diluted onto every button. -->
    <Style x:Key="RepairPrimaryBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource RepairAccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RepairAccentHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RepairSecondaryBtn" TargetType="Button">
        <Setter Property="Background" Value="#EEF2F7"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Outlined secondary button — for buttons that sit directly on the page's own
         #F0F2F6 background (not inside a white card Border), where RepairSecondaryBtn's
         near-identical light-gray fill (#EEF2F7) blends into the page and reads as plain
         text instead of a button. A visible border + white fill fixes that. -->
    <Style x:Key="RepairOutlineBtn" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="BorderBrush" Value="#C2CCDA"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RepairAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
