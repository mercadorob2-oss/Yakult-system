<UserControl x:Class="Yakult.Inventory.App.Wpf.RepairPortal.TimeInOut.Views.TimeInGateOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/RepairPortal/RepairPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#B01E293B">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="White" CornerRadius="16" Width="360" Height="220">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.25" Color="Black"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7EE;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="{StaticResource RepairAccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="You're not timed in" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,4" Foreground="#1E293B"/>
                    <TextBlock Text="Time in to unlock the repair workspace." FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button Content="Time In" Style="{StaticResource RepairPrimaryBtn}" Width="140" Cursor="Hand" ForceCursor="True" Command="{Binding TimeInCommand}"/>
                </StackPanel>
            </Border>

            <Button x:Name="BackToPortalFloatingButton" Content="Back to Portal" Width="360" Margin="0,16,0,0"
                    Cursor="Hand" ForceCursor="True"
                    Click="BackToPortalFloatingButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource RepairSecondaryBtn}">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="Black"/>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
