<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Detail.Views.EvidenceViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidence Viewer"
        WindowStartupLocation="CenterOwner" WindowState="Maximized" ResizeMode="CanResize"
        Background="#0F172A" KeyDown="Window_KeyDown">
    <Grid>
        <Image x:Name="ImageHost" Stretch="Uniform" Margin="90,20,90,60"/>

        <StackPanel x:Name="LoadingIndicator" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="160" Height="4"/>
            <TextBlock Text="Loading..." Foreground="White" FontSize="12" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <MediaElement x:Name="VideoHost" Margin="90,20,90,110" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      Stretch="Uniform" MediaOpened="VideoHost_MediaOpened" MediaEnded="VideoHost_MediaEnded"/>

        <!-- Play/Pause + seek slider + elapsed/total time + speed — only shown while a video is loaded. -->
        <Grid x:Name="VideoControlsBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,64"
              Width="720" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="PlayPauseButton" Grid.Column="0" Content="&#xE769;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                    Click="PlayPause_Click" Width="36" Height="36" Margin="0,0,8,0"
                    Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="ElapsedTimeText" Grid.Column="1" Text="00:00" Foreground="White" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>

            <Slider x:Name="SeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="1"
                    PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp"
                    ValueChanged="SeekSlider_ValueChanged"/>

            <TextBlock x:Name="TotalTimeText" Grid.Column="3" Text="00:00" Foreground="White" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,8,0"/>

            <ComboBox x:Name="SpeedCombo" Grid.Column="4" Width="70" VerticalAlignment="Center"
                      SelectionChanged="SpeedCombo_SelectionChanged"/>
        </Grid>

        <StackPanel x:Name="DocumentHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="90,20,90,60">
            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="White" HorizontalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="DocumentNameText" Foreground="White" FontSize="16" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            <TextBlock Text="This file type can't be previewed here." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16" HorizontalAlignment="Center"/>
            <Button Content="Open" Width="120" Height="34" Click="OpenExternally_Click"
                    Background="#2563EB" Foreground="White" BorderThickness="0"/>
        </StackPanel>

        <!-- Prev / Next -->
        <Button Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="20" Click="Prev_Click"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                Width="56" Height="56" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        <Button Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="20" Click="Next_Click"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                Width="56" Height="56" Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>

        <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0"
                Width="40" Height="40" Click="CloseButton_Click"
                Background="#33FFFFFF" Foreground="White" BorderThickness="0" Cursor="Hand"/>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16">
            <TextBlock x:Name="FileNameText" HorizontalAlignment="Center" Foreground="White" FontSize="13" Opacity="0.85"/>
            <TextBlock x:Name="SourceLabelText" HorizontalAlignment="Center" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
            <TextBlock x:Name="PositionText" HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</Window>
