<UserControl x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Detail.Views.RepairTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/RepairPortal/RepairPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- ── Compact fishbone preview — a horizontal spine with events branching alternately
             above/below it (like an Ishikawa diagram), scrolling sideways within a fixed height
             so it never pushes the rest of the page down. ─────────────────────────────────── -->
        <ScrollViewer x:Name="TimelineScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Height="210"
                      PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel"
                      Visibility="{Binding HasItems, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}" AlternationCount="2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="190">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="76"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="76"/>
                            </Grid.RowDefinitions>

                            <!-- Spine: every item contributes a segment, forming one continuous line.
                                 Split into two half-rows (2/3) so each bone's RowSpan can end exactly
                                 at the dot's center instead of overshooting past it. -->
                            <Border Grid.Row="2" Grid.RowSpan="2" Height="2" Background="#CBD5E1" VerticalAlignment="Center"/>

                            <!-- Top branch (even-indexed entries) -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="4,0,4,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToVisibilityConverter}, ConverterParameter=Top}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource RepairAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FieldName, Mode=OneWay}" FontWeight="SemiBold" FontSize="11"
                                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                               Text="{Binding NewValue, Mode=OneWay}"/>
                                    <TextBlock FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0">
                                        <Run Text="{Binding ChangedByName, Mode=OneWay, TargetNullValue='System'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ChangedAt, StringFormat='{}{0:MMM d, h:mm tt}'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <!-- Spans the connector row + the near half of the spine row only, so the
                                 bar's end lands exactly at the dot's center — no gap, no overshoot. -->
                            <Border Grid.Row="1" Grid.RowSpan="2" Width="2" Background="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToVisibilityConverter}, ConverterParameter=Top}"/>

                            <!-- Bottom branch (odd-indexed entries) -->
                            <Border Grid.Row="3" Grid.RowSpan="2" Width="2" Background="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToVisibilityConverter}, ConverterParameter=Bottom}"/>
                            <Border Grid.Row="5" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="4,0,4,0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                    Visibility="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource AlternationIndexToVisibilityConverter}, ConverterParameter=Bottom}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource RepairAccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FieldName, Mode=OneWay}" FontWeight="SemiBold" FontSize="11"
                                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                               Text="{Binding NewValue, Mode=OneWay}"/>
                                    <TextBlock FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0">
                                        <Run Text="{Binding ChangedByName, Mode=OneWay, TargetNullValue='System'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding ChangedAt, StringFormat='{}{0:MMM d, h:mm tt}'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Dot drawn last so it paints over the bars' small overlap into this row -->
                            <Ellipse Grid.Row="2" Grid.RowSpan="2" Width="9" Height="9" Fill="{StaticResource RepairAccentBrush}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="No history yet." FontSize="12" Foreground="#94A3B8"
                   Visibility="{Binding HasItems, ElementName=Root, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>

        <Button Content="See Full Timeline" Style="{StaticResource RepairSecondaryBtn}" FontSize="11" Padding="10,5"
                HorizontalAlignment="Left" Margin="0,8,0,0" Click="SeeFullTimeline_Click"
                Visibility="{Binding HasItems, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </StackPanel>
</UserControl>
