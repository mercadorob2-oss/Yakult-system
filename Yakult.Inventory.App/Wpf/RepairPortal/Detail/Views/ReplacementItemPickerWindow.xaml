<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Detail.Views.ReplacementItemPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
        Title="Choose Replacement Item" Height="560" Width="820" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="White">
    <Window.Resources>
        <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose Replacement Item" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
        <TextBlock Grid.Row="1" Text="Pick an existing, active item of the same category already in stock to issue to the original requester. Leave the search blank to browse items not currently in any set. If none is available, add the item first via the normal Item page, then try again." FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,10"/>

        <TextBox x:Name="SearchBox" Grid.Row="2" Padding="6" Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>

        <DataGrid x:Name="ResultsGrid" Grid.Row="3" Style="{StaticResource ListDataGridChrome}"
                  SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="70"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Model Number" Binding="{Binding ModelNumber}" Width="*"/>
                <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="*"/>
                <DataGridTextColumn Header="Date Created" Binding="{Binding DateCreated, StringFormat=MM/dd/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <shared:PagingControl x:Name="PagingBar" Grid.Row="4" Margin="0,8,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="86" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="OkButton" Content="OK" Width="86" Height="32" Background="#4E9AFC" Foreground="White" BorderThickness="0" IsEnabled="False" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
