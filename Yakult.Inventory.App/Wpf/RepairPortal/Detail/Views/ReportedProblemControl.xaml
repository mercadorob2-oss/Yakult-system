<UserControl x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Detail.Views.ReportedProblemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/RepairPortal/RepairPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"
                                       Text="{Binding DisplayNumber, StringFormat='Observation #{0}'}" Margin="0,0,0,4"/>

                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource RepairSecondaryBtn}"
                                        Padding="6,3" Margin="0,0,4,0" ToolTip="Move Up" Command="{Binding MoveUpCommand}"/>
                                <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Style="{StaticResource RepairSecondaryBtn}"
                                        Padding="6,3" Margin="0,0,4,0" ToolTip="Move Down" Command="{Binding MoveDownCommand}"/>
                                <Button Content="Edit" FontSize="11" Style="{StaticResource RepairSecondaryBtn}"
                                        Padding="8,3" Margin="0,0,4,0" Command="{Binding EditCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                                <Button Content="Delete" FontSize="11" Style="{StaticResource RepairSecondaryBtn}" Padding="8,3"
                                        Command="{Binding DeleteCommand}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ObservationText}" TextWrapping="Wrap" FontSize="12"
                                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>

                            <StackPanel Grid.Row="1" Grid.Column="0" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="60" Padding="6" Margin="0,0,0,6" IsVisibleChanged="EditTextBox_IsVisibleChanged"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Save" Style="{StaticResource RepairPrimaryBtn}" Padding="10,4" Margin="0,0,6,0" Command="{Binding SaveCommand}"/>
                                    <Button Content="Cancel" Style="{StaticResource RepairSecondaryBtn}" Padding="10,4" Command="{Binding CancelCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="No observations recorded yet." FontSize="12" Foreground="#94A3B8" Margin="0,0,0,8"
                   Visibility="{Binding HasObservations, ElementName=Root, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewObservationText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                     Padding="6" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Add Observation" Style="{StaticResource RepairPrimaryBtn}" Margin="8,0,0,0"
                    Command="{Binding AddObservationCommand, ElementName=Root}"/>
        </Grid>
    </StackPanel>
</UserControl>
