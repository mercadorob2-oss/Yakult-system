<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Detail.Views.RepairTicketDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yakult.Inventory.App.Wpf.RepairPortal.Detail.Views"
        Title="Repair Ticket" Height="900" Width="980" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F0F2F6">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/RepairPortal/RepairPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" DataContext="{Binding}" AllowDrop="True" Drop="EvidencePanel_Drop" DragOver="EvidencePanel_DragOver">

            <!-- ══ 1. Equipment Information ══════════════════════════════════ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Detail.ItemNameSnapshot}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock FontSize="12" Foreground="#64748B">
                        <Run Text="{Binding Detail.TicketCode, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,1,0,0"
                               Visibility="{Binding Detail.ItemSerialSnapshot, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <Run Text="Serial: "/><Run Text="{Binding Detail.ItemSerialSnapshot, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="#64748B" Margin="0,1,0,0"
                               Visibility="{Binding Detail.ModelNumber, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                        <Run Text="Model: "/><Run Text="{Binding Detail.ModelNumber, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource CategoryPillStyle}" Margin="0,0,6,0"
                                Visibility="{Binding Detail.Category, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource CategoryPillTextStyle}" Text="{Binding Detail.Category}"/>
                        </Border>
                        <Border Style="{StaticResource ItemIdPillStyle}">
                            <TextBlock Style="{StaticResource ItemIdPillTextStyle}" Text="{Binding Detail.ItemId, StringFormat='Item ID: {0}'}"/>
                        </Border>
                    </StackPanel>

                    <!-- Date Received / Date Created / Date Finished — Received and Created are easy
                         to mix up since they're usually seconds apart (Received only diverges when a
                         technician backdates it for a batch-logged/backlogged intake), so each gets a
                         short parenthetical spelling out what it actually tracks. -->
                    <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0">
                        <Run Text="Date Received: "/><Run Text="{Binding Detail.DateReceived, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                        <Run Text=" (when the item arrived — editable)" FontStyle="Italic"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                        <Run Text="Date Created: "/><Run Text="{Binding Detail.CreatedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                        <Run Text=" (when this ticket was logged in the system)" FontStyle="Italic"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="#94A3B8"
                               Visibility="{Binding Detail.CompletedAt, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Date Finished: "/><Run Text="{Binding Detail.CompletedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                    </TextBlock>

                    <!-- Requested By — display + inline edit -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding IsEditingRequestedBy, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                        <TextBlock Text="Requested By" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <Button Content="Edit" Style="{StaticResource RepairOutlineBtn}" FontSize="11.5" Padding="10,5" Margin="10,0,0,0"
                                Command="{Binding EditRequestedByCommand}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsEditingRequestedBy, Converter={StaticResource BoolToVisibilityInverseConverter}}">
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                   Visibility="{Binding Detail.CompanyName, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                            <Run Text="Company: "/><Run Text="{Binding Detail.CompanyName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                   Visibility="{Binding Detail.BranchName, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                            <Run Text="Branch: "/><Run Text="{Binding Detail.BranchName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                   Visibility="{Binding Detail.DeptName, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                            <Run Text="Department: "/><Run Text="{Binding Detail.DeptName, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                   Visibility="{Binding Detail.RequestedByEmpName, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                            <Run Text="Employee: "/><Run Text="{Binding Detail.RequestedByEmpName, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Visibility="{Binding IsEditingRequestedBy, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Requested By" Style="{StaticResource FilterLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                <RadioButton Content="Department" GroupName="EditRequestedByType" IsChecked="{Binding IsEditRequestedByDepartment, Mode=OneWay}"
                                             Command="{Binding SetEditRequestedByTypeCommand}" CommandParameter="Department" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <RadioButton Content="Employee" GroupName="EditRequestedByType" IsChecked="{Binding IsEditRequestedByEmployee, Mode=OneWay}"
                                             Command="{Binding SetEditRequestedByTypeCommand}" CommandParameter="Employee" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsEditRequestedByDepartment, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding EditRequestedCompanyOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedEditRequestedCompany}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                          ToolTip="Company"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding EditRequestedBranchOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedEditRequestedBranch}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                          ToolTip="Branch (optional)"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding DepartmentOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedRequestedDept}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                          ToolTip="Department"/>
                            </StackPanel>
                            <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding EmployeeOptions}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedRequestedEmployee}" HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                      Visibility="{Binding IsEditRequestedByEmployee, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource RepairSecondaryBtn}" FontSize="11" Padding="8,4" Margin="0,0,6,0"
                                        Command="{Binding CancelEditRequestedByCommand}"/>
                                <Button Content="Save" Style="{StaticResource RepairPrimaryBtn}" FontSize="11" Padding="8,4"
                                        Command="{Binding SaveRequestedByCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Refresh" Style="{StaticResource RepairOutlineBtn}" FontSize="11.5" Padding="10,5" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}" ToolTip="Reload this ticket — picks up evidence uploaded from the mobile app"/>
                    <Button x:Name="BtnGenerateQr" Content="Generate QR" Style="{StaticResource RepairOutlineBtn}" FontSize="11.5" Padding="10,5" Margin="0,0,8,0" Click="BtnGenerateQr_Click"/>
                    <Button x:Name="BtnViewQr" Content="View QR" Style="{StaticResource RepairOutlineBtn}" FontSize="11.5" Padding="10,5" Margin="0,0,12,0" Click="BtnViewQr_Click"/>
                    <TextBlock Text="{Binding Detail.DaysInCurrentStatus, StringFormat='{}{0}d'}" FontSize="11" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Style="{StaticResource StatusBadgeStyle}" DataContext="{Binding Detail}" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                    <Border Style="{StaticResource PriorityBadgeStyle}" DataContext="{Binding Detail}">
                        <TextBlock Text="{Binding Priority}" Style="{StaticResource BadgeTextStyle}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══ 2. Reported Problem ════════════════════════════════════════ -->
            <TextBlock Text="Reported Problem" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <local:ReportedProblemControl ItemsSource="{Binding Observations}"
                                                   NewObservationText="{Binding NewObservationText, Mode=TwoWay}"
                                                   AddObservationCommand="{Binding AddObservationCommand}"/>

                    <!-- Legacy flat Problem text: only shown for pre-redesign tickets that have no
                         Observations yet (new tickets auto-create Observation #1 from this same
                         text at intake, so it would otherwise just duplicate Observation #1). -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding Observations.Count, Converter={StaticResource ZeroToVisibilityConverter}}">
                        <StackPanel Visibility="{Binding Detail.Problem, Converter={StaticResource EmptyStringToVisibilityConverter}}">
                            <TextBlock Text="Original Problem Note (legacy)" Style="{StaticResource FilterLabel}"/>
                            <TextBlock Text="{Binding Detail.Problem}" TextWrapping="Wrap" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══ 3. Part Diagnostics ══════════════════════════════════════════ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Part Diagnostics" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="+ Add Part" Style="{StaticResource RepairPrimaryBtn}" Command="{Binding AddPartCommand}"/>
            </Grid>

            <TextBlock Text="{Binding EvidenceUsageText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#64748B"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding EvidenceUsageNearLimit}" Value="True">
                                <Setter Property="Foreground" Value="#DC2626"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Parts}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:RepairPartCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No parts logged yet. Click &quot;+ Add Part&quot; to start diagnosing a component."
                       FontSize="12" Foreground="#94A3B8" Margin="0,0,0,20"
                       Visibility="{Binding Parts.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>

            <!-- ══ 4. Evidence Gallery (aggregate: ticket-level + all parts) ══ -->
            <TextBlock Text="Evidence Gallery" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding EvidenceGallery}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="120" Height="90" Margin="0,0,8,8" CornerRadius="8" Background="#E5E9F0"
                                        Cursor="Hand" MouseLeftButtonUp="EvidenceGalleryItem_Click" ToolTip="Click to preview">
                                    <Grid>
                                        <TextBlock Style="{StaticResource EquipmentGlyphStyle}" FontSize="20"/>
                                        <Border VerticalAlignment="Bottom" Background="#B0000000" Padding="4,3">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PartDisplayName, TargetNullValue='Whole Equipment'}" Foreground="#CBD5E1" FontSize="8"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No evidence uploaded yet." FontSize="12" Foreground="#94A3B8"
                               Visibility="{Binding EvidenceGallery.Count, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Whole-equipment evidence upload — per spec, evidence is only attached directly to
                 the Repair Item when it applies to the entire equipment (not a specific part). -->
            <TextBlock Text="Whole-Equipment Evidence" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
            <local:ImageCarouselControl ItemsSource="{Binding Attachments}" DeleteSelectedCommand="{Binding DeleteSelectedAttachmentsCommand}" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Upload Evidence" Style="{StaticResource RepairSecondaryBtn}" Command="{Binding UploadEvidenceCommand}"/>
                <TextBlock Text="or drag &amp; drop files onto this page (applies to the whole equipment, not a specific part)" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- ══ 5. Repair Timeline (ticket-wide) ═══════════════════════════ -->
            <TextBlock Text="Repair Timeline" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <local:RepairTimelineControl ItemsSource="{Binding History}" Title="Repair Timeline"/>
            </Border>

            <!-- ══ 6. Technician Notes (whole-equipment / general) ═══════════ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Technician Notes" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Delete Ticket" Style="{StaticResource RepairSecondaryBtn}" Foreground="#DC2626"
                        Command="{Binding DeleteTicketCommand}" ToolTip="Permanently delete this ticket — for accidental intake mistakes (e.g. wrong item selected)"/>
            </Grid>
            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <local:NoteThreadControl ItemsSource="{Binding Notes}" NoteText="{Binding NewNoteText, Mode=TwoWay}" AddNoteCommand="{Binding AddNoteCommand}"/>
            </Border>

            <!-- ══ 7. Repair Actions (manual status override) ═════════════════ -->
            <TextBlock Text="Repair Actions" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,16">
                <Button Content="Mark Diagnosing" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,8" Command="{Binding SetStatusCommand}" CommandParameter="Diagnosing"
                        Background="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToBackgroundConverter}, ConverterParameter=Diagnosing}"
                        Foreground="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToForegroundConverter}, ConverterParameter=Diagnosing}"/>
                <Button Content="Mark Repairing" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,8" Command="{Binding SetStatusCommand}" CommandParameter="Repairing"
                        Background="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToBackgroundConverter}, ConverterParameter=Repairing}"
                        Foreground="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToForegroundConverter}, ConverterParameter=Repairing}"/>
                <Button Content="Mark Waiting Parts" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,8" Command="{Binding SetStatusCommand}" CommandParameter="AwaitingParts"
                        Background="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToBackgroundConverter}, ConverterParameter=AwaitingParts}"
                        Foreground="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToForegroundConverter}, ConverterParameter=AwaitingParts}"/>
                <Button Content="Mark Testing" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,8" Command="{Binding SetStatusCommand}" CommandParameter="Testing"
                        Background="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToBackgroundConverter}, ConverterParameter=Testing}"
                        Foreground="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToForegroundConverter}, ConverterParameter=Testing}"/>
                <Button Content="Mark as Repaired" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,8" Command="{Binding SetStatusCommand}" CommandParameter="Completed"
                        Background="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToBackgroundConverter}, ConverterParameter=Completed}"
                        Foreground="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToForegroundConverter}, ConverterParameter=Completed}"/>
                <Button Content="Mark Unrepairable" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,8" Command="{Binding SetStatusCommand}" CommandParameter="Unrepairable"
                        Background="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToBackgroundConverter}, ConverterParameter=Unrepairable}"
                        Foreground="{Binding Detail.Status, Converter={StaticResource PartStatusMatchToForegroundConverter}, ConverterParameter=Unrepairable}"/>
            </WrapPanel>

            <!-- ══ 7b. Disposition (Discard / Replace) — only once Status = Unrepairable ══════ -->
            <StackPanel Visibility="{Binding IsUnrepairable, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Disposition" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="This item is Unrepairable. Choose what happens to it — the choice can be changed later if needed."
                                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Discard Item" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,0" Command="{Binding DiscardDispositionCommand}"/>
                            <Button Content="Replace Item" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,0" Command="{Binding ReplaceDispositionCommand}"/>
                            <Button Content="Unlink" Style="{StaticResource RepairSecondaryBtn}" Foreground="#DC2626" Command="{Binding UnlinkDispositionCommand}"
                                    Visibility="{Binding Conclusion.DispositionExecutedAt, Converter={StaticResource NullToVisibilityConverter}}"
                                    ToolTip="Undo the current disposition — for correcting a mistake"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DispositionSummaryText}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══ 7c. Spare Item (temporary loaner) — only while Status = Repairing ═══════ -->
            <StackPanel Visibility="{Binding IsRepairing, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Spare Item" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Temporarily loan the requester a spare while this item is being repaired." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Assign Spare" Style="{StaticResource RepairSecondaryBtn}" Margin="0,0,8,0" Command="{Binding AssignSpareCommand}"
                                    Visibility="{Binding HasActiveSpare, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                            <Button Content="Unlink Spare" Style="{StaticResource RepairSecondaryBtn}" Foreground="#DC2626" Command="{Binding UnlinkSpareCommand}"
                                    Visibility="{Binding HasActiveSpare, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SpareSummaryText}" FontSize="11.5" Foreground="#334155" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══ 8. Repair Conclusion ═══════════════════════════════════════ -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Repair Conclusion" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Print Report" Style="{StaticResource RepairOutlineBtn}" Command="{Binding PrintReportCommand}"/>
            </Grid>
            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Available once every part is Repaired or Cannot Repair." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"
                               Visibility="{Binding AllPartsTerminal, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>

                    <TextBlock Text="Root Cause" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding RootCauseInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" Padding="6" Margin="0,4,0,10"/>

                    <TextBlock Text="Work Performed" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding WorkPerformedInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" Padding="6" Margin="0,4,0,10"/>

                    <TextBlock Text="Final Outcome" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding FinalOutcomeInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" Padding="6" Margin="0,4,0,10"/>

                    <TextBlock Text="Recommendations" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding RecommendationsInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             Height="60" Padding="6" Margin="0,4,0,10"/>

                    <TextBlock Text="Repaired By" Style="{StaticResource FilterLabel}"/>
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Repaired By..." Style="{StaticResource RepairSecondaryBtn}" Command="{Binding SelectRepairedByCommand}"/>
                        <TextBlock Grid.Column="1" Text="{Binding RepairedByDisplayText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="#334155" TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock Text="Repair Handed Over to Supplier" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding VendorOptions}" SelectedItem="{Binding SelectedVendor}"
                              DisplayMemberPath="VendorName" Height="30" Margin="0,4,0,10"
                              ToolTip="Select the vendor this repair was sent out to, if any — leave as &quot;None&quot; for in-house repairs."/>

                    <!-- Only meaningful once a conclusion has actually been saved with a completion
                         timestamp — bound directly to CompletedAt (not Conclusion) so a brand-new,
                         unsaved conclusion doesn't show a dangling "Completed by System on " with no
                         date. -->
                    <TextBlock FontSize="11" Foreground="#64748B" Margin="0,0,0,10"
                               Visibility="{Binding Conclusion.CompletedAt, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Completed by "/><Run Text="{Binding Conclusion.CompletedByName, Mode=OneWay, TargetNullValue='System'}"/>
                        <Run Text=" on "/><Run Text="{Binding Conclusion.CompletedAt, StringFormat='{}{0:MMM d, yyyy h:mm tt}'}"/>
                    </TextBlock>

                    <Button Content="Save Conclusion" Style="{StaticResource RepairPrimaryBtn}" HorizontalAlignment="Left" Command="{Binding SaveConclusionCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
