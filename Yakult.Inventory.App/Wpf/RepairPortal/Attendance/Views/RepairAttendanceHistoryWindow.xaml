<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Attendance.Views.RepairAttendanceHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time In/Out History" Height="640" Width="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/RepairPortal/RepairPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tier 2 popup header — see RepairPortalStyles.xaml's header-tier note. -->
        <Border Grid.Row="0" Style="{StaticResource PopupHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource PopupTitleAccentBar}" VerticalAlignment="Stretch"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Time In/Out History" Style="{StaticResource PopupTitleText}"/>
                    <TextBlock Text="Every Time In / Time Out session logged under your account, most recent first" Style="{StaticResource PopupSubtitleText}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh" Style="{StaticResource RepairSecondaryBtn}" VerticalAlignment="Center" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="16" Background="White" CornerRadius="10" Padding="4">
            <Grid>
                <DataGrid ItemsSource="{Binding Sessions}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Style="{StaticResource ListDataGridChrome}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding WorkDate, StringFormat='{}{0:MMM d, yyyy}'}" Width="130"/>
                        <DataGridTemplateColumn Header="Time In" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TimeIn, StringFormat='{}{0:h:mm tt}'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#16A34A"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Time Out" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding TimeOut, StringFormat='{}{0:h:mm tt}'}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTimedIn}" Value="True">
                                                        <Setter Property="Text" Value="Not recorded"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Setter Property="Foreground" Value="#EA580C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Duration" Binding="{Binding ElapsedDisplay}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="No Time In/Out history recorded yet." FontSize="13" Foreground="#94A3B8"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
