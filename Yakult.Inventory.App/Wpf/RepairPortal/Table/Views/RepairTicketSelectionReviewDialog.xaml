<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Table.Views.RepairTicketSelectionReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selected Repair Tickets"
        Width="1100" Height="720"
        MinWidth="960" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <!-- Same custom-chrome shape as Pages\Software\SelectedItemsReviewDialog.xaml (the "click the
         N selected badge to review/unselect" pattern this mirrors) — columns here are the Repair
         Table View's own, not that dialog's Items-specific set. -->
    <Window.Resources>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                      Opacity="0.06" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>

        <Style x:Key="RemoveBtn" TargetType="Button">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#FDEBEC"/>
            <Setter Property="Foreground"      Value="#D9534F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5"
                              Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#3A8EF6"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag"
                    Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Cursor="Arrow">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   ToolTip="Minimize"
                                   MouseLeftButtonDown="OnMinimizeClick"/>
                        <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   ToolTip="Maximize"
                                   MouseLeftButtonDown="OnMaximizeClick"/>
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnCloseClick"/>
                    </StackPanel>
                    <TextBlock Text="Selected Repair Tickets"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Background="#F7F8FA">
                <Border Style="{StaticResource Card}" Margin="12" Padding="16,12,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="TxtEmptyState"
                                   Text="No tickets selected."
                                   FontSize="12" Foreground="#7A8A9A"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed"/>

                        <DataGrid Grid.Row="1" x:Name="TicketsGrid"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF0F4"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F5F9FF"
                                  Background="White"
                                  BorderBrush="#DDE3EC"
                                  BorderThickness="1"
                                  MinRowHeight="34"
                                  FontSize="12"
                                  Foreground="#1A2333"
                                  VirtualizingPanel.IsVirtualizing="False">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"                 Value="#3498DB"/>
                                    <Setter Property="Foreground"                 Value="White"/>
                                    <Setter Property="FontWeight"                 Value="SemiBold"/>
                                    <Setter Property="FontSize"                   Value="12"/>
                                    <Setter Property="Padding"                    Value="8,0"/>
                                    <Setter Property="Height"                     Value="36"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0"/>
                                </Style>
                                <Style x:Key="CellText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin"            Value="8,0"/>
                                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                </Style>

                                <!-- The base header style above is HorizontalContentAlignment="Left" (fits
                                     text headers), which pushes the "select all" CheckBox hard against the
                                     column's left padding edge — combined with the column's narrow width,
                                     that squeezed it down to basically an unreadable sliver. Centering it
                                     here (this column only) plus the wider column below fixes that. -->
                                <Style x:Key="SelectAllHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>

                                <!-- Checkbox/Action cells centered — the base DataGridCell style above only
                                     zeroes Padding/BorderThickness, so its content otherwise defaults to the
                                     grid's left-aligned text layout, which looked off for a lone checkbox or
                                     button. -->
                                <Style x:Key="CenterCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment"   Value="Center"/>
                                </Style>

                                <!-- DataGridCheckBoxColumn generates its CheckBox with VerticalAlignment="Top"
                                     baked into its own default element style — the cell's own
                                     VerticalContentAlignment="Center" above doesn't override that, which is
                                     why the checkboxes stuck to the top of each (34px-tall) row instead of
                                     centering. Applied to both the read-only and editing states since a
                                     checkbox column swaps between the two on click. -->
                                <Style x:Key="RowCheckBoxStyle" TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment"   Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <!-- Same columns as the Repair Table View itself (RepairTicketTableView.xaml),
                                 plus a checkbox column so multiple rows can be dropped at once via
                                 "Remove Selected" instead of one at a time, and an Action column for the
                                 per-row Remove button. Each row is bound to a RepairTicketTableRow wrapper
                                 (Table.Views' own — same namespace), so bindings below go through Ticket.*
                                 except IsSelected itself.

                                 No FrozenColumnCount here on purpose — pinning columns previously made the
                                 horizontal scrollbar only span the unfrozen region, which read as though
                                 its left portion was missing. Plain left-to-right column order plus the
                                 wider default window width above (1100, up from 1000) is enough for every
                                 column to fit without scrolling in the common case. -->
                            <!-- IsReadOnly is deliberately NOT set at the DataGrid level — WPF's
                                 DataGrid.IsReadOnly="True" overrides every column's own IsReadOnly, even
                                 the checkbox column, which is exactly why the row checkboxes couldn't be
                                 clicked before. Each text column below is marked read-only individually
                                 instead, leaving the checkbox column (and the Action button, which was
                                 never editable content anyway) untouched. -->
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="46" CanUserSort="False"
                                                         HeaderStyle="{StaticResource SelectAllHeaderStyle}" CellStyle="{StaticResource CenterCellStyle}"
                                                         ElementStyle="{StaticResource RowCheckBoxStyle}" EditingElementStyle="{StaticResource RowCheckBoxStyle}">
                                    <DataGridCheckBoxColumn.Header>
                                        <!-- Explicit Background/BorderBrush — the default CheckBox chrome reads as
                                             a near-invisible blue-on-blue box against this header's #3498DB fill
                                             otherwise, since its checkmark uses the system accent color. -->
                                        <CheckBox x:Name="SelectAllCheckBox" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="SelectAllCheckBox_Click"
                                                  Background="White" BorderBrush="#1A2333" BorderThickness="1.5"
                                                  ToolTip="Select/deselect all"/>
                                    </DataGridCheckBoxColumn.Header>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="Item Name" Binding="{Binding Ticket.ItemName}" Width="1.6*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Company" Binding="{Binding Ticket.CompanyName}" Width="1*" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Branch" Binding="{Binding Ticket.BranchName}" Width="1.1*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Department" Binding="{Binding Ticket.DeptName}" Width="1.1*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Employee" Binding="{Binding Ticket.RequestedByDisplay}" Width="1.2*" MinWidth="110" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Problem" Binding="{Binding Ticket.Problem}" Width="1.8*" MinWidth="160" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Ticket.Status}" Width="1*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Priority" Binding="{Binding Ticket.Priority}" Width="0.9*" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="Action" Width="80" CanUserSort="False" CellStyle="{StaticResource CenterCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Style="{StaticResource RemoveBtn}"
                                                    Tag="{Binding Ticket.RepairTicketId}"
                                                    Click="BtnRemoveRow_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCount"
                               Grid.Column="0"
                               FontSize="11.5" Foreground="#7A8A9A"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRemoveSelected"
                                Content="Remove Selected"
                                Style="{StaticResource SecBtn}"
                                Margin="0,0,8,0"
                                Click="BtnRemoveSelected_Click"/>
                        <Button x:Name="BtnRemoveAll"
                                Content="Remove All"
                                Style="{StaticResource SecBtn}"
                                Margin="0,0,8,0"
                                Click="BtnRemoveAll_Click"/>
                        <Button Content="Close"
                                Style="{StaticResource PrimaryBtn}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
