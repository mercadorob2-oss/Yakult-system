<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Reports.Views.RepairReportAttachmentPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Yakult.Inventory.App.Wpf.RepairPortal"
        Title="Report Attachments"
        Width="760" Height="620"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <!-- Same custom-chrome shape as Pages\Software\SelectedItemsReviewDialog and
         Wpf\RepairPortal\Table\Views\RepairTicketSelectionReviewDialog — a checklist that replaces
         the old blanket "Include attachment images?" Yes/No MessageBox, so a technician can drop a
         specific irrelevant/blurry photo instead of an all-or-nothing choice. -->
    <Window.Resources>
        <conv:BytesToImageConverter x:Key="BytesToImage"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                      Opacity="0.06" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5"
                              Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#3A8EF6"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag"
                    Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Cursor="Arrow">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnCloseClick"/>
                    </StackPanel>
                    <TextBlock Text="Choose which photos to include in the report"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Background="#F7F8FA">
                <Border Style="{StaticResource Card}" Margin="12" Padding="16,12,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Everything is included by default — untick anything you don't want printed."
                                       FontSize="12" Foreground="#7A8A9A" VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" x:Name="AttachmentsGrid"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF0F4"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F5F9FF"
                                  Background="White"
                                  BorderBrush="#DDE3EC"
                                  BorderThickness="1"
                                  MinRowHeight="60"
                                  FontSize="12"
                                  Foreground="#1A2333"
                                  IsReadOnly="False"
                                  VirtualizingPanel.IsVirtualizing="False">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"                 Value="#3498DB"/>
                                    <Setter Property="Foreground"                 Value="White"/>
                                    <Setter Property="FontWeight"                 Value="SemiBold"/>
                                    <Setter Property="FontSize"                   Value="12"/>
                                    <Setter Property="Padding"                    Value="8,0"/>
                                    <Setter Property="Height"                     Value="36"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0"/>
                                </Style>
                                <Style x:Key="CellText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin"            Value="8,0"/>
                                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" IsReadOnly="False"/>
                                <DataGridTemplateColumn Header="Preview" Width="70" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="48" Height="48" Margin="6" CornerRadius="4" ClipToBounds="True" Background="#EEF0F4">
                                                <Image Source="{Binding Attachment.ThumbnailBytes, Converter={StaticResource BytesToImage}}" Stretch="UniformToFill"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Source" Binding="{Binding SourceLabel}" Width="1.2*" MinWidth="130" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn x:Name="TicketColumn" Header="Ticket" Binding="{Binding TicketLabel}" Width="0.9*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="File" Binding="{Binding Attachment.FileName}" Width="1.4*" MinWidth="140" IsReadOnly="True" ElementStyle="{StaticResource CellText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCount"
                               Grid.Column="0"
                               FontSize="11.5" Foreground="#7A8A9A"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="None" Style="{StaticResource SecBtn}" Margin="0,0,8,0" Click="BtnNone_Click"/>
                        <Button Content="Select All" Style="{StaticResource SecBtn}" Margin="0,0,8,0" Click="BtnSelectAll_Click"/>
                        <Button Content="Continue" Style="{StaticResource PrimaryBtn}" Click="BtnContinue_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
