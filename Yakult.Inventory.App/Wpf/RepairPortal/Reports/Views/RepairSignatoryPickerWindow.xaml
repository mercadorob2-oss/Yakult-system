<Window x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Reports.Views.RepairSignatoryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Signatories" Height="720" Width="1250" MinWidth="1250" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="#F1F5F9">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8FAFC" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Select Signatories" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Choose the people who will sign — each item set below shows exactly what it's for."
                           FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowDivider}" Value="True">
                                            <Setter Property="BorderBrush" Value="#1E293B"/>
                                            <Setter Property="BorderThickness" Value="1,1,1,3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding GroupLabel}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8"/>

                                <!-- Item table shown ONCE per group, even when several roles
                                     (Reviewed By, Received By, …) need to sign against it. -->
                                <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource ListDataGridChrome}"
                                          MaxHeight="220" Margin="0,0,0,14">
                                    <DataGrid.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="2*"/>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                        <DataGridTextColumn Header="Reported Problem" Binding="{Binding Problem}" Width="3*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Prepared By — always the current signed-in technician, shown read-only so
                                     it's visible up front instead of only appearing once the report itself is
                                     generated. Not part of the Roles list since it's fixed, not pickable. -->
                                <Border BorderBrush="#EEF1F4" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Prepared By" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" TextWrapping="Wrap"/>
                                            <TextBlock Text="Reporting technician" FontStyle="Italic" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Employee" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3"/>
                                            <Border Height="30" Padding="6,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <TextBlock Text="{Binding DataContext.PreparedByName, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           VerticalAlignment="Center" Foreground="#334155"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Title / Designation" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3"/>
                                            <Border Height="30" Padding="6,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <TextBlock Text="{Binding DataContext.PreparedByPosition, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           VerticalAlignment="Center" Foreground="#334155"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5">
                                            <TextBlock Text="Date Signed" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3"/>
                                            <Border Height="30" Padding="6,5" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                                <TextBlock Text="{Binding DataContext.PreparedByDateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           VerticalAlignment="Center" Foreground="#334155"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- One picker row per role that signs for this same item set. -->
                                <ItemsControl ItemsSource="{Binding Roles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEF1F4" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                                              <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding RoleName}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Hint}" FontStyle="Italic" FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Employee" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3"/>
                                                        <Grid>
                                                            <TextBox x:Name="EmployeeBox" Height="30" Padding="6,5" VerticalContentAlignment="Center"
                                                                     Text="{Binding EmployeeText, UpdateSourceTrigger=PropertyChanged}"
                                                                     IsEnabled="{Binding IsEditable}"
                                                                     TextChanged="EmployeeBox_TextChanged"
                                                                     GotFocus="EmployeeBox_GotFocus"/>
                                                            <Popup x:Name="EmployeePopup" PlacementTarget="{Binding ElementName=EmployeeBox}"
                                                                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                                                   Width="{Binding ActualWidth, ElementName=EmployeeBox}">
                                                                <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
                                                                    <ListBox x:Name="EmployeeListBox" MaxHeight="220" BorderThickness="0"
                                                                             DisplayMemberPath="Display"
                                                                             PreviewMouseLeftButtonUp="EmployeeListBox_PreviewMouseLeftButtonUp"/>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3">
                                                        <TextBlock Text="Title / Designation" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3"/>
                                                        <TextBox Height="30" Padding="6,5" VerticalContentAlignment="Center"
                                                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                                 IsEnabled="{Binding IsEditable}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="5">
                                                        <TextBlock Text="Date Signed" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="2,0,0,3"/>
                                                        <DatePicker Height="30" Padding="6,3" VerticalContentAlignment="Center"
                                                                    SelectedDate="{Binding SignedDate, UpdateSourceTrigger=PropertyChanged}"
                                                                    IsEnabled="{Binding IsEditable}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Locked state — this role already has a signature recorded from a
                                                     previous report; fields above are read-only until Edit is clicked. -->
                                                <Border Margin="0,8,0,0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,7">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="10.5" Foreground="#1E40AF" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Text="This repair report has already been printed, and this signatory has been recorded. Click Edit only if you made a mistake."/>
                                                        <Button Grid.Column="1" Content="Edit" Width="70" Height="26" Margin="10,0,0,0"
                                                                Click="UnlockRole_Click"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Shown for the entire time a HasPriorRecord role stays unlocked — Revert/Save
                                                     are always both present together here, not conditional on whether anything
                                                     was actually changed yet, so they never disappear mid-edit. Neither one
                                                     writes to the database by itself — that only happens once the whole dialog
                                                     is confirmed via Add to Report/Skip in RepairReportBuilder. -->
                                                <Border Margin="0,8,0,0" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="10,7">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding HasPriorRecord}" Value="True"/>
                                                                        <Condition Binding="{Binding IsLocked}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="10.5" Foreground="#92400E" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                   Text="Editing these details will change what's recorded in the database — only do this if you made a mistake."/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                            <Button Content="Revert" Width="70" Height="26" Margin="0,0,6,0" Click="RevertRole_Click"
                                                                    ToolTip="Discard changes and restore what was recorded last time"/>
                                                            <Button Content="Save" Width="70" Height="26" Click="SaveRole_Click"
                                                                    ToolTip="Keep these changes and lock the field again"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <!-- Non-blocking hint — only shown when a prefilled
                                                     field was edited away from what was recorded on
                                                     this ticket's last printed report. Add to
                                                     Report/Skip both still work regardless. -->
                                                <TextBlock Margin="0,6,0,0" FontSize="10.5" Foreground="#B45309">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasChangedFromOriginal}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="⚠ Differs from the last printed report — "/>
                                                    <Run Text="{Binding OriginalSummaryText, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </TextBlock>
                                              </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#F8FAFC" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Width="90" Height="34" Click="Cancel_Click"
                        ToolTip="Abort — don't generate the report at all"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Skip" Width="90" Height="34" Margin="0,0,10,0" Click="Skip_Click"
                            ToolTip="Generate the report without any signatures — leaves them blank for physical fill-in"/>
                    <Button Content="Add to Report" Width="140" Height="34"
                            Background="#4E9AFC" Foreground="White" BorderThickness="0" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
