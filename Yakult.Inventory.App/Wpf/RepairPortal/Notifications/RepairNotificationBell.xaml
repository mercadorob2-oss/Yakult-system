<UserControl x:Class="Yakult.Inventory.App.Wpf.RepairPortal.Notifications.RepairNotificationBell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yakult.Inventory.App.Wpf.RepairPortal"
             VerticalAlignment="Center">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/RepairPortal/RepairPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Bell button — matches the shell header's HamburgerButton treatment
                 (transparent, dark slate glyph, hand cursor, subtle hover). -->
            <Style x:Key="BellToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Width="36" Height="36">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                           Foreground="{TemplateBinding Foreground}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Text-only action links in the panel header. -->
            <Style x:Key="PanelLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.7"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="NotificationItemTemplate">
                <Border x:Name="RowBd" Background="Transparent" Padding="14,11" Cursor="Hand"
                        BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                Background="{Binding IconBackground}" VerticalAlignment="Top" Margin="0,1,10,0">
                            <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{Binding IconForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="#64748B"
                                       TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding TimeAgo}" FontSize="10.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{StaticResource RepairRedBrush}"
                                 VerticalAlignment="Top" Margin="8,6,0,0"
                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsUnread}" Value="True">
                        <!-- Barely-there warm tint for unread rows — the red unread dot is the
                             primary signal; this is just a faint wash, not a beige block. -->
                        <Setter TargetName="RowBd" Property="Background" Value="#FFFCF7"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="BellButton" Style="{StaticResource BellToggleStyle}"
                      IsChecked="{Binding IsDropdownOpen, Mode=TwoWay}"
                      ToolTip="Notifications"/>

        <!-- Unread badge — overlaps the bell's top-right. -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                MinWidth="17" Height="17" CornerRadius="8.5" Padding="4,0"
                Background="{StaticResource RepairRedBrush}"
                Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Popup IsOpen="{Binding IsDropdownOpen, Mode=TwoWay}" StaysOpen="False"
               PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
               HorizontalOffset="-324" VerticalOffset="8" AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="12"
                    Width="360" Margin="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Identity stripe — same red/blue split as the shell header. -->
                    <Grid Grid.Row="0" Height="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{StaticResource RepairRedBrush}"/>
                        <Rectangle Grid.Column="1" Fill="{StaticResource RepairAccentBrush}"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="16,13,16,10">
                        <TextBlock Text="Notifications" FontSize="14" FontWeight="Bold" Foreground="#0F172A"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Mark all read" Style="{StaticResource PanelLinkButton}"
                                    Foreground="{StaticResource RepairRedBrush}"
                                    Command="{Binding MarkAllReadCommand}"
                                    Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="&#160;&#160;" Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="Clear all" Style="{StaticResource PanelLinkButton}"
                                    Foreground="#64748B" Command="{Binding ClearAllCommand}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Items}"
                                          ItemTemplate="{StaticResource NotificationItemTemplate}"
                                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityInverseConverter}}"/>
                            <StackPanel Margin="16,36" HorizontalAlignment="Center"
                                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="&#xEA92;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                           Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                <TextBlock Text="No notifications yet" FontSize="12" Foreground="#94A3B8"
                                           Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
