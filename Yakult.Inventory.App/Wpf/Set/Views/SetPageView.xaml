<UserControl x:Class="Yakult.Inventory.App.WPF.Set.Views.SetPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToCardBrushConverter x:Key="BoolToCardBrush"/>
            <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="WrappedCenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ActionIconButton" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="2,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- ══ Page-local redesign styles (Sets page only — not shared) ═══════ -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>

            <Style x:Key="StatCardShell" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="7"/>
                <Setter Property="Margin"          Value="0,0,8,0"/>
                <Setter Property="Width"           Value="112"/>
                <Setter Property="Height"          Value="44"/>
                <Setter Property="Cursor"          Value="Hand"/>
            </Style>

            <Style x:Key="StatValueText" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="StatLabelText" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="7"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin"          Value="0"/>
            </Style>

            <Style x:Key="OutlineAccentBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"  Value="White"/>
                <Setter Property="Foreground"  Value="#27AE60"/>
                <Setter Property="BorderBrush" Value="#27AE60"/>
            </Style>

            <Style x:Key="SetsGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListDataGridColumnHeader}">
                <Setter Property="Background"  Value="#6FAEFB"/>
                <Setter Property="BorderBrush" Value="#5FA0F2"/>
            </Style>

            <Style x:Key="SetsGridColumnHeaderCentered" TargetType="DataGridColumnHeader" BasedOn="{StaticResource SetsGridColumnHeader}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SetsGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ListDataGridCell}">
                <Setter Property="Padding" Value="10,9"/>
            </Style>

            <Style x:Key="SetsSelectColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource SelectColumnHeader}">
                <Setter Property="Background"  Value="#6FAEFB"/>
                <Setter Property="BorderBrush" Value="#5FA0F2"/>
            </Style>

            <!-- Row highlighting for invoice-type sets (light yellow) and archived sets (light
                 gray) — archived wins when a row is both, since "Show Archives" implies the row
                 is no longer active. -->
            <Style x:Key="SetsGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource AltRowBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                        <Setter Property="Background" Value="#E6E6E6"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverRowBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource SelectedRowBrush}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="IsMouseOver" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource SelectedHoverRowBrush}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,20,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header: title (left) + compact clickable summary cards (right) ═ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#E9F2FF" Margin="0,0,12,0">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Manage Sets" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Browse, dispatch, archive, and report on sets" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsAllCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#4E9AFC"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueText}" Foreground="#4E9AFC"/>
                            <TextBlock Text="TOTAL" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsExpiredCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ExpiredCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#E74C3C"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource StatValueText}" Foreground="#E74C3C"/>
                            <TextBlock Text="EXPIRED" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsWithQrCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding WithQrCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#2ECC71"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding WithQrCount}" Style="{StaticResource StatValueText}" Foreground="#2ECC71"/>
                            <TextBlock Text="WITH QR" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsHardwareCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding HardwareCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#3498DB"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding HardwareCount}" Style="{StaticResource StatValueText}" Foreground="#3498DB"/>
                            <TextBlock Text="HARDWARE" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsSoftwareLicenseCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding SoftwareLicenseCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#9B59B6"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding SoftwareLicenseCount}" Style="{StaticResource StatValueText}" Foreground="#9B59B6"/>
                            <TextBlock Text="SOFTWARE/LIC." Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Margin="0" Background="{Binding IsServicesCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ServicesCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#1ABC9C"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ServicesCount}" Style="{StaticResource StatValueText}" Foreground="#1ABC9C"/>
                            <TextBlock Text="SERVICES" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ Action bar: primary actions + Search + Advanced Filters (left), Refresh (right) ═ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,0,0,20">
            <Grid IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddCommand}">
                        <TextBlock Text="➕  Add Set"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding OpenSelectedCommand}">
                        <TextBlock Text="🔍  Open"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding BulkArchiveCommand}">
                        <TextBlock Text="📦  Archive Selected"/>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}" Command="{Binding BulkDeleteCommand}">
                        <TextBlock Text="🗑  Delete"/>
                    </Button>
                    <Button Style="{StaticResource OutlineAccentBtn}" Command="{Binding GenerateReportCommand}">
                        <TextBlock Text="📄  Generate Report"/>
                    </Button>
                    <shared:SelectedCountBadge Count="{Binding SelectedCount}" EntityLabel="sets"
                                                Click="SelectedBadge_Click" Margin="0,0,16,8"/>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding BulkAddFilesCommand}" Margin="0,0,16,8">
                        <TextBlock Text="📁  Bulk Add Files"/>
                    </Button>

                    <!-- Search -->
                    <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                            CornerRadius="5" Background="White" Height="30" Width="220" Margin="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#7A8A9A"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="11"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Set Code, Document #, Reference #, Status, Serial #, Item, Created By..."/>
                        </Grid>
                    </Border>

                    <!-- Advanced Filters -->
                    <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                  Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                    <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                           IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                           HorizontalOffset="-830" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                CornerRadius="8" Padding="18" Width="960">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                                <StackPanel>

                                <!-- Row 1: Filter By / Sort By -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Filter By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding FilterByOptions}"
                                                  SelectedItem="{Binding SelectedFilterBy, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SortByCombo" Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding SortByOptions}"
                                                  SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Category -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Category" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ToggleButton x:Name="CategoryFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                                  HorizontalAlignment="Stretch" Content="{Binding CategoryFilterSummary}"/>
                                    <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                                           IsOpen="{Binding IsChecked, ElementName=CategoryFilterToggle, Mode=TwoWay}"
                                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                                CornerRadius="4" Padding="8" MinWidth="200">
                                            <StackPanel>
                                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          Padding="4,0" Margin="2,4" FontSize="11"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <Separator Margin="0,6,0,4"/>
                                                <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                        Style="{StaticResource SmallBtn}" Margin="0"
                                                        Command="{Binding ClearCategoryFilterCommand}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- Row 3: Created From / To -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Created From" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="To" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Set Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Document #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Company" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="6">
                                        <TextBlock Text="Department" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="8">
                                        <TextBlock Text="Branch" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="10">
                                        <TextBlock Text="Employee" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 2: Reference Code | Parent Tag -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Reference Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Parent Tag" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Req ID -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Req ID" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                </StackPanel>
                                </ScrollViewer>

                                <Separator Margin="0,2,0,12"/>

                                <!-- Row 4: Show Archives + Reset Filters -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <CheckBox Content="Show Archives" VerticalAlignment="Center"
                                                  IsChecked="{Binding ShowArchived, Mode=TwoWay}"/>
                                        <CheckBox Content="Show Consumable Items" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  Visibility="{Binding IsConsumableFilterAvailable, Converter={StaticResource BoolToVis}}"
                                                  IsChecked="{Binding ShowConsumableItemsOnly, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                        <TextBlock Text="↺  Reset Filters"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <!-- "Did you mean...?" banner — only shown when these rows came from the fuzzy fallback
             (FuzzyMatchSets) rather than an exact search-text match, so typo-corrected guesses
             are never presented as if they were literal hits. -->
        <Border Grid.Row="2" Padding="14,9" Margin="0,0,0,10"
                Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#7A5C00" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,20">
            <DataGrid x:Name="SetsGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      ColumnHeaderStyle="{StaticResource SetsGridColumnHeader}"
                      CellStyle="{StaticResource SetsGridCell}"
                      MinRowHeight="42"
                      RowStyle="{StaticResource SetsGridRowStyle}"
                      IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Sorting="SetsGrid_Sorting">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="60" MinWidth="60" CanUserSort="False" HeaderStyle="{StaticResource SetsSelectColumnHeader}" CellStyle="{StaticResource SelectColumnCell}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.SelectAllState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Mode=OneWay + explicit Click: a DataGridTemplateColumn CheckBox's
                                     TwoWay IsChecked binding does not reliably commit back to the row
                                     when clicked (WPF DataGridCell/virtualization quirk) — the box
                                     visually toggles but the bound property never updates. Reading the
                                     toggled state explicitly in Click and writing it back manually
                                     works reliably. -->
                                <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Set Code" Binding="{Binding SetCode}" SortMemberPath="SetCode" Width="1.1*" MinWidth="90" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SetType}" SortMemberPath="SetType" Width="*" MinWidth="90" HeaderStyle="{StaticResource SetsGridColumnHeaderCentered}" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Categories" Binding="{Binding CategoriesText}" CanUserSort="False" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding SetStatus}" SortMemberPath="SetStatus" Width="*" MinWidth="100" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" SortMemberPath="CreatedByName" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat='MM/dd/yyyy HH:mm'}" SortMemberPath="CreatedAt" Width="1.1*" MinWidth="130" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Date Requested" Binding="{Binding DateRequested, StringFormat='MM/dd/yyyy'}" SortMemberPath="DateRequested" Width="1.1*" MinWidth="115" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Earliest Purchase Date" Binding="{Binding EarliestItemPurchaseDate, StringFormat='MM/dd/yyyy'}" SortMemberPath="EarliestItemPurchaseDate" Width="1.1*" MinWidth="130" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Latest Purchase Date" Binding="{Binding LatestItemPurchaseDate, StringFormat='MM/dd/yyyy'}" SortMemberPath="LatestItemPurchaseDate" Width="1.1*" MinWidth="125" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Item Count" Binding="{Binding ItemCount}" SortMemberPath="ItemCount" Width="0.8*" MinWidth="80" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Employee" Binding="{Binding CurrentEmployeeName}" SortMemberPath="CurrentEmployeeName" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Employee #" Binding="{Binding CurrentEmployeeNumber}" SortMemberPath="CurrentEmployeeNumber" Width="*" MinWidth="100" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CurrentCompanyName}" SortMemberPath="CurrentCompanyName" Width="1.1*" MinWidth="110" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Branch" Binding="{Binding CurrentBranchName}" SortMemberPath="CurrentBranchName" Width="1.1*" MinWidth="105" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding CurrentDepartmentName}" SortMemberPath="CurrentDepartmentName" Width="1.1*" MinWidth="115" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Expiry" Binding="{Binding EffectiveExpiry, StringFormat='MM/dd/yyyy'}" SortMemberPath="EffectiveExpiry" Width="*" MinWidth="110" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Days Left" Binding="{Binding DaysLeft}" SortMemberPath="DaysLeft" Width="0.8*" MinWidth="80" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="QR Image" Binding="{Binding QRImageDisplay}" SortMemberPath="QRImagePath" Width="1.4*" MinWidth="150" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" SortMemberPath="Remarks" Width="1.4*" MinWidth="140" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Footer / paging ══════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="Transparent" Padding="0,0,0,16">
            <shared:PagingControl HorizontalAlignment="Left"
                                   FirstPageCommand="{Binding FirstPageCommand}"
                                   PrevPageCommand="{Binding PrevPageCommand}"
                                   NextPageCommand="{Binding NextPageCommand}"
                                   LastPageCommand="{Binding LastPageCommand}"
                                   PageInfoText="{Binding PageInfoText}"/>
        </Border>
    </Grid>
</UserControl>
