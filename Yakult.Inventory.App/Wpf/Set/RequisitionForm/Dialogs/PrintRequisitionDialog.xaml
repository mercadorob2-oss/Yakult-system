<Window x:Class="Yakult.Inventory.App.WPF.Set.RequisitionForm.Dialogs.PrintRequisitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Requisition Form"
        Width="920" Height="980"
        MinWidth="700" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F6">
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PageSizeOption" TargetType="RadioButton">
            <Setter Property="GroupName" Value="PageSize"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CopyCountOption" TargetType="RadioButton" BasedOn="{StaticResource PageSizeOption}">
            <Setter Property="GroupName" Value="CopyCount"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Print Requisition Form"
                               FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1A2340"/>
                    <TextBlock Text="Review the requisition form below before printing."
                               FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A6380"
                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Page size:" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#5A6380"
                                   Margin="0,0,10,0"/>
                        <RadioButton x:Name="_letterRadio" Content="Letter" Tag="Letter"
                                     Style="{StaticResource PageSizeOption}"
                                     IsChecked="True" Checked="OnPageSizeChanged"/>
                        <RadioButton x:Name="_legalRadio" Content="Legal" Tag="Legal"
                                     Style="{StaticResource PageSizeOption}"
                                     Checked="OnPageSizeChanged"/>
                        <RadioButton x:Name="_a4Radio" Content="A4" Tag="A4"
                                     Style="{StaticResource PageSizeOption}" Margin="0"
                                     Checked="OnPageSizeChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <TextBlock Text="Copies:" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#5A6380"
                                   Margin="0,0,10,0"/>
                        <RadioButton x:Name="_oneCopyRadio" Content="1 copy" Tag="1"
                                     Style="{StaticResource CopyCountOption}"
                                     Checked="OnCopyCountChanged"/>
                        <RadioButton x:Name="_twoCopyRadio" Content="2 copies" Tag="2"
                                     Style="{StaticResource CopyCountOption}" Margin="0"
                                     IsChecked="True" Checked="OnCopyCountChanged"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Print Preview ───────────────────────────────────────────────── -->
        <Border Grid.Row="1" Margin="16" Background="#F0F2F6"
                BorderBrush="#DDE1E8" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border Background="White" BorderBrush="#CCC" BorderThickness="1" Margin="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox x:Name="_previewBox" Stretch="Uniform" Margin="6">
                        <ContentControl x:Name="_pageHost"/>
                    </Viewbox>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ── Footer ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionBtn}"
                        Content="Skip for Now"
                        Background="White" Foreground="#444"
                        BorderBrush="#CCC"
                        Margin="0,0,10,0"
                        Click="OnSkip"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Print as PDF"
                        Background="White" Foreground="#444"
                        BorderBrush="#CCC"
                        Margin="0,0,10,0"
                        Click="OnPrintAsPdf"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Print"
                        Background="#4E9AFC" Foreground="White"
                        BorderBrush="#3D86E0"
                        Click="OnPrint"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
