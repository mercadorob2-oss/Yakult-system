<UserControl x:Class="Yakult.Inventory.App.WPF.Set.RequisitionForm.Views.RequisitionFormPrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.Set.RequisitionForm.Converters"
             x:Name="Root"
             FontFamily="Times New Roman"
             FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=14.7}"
             Background="White">

    <StackPanel Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='20,16,20,16'}">

        <!-- Company header -->
        <StackPanel HorizontalAlignment="Center"
                    Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,0,0,10'}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox IsChecked="{Binding IsYakultPhilippines, Mode=OneWay}"
                          IsHitTestVisible="False" VerticalAlignment="Center"/>
                <TextBlock Text="  YAKULT PHILIPPINES INC." VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <CheckBox IsChecked="{Binding IsYakultMarketing, Mode=OneWay}"
                          IsHitTestVisible="False" VerticalAlignment="Center"/>
                <TextBlock Text="  YAKULT MARKETING CORP." VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <CheckBox IsChecked="{Binding IsYakultElSalvador, Mode=OneWay}"
                          IsHitTestVisible="False" VerticalAlignment="Center"/>
                <TextBlock Text="  YAKULT EL SALVADOR MANUFACTURING CORP." VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="REQUISITION FORM" FontWeight="Bold"
                   FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=21.3}"
                   HorizontalAlignment="Center"
                   Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,0,0,16'}"/>

        <!-- DEPARTMENT / DATE / EMPLOYEE -->
        <Grid Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,0,0,12'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="DEPARTMENT:  " VerticalAlignment="Bottom"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1" MinWidth="220">
                    <TextBlock Text="{Binding Department, TargetNullValue=''}" VerticalAlignment="Bottom" Padding="0,0,0,1"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="DATE :  " VerticalAlignment="Bottom"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1" MinWidth="110">
                    <TextBlock Text="{Binding Date, TargetNullValue=''}" VerticalAlignment="Bottom" Padding="0,0,0,1"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                        Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,6,0,0'}">
                <TextBlock Text="EMPLOYEE:  " VerticalAlignment="Bottom"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1" MinWidth="220">
                    <TextBlock Text="{Binding Employee, TargetNullValue=''}" VerticalAlignment="Bottom" Padding="0,0,0,1"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- QUANTITY / DESCRIPTION / REMARKS table -->
        <!-- MinHeight makes the table dominate the form like the original blank pad
             (see reference PDF) instead of shrinking to just fit whatever few rows of
             data exist. Sized so a typical short list (1-3 items) still fits within one
             half of a Letter page without triggering the shrink-to-fit font scale. -->
        <Border BorderBrush="Black" BorderThickness="1"
                MinHeight="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=215}"
                Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,0,0,4'}">
            <!-- Grid (not StackPanel) so the middle row can absorb whatever height the
                 MinHeight above reserves beyond the actual item rows, leaving that extra
                 space as one blank, undivided area (no column rules drawn into it, same
                 as the reference form) and docking "cc: ITD/Requested by" to the very
                 bottom of the table, flush above the border, instead of it trailing
                 right after the last item row. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,1"
                            Padding="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,3,4,3'}">
                        <TextBlock Text="QUANTITY" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1"
                            Padding="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,3,4,3'}">
                        <TextBlock Text="DESCRIPTION" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,1"
                            Padding="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,3,4,3'}">
                        <TextBlock Text="REMARKS" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <ItemsControl Grid.Row="1" VerticalAlignment="Top" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=26}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,1"
                                        Padding="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,3,4,3'}">
                                    <TextBlock Text="{Binding Quantity, TargetNullValue=''}" HorizontalAlignment="Center"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1"
                                        Padding="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,3,4,3'}">
                                    <TextBlock Text="{Binding Description, TargetNullValue=''}" TextWrapping="Wrap"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,1"
                                        Padding="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,3,4,3'}">
                                    <TextBlock Text="{Binding Remarks, TargetNullValue=''}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2"
                           Text="{Binding CcRequestedBy, StringFormat='cc: ITD/Requested by ({0})', TargetNullValue='cc: ITD/Requested by ()'}"
                           FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=12}"
                           Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='4,4,0,4'}"/>
            </Grid>
        </Border>

        <!-- Signature block: PREPARED BY / NOTED BY / APPROVED BY / RECEIVED BY.
             Set one size on the Grid so every label and signatory name inside
             inherits it, a step up from the body text. -->
        <Grid TextElement.FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=16.5}"
              Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,20,0,0'}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="PREPARED BY:" FontWeight="Bold"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1"
                        Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,26,0,4'}"/>
                <TextBlock Text="{Binding PreparedByName, TargetNullValue=''}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding PreparedByPosition, TargetNullValue=''}" Foreground="#333"
                           FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=13.5}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="NOTED BY:" FontWeight="Bold"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1"
                        Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,26,0,4'}"/>
                <TextBlock Text="{Binding NotedByName, TargetNullValue=''}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NotedByPosition, TargetNullValue=''}" Foreground="#333"
                           FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=13.5}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                <TextBlock Text="APPROVED BY:" FontWeight="Bold"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1"
                        Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,26,0,4'}"/>
                <TextBlock Text="{Binding ApprovedByName, TargetNullValue=''}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ApprovedByPosition, TargetNullValue=''}" Foreground="#333"
                           FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=13.5}"/>
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="RECEIVED BY :" FontWeight="Bold"/>
                <Border BorderBrush="Black" BorderThickness="0,0,0,1"
                        Margin="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleThicknessConverter.Instance}, ConverterParameter='0,26,0,4'}"/>
                <TextBlock Text="{Binding ReceivedByLabel, TargetNullValue=''}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ReceivedByPosition, TargetNullValue=''}" Foreground="#333"
                           FontSize="{Binding FontScale, ElementName=Root, Converter={x:Static conv:ScaleDoubleConverter.Instance}, ConverterParameter=13.5}"/>
            </StackPanel>
        </Grid>

    </StackPanel>
</UserControl>
