<UserControl x:Class="Yakult.Inventory.App.WPF.Branch.Views.BranchPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Branch.Views"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToCheckmarkConverter x:Key="BoolToCheckmark"/>
            <conv:BoolToCardBrushConverter x:Key="BoolToCardBrush"/>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header: title (left) + compact summary cards (right) ═════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8CA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Branches" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Manage branch locations" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Style="{StaticResource StatCardClickable}" Cursor="Hand" Background="{Binding IsTotalCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatCardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardClickable}" Cursor="Hand" Background="{Binding IsFactoryCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding FactoryCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="FACTORY" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding FactoryCount}" Style="{StaticResource StatCardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardClickable}" Cursor="Hand" Background="{Binding IsDepotCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DepotCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="DEPOT" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DepotCount}" Style="{StaticResource StatCardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardClickable}" Cursor="Hand" Background="{Binding IsCenterCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding CenterCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="CENTER" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding CenterCount}" Style="{StaticResource StatCardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCardClickable}" Cursor="Hand" Margin="0" Background="{Binding IsDistributorCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DistributorCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="DISTRIBUTOR" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DistributorCount}" Style="{StaticResource StatCardValue}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Command="{Binding RefreshCommand}" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Toolbar: actions + search + Advanced Filters ════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBar}">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddCommand}">
                    <TextBlock Text="➕  Add Branch"/>
                </Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding EditCommand}">
                    <TextBlock Text="✎  Edit"/>
                </Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding ArchiveCommand}">
                    <TextBlock Text="📦  Archive"/>
                </Button>
                <Button Style="{StaticResource DangerBtn}" Command="{Binding DeleteCommand}" Margin="0,0,8,8">
                    <TextBlock Text="🗑  Delete"/>
                </Button>

                <shared:SelectedCountBadge Count="{Binding SelectedCount}" EntityLabel="branches"
                                            Click="SelectedBadge_Click" Margin="0,0,16,8"/>

                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#7A8A9A"/>
                <TextBox Style="{StaticResource SearchBox}" Width="260" Margin="0,0,8,8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Name, Description, Company, or Department..."/>

                <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                              Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                       IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                       StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Width="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Filter By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                      ItemsSource="{Binding FilterByOptions}"
                                      SelectedItem="{Binding SelectedFilterBy, Mode=TwoWay}"/>

                            <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                      ItemsSource="{Binding SortByOptions}"
                                      SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>

                            <Separator Margin="0,2,0,12"/>

                            <Button HorizontalAlignment="Right" Style="{StaticResource SmallBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                <TextBlock Text="↺  Reset Filters"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </WrapPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" Margin="14,0,14,0">
            <DataGrid x:Name="BranchesGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      IsReadOnly="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ItemsSource="{Binding PagedBranches}"
                      Sorting="BranchesGrid_Sorting"
                      MouseDoubleClick="BranchesGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource PrimaryHoverBrush}" BorderThickness="0,0,1,1">
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Select / deselect all rows on this page"
                                                          Click="SelectAllCheckBox_Click"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          Checked="RowSelectCheckBox_Changed"
                                          Unchecked="RowSelectCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ID" Binding="{Binding BranchId}" Width="55" SortMemberPath="BranchId"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.6*" MinWidth="140" SortMemberPath="Name"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" MinWidth="180" SortMemberPath="Description">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.3*" MinWidth="110" SortMemberPath="CompanyName"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="1.3*" MinWidth="110" SortMemberPath="DepartmentName"/>
                    <DataGridTextColumn Header="Factory" Binding="{Binding IsFactory, Converter={StaticResource BoolToCheckmark}}" Width="*" MinWidth="75" SortMemberPath="IsFactory"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Depot" Binding="{Binding IsDepot, Converter={StaticResource BoolToCheckmark}}" Width="*" MinWidth="70" SortMemberPath="IsDepot"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Center" Binding="{Binding IsCenter, Converter={StaticResource BoolToCheckmark}}" Width="*" MinWidth="70" SortMemberPath="IsCenter"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Region" Binding="{Binding CenterRegion}" Width="*" MinWidth="100" SortMemberPath="CenterRegion"/>
                    <DataGridTextColumn Header="Distributor" Binding="{Binding IsDistributor, Converter={StaticResource BoolToCheckmark}}" Width="*" MinWidth="85" SortMemberPath="IsDistributor"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Date Created" Binding="{Binding DateCreated, StringFormat=MM/dd/yyyy}" Width="*" MinWidth="110" SortMemberPath="DateCreated"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="1.2*" MinWidth="120" SortMemberPath="CreatedByName"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Pagination ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <shared:PagingControl HorizontalAlignment="Left"
                                   FirstPageCommand="{Binding FirstPageCommand}"
                                   PrevPageCommand="{Binding PrevPageCommand}"
                                   NextPageCommand="{Binding NextPageCommand}"
                                   LastPageCommand="{Binding LastPageCommand}"
                                   PageInfoText="{Binding PageInfoText}"/>
        </Border>
    </Grid>
</UserControl>
