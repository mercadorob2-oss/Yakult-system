<UserControl x:Class="Yakult.Inventory.App.WPF.InvoicePreparation.Views.InvoicePreparationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin"          Value="0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,20,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="34" Height="34" CornerRadius="8" Background="#E9F2FF" Margin="0,0,12,0">
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Invoice Sub Groups" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Sub-Type Groups staged from the Items Page, ready to be reviewed and invoiced" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding PreviewCommand}" Margin="0,0,8,8">
                        <TextBlock Text="👁  Preview Contents"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryBtn}" Command="{Binding CreateInvoiceCommand}" Margin="0,0,8,8">
                        <TextBlock Text="🧾  Create an Invoice From Them"/>
                    </Button>
                </WrapPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <ToggleButton x:Name="SubTypeFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                  Width="170" Content="{Binding SubTypeFilterSummary}"/>
                    <Popup PlacementTarget="{Binding ElementName=SubTypeFilterToggle}"
                           IsOpen="{Binding IsChecked, ElementName=SubTypeFilterToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                CornerRadius="4" Padding="8" MinWidth="170">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SubTypeFilterOptions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      Padding="4,0" Margin="2,4" FontSize="11"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="0,6,0,4"/>
                                <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                        Style="{StaticResource SmallBtn}" Margin="0"
                                        Command="{Binding ClearSubTypeFilterCommand}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource GhostBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabControl" Grid.Row="2" Background="Transparent" BorderThickness="0"
                    SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Not Completed">
                <Border Style="{StaticResource SectionCard}" Padding="0" Margin="0,12,0,0">
                    <DataGrid x:Name="NotCompletedGrid"
                              Style="{StaticResource ListDataGridChrome}"
                              MinRowHeight="40"
                              AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ItemsSource="{Binding NotCompletedGroups}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              MouseDoubleClick="GroupsGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" MinWidth="36" CanUserResize="False" CellStyle="{StaticResource SelectColumnCell}">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SelectColumnHeader}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridColumnHeader">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <CheckBox x:Name="SelectAllCheckBox" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="Select / deselect all groups"
                                                                  IsChecked="{Binding NotCompletedSelectAllState, Mode=OneWay}"
                                                                  Click="NotCompletedSelectAllCheckBox_Click"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Mode=OneWay + explicit Click: a DataGridTemplateColumn CheckBox's TwoWay
                                             binding does not reliably commit back to the row when clicked (same
                                             WPF quirk documented on InvoicePreparationDetailWindow) — read the
                                             toggled state explicitly and write it back manually. -->
                                        <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Sub-Type" Binding="{Binding SubType}" Width="1*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Reference Code / ID" Binding="{Binding ReferenceCode}" Width="1.2*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.2*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding BeginDate, StringFormat='MM/dd/yyyy'}" Width="0.9*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat='MM/dd/yyyy'}" Width="0.9*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Item Count" Binding="{Binding ItemCount}" Width="0.7*" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="0.9*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.8*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="Completed">
                <Border Style="{StaticResource SectionCard}" Padding="0" Margin="0,12,0,0">
                    <DataGrid x:Name="CompletedGrid"
                              Style="{StaticResource ListDataGridChrome}"
                              MinRowHeight="40"
                              AutoGenerateColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              ItemsSource="{Binding CompletedGroups}"
                              SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                              MouseDoubleClick="GroupsGrid_MouseDoubleClick">
                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" MinWidth="36" CanUserResize="False" CellStyle="{StaticResource SelectColumnCell}">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource SelectColumnHeader}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridColumnHeader">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <CheckBox x:Name="SelectAllCheckBox" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="Select / deselect all groups"
                                                                  IsChecked="{Binding CompletedSelectAllState, Mode=OneWay}"
                                                                  Click="CompletedSelectAllCheckBox_Click"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Sub-Type" Binding="{Binding SubType}" Width="1*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Reference Code / ID" Binding="{Binding ReferenceCode}" Width="1.2*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="1.2*" MinWidth="120" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding BeginDate, StringFormat='MM/dd/yyyy'}" Width="0.9*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat='MM/dd/yyyy'}" Width="0.9*" MinWidth="95" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Item Count" Binding="{Binding ItemCount}" Width="0.7*" MinWidth="80" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="0.9*" MinWidth="100" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.8*" MinWidth="90" IsReadOnly="True" ElementStyle="{StaticResource CenteredCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
