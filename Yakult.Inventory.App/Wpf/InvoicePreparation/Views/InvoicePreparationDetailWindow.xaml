<Window x:Class="Yakult.Inventory.App.WPF.InvoicePreparation.Views.InvoicePreparationDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview Contents" Height="600" Width="1300"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header (read-only) ═════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Sub-Type" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SubType}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="3" Text="Reference Code" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding ReferenceCode}" FontWeight="Bold" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="6" Text="Start" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="7" Text="{Binding BeginDate, StringFormat='MM/dd/yyyy'}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="9" Text="Status" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="10" Text="{Binding Status}" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Grid>
        </Border>

        <!-- ══ Items grid (read-only) ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,16">
            <DataGrid x:Name="ItemsGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      MinRowHeight="38"
                      IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      AutoGenerateColumns="False"
                      ItemsSource="{Binding Items}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Inventory Item" Binding="{Binding ItemName}" Width="1.3*" MinWidth="130"/>
                    <DataGridTextColumn Header="Item Type" Binding="{Binding ItemType}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.3*" MinWidth="130"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Serial Number" Binding="{Binding SerialNumber}" Width="*" MinWidth="110"/>
                    <DataGridTextColumn Header="Warranty Start" Binding="{Binding WarrantyStartDate, StringFormat='MM/dd/yyyy'}" Width="*" MinWidth="105"/>
                    <DataGridTextColumn Header="Warranty End" Binding="{Binding WarrantyEndDate, StringFormat='MM/dd/yyyy'}" Width="*" MinWidth="105"/>
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="0.6*" MinWidth="60"/>
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="0.7*" MinWidth="75"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=N2}" Width="0.8*" MinWidth="85"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="0.8*" MinWidth="85"/>
                    <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.2*" MinWidth="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Footer ══════════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SmallBtn}" Click="BtnClose_Click">
                <TextBlock Text="Close"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
