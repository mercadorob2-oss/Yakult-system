<UserControl x:Class="Yakult.Inventory.App.WPF.RepairedItems.Views.RepairedItemsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.RepairedItems.Views"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBooleanConverter x:Key="InverseBoolean"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <local:RepairStatusToBrushConverter x:Key="RepairStatusToBrush"/>
            <local:SpareToBrushConverter x:Key="SpareToBrush"/>
            <local:LocationToBrushConverter x:Key="LocationToBrush"/>
            <local:OriginToBrushConverter x:Key="OriginToBrush"/>

            <Style x:Key="TotalCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardClickable}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsTotalCardActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RepairedCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardClickable}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRepairedCardActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="UnrepairedCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardClickable}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnrepairedCardActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SpareCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardClickable}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSpareCardActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DamagedCardStyle" TargetType="Border" BasedOn="{StaticResource StatCardClickable}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDamagedCardActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header: title (left) + compact summary cards (right) ═════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Track repair status, spares, and item lifecycle decisions" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Style="{StaticResource TotalCardStyle}" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardClickCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatCardValue}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource RepairedCardStyle}" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding RepairedCardClickCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="REPAIRED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding RepairedCount}" Style="{StaticResource StatCardValue}" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource UnrepairedCardStyle}" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding UnrepairedCardClickCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="NEEDS REPAIR" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding UnrepairedCount}" Style="{StaticResource StatCardValue}" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SpareCardStyle}" Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SpareCardClickCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="SPARE" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SpareCount}" Style="{StaticResource StatCardValue}" Foreground="{StaticResource PrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DamagedCardStyle}" Cursor="Hand" Margin="0">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding DamagedCardClickCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="DAMAGED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding DamagedCount}" Style="{StaticResource StatCardValue}" Foreground="#E67E22"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Command="{Binding RefreshCommand}" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Toolbar: actions + search + Advanced Filters ════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBar}">
            <WrapPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}" VerticalAlignment="Center">
                <Button Style="{StaticResource SmallBtn}" Command="{Binding ViewHistoryCommand}"><TextBlock Text="🔧  Repair History"/></Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding MarkRepairedCommand}"><TextBlock Text="✅  Mark Repaired"/></Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding MarkUnrepairedCommand}"><TextBlock Text="❌  Mark Unrepaired"/></Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding MarkSpareCommand}"><TextBlock Text="🔁  Mark Spare"/></Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding DisposeCommand}"><TextBlock Text="🗑️  Dispose"/></Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding SellCommand}"><TextBlock Text="💰  Sell"/></Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding ExportCsvCommand}" Margin="0,0,16,8"><TextBlock Text="📄  Export CSV"/></Button>

                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#7A8A9A"/>
                <TextBox Style="{StaticResource SearchBox}" Width="240" Margin="0,0,8,8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by name, category, model, serial, condition, action..."/>

                <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                              Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                       IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                       StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                       HorizontalOffset="-910" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Width="960">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                            <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                            <StackPanel>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Repair" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding RepairStatusOptions}" SelectedItem="{Binding SelectedRepairStatus, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Condition" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding ConditionOptions}" SelectedItem="{Binding SelectedCondition, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Category" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Spare" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding SpareOptions}" SelectedItem="{Binding SelectedSpare, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Active" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding ActiveOptions}" SelectedItem="{Binding SelectedActive, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Location" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Origin" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding OriginOptions}" SelectedItem="{Binding SelectedOrigin, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" ItemsSource="{Binding SortByOptions}" SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Problems only" IsChecked="{Binding ProblemsOnly}"
                                      FontSize="11" Foreground="{StaticResource TextSubtleBrush}" Margin="0,0,0,12"/>

                            <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Set Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Document #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="Company" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="Department" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="8">
                                    <TextBlock Text="Branch" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="10">
                                    <TextBlock Text="Employee" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Row 2: Reference Code | Parent Tag -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Reference Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Parent Tag" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Req ID -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Req ID" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            </StackPanel>
                            </ScrollViewer>

                            <Separator Margin="0,2,0,12"/>

                            <Button HorizontalAlignment="Right" Style="{StaticResource SmallBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                <TextBlock Text="↺  Reset Filters"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </WrapPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <!-- "Did you mean...?" banner — only shown when these rows came from the fuzzy fallback
             (FuzzyMatchRepairedItems) rather than an exact search-text match, so typo-corrected
             guesses are never presented as if they were literal hits. -->
        <Border Grid.Row="2" Padding="14,9" Margin="14,0,14,10"
                Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#7A5C00" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" Margin="14,0,14,0">
            <DataGrid x:Name="ItemsGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      ItemsSource="{Binding PagedRows}"
                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      Sorting="ItemsGrid_Sorting">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy Serial" Command="{Binding CopySerialCommand}"/>
                        <Separator/>
                        <MenuItem Header="Open Repair History" Command="{Binding ViewHistoryCommand}"/>
                        <Separator/>
                        <MenuItem Header="Mark Repaired" Command="{Binding MarkRepairedCommand}"/>
                        <MenuItem Header="Mark Unrepaired" Command="{Binding MarkUnrepairedCommand}"/>
                        <MenuItem Header="Mark Spare" Command="{Binding MarkSpareCommand}"/>
                        <Separator/>
                        <MenuItem Header="Dispose" Command="{Binding DisposeCommand}"/>
                        <MenuItem Header="Sell" Command="{Binding SellCommand}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" MinWidth="44" CanUserResize="False" CanUserSort="False" HeaderStyle="{StaticResource SelectColumnHeader}" CellStyle="{StaticResource SelectColumnCell}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.SelectAllState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" MinWidth="160" SortMemberPath="Name">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" MinWidth="110" SortMemberPath="Category"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="*" MinWidth="110" SortMemberPath="ModelNumber"/>
                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="*" MinWidth="120" SortMemberPath="SerialNumber"/>
                    <DataGridTextColumn Header="Condition" Binding="{Binding ConditionName}" Width="*" MinWidth="100" SortMemberPath="ConditionName"/>
                    <DataGridTextColumn Header="Repair" Binding="{Binding NeedsRepairLabel}" Width="*" MinWidth="90" SortMemberPath="NeedsRepairLabel">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding NeedsRepairLabel, Converter={StaticResource RepairStatusToBrush}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Repairs" Binding="{Binding RepairCount}" Width="*" MinWidth="75" SortMemberPath="RepairCount"/>
                    <DataGridTextColumn Header="Last Action" Binding="{Binding LastRepairAction}" Width="2*" MinWidth="170" SortMemberPath="LastRepairAction"/>
                    <DataGridTextColumn Header="Last Repair" Binding="{Binding LastRepairAt, StringFormat=yyyy-MM-dd HH:mm}" Width="*" MinWidth="130" SortMemberPath="LastRepairAt"/>
                    <DataGridTextColumn Header="Origin" Binding="{Binding LastRepairOrigin}" Width="*" MinWidth="85" SortMemberPath="LastRepairOrigin">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding LastRepairOrigin, Converter={StaticResource OriginToBrush}}"/>
                                <Setter Property="ToolTip" Value="{Binding LastRepairSourceRaw, StringFormat='Source: {0}'}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Processed By" Binding="{Binding LastRepairProcessedByName}" Width="*" MinWidth="110" SortMemberPath="LastRepairProcessedByName"/>
                    <DataGridTextColumn Header="Remark" Binding="{Binding LastRepairRemarkOneLine}" Width="2*" MinWidth="180" SortMemberPath="LastRepairRemarkOneLine">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                <Setter Property="ToolTip" Value="{Binding LastRepairRemark}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Spare" Binding="{Binding SpareLabel}" Width="*" MinWidth="70" SortMemberPath="SpareLabel">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding SpareLabel, Converter={StaticResource SpareToBrush}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Location" Binding="{Binding LocationLabel}" Width="*" MinWidth="100" SortMemberPath="LocationLabel">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{Binding LocationLabel, Converter={StaticResource LocationToBrush}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Set" Binding="{Binding CurrentSetCode}" Width="*" MinWidth="100" SortMemberPath="CurrentSetCode"/>
                    <DataGridTextColumn Header="Stock" Binding="{Binding StockOnHand}" Width="*" MinWidth="70" SortMemberPath="StockOnHand"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Pagination ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource FooterBar}">
            <DockPanel LastChildFill="False">
                <shared:PagingControl DockPanel.Dock="Left"
                                       FirstPageCommand="{Binding FirstPageCommand}"
                                       PrevPageCommand="{Binding PrevPageCommand}"
                                       NextPageCommand="{Binding NextPageCommand}"
                                       LastPageCommand="{Binding LastPageCommand}"
                                       PageInfoText="{Binding PageInfoText}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
