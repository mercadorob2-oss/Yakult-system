<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.FulfilledCartridgeDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fulfilled Request Detail"
        Width="620" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F6">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4E9AFC"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#7A8A9A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="120"/>
        </Style>

        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Foreground"        Value="#1A2340"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping"      Value="Wrap"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#4E9AFC"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4E9AFC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Body -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Fulfilled Request Detail"
                           FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A2340"/>
                <TextBlock Text="Review the complete fulfilled request, including every cartridge model, before reprinting."
                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A6380"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Scrollable body ─────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!-- Request summary card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REQUEST SUMMARY" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Set Code" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtSetCode" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Fulfilled" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtFulfilledAt" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Requester" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtRequester" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Received By" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtReceivedBy" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Company" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtCompany" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Branch" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtBranch" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Department" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtDepartment" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="Total Issued Qty" Style="{StaticResource FormLabel}"/>
                                <TextBlock x:Name="TxtTotalIssuedQty" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Cartridge model lines card -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <StackPanel>
                        <TextBlock Text="CARTRIDGE MODELS REQUESTED" Style="{StaticResource SectionHeader}"
                                   Margin="16,12,16,8"/>

                        <DataGrid x:Name="ModelsGrid"
                                  Background="White"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF1F4"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  RowHeaderWidth="0"
                                  FontFamily="Segoe UI"
                                  FontSize="12"
                                  RowHeight="34"
                                  MaxHeight="260"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cartridge Model" Binding="{Binding CartridgeModel}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding"           Value="10,0,0,0"/>
                                            <Setter Property="FontWeight"        Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Requested Qty" Binding="{Binding RequestedQty}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Good Empty" Binding="{Binding GoodEmptyQty}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Damaged Empty" Binding="{Binding DamagedEmptyQty}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding"           Value="10,0,0,0"/>
                                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="TxtEmptyState"
                                   Text="No individual cartridge model lines were recorded for this request."
                                   FontFamily="Segoe UI" FontSize="11.5" Foreground="#7A8A9A"
                                   Margin="16,10,16,14" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource ActionBtn}" Click="OnClose"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
