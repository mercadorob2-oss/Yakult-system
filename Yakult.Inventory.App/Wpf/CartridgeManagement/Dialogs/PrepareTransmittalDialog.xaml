<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.PrepareTransmittalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prepare Transmittal Form"
        Width="580" Height="660"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F6">

    <Window.Resources>
        <!-- Section card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#DDE1E8"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="6"/>
            <Setter Property="Padding"          Value="16,12"/>
            <Setter Property="Margin"           Value="0,0,0,10"/>
        </Style>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#4E9AFC"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
        </Style>

        <!-- Form label -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Foreground"       Value="#444"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"            Value="120"/>
        </Style>

        <!-- Read-only value -->
        <Style x:Key="ReadOnlyValue" TargetType="TextBlock">
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Foreground"       Value="#1A2340"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TextBox input style -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="FontFamily"    Value="Segoe UI"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Height"        Value="32"/>
            <Setter Property="Padding"       Value="8,0"/>
            <Setter Property="BorderBrush"   Value="#C8CDD8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox input style -->
        <Style x:Key="ComboInput" TargetType="ComboBox">
            <Setter Property="FontFamily"    Value="Segoe UI"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Height"        Value="32"/>
            <Setter Property="BorderBrush"   Value="#C8CDD8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing"     Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll"        Value="True"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker style -->
        <Style x:Key="DateInput" TargetType="DatePicker">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Height"     Value="32"/>
        </Style>

        <!-- Action button style -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="MinWidth"    Value="110"/>
            <Setter Property="Padding"     Value="18,0"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Form (scrollable) -->
            <RowDefinition Height="Auto"/>  <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="Prepare Transmittal Form"
                           FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A2340"/>
                <TextBlock Text="Complete the fields below before generating the printable transmittal document."
                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A6380"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ── Scrollable form body ─────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>

                <!-- Request Summary card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="REQUEST SUMMARY" Style="{StaticResource SectionHeader}"/>

                        <!-- Company checkboxes -->
                        <TextBlock Text="Company:"
                                   FontFamily="Segoe UI" FontSize="11.5"
                                   Foreground="#666" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding IsYakultPhilippines}"
                                      FontFamily="Segoe UI" FontSize="12" Foreground="#1A2340"
                                      Content="Yakult Philippines Inc." Margin="0,0,20,0"
                                      VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding IsYakultMarketing}"
                                      FontFamily="Segoe UI" FontSize="12" Foreground="#1A2340"
                                      Content="Yakult Marketing Corp."
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Requester:" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding RequesterName}" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Branch:" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding BranchName}" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Department:" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding DepartmentName}" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Issued By:" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding IssuedBy}" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Model:" Style="{StaticResource FormLabel}"/>
                                <TextBlock Text="{Binding CartridgeModelLabel}" Style="{StaticResource ReadOnlyValue}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Signatures card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="SIGNATURES" Style="{StaticResource SectionHeader}"/>

                        <!-- Noted By -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Noted By"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="_notedByCombo"
                                      Style="{StaticResource ComboInput}"
                                      ItemsSource="{Binding NotedByView}"
                                      SelectedItem="{Binding SelectedNotedBy}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      IsTextSearchEnabled="False"
                                      TextBoxBase.TextChanged="OnNotedByTextChanged"/>
                        </StackPanel>

                        <!-- Approved By -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Approved By"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="_approvedByCombo"
                                      Style="{StaticResource ComboInput}"
                                      ItemsSource="{Binding ApprovedByView}"
                                      SelectedItem="{Binding SelectedApprovedBy}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      IsTextSearchEnabled="False"
                                      TextBoxBase.TextChanged="OnApprovedByTextChanged"/>
                        </StackPanel>

                        <!-- Approval Date -->
                        <StackPanel>
                            <TextBlock Text="Approval Date"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource DateInput}"
                                        SelectedDate="{Binding ApprovalDate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Receiver card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="RECEIVER" Style="{StaticResource SectionHeader}"/>

                        <!-- Received By -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Received By"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <ComboBox x:Name="_receivedByCombo"
                                      Style="{StaticResource ComboInput}"
                                      ItemsSource="{Binding ReceivedByView}"
                                      SelectedItem="{Binding SelectedReceivedBy}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      IsTextSearchEnabled="False"
                                      TextBoxBase.TextChanged="OnReceivedByTextChanged"/>
                        </StackPanel>

                        <!-- Received Date -->
                        <StackPanel>
                            <TextBlock Text="Received Date"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource DateInput}"
                                        SelectedDate="{Binding ReceivedDate}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notes card -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="NOTES" Style="{StaticResource SectionHeader}"/>

                        <!-- Remarks -->
                        <StackPanel>
                            <TextBlock Text="Remarks"
                                       FontFamily="Segoe UI" FontSize="11.5"
                                       Foreground="#666" Margin="0,0,0,4"/>
                            <TextBox Style="{StaticResource Input}"
                                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Height="64"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer buttons ──────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Skip to close without printing the transmittal."
                           FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                           Foreground="#999" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionBtn}"
                            Content="Cancel"
                            Background="White" Foreground="#444"
                            BorderBrush="#CCC"
                            Margin="0,0,8,0"
                            Click="OnCancel"/>
                    <Button Style="{StaticResource ActionBtn}"
                            Content="Skip"
                            Background="White" Foreground="#888"
                            BorderBrush="#CCC"
                            Margin="0,0,8,0"
                            Click="OnSkip"/>
                    <Button Style="{StaticResource ActionBtn}"
                            Content="Generate Preview"
                            Background="#4E9AFC" Foreground="White"
                            BorderBrush="#3D86E0"
                            Click="OnContinue"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
