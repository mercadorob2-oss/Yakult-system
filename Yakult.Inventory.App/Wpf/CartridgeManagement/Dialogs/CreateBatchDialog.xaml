<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.CreateBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Refill Batch"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F6">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="White">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="New Refill Batch"
                           FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#2A3A4A"/>
                <TextBlock Text="Select a vendor and the cartridge models to include in this batch."
                           FontFamily="Segoe UI" FontSize="12" Foreground="#7A8A9A" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Vendor -->
            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <TextBlock Text="REFILL VENDOR" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbVendor" Height="34" FontFamily="Segoe UI" FontSize="13"
                          BorderBrush="#DDE2E8" Background="White" VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Models -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="CARTRIDGE MODELS" Style="{StaticResource FieldLabel}" Margin="0" DockPanel.Dock="Left"/>
                    <TextBlock Text="check all that apply" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#9AA0A8" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                </DockPanel>
                <Border BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="4" MaxHeight="200">
                    <ListBox x:Name="ModelsList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="3" Margin="2,1">
                                                <ContentPresenter Margin="4,3"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F5F7FA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding ModelNumber}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          FontFamily="Segoe UI" FontSize="13" Foreground="#2A3A4A"
                                          Padding="6,0"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>

            <!-- Remarks -->
            <StackPanel Grid.Row="3" Margin="0,0,0,24">
                <TextBlock Text="REMARKS (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtRemarks" Height="68" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Segoe UI" FontSize="13"
                         BorderBrush="#DDE2E8" Padding="8,8"
                         VerticalContentAlignment="Top"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Background="#E8EBF0" Foreground="#3A4A5A"
                        Style="{StaticResource Btn}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button Content="+ Create Batch" Background="#1E9E5E"
                        Style="{StaticResource Btn}" Click="BtnCreate_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
