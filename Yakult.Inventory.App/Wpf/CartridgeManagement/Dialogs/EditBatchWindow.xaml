<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.EditBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Batch"
        Width="580" SizeToContent="Height" MaxHeight="760"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9AA0A8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="ReadOnlyBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4A5A6A"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ─── Header ─── -->
            <Grid Margin="28,24,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Edit Batch"
                               FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#2A3A4A"/>
                    <TextBlock x:Name="TxtSubtitle"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#7A8A9A" Margin="0,3,0,0"/>
                </StackPanel>
                <Border x:Name="StatusBadge" Grid.Column="1"
                        CornerRadius="11" Padding="12,5"
                        VerticalAlignment="Center" Background="#3A8EF6">
                    <TextBlock x:Name="TxtStatusBadge"
                               FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Border>
            </Grid>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,18,0,0"/>

            <!-- ─── Batch Information ─── -->
            <StackPanel Margin="28,16,28,0">
                <TextBlock Text="BATCH INFORMATION" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="BATCH ID" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtBatchId" Style="{StaticResource ReadOnlyBox}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ORIGINAL QTY" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtOriginalQty" Style="{StaticResource ReadOnlyBox}"/>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="PnlRemarks" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock Text="REMARKS" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtRemarks" Style="{StaticResource ReadOnlyBox}"/>
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,16,0,0"/>

            <!-- ─── Cartridge Models ─── -->
            <StackPanel Margin="28,16,28,0">
                <DockPanel>
                    <TextBlock Text="CARTRIDGE MODELS" Style="{StaticResource SectionLabel}"
                               DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0"/>
                    <Border x:Name="ModelCountBadge" DockPanel.Dock="Left"
                            Background="#EBF5FF" CornerRadius="8" Padding="7,2"
                            Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="TxtModelCount"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#3A8EF6"/>
                    </Border>
                </DockPanel>

                <TextBlock x:Name="TxtModelsLoading" Text="Loading cartridge models..."
                           FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                           Foreground="#9AA0A8" Margin="0,10,0,0"/>

                <Border x:Name="ModelsBorder" Margin="0,10,0,0"
                        BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="6"
                        Visibility="Collapsed">
                    <ItemsControl x:Name="ModelLinesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="14,11,14,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ModelNumber}"
                                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#2A3A4A" VerticalAlignment="Center"/>
                                        <!-- Sent count -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Sent "
                                                       FontFamily="Segoe UI" FontSize="11"
                                                       Foreground="#9AA0A8" VerticalAlignment="Center"/>
                                            <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{Binding SentQty}"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#3A8EF6"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- Returned count -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Returned "
                                                       FontFamily="Segoe UI" FontSize="11"
                                                       Foreground="#9AA0A8" VerticalAlignment="Center"/>
                                            <Border Background="#E8F5E9" CornerRadius="4" Padding="8,3">
                                                <TextBlock Text="{Binding ReturnedQty}"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#1E9E5E"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="#EEF1F4"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,16,0,0"/>

            <!-- ─── Refill Vendor ─── -->
            <StackPanel Margin="28,16,28,0">
                <TextBlock Text="REFILL VENDOR" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CmbVendor" Margin="0,8,0,0" Height="34"
                          FontFamily="Segoe UI" FontSize="13"
                          BorderBrush="#DDE2E8" Background="White"
                          VerticalContentAlignment="Center"/>
                <TextBlock x:Name="TxtVendorHint"
                           FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                           Foreground="#9AA0A8" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- ─── Transfer Cartridges (Active batches only) ─── -->
            <StackPanel x:Name="PnlTransfer" Margin="28,14,28,0" Visibility="Collapsed">
                <Rectangle Height="1" Fill="#EEF1F4"/>
                <StackPanel Margin="0,14,0,0">
                    <Button HorizontalAlignment="Left"
                            Content="⇄ Transfer Cartridges" Background="#1A7A6E"
                            Style="{StaticResource Btn}" Click="BtnTransferCartridges_Click"/>
                    <TextBlock Text="Move cartridges from this batch to another active batch."
                               FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                               Foreground="#9AA0A8" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,16,0,0"/>

            <!-- ─── Footer ─── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="28,14,28,24">
                <Button Content="Cancel" Background="#E8EBF0" Foreground="#3A4A5A"
                        Style="{StaticResource Btn}" Click="BtnCancel_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnSave" Content="Save Changes" Background="#3A8EF6"
                        Style="{StaticResource Btn}" Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
