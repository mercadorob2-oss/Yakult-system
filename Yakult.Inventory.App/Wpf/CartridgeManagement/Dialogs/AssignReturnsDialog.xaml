<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.AssignReturnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign Returns to Refill Batches"
        Width="920" Height="680"
        MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F4"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF2F7"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDEEFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>   <!-- Header bar -->
            <RowDefinition Height="70"/>   <!-- Step indicator -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="55"/>   <!-- Button bar -->
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="#3A8EF6">
            <TextBlock Text="Assign Returns to Refill Batches"
                       FontFamily="Segoe UI" FontSize="15" FontWeight="Bold"
                       Foreground="White" Margin="20,0,0,0"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Step indicator -->
        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <!-- Step 1 -->
                <Grid Width="30" Height="30">
                    <Ellipse x:Name="Dot1" Fill="#3A8EF6"/>
                    <TextBlock Text="1" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="Lbl1" Text="Select Returns"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           Foreground="#3A8EF6" Margin="8,0,0,0" VerticalAlignment="Center"/>

                <!-- Connector -->
                <Rectangle x:Name="Connector" Width="80" Height="2" Fill="#CCCCCC" Margin="16,0"/>

                <!-- Step 2 -->
                <Grid Width="30" Height="30">
                    <Ellipse x:Name="Dot2" Fill="#CCCCCC"/>
                    <TextBlock Text="2" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="Lbl2" Text="Assign Batch"
                           FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                           Foreground="#999999" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Content area (steps overlap, only one visible at a time) -->
        <Grid Grid.Row="2">

            <!-- ── STEP 1 ─────────────────────────────────────────────────── -->
            <Grid x:Name="Step1Panel" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top toolbar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Returned Empty Cartridges — Unassigned"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                   Foreground="#2A3A4A" VerticalAlignment="Center"/>
                        <Rectangle Grid.Column="1" Width="1" Height="20" Fill="#DDE2E8" Margin="16,0"/>
                        <TextBlock Grid.Column="2" Text="Filter by model:"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#7A8A9A"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="CmbModelFilter" Grid.Column="3" Width="220" Height="30"
                                  FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Left"
                                  SelectionChanged="CmbModelFilter_SelectionChanged"/>
                        <CheckBox x:Name="ChkSelectAll" Grid.Column="4" Content="Select All"
                                  FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"
                                  Margin="16,0,0,0" Checked="ChkSelectAll_CheckChanged"
                                  Unchecked="ChkSelectAll_CheckChanged"/>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid x:Name="ReturnsGrid" Grid.Row="1" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="RowCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ID" Binding="{Binding EmptyCartridgeId}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding CartridgeModel}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Condition" Binding="{Binding ConditionStatus}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedAtFormatted}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="2*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Status bar -->
                <Border Grid.Row="2" Background="White" BorderBrush="#EEF1F4" BorderThickness="0,1,0,0" Padding="16,6">
                    <TextBlock x:Name="TxtSelectionStatus" Text="0 rows selected • 0 units"
                               FontFamily="Segoe UI" FontSize="12" FontStyle="Italic" Foreground="#7A8A9A"/>
                </Border>
            </Grid>

            <!-- ── STEP 2 ─────────────────────────────────────────────────── -->
            <Grid x:Name="Step2Panel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Config section -->
                    <RowDefinition Height="*"/>     <!-- Model cards -->
                </Grid.RowDefinitions>

                <!-- Config section -->
                <Border Grid.Row="0" Background="White" BorderBrush="#EEF1F4"
                        BorderThickness="0,0,0,1" Padding="20,16">
                    <StackPanel>
                        <!-- Title + summary -->
                        <TextBlock Text="Assign to Refill Batch"
                                   FontFamily="Segoe UI" FontSize="14" FontWeight="Bold"
                                   Foreground="#2A3A4A" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtStep2Summary"
                                   FontFamily="Segoe UI" FontSize="12" Foreground="#5A7A9A"
                                   Margin="0,0,0,14"/>

                        <Rectangle Height="1" Fill="#EEF1F4" Margin="0,0,0,14"/>

                        <!-- Mode toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <RadioButton x:Name="RadNew" Content="Create New Batch"
                                         GroupName="BatchMode" IsChecked="True"
                                         FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                         Foreground="#2A3A4A" Margin="0,0,24,0"
                                         Checked="RadBatchMode_Changed"/>
                            <RadioButton x:Name="RadExisting" Content="Use Existing Active Batch"
                                         GroupName="BatchMode"
                                         FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                         Foreground="#2A3A4A"
                                         Checked="RadBatchMode_Changed"/>
                        </StackPanel>

                        <!-- Create New sub-section -->
                        <StackPanel x:Name="PnlNew" Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="REFILL VENDOR" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbVendor" Grid.Row="1" Grid.Column="0" Width="320" Height="34"
                                          FontFamily="Segoe UI" FontSize="13"
                                          BorderBrush="#DDE2E8" Background="White" VerticalContentAlignment="Center"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="REMARKS (OPTIONAL)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="TxtRemarks" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                         Height="34" FontFamily="Segoe UI" FontSize="13"
                                         BorderBrush="#DDE2E8" Padding="8,0"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Use Existing sub-section -->
                        <StackPanel x:Name="PnlExisting" Visibility="Collapsed">
                            <TextBlock Text="ACTIVE BATCH" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbExistingBatch" Height="34"
                                      FontFamily="Segoe UI" FontSize="13"
                                      BorderBrush="#DDE2E8" Background="White" VerticalContentAlignment="Center"/>
                            <TextBlock Text="Selected returns will be added to the chosen batch — no new batch will be created."
                                       FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                                       Foreground="#9AA0A8" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="#EEF1F4" Margin="0,14,0,6"/>
                        <TextBlock Text="MODELS TO ASSIGN" Style="{StaticResource FieldLabel}" Margin="0"/>
                    </StackPanel>
                </Border>

                <!-- Model cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,12,20,12">
                    <ItemsControl x:Name="ModelCards">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8F9FA" BorderBrush="#DDE2E8" BorderThickness="1"
                                        CornerRadius="6" Margin="0,0,0,8" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CartridgeModel}"
                                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#2A3A4A"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding RowCount, StringFormat={}{0} row(s)}"
                                                           FontFamily="Segoe UI" FontSize="12" Foreground="#7A8A9A"/>
                                                <TextBlock Text=" • " FontFamily="Segoe UI" FontSize="12" Foreground="#AABBCC"/>
                                                <TextBlock Text="{Binding TotalQty, StringFormat={}{0} unit(s)}"
                                                           FontFamily="Segoe UI" FontSize="12" Foreground="#7A8A9A"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Tag="{Binding CartridgeModelId}"
                                                Content="Remove" Height="28" Padding="10,0"
                                                FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                                Foreground="#C03020" Background="White"
                                                BorderBrush="#E0A090" BorderThickness="1"
                                                Cursor="Hand" VerticalAlignment="Center"
                                                Click="BtnRemoveModel_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FFF0EE"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Button bar -->
        <Border Grid.Row="3" Background="#F5F7FA" BorderBrush="#DDE2E8" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Button x:Name="BtnCancel" Content="Cancel" Background="#9AACBC" Foreground="White"
                        Style="{StaticResource Btn}" HorizontalAlignment="Left"
                        Click="BtnCancel_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="← Back" Background="#7A8A9A"
                            Style="{StaticResource Btn}" Visibility="Collapsed"
                            Margin="0,0,8,0" Click="BtnBack_Click"/>
                    <Button x:Name="BtnNext" Content="Next →" Background="#3A8EF6"
                            Style="{StaticResource Btn}"
                            Click="BtnNext_Click"/>
                    <Button x:Name="BtnConfirm" Content="Confirm Assignment" Background="#1E9E5E"
                            Style="{StaticResource Btn}" Visibility="Collapsed"
                            Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
