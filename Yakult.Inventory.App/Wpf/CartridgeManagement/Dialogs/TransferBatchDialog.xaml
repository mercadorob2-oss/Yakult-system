<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.TransferBatchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer to Another Batch"
        Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F6">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Border Background="White">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Transfer to Another Batch"
                           FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#2A3A4A"/>
            </StackPanel>

            <!-- Context info card -->
            <Border Grid.Row="1" Background="#EBF5FF" BorderBrush="#B3D4F5" BorderThickness="1"
                    CornerRadius="6" Padding="16,12" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="TxtTransferContext"
                               FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                               Foreground="#2A3A4A"/>
                    <TextBlock x:Name="TxtFromBatch"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#5A7A9A"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Target batch picker -->
            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <TextBlock Text="TARGET BATCH" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbTargetBatch" Height="34" FontFamily="Segoe UI" FontSize="13"
                          BorderBrush="#DDE2E8" Background="White" VerticalContentAlignment="Center"/>
                <TextBlock Text="Only Active batches are listed."
                           FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                           Foreground="#9AA0A8" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Background="#E8EBF0" Foreground="#3A4A5A"
                        Style="{StaticResource Btn}" Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button Content="⇌ Transfer" Background="#3A8EF6"
                        Style="{StaticResource Btn}" Click="BtnTransfer_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
