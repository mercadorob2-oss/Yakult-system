<Window x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Dialogs.TransferCartridgesWpfDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfer Cartridges"
        Width="620" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Window.Resources>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtyBtn" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A5A6A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDE2E8"/>
            <Setter Property="Background" Value="#F0F2F6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E4EA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9AA0A8"/>
        </Style>

    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ─── Header ─── -->
            <StackPanel Margin="28,24,28,0">
                <TextBlock Text="Transfer Cartridges"
                           FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="#2A3A4A"/>
                <TextBlock x:Name="TxtSubtitle"
                           FontFamily="Segoe UI" FontSize="12" Foreground="#7A8A9A" Margin="0,3,0,0"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,18,0,0"/>

            <!-- ─── Model selection ─── -->
            <StackPanel Margin="28,16,28,0">
                <TextBlock Text="SELECT MODELS AND QUANTITIES" Style="{StaticResource SectionLabel}"/>
                <TextBlock Text="Check each model you want to transfer and set the quantity."
                           FontFamily="Segoe UI" FontSize="12" Foreground="#9AA0A8" Margin="0,4,0,0"/>

                <!-- Loading placeholder -->
                <TextBlock x:Name="TxtModelsLoading" Text="Loading cartridge data..."
                           FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                           Foreground="#9AA0A8" Margin="0,12,0,0"/>

                <!-- Model rows -->
                <Border x:Name="ModelsBorder" Margin="0,12,0,0"
                        BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="6"
                        Visibility="Collapsed">
                    <ItemsControl x:Name="ModelsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="16,13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"/>

                                        <!-- Model info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ModelName}"
                                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#2A3A4A"/>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#9AA0A8" Margin="0,2,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} unit(s) available across {1} row(s)">
                                                        <Binding Path="AvailableQty"/>
                                                        <Binding Path="RowCount"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Qty control -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Opacity" Value="0.35"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Qty"
                                                       FontFamily="Segoe UI" FontSize="11"
                                                       Foreground="#9AA0A8" VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <Button Content="−" Style="{StaticResource QtyBtn}"
                                                    IsEnabled="{Binding QtyDecrEnabled}"
                                                    Click="BtnDecrement_Click"/>
                                            <TextBlock Text="{Binding TransferQty}"
                                                       FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#2A3A4A" Width="36"
                                                       TextAlignment="Center" VerticalAlignment="Center"/>
                                            <Button Content="+" Style="{StaticResource QtyBtn}"
                                                    IsEnabled="{Binding QtyIncrEnabled}"
                                                    Click="BtnIncrement_Click"/>
                                            <TextBlock FontFamily="Segoe UI" FontSize="11" Foreground="#9AA0A8"
                                                       VerticalAlignment="Center" Margin="6,0,0,0">
                                                <TextBlock.Text>
                                                    <Binding Path="AvailableQty" StringFormat="/ {0}"/>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- No-rows message -->
                <TextBlock x:Name="TxtNoRows" Visibility="Collapsed"
                           Text="No transferable cartridges found in this batch."
                           FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                           Foreground="#9AA0A8" Margin="0,12,0,0"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,16,0,0"/>

            <!-- ─── Target batch ─── -->
            <StackPanel Margin="28,16,28,0">
                <TextBlock Text="TARGET BATCH" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CmbTarget" Margin="0,8,0,0" Height="34"
                          FontFamily="Segoe UI" FontSize="13"
                          BorderBrush="#DDE2E8" Background="White"
                          VerticalContentAlignment="Center"
                          SelectionChanged="CmbTarget_SelectionChanged"/>
                <TextBlock Text="Only Active batches other than this one are listed."
                           FontFamily="Segoe UI" FontSize="11" FontStyle="Italic"
                           Foreground="#9AA0A8" Margin="0,5,0,0"/>
            </StackPanel>

            <Rectangle Height="1" Fill="#EEF1F4" Margin="0,16,0,0"/>

            <!-- ─── Footer ─── -->
            <Grid Margin="28,14,28,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtSummary" Grid.Column="0"
                           Text="No models selected"
                           FontFamily="Segoe UI" FontSize="12" FontStyle="Italic"
                           Foreground="#9AA0A8" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Background="#E8EBF0" Foreground="#3A4A5A"
                            Style="{StaticResource Btn}" Click="BtnClose_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnTransfer" Content="⇄ Transfer Selected" Background="#3A8EF6"
                            Style="{StaticResource Btn}" Click="BtnTransfer_Click"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Window>
