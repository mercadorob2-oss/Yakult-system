<UserControl x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Views.CartridgeTransmittalPrintPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Views"
             Width="793.7"
             Height="1122.5"
             Background="White">
    <!--
        A4 page at 96 DPI. Hosts a single CartridgeTransmittalPrintView.
        DataContext is set externally by PrintTransmittalDialog (preview).
        Actual printing of 3 copies (GATEPASS / TRANSMITTAL / FILE) is handled
        by TransmittalPrintService.Print() via FixedDocument — not this page.
    -->
    <views:CartridgeTransmittalPrintView/>
</UserControl>
