<UserControl x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Views.ClosedCartridgesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="110"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#B8D4FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#4E9AFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Row 0 · Page header                                                -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}"
                           FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                <TextBlock Text="{Binding PageSubtitle}"
                           FontSize="10" Foreground="#1A2333" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Row 1 · Stat cards + action toolbar                                -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">

                <!-- Right: loading badge + refresh button -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button x:Name="BtnRefresh"
                            Background="#4E9AFC"
                            Style="{StaticResource ActionButton}"
                            Content="⟳  Refresh"
                            Click="BtnRefresh_Click"/>
                </StackPanel>

                <!-- Left: stat cards -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="TOTAL RECORDS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalRecords}"
                                       FontSize="22" FontWeight="Bold" Foreground="#1A2333"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="TOTAL UNITS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalUnits}"
                                       FontSize="22" FontWeight="Bold" Foreground="#4E9AFC"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Row 2 · Filter bar                                                 -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#7A8A9A"/>
                <TextBox x:Name="TxtSearch"
                         Style="{StaticResource SearchBox}"
                         Width="300" Padding="8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Req ID or Cartridge Model"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Row 3 · DataGrid                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="3"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF1F4"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFBFC"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  RowHeight="38"
                  IsReadOnly="True"
                  ItemsSource="{Binding PagedRows}">
            <DataGrid.Columns>

                <!-- ID -->
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding EmptyCartridgeId}"
                                    Width="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                            <Setter Property="Foreground"          Value="#3A4A5A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Cartridge Model -->
                <DataGridTextColumn Header="Cartridge Model"
                                    Binding="{Binding CartridgeModel}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                            <Setter Property="FontWeight"        Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Qty -->
                <DataGridTextColumn Header="Qty"
                                    Binding="{Binding Quantity}"
                                    Width="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="FontWeight"          Value="Bold"/>
                            <Setter Property="FontSize"            Value="14"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Returned At -->
                <DataGridTextColumn Header="Returned At"
                                    Binding="{Binding ReturnedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="145">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Disposed At / Sold At — header set in code-behind via MainGrid.Columns[4] -->
                <DataGridTextColumn Header="Closed At"
                                    Binding="{Binding ClosedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue='—'}"
                                    Width="145">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Req ID -->
                <DataGridTextColumn Header="Req ID"
                                    Binding="{Binding ReqId, TargetNullValue='—'}"
                                    Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="Foreground"          Value="#5A6A7A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Disposal Company -->
                <DataGridTextColumn Header="Disposal Company"
                                    Binding="{Binding DisposalCompanyName, TargetNullValue='—'}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Remarks -->
                <DataGridTextColumn Header="Remarks"
                                    Binding="{Binding Remarks, TargetNullValue='—'}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment"  Value="Center"/>
                            <Setter Property="Padding"            Value="4,0,0,0"/>
                            <Setter Property="Foreground"         Value="#7A8A9A"/>
                            <Setter Property="FontStyle"          Value="Italic"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Row 4 · Pagination bar                                             -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPrev"
                            Content="‹"
                            Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}"
                            Click="BtnPrev_Click"/>
                    <TextBlock Text="{Binding PageInfo}"
                               FontSize="11" Foreground="#5A6A7A"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="BtnNext"
                            Content="›"
                            Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}"
                            Click="BtnNext_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
