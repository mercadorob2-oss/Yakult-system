<UserControl x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Views.CartridgeTrackingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="110"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#B8D4FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height"       Value="28"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Background"   Value="White"/>
            <Setter Property="BorderBrush"  Value="#B0BAC8"/>
            <Setter Property="Margin"       Value="0,0,12,0"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#4E9AFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Page header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="Cartridge Tracking"
                           FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                <TextBlock Text="Cartridge movement history  •  Read-only view"
                           FontSize="10" Foreground="#1A2333" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 1 · Stat card + refresh -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">

                <!-- Right: loading + refresh -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button x:Name="BtnRefresh"
                            Background="#4E9AFC"
                            Style="{StaticResource ActionButton}"
                            Content="⟳  Refresh"
                            Click="BtnRefresh_Click"/>
                </StackPanel>

                <!-- Left: stat card -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="TOTAL RECORDS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalRecords}"
                                       FontSize="22" FontWeight="Bold" Foreground="#1A2333"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 2 · Filter bar -->
        <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="14,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"
                           Margin="0,0,6,0" Foreground="#7A8A9A"/>
                <TextBox x:Name="TxtSearch"
                         Style="{StaticResource SearchBox}"
                         Width="220" Padding="8,0" Margin="0,0,16,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by item name, employee, branch…"/>

                <TextBlock Text="Item:" VerticalAlignment="Center"
                           FontSize="11" Foreground="#7A8A9A" Margin="0,0,5,0"/>
                <ComboBox x:Name="CmbItem"
                          Style="{StaticResource FilterCombo}"
                          Width="200"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItemLookup, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Employee:" VerticalAlignment="Center"
                           FontSize="11" Foreground="#7A8A9A" Margin="0,0,5,0"/>
                <ComboBox x:Name="CmbEmployee"
                          Style="{StaticResource FilterCombo}"
                          Width="180"
                          ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployeeLookup, Mode=TwoWay}"
                          DisplayMemberPath="Name"/>

                <TextBlock Text="Movement:" VerticalAlignment="Center"
                           FontSize="11" Foreground="#7A8A9A" Margin="0,0,5,0"/>
                <ComboBox x:Name="CmbMovement"
                          Style="{StaticResource FilterCombo}"
                          Width="140" Margin="0"
                          ItemsSource="{Binding MovementTypes}"
                          SelectedItem="{Binding SelectedMovementType, Mode=TwoWay}"/>

            </WrapPanel>
        </Border>

        <!-- Row 3 · DataGrid -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="3"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#DDE3EC"
                  VerticalGridLinesBrush="#DDE3EC"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFBFC"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  CanUserReorderColumns="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  IsReadOnly="True"
                  ItemsSource="{Binding PagedRows}">
            <DataGrid.Columns>

                <!-- Date / Time -->
                <DataGridTextColumn Header="Date / Time" Binding="{Binding DateTimeStr}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment"   Value="Top"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding"             Value="0,6,0,6"/>
                            <Setter Property="FontSize"            Value="11"/>
                            <Setter Property="TextWrapping"        Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Cartridge Item -->
                <DataGridTextColumn Header="Cartridge Item" Binding="{Binding ItemName}" Width="2*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="FontWeight"        Value="SemiBold"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Movement Type — pill badge -->
                <DataGridTemplateColumn Header="Movement" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="MovBadge" CornerRadius="10" Padding="8,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#EEF2FF">
                                <TextBlock x:Name="MovText" Text="{Binding MovementType}"
                                           FontWeight="SemiBold" FontSize="10"
                                           HorizontalAlignment="Center"
                                           Foreground="#4338CA"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding MovementType}" Value="StockIn">
                                    <Setter TargetName="MovBadge" Property="Background" Value="#DCFCE7"/>
                                    <Setter TargetName="MovText"  Property="Foreground" Value="#15803D"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MovementType}" Value="Issued">
                                    <Setter TargetName="MovBadge" Property="Background" Value="#FEF3C7"/>
                                    <Setter TargetName="MovText"  Property="Foreground" Value="#92400E"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MovementType}" Value="Returned">
                                    <Setter TargetName="MovBadge" Property="Background" Value="#E0F2FE"/>
                                    <Setter TargetName="MovText"  Property="Foreground" Value="#0369A1"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MovementType}" Value="RefillIn">
                                    <Setter TargetName="MovBadge" Property="Background" Value="#F0FDF4"/>
                                    <Setter TargetName="MovText"  Property="Foreground" Value="#166534"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MovementType}" Value="Adjustment">
                                    <Setter TargetName="MovBadge" Property="Background" Value="#FEE2E2"/>
                                    <Setter TargetName="MovText"  Property="Foreground" Value="#B91C1C"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Qty -->
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Category -->
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Employee -->
                <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Branch -->
                <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Department -->
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Condition -->
                <DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Performed By -->
                <DataGridTextColumn Header="Performed By" Binding="{Binding PerformedBy}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Remarks -->
                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Top"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 4 · Pagination -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PageInfo}"
                           VerticalAlignment="Center"
                           FontSize="11" Foreground="#7A8A9A"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="‹‹" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}" Click="BtnPrev_Click"/>
                    <Button Content="‹" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}" Click="BtnPrev_Click"/>
                    <Button Content="›" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}" Click="BtnNext_Click"/>
                    <Button Content="››" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}" Click="BtnNext_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
