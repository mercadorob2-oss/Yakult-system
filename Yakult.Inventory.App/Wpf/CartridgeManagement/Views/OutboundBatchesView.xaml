<UserControl x:Class="Yakult.Inventory.App.WPF.CartridgeManagement.Views.OutboundBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="110"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Finalize row button (compact, inside DataGrid cell) -->
        <Style x:Key="FinalizeButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#3A86E8"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="26"/>
            <Setter Property="MinWidth"        Value="70"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Audit trail grid column header -->
        <Style x:Key="AuditHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#3A86E8"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#2F72CC"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Batches grid column header -->
        <Style x:Key="BatchHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#3A86E8"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#2F72CC"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#3A86E8"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#2F72CC"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#B8D4FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#3A86E8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Header strip   -->
            <RowDefinition Height="Auto"/>   <!-- 1: Toolbar        -->
            <RowDefinition Height="Auto"/>   <!-- 2: Audit title    -->
            <RowDefinition Height="220"/>    <!-- 3: Audit trail    -->
            <RowDefinition Height="2"/>      <!-- 4: Separator      -->
            <RowDefinition Height="Auto"/>   <!-- 5: Batches title  -->
            <RowDefinition Height="*"/>      <!-- 6: Batches grid   -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 0 · Blue header strip                                         -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="Outbound Batches"
                           FontSize="18" FontWeight="Bold" Foreground="#3A86E8"/>
                <TextBlock FontSize="10" Foreground="#1A2333" Margin="0,5,0,0"
                           Text="Active DISPOSE and SELL batches  •  Select a batch to view its audit trail  •  Finalize to mark all linked cartridges as disposed or sold"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 1 · Toolbar: stat cards + action buttons                      -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="False">

                <!-- Right: loading badge + action buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#3A86E8"/>
                    </Border>

                    <Button x:Name="BtnRefresh"
                            Background="#3A86E8"
                            Style="{StaticResource ActionButton}"
                            Content="⟳  Refresh"
                            Click="BtnRefresh_Click"/>

                    <Button x:Name="BtnNewBatch"
                            Background="#E07820"
                            Style="{StaticResource ActionButton}"
                            Content="+ New Outbound"
                            Click="BtnNewBatch_Click"/>

                    <Button x:Name="BtnDelete"
                            Background="#C0392B"
                            Style="{StaticResource ActionButton}"
                            Content="🗑  Delete"
                            IsEnabled="{Binding CanDelete}"
                            Click="BtnDelete_Click"/>

                    <Button x:Name="BtnReport"
                            Background="#1B3A6B"
                            Style="{StaticResource ActionButton}"
                            Content="📄  Dispose/Sold"
                            Margin="0"
                            Click="BtnReport_Click"/>
                </StackPanel>

                <!-- Left: stat cards -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="ACTIVE BATCHES" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalBatches}"
                                       FontSize="22" FontWeight="Bold" Foreground="#1A2333"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="TOTAL UNITS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalUnits}"
                                       FontSize="22" FontWeight="Bold" Foreground="#3A86E8"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 2 · Audit Trail section header                                -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" Padding="14,10,14,4">
            <StackPanel>
                <TextBlock Text="Batch Audit Trail (Read-Only)"
                           FontSize="12" FontWeight="Bold" Foreground="#34495E"/>
                <TextBlock Text="Cartridges assigned to the selected outbound batch  •  Select a batch below to view"
                           FontSize="10" Foreground="#95A5A6" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 3 · Audit Trail DataGrid                                      -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <DataGrid x:Name="AuditGrid"
                  Grid.Row="3"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0,1,0,0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF1F4"
                  RowBackground="White"
                  AlternatingRowBackground="#F5F8FF"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="11"
                  IsReadOnly="True"
                  ItemsSource="{Binding AuditTrail}">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Cartridge ID"
                                    Binding="{Binding EmptyCartridgeId}"
                                    Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Request ID"
                                    Binding="{Binding RequestId, TargetNullValue='—'}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Returned Date"
                                    Binding="{Binding RequestDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="145">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Qty"
                                    Binding="{Binding ReturnedQty}"
                                    Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="FontWeight"          Value="Bold"/>
                            <Setter Property="FontSize"            Value="13"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Cartridge Model"
                                    Binding="{Binding CartridgeModel}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                            <Setter Property="FontWeight"        Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Vendor"
                                    Binding="{Binding Vendor}"
                                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Batch ID"
                                    Binding="{Binding BatchId}"
                                    Width="75">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Returned By"
                                    Binding="{Binding ReturnedByName}"
                                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,6,4,6"/>
                            <Setter Property="TextWrapping"      Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Remarks"
                                    Binding="{Binding Remarks, TargetNullValue='—'}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground"        Value="#7A8A9A"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 4 · Separator                                                 -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#DDE3EC"/>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 5 · Active Batches section header                             -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Background="White" Padding="14,10,14,4">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Text="Active Outbound Batches"
                           FontSize="12" FontWeight="Bold" Foreground="#34495E"
                           VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding SummaryText}"
                           FontSize="10" Foreground="#E07820"
                           FontStyle="Italic" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 6 · Active Batches DataGrid                                   -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <DataGrid x:Name="BatchGrid"
                  Grid.Row="6"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0,1,0,0"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF1F4"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFBFC"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  RowHeight="40"
                  IsReadOnly="True"
                  ItemsSource="{Binding Batches}"
                  SelectedItem="{Binding SelectedBatch, Mode=TwoWay}">
            <DataGrid.Columns>

                <!-- Batch # -->
                <DataGridTextColumn Header="Batch #"
                                    Binding="{Binding BatchId}"
                                    Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="FontWeight"          Value="Bold"/>
                            <Setter Property="Foreground"          Value="#3A4A5A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Purpose badge (DISPOSE = orange, SELL = green) -->
                <DataGridTemplateColumn Header="Purpose" Width="110" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="PurposeBadge"
                                    Background="#FFE0B2"
                                    CornerRadius="10"
                                    Padding="10,3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,5">
                                <TextBlock x:Name="PurposeText"
                                           Text="{Binding BatchPurpose}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#B45000"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding BatchPurpose}" Value="SELL">
                                    <Setter TargetName="PurposeBadge" Property="Background" Value="#C8E6C9"/>
                                    <Setter TargetName="PurposeText"  Property="Foreground" Value="#1B5E20"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Vendor -->
                <DataGridTextColumn Header="Vendor"
                                    Binding="{Binding VendorName}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Models -->
                <DataGridTextColumn Header="Models"
                                    Binding="{Binding ModelSummary, TargetNullValue='—'}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Total Qty -->
                <DataGridTextColumn Header="Total Qty"
                                    Binding="{Binding TotalQty}"
                                    Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="VerticalAlignment"   Value="Center"/>
                            <Setter Property="FontWeight"          Value="Bold"/>
                            <Setter Property="FontSize"            Value="14"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Created -->
                <DataGridTextColumn Header="Created"
                                    Binding="{Binding CreatedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground"        Value="#5A6A7A"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Remarks -->
                <DataGridTextColumn Header="Remarks"
                                    Binding="{Binding Remarks, TargetNullValue=''}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Foreground"        Value="#7A8A9A"/>
                            <Setter Property="Padding"           Value="4,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Finalize action button -->
                <DataGridTemplateColumn Header="Action" Width="100" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Finalize"
                                    Style="{StaticResource FinalizeButton}"
                                    Margin="6,0"
                                    Tag="{Binding}"
                                    Click="BtnFinalize_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>
