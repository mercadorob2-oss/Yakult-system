<UserControl x:Class="Yakult.Inventory.App.WPF.NotificationCenter.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Yakult.Inventory.App.WPF.NotificationCenter.Controls"
             FontFamily="Segoe UI"
             Background="#F2F4F7"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ── Notification tabs: flat, underline-indicator ─────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="#F2F4F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- header strip with a hairline baseline the indicators sit on -->
                            <Border Grid.Row="0" Background="#F2F4F7"
                                    BorderBrush="#E3E7ED" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Margin="10,4,10,0" Panel.ZIndex="1"/>
                            </Border>

                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground"  Value="#7A8794"/>
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="0"
                                    Padding="14,8,14,9">
                                <ContentPresenter x:Name="Cp" ContentSource="Header"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                            </Border>
                            <!-- underline indicator: overlaps the header baseline -->
                            <Border x:Name="Ind" Height="2.5" VerticalAlignment="Bottom" Margin="10,0"
                                    CornerRadius="2" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#EAEEF3"/>
                                <Setter TargetName="Cp"  Property="TextElement.Foreground" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd"  Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="Cp"  Property="TextElement.Foreground" Value="#0F172A"/>
                                <Setter TargetName="Ind" Property="Background" Value="#4E9AFC"/>
                                <Setter Property="Panel.ZIndex" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close button ─────────────────────────────────────────────────── -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Shared empty-state label style ──────────────────────────────── -->
        <Style x:Key="EmptyState" TargetType="TextBlock">
            <Setter Property="FontSize"            Value="10"/>
            <Setter Property="Foreground"          Value="#9AAAB5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin"              Value="0,12,0,14"/>
        </Style>

        <!-- ── Days badge (pill) inside each expiry row ─────────────────────── -->
        <Style x:Key="DaysBadge" TargetType="Border">
            <Setter Property="CornerRadius"      Value="10"/>
            <Setter Property="Padding"           Value="9,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth"          Value="64"/>
        </Style>

        <!-- ── Shared row shell: icon circle + text + trailing content ──────── -->
        <Style x:Key="RowShell" TargetType="Border">
            <Setter Property="Margin"       Value="0,0,0,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Background"   Value="#FAFBFC"/>
            <Setter Property="BorderBrush"  Value="#EEF1F5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ── License row DataTemplate ─────────────────────────────────────── -->
        <DataTemplate x:Key="LicenseRowTemplate">
            <Border>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClickCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RowShell}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Setter Property="BorderBrush" Value="#CFE6F8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,9,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding DaysBadgeBackground}" Margin="2,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemName}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ItemType}"
                                   FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource DaysBadge}"
                            Background="{Binding DaysBadgeBackground}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DaysLabel}"
                                   FontSize="9.5" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Warranty row DataTemplate ─────────────────────────────────────── -->
        <DataTemplate x:Key="WarrantyRowTemplate">
            <Border>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClickCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RowShell}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FDEDEC"/>
                                <Setter Property="BorderBrush" Value="#F7CFC9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,9,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding DaysBadgeBackground}" Margin="2,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ItemName}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ItemType}"
                                   FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource DaysBadge}"
                            Background="{Binding DaysBadgeBackground}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding DaysLabel}"
                                   FontSize="9.5" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Mobile update row DataTemplate (purple accent) ──────────────── -->
        <DataTemplate x:Key="MobileRowTemplate">
            <Border>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClickCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RowShell}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5EEF8"/>
                                <Setter Property="BorderBrush" Value="#E4CDEC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,9,10,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="#8E44AD" Margin="2,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SetCode}"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#0F172A"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryLine}"
                                   FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Activity child row (one item under an expanded batch row) ─────── -->
        <DataTemplate x:Key="ActivityChildTemplate">
            <Border Background="Transparent" Cursor="Hand" Padding="6,4,6,4" Margin="0,1,0,1" CornerRadius="4">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClickCommand}"/>
                </Border.InputBindings>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3EEF9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="11" Foreground="#334155" TextTrimming="CharacterEllipsis">
                    <Run Text="•  "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding TypeLabel, Mode=OneWay}" Foreground="#94A3B8"/><Run Text="  "/><Run Text="{Binding QtyLabel, Mode=OneWay}" Foreground="#64748B" FontWeight="SemiBold"/>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- ── Activity row DataTemplate (persisted dbo.Notification) ────────── -->
        <DataTemplate x:Key="ActivityRowTemplate">
            <Border>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource RowShell}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EBF5FB"/>
                                <Setter Property="BorderBrush" Value="#CFE6F8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <!-- clickable header: marks read + (batch) toggles the item list / (single) navigates -->
                    <Grid Margin="10,9,10,9" Background="Transparent">
                        <Grid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ClickCommand}"/>
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Top" Margin="2,4,8,0"
                                 Fill="{Binding UnreadDotBrush}"/>

                        <Button Grid.Column="1" Command="{Binding ToggleExpandCommand}"
                                Visibility="{Binding ChildToggleVisibility}"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                Margin="0,2,8,0" VerticalAlignment="Top" Cursor="Hand" Focusable="False"
                                ToolTip="Show / hide items">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="{Binding ExpandGlyph}" FontSize="11" Foreground="#64748B"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="12.5" FontWeight="{Binding TitleWeight}" Foreground="#0F172A"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Message}"
                                       FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                            <Border Visibility="{Binding SourceVisibility}"
                                    HorizontalAlignment="Left" Margin="0,4,0,0"
                                    Background="#EEF2F7" CornerRadius="8" Padding="7,2">
                                <TextBlock Text="{Binding SourceLabel}"
                                           FontSize="9.5" Foreground="#5B6B7C"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="3" Text="{Binding TimeAgo}"
                                   FontSize="9.5" Foreground="#9AAAB5" VerticalAlignment="Top"
                                   Margin="10,1,0,0"/>
                    </Grid>

                    <!-- expandable per-item list (batch rows only) -->
                    <ItemsControl ItemsSource="{Binding Children}"
                                  ItemTemplate="{StaticResource ActivityChildTemplate}"
                                  Visibility="{Binding ChildListVisibility}"
                                  Margin="30,0,10,8"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Fixed header bar ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#4E9AFC">
            <Border.Effect>
                <DropShadowEffect Color="#0F172A" BlurRadius="10" ShadowDepth="1" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <Grid Margin="16,0,10,0">
                <TextBlock Text="🔔  Notifications"
                           Foreground="White" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource CloseBtn}"
                        Command="{Binding CloseCommand}"
                        Content="✕"/>
            </Grid>
        </Border>

        <!-- ── Reminders / Activity tabs ─────────────────────────────────────── -->
        <TabControl Grid.Row="1" BorderThickness="0" Background="#F2F4F7" Padding="0">

          <TabItem Header="Reminders">
        <!-- ── Scrollable card area ───────────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="10,10,10,10">
            <StackPanel>

                <!-- ── LICENSE &amp; SERVICE EXPIRY ─────────────────────────── -->
                <controls:NotificationCardControl
                    CardTitle="📅  License &amp; Service Expiry"
                    AccentBrush="#3498DB"
                    ViewAllCommand="{Binding ViewAllLicenseCommand}">
                    <controls:NotificationCardControl.CardContent>
                        <StackPanel Margin="0,4,0,6">
                            <ItemsControl ItemsSource="{Binding LicenseItems}"
                                          ItemTemplate="{StaticResource LicenseRowTemplate}"/>
                            <TextBlock Text="✓  No items expiring soon">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </controls:NotificationCardControl.CardContent>
                </controls:NotificationCardControl>

                <!-- ── WARRANTY EXPIRY ──────────────────────────────────────── -->
                <controls:NotificationCardControl
                    CardTitle="🛡️  Warranty Expiry"
                    AccentBrush="#E74C3C"
                    ViewAllCommand="{Binding ViewAllWarrantyCommand}">
                    <controls:NotificationCardControl.CardContent>
                        <StackPanel Margin="0,4,0,6">
                            <ItemsControl ItemsSource="{Binding WarrantyItems}"
                                          ItemTemplate="{StaticResource WarrantyRowTemplate}"/>
                            <TextBlock Text="✓  All warranties up to date">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WarrantyItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </controls:NotificationCardControl.CardContent>
                </controls:NotificationCardControl>

                <!-- ── MOBILE UPDATES ────────────────────────────────────────── -->
                <controls:NotificationCardControl
                    CardTitle="📱  Mobile Updates"
                    AccentBrush="#8E44AD"
                    ViewAllCommand="{Binding ViewAllMobileCommand}"
                    ExtraHeaderVisible="True"
                    ExtraHeaderText="{Binding MobilePendingLabel}"
                    ExtraHeaderColor="{Binding MobilePendingColor}">
                    <controls:NotificationCardControl.CardContent>
                        <StackPanel Margin="0,4,0,6">
                            <ItemsControl ItemsSource="{Binding MobileItems}"
                                          ItemTemplate="{StaticResource MobileRowTemplate}"/>
                            <TextBlock Text="✓  No pending mobile updates">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MobileItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </controls:NotificationCardControl.CardContent>
                </controls:NotificationCardControl>

            </StackPanel>
        </ScrollViewer>
          </TabItem>

          <TabItem Header="Activity">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Filter + "Mark all as read" bar ── -->
                <Grid Grid.Row="0" Margin="12,8,12,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding ActivityFilters}"
                              SelectedItem="{Binding SelectedActivityFilter, Mode=TwoWay}"
                              FontSize="11" MinWidth="110" VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Command="{Binding MarkAllActivityReadCommand}"
                            Content="Mark all as read"
                            Visibility="{Binding HasUnreadActivity, Converter={StaticResource BoolToVisibility}}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#2980B9" FontSize="11" Cursor="Hand"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,6,10,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding ActivityItems}"
                                      ItemTemplate="{StaticResource ActivityRowTemplate}"/>
                        <TextBlock Text="✓  No recent activity">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyState}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActivityItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
          </TabItem>

        </TabControl>
    </Grid>
</UserControl>
