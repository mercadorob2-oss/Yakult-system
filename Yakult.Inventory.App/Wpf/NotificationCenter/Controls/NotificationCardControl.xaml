<UserControl x:Class="Yakult.Inventory.App.WPF.NotificationCenter.Controls.NotificationCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="10" Margin="0,0,0,14"
            BorderBrush="#E5EAF1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="16" ShadowDepth="3" Opacity="0.08" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Coloured accent bar -->
            <Border Grid.Row="0"
                    Background="{Binding AccentBrush, ElementName=Root}"
                    CornerRadius="10,10,0,0"/>

            <!-- Card header -->
            <Grid Grid.Row="1" Margin="16,12,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding CardTitle, ElementName=Root}"
                           FontSize="13.5" FontWeight="SemiBold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"/>

                <!-- Optional count label (e.g. "Unprocessed: 5") -->
                <Border Grid.Column="1"
                        Background="{Binding ExtraHeaderColor, ElementName=Root}"
                        CornerRadius="9" Padding="8,3" Margin="0,0,10,0"
                        Visibility="{Binding ExtraHeaderVisible, ElementName=Root, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ExtraHeaderText, ElementName=Root}"
                               Foreground="White"
                               FontSize="9.5" FontWeight="SemiBold"/>
                </Border>

                <!-- View All → link -->
                <TextBlock Grid.Column="2" Text="View All  →"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{Binding AccentBrush, ElementName=Root}"
                           VerticalAlignment="Center" Cursor="Hand">
                    <TextBlock.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding ViewAllCommand, ElementName=Root}"/>
                    </TextBlock.InputBindings>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.85"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="TextDecorations" Value="Underline"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Content slot: each card passes its own ListView here -->
            <ContentPresenter Grid.Row="2"
                              Content="{Binding CardContent, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
