<UserControl
    x:Class="Yakult.Inventory.App.WPF.RequestManagement.Views.MixedRequestExchangeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestManagement.ViewModels"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Background="#F0F2F6"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <!-- Converters -->
        <conv:StringToColorBrushConverter      x:Key="HexToBrush"/>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>

        <!-- Summary field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5A6A"/>
            <Setter Property="Margin"     Value="0,4,0,2"/>
        </Style>

        <!-- Read-only summary textbox -->
        <Style x:Key="SummaryBox" TargetType="TextBox">
            <Setter Property="IsReadOnly"         Value="True"/>
            <Setter Property="Background"         Value="#F3F5F8"/>
            <Setter Property="BorderBrush"        Value="#CDD5DE"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="7,5"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="Foreground"         Value="#1A2333"/>
            <Setter Property="Margin"             Value="0,0,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Section card border -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <!-- Search box -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DatePicker with classic calendar icon -->
        <Style x:Key="CleanDatePicker" TargetType="DatePicker">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="MinWidth"        Value="112"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#C8D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="dpBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="PART_TextBox"
                                         Grid.Column="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="{TemplateBinding FontSize}"
                                         Padding="6,0"
                                         VerticalContentAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0,3,3,0">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="#5A6A7E"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="#EEF2F7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact ComboBox -->
        <Style x:Key="FilterComboBox" TargetType="ComboBox">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Padding"         Value="6,0"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#C8D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Action button base -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination button -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EBF5FF"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid column header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#EEF2F7"/>
            <Setter Property="Foreground"      Value="#3A4A5A"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Padding"         Value="7,6"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- DataGrid row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A8EF6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Thin modern ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                                  Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#B8C4D0"
                                                        CornerRadius="3"
                                                        Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#3A8EF6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                                  Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root"       Property="Width"     Value="Auto"/>
                                <Setter TargetName="Root"       Property="Height"    Value="6"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text styles for grid cells -->
        <Style x:Key="CellCenter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
        </Style>
        <Style x:Key="CellLeft" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <!-- Submission block (left list) -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:MixedGroupViewModel}">
            <Border Margin="0,0,0,10"
                    Background="White"
                    BorderThickness="1"
                    CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#DDE3EC"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BorderBrush" Value="#3A8EF6"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.09" Color="#000000" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar (click selects the submission) -->
                    <Border Grid.Row="0"
                            Background="{Binding HeaderBrush}"
                            CornerRadius="7,7,0,0"
                            Padding="10,0"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick"
                                          Command="{Binding DataContext.SelectGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          CommandParameter="{Binding}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="#28000000"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding LineCountBadge, StringFormat='Mixed · {0}'}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding HeaderText}"
                                       FontWeight="SemiBold" FontSize="11"
                                       Foreground="{Binding HeaderForeground}"
                                       VerticalAlignment="Center"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>

                            <Border Grid.Column="2"
                                    Background="{Binding DateBrush}"
                                    CornerRadius="10"
                                    Padding="9,3"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding DateCreated, StringFormat='yyyy-MM-dd HH:mm'}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Request lines -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2F7"
                              BorderThickness="0"
                              Background="White"
                              RowHeaderWidth="0"
                              ColumnHeaderHeight="33"
                              MinRowHeight="38"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              MaxHeight="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Req #" Binding="{Binding ReqId, Mode=OneWay}" Width="55">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#2A3A4A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Item" Binding="{Binding ItemName, Mode=OneWay}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" Width="95"
                                                ElementStyle="{StaticResource CellLeft}"/>

                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Mode=OneWay}" Width="45"
                                                ElementStyle="{StaticResource CellCenter}"/>

                            <DataGridTextColumn Header="Issued" Binding="{Binding IssuedQty, Mode=OneWay}" Width="55"
                                                ElementStyle="{StaticResource CellCenter}"/>

                            <DataGridTextColumn Header="Pending" Binding="{Binding PendingQty, Mode=OneWay}" Width="60"
                                                ElementStyle="{StaticResource CellCenter}"/>

                            <DataGridTextColumn Header="Status" Binding="{Binding FulfillmentStatus, Mode=OneWay}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{Binding FulfillmentStatusBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding DateCreated, Mode=OneWay, StringFormat='yyyy-MM-dd HH:mm'}"
                                                Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One line to issue (right panel) -->
        <DataTemplate x:Key="IssueLineTemplate" DataType="{x:Type vm:MixedLineViewModel}">
            <Border Margin="0,0,0,8"
                    Background="#F5F8FF"
                    BorderBrush="#DDE3EC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Req # / item / category -->
                    <TextBlock Grid.Row="0" Margin="0,0,0,6" FontWeight="Bold" FontSize="11" Foreground="#2A3A4A"
                               TextWrapping="Wrap">
                        <Run Text="Req #"/><Run Text="{Binding ReqId, Mode=OneWay}"/>
                        <Run Text=" — "/><Run Text="{Binding ItemName, Mode=OneWay}"/>
                        <Run Text="  ("/><Run Text="{Binding Category, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>

                    <!-- Issue quantity -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Issue Qty:" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <conv:IntegerSpinner Grid.Column="1"
                                             Value="{Binding IssueQty, Mode=TwoWay}"
                                             MinValue="0"
                                             MaxValue="{Binding MaxIssue}"/>
                        <TextBlock Grid.Column="2" Text="{Binding StockInfo}"
                                   FontSize="9" FontStyle="Italic"
                                   Foreground="{Binding StockInfoBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Metrics + status -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Requested: " FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E"/>
                            <TextBlock Text="{Binding Quantity}" FontSize="10" FontWeight="Bold" Foreground="#2A3A4A"/>
                            <TextBlock Text="   Issued: " FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding IssuedQty}" FontSize="10" FontWeight="Bold" Foreground="#1E9E5E"/>
                            <TextBlock Text="   Pending: " FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding PendingQty}" FontSize="10" FontWeight="Bold" Foreground="#D03020"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{Binding FulfillmentStatusBrush}"
                                CornerRadius="10" Padding="10,3">
                            <TextBlock Text="{Binding FulfillmentStatus}" Foreground="White"
                                       FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </Grid>

                    <!-- Line remarks -->
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Remarks (optional):" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <!--  ROOT LAYOUT                                                              -->
    <!-- ══════════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="35*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════ LEFT PANEL: pending mixed requests ════════════════ -->
        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Title -->
                <RowDefinition Height="Auto"/>   <!-- Filters -->
                <RowDefinition Height="Auto"/>   <!-- Sort + loading -->
                <RowDefinition Height="*"/>      <!-- Submission blocks -->
                <RowDefinition Height="Auto"/>   <!-- Pagination -->
                <RowDefinition Height="Auto"/>   <!-- Buttons -->
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="16,14,16,8">
                <TextBlock Text="📋 Pending Mixed Requests (Grouped by Submission)"
                           FontSize="14" FontWeight="Bold" Foreground="#3A8EF6"/>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#DDE3EC"
                    BorderThickness="0,0,0,1"
                    Padding="12,8,12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBox}"/>
                        <TextBlock Text="Search by requester, company, branch, department, item, or req #..."
                                   FontSize="10" Foreground="#9DAAB8"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="From:" FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                                    Style="{StaticResource CleanDatePicker}" Margin="0,0,8,0"/>

                        <TextBlock Text="To:" FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}"
                                    Style="{StaticResource CleanDatePicker}" Margin="0,0,10,0"/>

                        <Border Width="1" Height="16" Background="#DDE3EC" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Text="Timeline:" FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding QuickRanges}"
                                  SelectedItem="{Binding SelectedQuickRange, Mode=TwoWay}"
                                  Style="{StaticResource FilterComboBox}"
                                  MinWidth="120" Margin="0,0,8,0"/>

                        <Border Width="1" Height="16" Background="#DDE3EC" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Text="Category:" FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7E"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding CategoryFilterOptions}"
                                  SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                  Style="{StaticResource FilterComboBox}"
                                  MinWidth="110" Margin="0,0,8,0"/>

                        <Button Content="✕ Clear"
                                Command="{Binding ClearFilterCommand}"
                                Height="26" Padding="8,0"
                                FontSize="10" FontWeight="SemiBold"
                                Foreground="#5A6A7E"
                                Background="#F0F3F7"
                                BorderBrush="#CDD5DE" BorderThickness="1"
                                Cursor="Hand"
                                VerticalContentAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E4E9F0"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="14,6,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding ToggleSortCommand}"
                        HorizontalAlignment="Left"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{Binding SortIndicatorText}"
                                       FontWeight="Bold" FontSize="10"
                                       Foreground="{Binding SortIndicatorColor, Converter={StaticResource HexToBrush}}"/>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳ Loading…" FontSize="10" FontStyle="Italic" Foreground="#8A9AAA"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalFirst">
                <ItemsControl ItemsSource="{Binding PagedGroups}"
                              ItemTemplate="{StaticResource GroupTemplate}"
                              Padding="12,8,12,8"/>
            </ScrollViewer>

            <Border Grid.Row="4" Background="#F3F5F8" Padding="12,6"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding FirstPageCommand}"/>
                        <Button Content="‹" Style="{StaticResource PageButton}" Command="{Binding PrevPageCommand}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding PageInfo}"
                               FontSize="10" Foreground="#4A5A6A"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}"/>
                        <Button Content="»" Style="{StaticResource PageButton}" Command="{Binding LastPageCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Background="White" Padding="12,8,12,12"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="🔄 Refresh"
                            Background="#1E9E5E"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      Background="#DDE3EC"
                      ResizeDirection="Columns"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"/>

        <!-- ════════════════ RIGHT PANEL: Mixed Request Exchange ════════════════ -->
        <Grid Grid.Column="2" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" Padding="16,14,16,8"
                    BorderBrush="#DDE3EC" BorderThickness="0,0,0,1">
                <TextBlock Text="🔄 Mixed Request Exchange"
                           FontSize="14" FontWeight="Bold" Foreground="#E07020"/>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,8,12,0">
                <StackPanel>

                    <!-- Empty state -->
                    <TextBlock Text="Select a request on the left to review and fulfill it."
                               FontSize="11" FontStyle="Italic" Foreground="#8A9AAA"
                               Margin="4,6,4,12" TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}"/>

                    <!-- Request summary -->
                    <Border Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                                <TextBlock Text="Requester:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.Requester, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Request #:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.ReqIds, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Total Quantity:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.TotalQty, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Company:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.Company, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Branch:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.Branch, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Text="Department:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.Department, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Distribution Method:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.DistributionMethod, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Received By:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.ReceivedBy, Mode=OneWay}" Style="{StaticResource SummaryBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                                <TextBlock Text="Additional Remarks:" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SelectedGroup.AdditionalRemarks, Mode=OneWay}"
                                         TextWrapping="Wrap"
                                         Style="{StaticResource SummaryBox}"
                                         MinHeight="40"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Issue items -->
                    <Border Style="{StaticResource SectionCard}">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1E9E5E" Offset="0"/>
                                <GradientStop Color="#DDE3EC" Offset="0.05"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <Thickness Left="1" Top="3" Right="1" Bottom="1"/>
                        </Border.BorderThickness>
                        <StackPanel>
                            <TextBlock Text="📤 Issue Items (cartridges and other consumables)"
                                       FontSize="11" FontWeight="Bold" Foreground="#1E9E5E"
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SelectedGroup.Lines}"
                                          ItemTemplate="{StaticResource IssueLineTemplate}"/>
                            <TextBlock Text="Each line is issued from its own stock on hand. Quantities cannot exceed what is pending or in stock."
                                       FontSize="9" FontStyle="Italic" Foreground="#5A6A7E"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="White" Padding="12,8,12,12"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="-2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <WrapPanel Orientation="Horizontal">
                    <Button Content="✅ Fulfill Request"
                            Background="#1E9E5E"
                            Command="{Binding FulfillCommand}"
                            Style="{StaticResource ActionButton}"/>
                    <Button Content="🗑 Clear"
                            Background="#8090A0"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource ActionButton}"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
