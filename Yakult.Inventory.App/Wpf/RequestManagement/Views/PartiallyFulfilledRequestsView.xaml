<UserControl x:Class="Yakult.Inventory.App.WPF.RequestManagement.Views.PartiallyFulfilledRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestManagement.ViewModels"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>

        <!-- Converters -->
        <conv:BoolToVisibilityConverter         x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter  x:Key="InvBoolToVis"/>
        <conv:StringToColorBrushConverter       x:Key="HexToBrush"/>
        <conv:NullToVisibilityConverter         x:Key="NullToVis"/>
        <conv:BoolToCardBrushConverter           x:Key="BoolToCardBrush"/>

        <!-- Base text style -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="Foreground"  Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="#4A5A6A"/>
            <Setter Property="Margin"      Value="0,0,0,3"/>
        </Style>

        <!-- Stat card box -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#DDE3EC"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="8"/>
            <Setter Property="Padding"          Value="16,10"/>
            <Setter Property="Margin"           Value="0,0,12,0"/>
            <Setter Property="MinWidth"         Value="120"/>
        </Style>

        <!-- ══ Page-local redesign styles (not shared — this page keeps its own full style
             dictionary rather than merging ListPageStyles.xaml) ═══════════════════════════ -->
        <Style x:Key="StatCardShell" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="7"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Width"           Value="120"/>
            <Setter Property="Height"          Value="44"/>
        </Style>

        <Style x:Key="StatValueText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="StatLabelText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="7"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#4A5A6A"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="AdvancedFiltersToggleBtn" TargetType="ToggleButton">
            <Setter Property="BorderBrush" Value="#C8D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="#6B7A8D"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search box -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"            Value="#B0BAC8"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="Foreground"             Value="#1A2333"/>
            <Setter Property="FontSize"               Value="11"/>
            <Setter Property="Padding"                Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter combobox -->
        <Style x:Key="FilterComboBox" TargetType="ComboBox">
            <Setter Property="Height"                 Value="28"/>
            <Setter Property="FontSize"               Value="10"/>
            <Setter Property="Padding"                Value="6,0"/>
            <Setter Property="Background"             Value="White"/>
            <Setter Property="BorderBrush"            Value="#C8D2DC"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Action button (blue primary) -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fulfill button (green) -->
        <Style x:Key="FulfillButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#1E9E5E"/>
        </Style>

        <!-- Icon refresh button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background"      Value="#F0F3F7"/>
            <Setter Property="BorderBrush"     Value="#C8D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Pagination button -->
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"   Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid column header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"       Value="#EEF2F7"/>
            <Setter Property="Foreground"       Value="#3A4A5A"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="FontSize"         Value="10"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="BorderBrush"      Value="#DDE3EC"/>
            <Setter Property="BorderThickness"  Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- DataGrid row -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background"  Value="White"/>
            <Setter Property="Foreground"  Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A8EF6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid cell -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Session block header button (clickable blue bar) -->
        <Style x:Key="SessionHeaderBtn" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7,7,0,0" Height="40"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin scrollbar -->
        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Width"  Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0C8D4" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Style="{StaticResource ThinScrollBar}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Session group DataTemplate ────────────────────────────────────── -->
        <DataTemplate x:Key="SessionGroupTemplate" DataType="{x:Type vm:RequestSessionGroupViewModel}">
            <Border Margin="0,0,0,12" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                      Opacity="0.09" Direction="270" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Blue header bar (clickable to toggle) -->
                    <Button Grid.Row="0"
                            Background="{Binding HeaderBrush}"
                            Command="{Binding ToggleExpandCommand}"
                            Style="{StaticResource SessionHeaderBtn}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">

                                <!-- Set # badge -->
                                <Border Background="#28FFFFFF" CornerRadius="4"
                                        Padding="6,2" Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SetLabel}"
                                               Foreground="White" FontSize="10"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <!-- Requester name -->
                                <TextBlock Text="{Binding RequesterName}"
                                           Foreground="White" FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <!-- Divider + Branch -->
                                <TextBlock Text=" · " Foreground="#99FFFFFF"
                                           FontSize="10" VerticalAlignment="Center"
                                           Visibility="{Binding BranchName,
                                               Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding BranchName}"
                                           Foreground="#E8F4FF" FontSize="10"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding BranchName,
                                               Converter={StaticResource NullToVis}}"/>

                                <!-- Divider + Department -->
                                <TextBlock Text=" · " Foreground="#99FFFFFF"
                                           FontSize="10" VerticalAlignment="Center"
                                           Visibility="{Binding DepartmentName,
                                               Converter={StaticResource NullToVis}}"/>
                                <TextBlock Text="{Binding DepartmentName}"
                                           Foreground="#E8F4FF" FontSize="10"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DepartmentName,
                                               Converter={StaticResource NullToVis}}"/>

                                <!-- Pending badge -->
                                <Border Background="#CC2A1F1F" CornerRadius="4"
                                        Padding="7,2" Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasPending,
                                            Converter={StaticResource BoolToVis}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="0"
                                                          Opacity="0.18" Color="#000000"/>
                                    </Border.Effect>
                                    <TextBlock Text="{Binding PendingBadgeText}"
                                               Foreground="White" FontSize="10"
                                               FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <!-- Toggle icon -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ToggleIcon}"
                                       Foreground="White" FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,14,0"/>
                        </Grid>
                    </Button>

                    <!-- DataGrid (collapses with toggle) -->
                    <DataGrid Grid.Row="1"
                              x:Name="RowGrid"
                              ItemsSource="{Binding Rows}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2F7"
                              BorderThickness="0"
                              Background="White"
                              RowHeaderWidth="0"
                              ColumnHeaderHeight="33"
                              MinRowHeight="38"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="False">

                        <DataGrid.Columns>

                            <!-- Req # -->
                            <DataGridTextColumn Header="Req #"
                                                Binding="{Binding ReqId}"
                                                Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize"    Value="10"/>
                                        <Setter Property="FontWeight"  Value="Bold"/>
                                        <Setter Property="Foreground"  Value="#2A3A4A"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Top"/>
                                        <Setter Property="Padding"     Value="4,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Item -->
                            <DataGridTextColumn Header="Item"
                                                Binding="{Binding ItemName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize"   Value="10"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#1A2333"/>
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="Padding"    Value="8,6"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Requested -->
                            <DataGridTextColumn Header="Requested"
                                                Binding="{Binding Quantity}"
                                                Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize"  Value="10"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Top"/>
                                        <Setter Property="Padding"   Value="4,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Issued (colored green when > 0) -->
                            <DataGridTemplateColumn Header="Issued" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IssuedQty}"
                                                   FontSize="10"
                                                   FontWeight="{Binding IssuedQtyWeight}"
                                                   Foreground="{Binding IssuedQtyColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Padding="4,6"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Pending (colored red when > 0) -->
                            <DataGridTemplateColumn Header="Pending" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PendingQty}"
                                                   FontSize="10"
                                                   FontWeight="{Binding PendingQtyWeight}"
                                                   Foreground="{Binding PendingQtyColor}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   Padding="4,6"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status (color-coded) -->
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FulfillmentStatusDisplay}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusColor}"
                                                   VerticalAlignment="Top"
                                                   Padding="8,6"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Created date -->
                            <DataGridTextColumn Header="Created At"
                                                Binding="{Binding CreatedDateFormatted}"
                                                Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize"  Value="10"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment"   Value="Top"/>
                                        <Setter Property="Padding"   Value="4,6"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Remarks (multiline, full text) -->
                            <DataGridTemplateColumn Header="Remarks" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Remarks}"
                                                   FontSize="10"
                                                   Foreground="#4A5A6A"
                                                   VerticalAlignment="Top"
                                                   Padding="8,6"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Root layout                                                            -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title + Stats -->
            <RowDefinition Height="Auto"/>  <!-- Search / Filter toolbar -->
            <RowDefinition Height="*"/>     <!-- Session cards -->
            <RowDefinition Height="70"/>    <!-- Remarks strip -->
            <RowDefinition Height="Auto"/>  <!-- Footer: Fulfill + Pagination -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 0 · Title & Stats                                            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"
                Padding="18,14,18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <DockPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Partially Fulfilled Requests"
                               FontSize="15" FontWeight="Bold" Foreground="#3A8EF6"
                               VerticalAlignment="Center"/>

                    <!-- Loading indicator -->
                    <Border DockPanel.Dock="Left" Margin="14,0,0,0"
                            Background="#EBF5FF" CornerRadius="4"
                            Padding="8,2"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Loading…" FontSize="10" Foreground="#3A8EF6"
                                   VerticalAlignment="Center"/>
                    </Border>
                </DockPanel>

                <!-- Stats cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Style="{StaticResource StatCardShell}" Cursor="Hand" Background="{Binding IsSetsCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetsCardCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="#3A8EF6"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock Text="{Binding SessionCount}" Style="{StaticResource StatValueText}" Foreground="#3A8EF6"/>
                                <TextBlock Text="SETS" Style="{StaticResource StatLabelText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatCardShell}" Cursor="Hand" Background="{Binding IsTotalIssuedCardActive, Converter={StaticResource BoolToCardBrush}}" ToolTip="Click to sort sessions by highest total issued">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding TotalIssuedCardCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="#27AE60"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock Text="{Binding TotalIssued}" Style="{StaticResource StatValueText}" Foreground="#27AE60"/>
                                <TextBlock Text="TOTAL ISSUED" Style="{StaticResource StatLabelText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource StatCardShell}" Margin="0" Cursor="Hand" Background="{Binding IsTotalPendingCardActive, Converter={StaticResource BoolToCardBrush}}" ToolTip="Click to sort sessions by highest still pending">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding TotalPendingCardCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Fill="#E74C3C"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                                <TextBlock Text="{Binding TotalPending}" Style="{StaticResource StatValueText}" Foreground="#E74C3C"/>
                                <TextBlock Text="STILL PENDING" Style="{StaticResource StatLabelText}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 1 · Search / Filter toolbar                                  -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel LastChildFill="False">

                <!-- Refresh button (right-docked first so it stays right) -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource GhostBtn}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Refresh"
                        Margin="0,0,0,0">
                    <TextBlock Text="↻" FontSize="15" Foreground="#3A8EF6"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>

                <!-- Search box -->
                <Grid DockPanel.Dock="Left" Margin="0,0,10,0" Width="280" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             Height="30" Padding="28,4,8,4"/>
                    <!-- Search icon -->
                    <TextBlock Text="🔍" IsHitTestVisible="False"
                               FontSize="10" Foreground="#9DAAB8"
                               VerticalAlignment="Center" Margin="9,0,0,0"/>
                    <!-- Placeholder -->
                    <TextBlock IsHitTestVisible="False"
                               FontSize="10" Foreground="#9DAAB8"
                               VerticalAlignment="Center" Margin="28,0,0,0"
                               Text="Search by requester, branch, department, item, req #…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Advanced Filters -->
                <ToggleButton DockPanel.Dock="Left" x:Name="AdvancedFiltersToggle"
                              Style="{StaticResource AdvancedFiltersToggleBtn}"
                              Width="140" Height="30" VerticalAlignment="Center"
                              Content="Advanced Filters"/>
                <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                       IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                       StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                       AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                            CornerRadius="8" Padding="18" Width="960">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                            <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                            <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                            <StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Filter" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FilterByBox"
                                          Style="{StaticResource FilterComboBox}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem>All Fields</ComboBoxItem>
                                    <ComboBoxItem>Requester</ComboBoxItem>
                                    <ComboBoxItem>Branch</ComboBoxItem>
                                    <ComboBoxItem>Department</ComboBoxItem>
                                    <ComboBoxItem>Item</ComboBoxItem>
                                    <ComboBoxItem>Req #</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Sort" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SortByBox"
                                          Style="{StaticResource FilterComboBox}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem>Set # (A→Z)</ComboBoxItem>
                                    <ComboBoxItem>Set # (Z→A)</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Set Code" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Document #" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <TextBlock Text="Company" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="6">
                                    <TextBlock Text="Department" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="8">
                                    <TextBlock Text="Branch" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="10">
                                    <TextBlock Text="Employee" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <!-- Row 2: Reference Code | Parent Tag -->
                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Reference Code" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="Parent Tag" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Req ID -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Req ID" FontSize="10" Foreground="#4A5A6A" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            </StackPanel>
                            </ScrollViewer>

                            <Separator Margin="0,2,0,12"/>

                            <Button HorizontalAlignment="Right" Style="{StaticResource GhostBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                <TextBlock Text="↺  Reset Filters"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 2 · Scrollable session cards                                 -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="14,10,14,4">

            <Grid>
                <!-- Session list -->
                <ItemsControl x:Name="SessionList"
                              ItemsSource="{Binding PagedSessions}"
                              ItemTemplate="{StaticResource SessionGroupTemplate}"
                              Visibility="{Binding PagedSessions.Count,
                                  Converter={StaticResource NullToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty state -->
                <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                        CornerRadius="8" Padding="32" Margin="0,4,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PagedSessions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No partially fulfilled requests found."
                                   FontSize="13" Foreground="#7A8A9A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Try adjusting your search or filter, or refresh to reload data."
                                   FontSize="10" Foreground="#9DAAB8" Margin="0,6,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 3 · Remarks strip                                            -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="White"
                BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                Padding="18,8,18,8">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="REMARKS" Style="{StaticResource FieldLabel}"
                           Margin="0,0,0,3"/>
                <TextBlock Text="{Binding RemarksText}"
                           FontSize="11" Foreground="#2A3A4A"
                           TextWrapping="Wrap" MaxHeight="36"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding RemarksText}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════ -->
        <!-- Row 4 · Footer: Fulfill button + Pagination                      -->
        <!-- ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White"
                BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                Padding="14,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="-2"
                                  Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <DockPanel LastChildFill="False">

                <!-- Fulfill Selected button -->
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource FulfillButton}"
                        Command="{Binding FulfillSelectedCommand}"
                        IsEnabled="{Binding CanFulfill}"
                        Padding="18,0" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✔" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Fulfill Selected" FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Pagination (right-aligned) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource PageButton}"
                            Command="{Binding FirstPageCommand}"
                            IsEnabled="{Binding CanGoFirst}"
                            ToolTip="First page">
                        <TextBlock Text="«" FontSize="11"/>
                    </Button>

                    <Button Style="{StaticResource PageButton}"
                            Command="{Binding PrevPageCommand}"
                            IsEnabled="{Binding CanGoPrev}"
                            ToolTip="Previous page">
                        <TextBlock Text="‹" FontSize="13"/>
                    </Button>

                    <Border Background="#F5F8FF" BorderBrush="#DDE3EC"
                            BorderThickness="1" CornerRadius="4"
                            Padding="10,4" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageInfoText}"
                                   FontSize="10" Foreground="#3A4A5A"/>
                    </Border>

                    <Button Style="{StaticResource PageButton}"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"
                            ToolTip="Next page">
                        <TextBlock Text="›" FontSize="13"/>
                    </Button>

                    <Button Style="{StaticResource PageButton}"
                            Command="{Binding LastPageCommand}"
                            IsEnabled="{Binding CanGoLast}"
                            ToolTip="Last page">
                        <TextBlock Text="»" FontSize="11"/>
                    </Button>

                </StackPanel>

            </DockPanel>
        </Border>

    </Grid>
</UserControl>
