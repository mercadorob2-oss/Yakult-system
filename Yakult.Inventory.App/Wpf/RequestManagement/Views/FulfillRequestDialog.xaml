<Window x:Class="Yakult.Inventory.App.WPF.RequestManagement.Views.FulfillRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
        xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestManagement.ViewModels"
        Title="Fulfill Request"
        Width="560"
        MinHeight="260"
        MaxHeight="680"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:StringToColorBrushConverter      x:Key="HexToBrush"/>

        <!-- Spinner button (+ / −) -->
        <Style x:Key="SpinBtn" TargetType="Button">
            <Setter Property="Width"           Value="22"/>
            <Setter Property="Height"          Value="20"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Foreground"      Value="#3A4A5A"/>
            <Setter Property="Background"      Value="#F0F3F7"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDE3EC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quantity value box -->
        <Style x:Key="QtyBox" TargetType="TextBox">
            <Setter Property="Width"                   Value="54"/>
            <Setter Property="Height"                  Value="28"/>
            <Setter Property="FontSize"                Value="13"/>
            <Setter Property="FontWeight"              Value="SemiBold"/>
            <Setter Property="Foreground"              Value="#1A2333"/>
            <Setter Property="TextAlignment"           Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"             Value="#C8D2DC"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Background"              Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog action button -->
        <Style x:Key="DlgButton" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- Outer shell with rounded corners + shadow                              -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4"
                              Opacity="0.20" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- Header bar -->
                <RowDefinition Height="*"/>    <!-- Scrollable cards -->
                <RowDefinition Height="52"/>   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- Header bar                                                   -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#3A8EF6" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll">
                <DockPanel Margin="16,0">
                    <TextBlock DockPanel.Dock="Right"
                               x:Name="CloseBtn"
                               Text="✕" FontSize="14" Foreground="#CCE4FF"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               MouseLeftButtonDown="OnCloseClick"
                               Margin="0,0,4,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock x:Name="SubtitleText"
                                   FontSize="10" Foreground="#CCE4FF"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- Scrollable request cards                                     -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="#F0F2F6">
                <ItemsControl x:Name="StatesPanel"
                              ItemsSource="{Binding}"
                              Margin="14,12,14,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FulfillRequestRowStateViewModel}">

                            <!-- Per-request card -->
                            <Border Background="White"
                                    BorderBrush="#DDE3EC" BorderThickness="1"
                                    CornerRadius="8" Margin="0,0,0,10"
                                    Padding="16,14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                                      Opacity="0.07" Direction="270"/>
                                </Border.Effect>

                                <StackPanel>

                                    <!-- Item name -->
                                    <TextBlock Text="{Binding ItemName}"
                                               FontSize="12" FontWeight="Bold"
                                               Foreground="#1A2333"/>

                                    <!-- Sub-header: req#, requested, prev issued, pending -->
                                    <TextBlock Text="{Binding SubHeaderText}"
                                               FontSize="9" Foreground="#6A7A8A"
                                               Margin="0,3,0,0"/>

                                    <!-- Divider -->
                                    <Border Height="1" Background="#EEF2F7"
                                            Margin="0,10,0,10"/>

                                    <!-- ── Qty to Issue section ───────────── -->
                                    <TextBlock Text="QTY TO ISSUE"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="#4A5A6A" Margin="0,0,0,8"/>

                                    <!-- Cartridge line of a mixed submission: exchanged like the Cartridge Exchange -->
                                    <StackPanel Margin="0,0,0,4"
                                                Visibility="{Binding IsExchangeLine, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Brand New:"
                                                       FontSize="11" Foreground="#2A3A4A"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SpinBtn}" Content="−"
                                                        Command="{Binding DecreaseBrandNewCommand}"/>
                                                <TextBox Style="{StaticResource QtyBox}" Margin="4,0"
                                                         Text="{Binding IssueBrandNewQty, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Style="{StaticResource SpinBtn}" Content="+"
                                                        Command="{Binding IncreaseBrandNewCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Refilled:"
                                                       FontSize="11" Foreground="#2A3A4A"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SpinBtn}" Content="−"
                                                        Command="{Binding DecreaseRefilledCommand}"/>
                                                <TextBox Style="{StaticResource QtyBox}" Margin="4,0"
                                                         Text="{Binding IssueRefilledQty, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Style="{StaticResource SpinBtn}" Content="+"
                                                        Command="{Binding IncreaseRefilledCommand}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding CartridgeStockText}"
                                                   FontSize="10" Foreground="{Binding AvailableStockColor,
                                                       Converter={StaticResource HexToBrush}}"
                                                   TextWrapping="Wrap"/>
                                        <Border Background="#FFF4E5" BorderBrush="#F5C58A" BorderThickness="1"
                                                CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding EmptiesInfo}" FontSize="10"
                                                       Foreground="#8A4B08" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,4"
                                          Visibility="{Binding IsPlainLine, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Issue Now:"
                                                   FontSize="11" Foreground="#2A3A4A"
                                                   VerticalAlignment="Center"/>

                                        <!-- Spinner: − value + -->
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource SpinBtn}"
                                                    Content="−"
                                                    Command="{Binding DecreaseQtyCommand}"/>
                                            <TextBox Style="{StaticResource QtyBox}"
                                                     Text="{Binding IssueQty,
                                                            UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="4,0"/>
                                            <Button Style="{StaticResource SpinBtn}"
                                                    Content="+"
                                                    Command="{Binding IncreaseQtyCommand}"/>
                                        </StackPanel>

                                        <!-- Availability -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AvailableStockText}"
                                                   FontSize="10"
                                                   Foreground="{Binding AvailableStockColor,
                                                       Converter={StaticResource HexToBrush}}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"/>
                                    </Grid>

                                    <!-- Divider -->
                                    <Border Height="1" Background="#EEF2F7"
                                            Margin="0,10,0,10"/>

                                    <!-- ── Live fulfillment preview ──────── -->
                                    <TextBlock Text="FULFILLMENT PREVIEW"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="#4A5A6A" Margin="0,0,0,8"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <Border Background="#F5F8FF" BorderBrush="#DDE3EC"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,4" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Issued After: "
                                                           FontSize="10" Foreground="#4A5A6A"/>
                                                <TextBlock Text="{Binding IssuedAfter}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="#27AE60"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F5F8FF" BorderBrush="#DDE3EC"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,4" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Pending After: "
                                                           FontSize="10" Foreground="#4A5A6A"/>
                                                <TextBlock Text="{Binding PendingAfter}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="#E74C3C"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F5F8FF" BorderBrush="#DDE3EC"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="10,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Status: "
                                                           FontSize="10" Foreground="#4A5A6A"/>
                                                <TextBlock Text="{Binding StatusAfterText}"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding StatusAfterColor,
                                                               Converter={StaticResource HexToBrush}}"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <!-- Divider -->
                                    <Border Height="1" Background="#EEF2F7"
                                            Margin="0,10,0,10"/>

                                    <!-- ── Remarks ────────────────────────── -->
                                    <TextBlock Text="REMARKS (optional)"
                                               FontSize="9" FontWeight="SemiBold"
                                               Foreground="#4A5A6A" Margin="0,0,0,6"/>

                                    <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="11" Foreground="#1A2333"
                                             BorderBrush="#C8D2DC" BorderThickness="1"
                                             Background="White" Padding="8,6"
                                             AcceptsReturn="False"
                                             MaxLength="400"
                                             Height="32">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter Property="BorderBrush" Value="#3A8EF6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- Footer                                                       -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    Padding="16,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DlgButton}"
                            Background="#1E9E5E" Foreground="White"
                            Click="OnConfirmClick"
                            IsDefault="True"
                            Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✔" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Confirm"/>
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DlgButton}"
                            Background="#E8ECF0" Foreground="#4A5A6A"
                            Click="OnCancelClick"
                            IsCancel="True"
                            Margin="0,0,8,0">
                        Cancel
                    </Button>

                </DockPanel>
            </Border>

        </Grid>
    </Border>

</Window>
