<UserControl x:Class="Yakult.Inventory.App.WPF.EDocs.Views.EDocsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:gp="clr-namespace:Yakult.Inventory.App.WPF.EDocs.Gatepass.Views"
             FontFamily="Segoe UI"
             Background="#F5F7FA"
             SizeChanged="OnSizeChanged">
    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="ResponsiveStates">
            <VisualState x:Name="Wide">
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="QuickActionGrid" Storyboard.TargetProperty="Columns">
                        <DiscreteObjectKeyFrame KeyTime="0">
                            <DiscreteObjectKeyFrame.Value>
                                <sys:Int32>3</sys:Int32>
                            </DiscreteObjectKeyFrame.Value>
                        </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>
            <VisualState x:Name="Narrow">
                <Storyboard>
                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="QuickActionGrid" Storyboard.TargetProperty="Columns">
                        <DiscreteObjectKeyFrame KeyTime="0">
                            <DiscreteObjectKeyFrame.Value>
                                <sys:Int32>1</sys:Int32>
                            </DiscreteObjectKeyFrame.Value>
                        </DiscreteObjectKeyFrame>
                    </ObjectAnimationUsingKeyFrames>
                </Storyboard>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <UserControl.Resources>
        <gp:GatepassCategoryLabelConverter x:Key="CategoryLabel"/>
        <gp:GatepassModelLabelConverter x:Key="ModelLabel"/>
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="chip" CornerRadius="14" BorderBrush="#C9CED4"
                                BorderThickness="1" Background="White" Padding="14,6,14,6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chip" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="chip" Property="Background" Value="#3498DB"/>
                                <Setter TargetName="chip" Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ChipList" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ChipItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E1E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7,14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E1E6EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
        <Style x:Key="StepBadge" TargetType="Ellipse">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Fill" Value="#3498DB"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5A6C7D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F2D3D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4,6,4"/>
            <Setter Property="BorderBrush" Value="#C9D2DC"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="OuterScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MinWidth="480">
            <Border Background="White" CornerRadius="8" BorderBrush="#E1E6EB" BorderThickness="1" Padding="0" Margin="0,0,0,12">
                <StackPanel>
                    <Border Background="#3498DB" CornerRadius="8,8,0,0" Height="6"/>
                    <StackPanel Margin="20,14,20,18">
                    <TextBlock Text="E-Documents" FontSize="22" FontWeight="Bold" Foreground="#1F2D3D"/>
                    <TextBlock Text="Transmittal &#x2022; Gatepass &#x2022; Requisition" FontSize="13" Foreground="#5A6C7D" Margin="0,4,0,0"/>
                    <TextBlock Text="Standalone print forms — fill in the fields on each tab, then print. Nothing here is tied to sets, requests, or cartridges." FontSize="12" Foreground="#5A6C7D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <UniformGrid x:Name="QuickActionGrid" Columns="3" Margin="0,0,0,4">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Rectangle Width="36" Height="36" Fill="#3498DB" RadiusX="6" RadiusY="6" HorizontalAlignment="Left"/>
                        <TextBlock Text="Transmittal" Style="{StaticResource CardTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Fill and print a standalone transmittal form." Style="{StaticResource CardSubtitle}" Margin="0,4,0,10"/>
                        <Button Content="Open Transmittal" Style="{StaticResource PrimaryButton}" Command="{Binding OpenTransmittalCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Ellipse Width="36" Height="36" Fill="#3498DB" HorizontalAlignment="Left"/>
                        <TextBlock Text="Gatepass" Style="{StaticResource CardTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Fill and print a standalone gatepass form." Style="{StaticResource CardSubtitle}" Margin="0,4,0,10"/>
                        <Button Content="New Gatepass" Style="{StaticResource PrimaryButton}" Command="{Binding NewGatepassCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Path Width="36" Height="36" Fill="#3498DB" Stretch="Uniform" HorizontalAlignment="Left" Data="M6,2 L18,2 L24,8 L24,30 L6,30 Z M18,2 L18,8 L24,8"/>
                        <TextBlock Text="Requisition" Style="{StaticResource CardTitle}" Margin="0,10,0,0"/>
                        <TextBlock Text="Fill and print a standalone requisition form." Style="{StaticResource CardSubtitle}" Margin="0,4,0,10"/>
                        <Button Content="Open Requisition" Style="{StaticResource PrimaryButton}" Command="{Binding OpenRequisitionCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="White" BorderBrush="#E1E6EB" Margin="0,8,0,0">
                <TabItem Header="Transmittal">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel MaxWidth="780">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Document header — all optional" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="TO" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TransmittalInput.To, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TransmittalInput.Date, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="FROM (permanent)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding TransmittalInput.From, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                             IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"
                                             ToolTip="Fixed value — every form issued from this section comes from the IT department."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Items — add rows as needed" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="+ Add Row" Command="{Binding AddTransmittalItemCommand}" Padding="12,4,12,4" Margin="0,0,8,0"/>
                                        <Button Content="Delete Selected" Command="{Binding DeleteTransmittalItemsCommand}" CommandParameter="{Binding SelectedItems, ElementName=TransmittalItemsGrid}" Padding="12,4,12,4"/>
                                    </StackPanel>
                                    <DataGrid x:Name="TransmittalItemsGrid" ItemsSource="{Binding TransmittalEntryItems}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="150" Margin="0,0,0,4" GridLinesVisibility="All" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Signatories" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="PREPARED BY" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TransmittalInput.PreparedBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="TRANSMITTED BY" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TransmittalInput.TransmitBy, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="RECEIVED BY / DATE" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding TransmittalInput.ReceivedByDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="APPROVED BY / DATE" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding ApprovedBySignatories}" SelectedItem="{Binding TransmittalInput.ApprovedByDate}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="NOTED BY" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding NotedBySignatories}" SelectedItem="{Binding TransmittalInput.NotedBy}"/>
                                </StackPanel>
                            </Border>
                            <Button Content="Print Preview" Style="{StaticResource PrimaryButton}" Command="{Binding PrintTransmittalCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" Padding="22,9,22,9" FontSize="14"/>
                            <Button Content="Save as PDF" Command="{Binding SaveTransmittalPdfCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="22,7,22,7"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Gatepass">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel MaxWidth="780">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Company and form type" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <RadioButton Content="Yakult Philippines Inc." GroupName="GatepassCompany" IsChecked="{Binding GatepassInput.IsYakultPhilippines}" Margin="0,0,16,0"/>
                                        <RadioButton Content="Yakult Marketing Corp." GroupName="GatepassCompany" IsChecked="{Binding GatepassInput.IsYakultMarketing}"/>
                                    </StackPanel>
                                    <TextBlock Text="FORM TYPE" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding GatepassFormTypes}" SelectedItem="{Binding GatepassInput.FormType}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Document header — all optional" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="TO" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.To, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.Date, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="FROM (permanent)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding GatepassInput.From, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                             IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"
                                             ToolTip="Fixed value — every form issued from this section comes from the IT department."/>
                                    <TextBlock Text="ITEM" Style="{StaticResource FieldLabel}"/>
                                    <ListBox Style="{StaticResource ChipList}"
                                             ItemsSource="{Binding GatepassCategories}"
                                             SelectedItem="{Binding GatepassInput.ItemCategory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource CategoryLabel}}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="IF OTHERS, SPECIFY" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding GatepassInput.ItemCategoryOther, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                    <TextBlock Text="MODEL" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                                    <ListBox Style="{StaticResource ChipList}"
                                             ItemsSource="{Binding GatepassModelChips}"
                                             SelectedItem="{Binding GatepassInput.Model}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ModelLabel}}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="FIXED ASSET NO." Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.FixedAssetNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="QUANTITY" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Items — add rows as needed" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="+ Add Row" Command="{Binding AddGatepassItemCommand}" Padding="12,4,12,4" Margin="0,0,8,0"/>
                                        <Button Content="Delete Selected" Command="{Binding DeleteGatepassItemsCommand}" CommandParameter="{Binding SelectedItems, ElementName=GatepassItemsGrid}" Padding="12,4,12,4"/>
                                    </StackPanel>
                                    <DataGrid x:Name="GatepassItemsGrid" ItemsSource="{Binding GatepassEntryItems}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="130" Margin="0,0,0,4" GridLinesVisibility="All" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="OTHERS" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.Others, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="REMARKS" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.Remarks, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="4" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Signatories" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="ISSUED BY" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding IssuedBySignatories}" SelectedItem="{Binding GatepassInput.IssuedBy}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="NOTED BY" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding NotedBySignatories}" SelectedItem="{Binding GatepassInput.NotedBy}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="RECEIVED BY / DATE" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding GatepassInput.ReceivedByDate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="APPROVED BY / DATE" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding ApprovedBySignatories}" SelectedItem="{Binding GatepassInput.ApprovedByDate}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <CheckBox Content="Print all three form types (Gatepass, Transmittal, File — 3 sheets)" IsChecked="{Binding GatepassInput.PrintAllThree}" Margin="0,4,0,0" FontSize="12"/>
                            <Button Content="Print Preview" Style="{StaticResource PrimaryButton}" Command="{Binding PrintGatepassCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="22,9,22,9" FontSize="14"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Requisition">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel MaxWidth="780">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="1" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Company" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <RadioButton Content="Yakult Philippines Inc." GroupName="ReqCompany" IsChecked="{Binding RequisitionInput.IsYakultPhilippines}" Margin="0,0,0,4"/>
                                    <RadioButton Content="Yakult Marketing Corp." GroupName="ReqCompany" IsChecked="{Binding RequisitionInput.IsYakultMarketing}" Margin="0,0,0,4"/>
                                    <RadioButton Content="Yakult El Salvador Manufacturing Corp." GroupName="ReqCompany" IsChecked="{Binding RequisitionInput.IsYakultElSalvador}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="2" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Document header — all optional" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="DEPARTMENT (permanent)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                                                     IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"
                                                     ToolTip="Fixed value — every requisition issued from this section is on behalf of IT."/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.Date, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock Text="EMPLOYEE" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding RequisitionInput.Employee, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="3" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Items — add rows as needed" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Content="+ Add Row" Command="{Binding AddReqItemCommand}" Padding="12,4,12,4" Margin="0,0,8,0"/>
                                        <Button Content="Delete Selected" Command="{Binding DeleteReqItemsCommand}" CommandParameter="{Binding SelectedItems, ElementName=ReqItemsGrid}" Padding="12,4,12,4"/>
                                    </StackPanel>
                                    <DataGrid x:Name="ReqItemsGrid" ItemsSource="{Binding ReqItems}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" MinHeight="140" Margin="0,0,0,4" GridLinesVisibility="All" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="QUANTITY" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="26" Height="26">
                                            <Ellipse Style="{StaticResource StepBadge}"/>
                                            <TextBlock Text="4" Style="{StaticResource StepNumber}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="Signatories" Style="{StaticResource SectionTitle}"/>
                                    </Grid>
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="PREPARED BY (NAME)" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox ItemsSource="{Binding RequisitionSignatories}" Text="{Binding RequisitionInput.PreparedByName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="POSITION" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.PreparedByPosition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="NOTED BY (NAME, permanent)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.NotedByName}" Style="{StaticResource FieldBox}"
                                                     IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="POSITION (permanent)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.NotedByPosition}" Style="{StaticResource FieldBox}"
                                                     IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="APPROVED BY (NAME, permanent)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.ApprovedByName}" Style="{StaticResource FieldBox}"
                                                     IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="POSITION (permanent)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.ApprovedByPosition}" Style="{StaticResource FieldBox}"
                                                     IsReadOnly="True" Focusable="False" Background="#F2F4F7" Foreground="#5A6C7D"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="RECEIVED BY" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.ReceivedByLabel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="POSITION" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding RequisitionInput.ReceivedByPosition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Button Content="Print Preview" Style="{StaticResource PrimaryButton}" Command="{Binding PrintRequisitionCommand}" HorizontalAlignment="Left" Margin="0,2,0,0" Padding="22,9,22,9" FontSize="14"/>
                            <Button Content="Save as PDF" Command="{Binding SaveRequisitionPdfCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="22,7,22,7"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
