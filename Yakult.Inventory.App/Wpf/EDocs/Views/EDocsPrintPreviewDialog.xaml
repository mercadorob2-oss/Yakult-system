<Window x:Class="Yakult.Inventory.App.WPF.EDocs.Views.EDocsPrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview"
        Width="920" Height="980"
        MinWidth="700" MinHeight="750"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Background="#F0F2F6">
    <Window.Resources>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Title and subtitle -->
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText"
                               FontFamily="Segoe UI" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1A2340"/>
                    <TextBlock x:Name="SubtitleText"
                               FontFamily="Segoe UI" FontSize="11.5" Foreground="#5A6380"
                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Page size and copies controls (upper right) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,0,0,0">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Page size:" FontFamily="Segoe UI" FontSize="11" Foreground="#444" Margin="0,0,0,4"/>
                        <StackPanel>
                            <RadioButton x:Name="PageSizeLetter" Content="Letter" GroupName="PageSize" FontSize="11" Margin="0,0,0,2"/>
                            <RadioButton x:Name="PageSizeLegal" Content="Legal" GroupName="PageSize" FontSize="11" Margin="0,0,0,2"/>
                            <RadioButton x:Name="PageSizeA4" Content="A4" GroupName="PageSize" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Copies:" FontFamily="Segoe UI" FontSize="11" Foreground="#444" Margin="0,0,0,4"/>
                        <StackPanel>
                            <RadioButton x:Name="Copies1" Content="1 copy" GroupName="Copies" FontSize="11" Margin="0,0,0,2"/>
                            <RadioButton x:Name="Copies2" Content="2 copies" GroupName="Copies" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Print Preview ───────────────────────────────────────────────── -->
        <Border Grid.Row="1" Margin="16" Background="#F0F2F6"
                BorderBrush="#DDE1E8" BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Border Background="White" BorderBrush="#CCC" BorderThickness="1" Margin="12"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl x:Name="PreviewHost" Margin="6"/>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- ── Footer ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White"
                BorderBrush="#DDE1E8" BorderThickness="0,1,0,0"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ActionBtn}"
                        Content="Skip for Now"
                        Background="White" Foreground="#444"
                        BorderBrush="#CCC"
                        Margin="0,0,10,0"
                        Click="OnSkip"/>
                <Button Style="{StaticResource ActionBtn}"
                        Content="Print"
                        Background="#4E9AFC" Foreground="White"
                        BorderBrush="#3D86E0"
                        Click="OnPrint"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
