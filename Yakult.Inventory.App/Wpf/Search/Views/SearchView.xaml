<UserControl
    x:Class="Yakult.Inventory.App.Wpf.Search.Views.SearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.Wpf.Search.Converters"
    xmlns:wpfInput="clr-namespace:System.Windows.Controls;assembly=DotNetProjects.Input.Toolkit"
    Background="#F0F3F7"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisConverter             x:Key="BoolToVis"/>
        <conv:InverseBoolToVisConverter      x:Key="InvBoolToVis"/>
        <conv:NullOrEmptyToVisConverter      x:Key="NullToVis"/>
        <conv:DestinationToBrushConverter    x:Key="DestBrush"/>
        <conv:DestinationToLightBrushConverter x:Key="DestLightBrush"/>
        <conv:StockToCountBrushConverter     x:Key="StockBrush"/>

        <!-- Base TextBlock -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- Thin ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="tb" Background="#C4CDD8" CornerRadius="3" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="tb" Property="Background" Value="#8EA0B4"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pagination button -->
        <Style x:Key="PagBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#5A6A7E"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Width="38" Height="38">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#EEF2F8"/>
                                <Setter TargetName="root" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Back button -->
        <Style x:Key="BackBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#3A6EA8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#E8EEF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigate CTA button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card border style (selected / hover) -->
        <Style x:Key="ResultCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="6"/>
            <Setter Property="MinHeight"       Value="155"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.07" Color="#0A1A2A" Direction="270"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#3A8EF6"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" Color="#3A8EF6" Direction="270"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Filter button -->
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A6EA8"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22" Height="40" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background"   Value="#EEF2F8"/>
                                <Setter TargetName="root" Property="BorderBrush"  Value="#3A8EF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter chip remove button -->
        <Style x:Key="ChipRemoveBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root" Background="Transparent" CornerRadius="10" Width="16" Height="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#C8D8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AutoCompleteBox's internal TextBox — blends into the pill-shaped Border that wraps it -->
        <Style x:Key="AutoBoxTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush"       Value="#3A8EF6"/>
            <!-- Padding is intentionally not set here — it's driven by the AutoCompleteBox's own
                 Padding (forwarded via TemplateBinding), which differs per instance to leave room
                 for the search icon / clear button overlaid on top of it. -->
        </Style>

        <!-- Suggestion row: primary name (bold) + short detail/status line beneath it -->
        <DataTemplate x:Key="SuggestionItemTemplate">
            <Grid Margin="10,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Primary}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2333"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#7A8FA6" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{Binding Destination, Converter={StaticResource DestLightBrush}}"
                        CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Destination}" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{Binding Destination, Converter={StaticResource DestBrush}}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- AutoCompleteBox suggestion ListBoxItem — subtle hover/selection highlight -->
        <Style x:Key="AutoBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor"  Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="5" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EBF5FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full re-template of AutoCompleteBox: the library's default dropdown chrome is an
             unstyled system-gray box that stretches to fill the window and ignores the app's
             rounded/white/shadowed visual language. This template throws that default out and
             draws a text part + a Popup that matches the rest of the search UI. -->
        <Style TargetType="{x:Type wpfInput:AutoCompleteBox}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type wpfInput:AutoCompleteBox}">
                        <Grid x:Name="Root">
                            <!-- Required "Text" part — the control syncs its Text property to/from this box itself -->
                            <TextBox x:Name="Text"
                                     Style="{TemplateBinding TextBoxStyle}"
                                     FontSize="{TemplateBinding FontSize}"
                                     Padding="{TemplateBinding Padding}"/>

                            <!-- Placeholder overlay (the control's own Placeholder rendering inherits the
                                 same broken default styling, so it's replaced with a plain watermark here) -->
                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Placeholder}"
                                       Foreground="#A8B4C0"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <!-- Required "Popup" part — the control opens/closes and positions this itself -->
                            <Popup x:Name="Popup"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   PopupAnimation="Fade"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Root}"
                                   Width="{Binding ActualWidth, ElementName=Root}">
                                <Border Background="White"
                                        BorderBrush="#D0D8E6" BorderThickness="1"
                                        CornerRadius="10" Margin="0,6,0,0"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.13" Color="#000000"/>
                                    </Border.Effect>
                                    <!-- Required "Selector" part — ItemsSource is assigned by the control itself.
                                         No extra wrapping ScrollViewer here: a ListBox already brings its own
                                         internal one (using the app's thin ScrollBar style, defined above), and
                                         double-nesting them was what ate the mouse wheel — the inner ListBox's own
                                         scroll host was set to Disabled and simply swallowed the wheel event
                                         instead of forwarding it to an outer one. -->
                                    <ListBox x:Name="Selector"
                                             BorderThickness="0" Background="Transparent" Padding="4"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemTemplate="{TemplateBinding ItemTemplate}"
                                             ItemContainerStyle="{TemplateBinding ItemContainerStyle}"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Text" Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════════
         ROOT GRID  ·  Row 0 = header bar,  Row 1 = content body
    ══════════════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── HEADER BAR  (hidden during initial state, visible once results show) ── -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="28,10"
                Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back button -->
                <Button Grid.Column="0"
                        Content="← Back"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource BackBtn}"
                        Margin="0,0,14,0"
                        Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"/>

                <!-- Search box (Google-style AutoCompleteBox, manually queried — see SearchView.xaml.cs) -->
                <Grid Grid.Column="1">
                    <Border x:Name="SearchBorder"
                            Background="White"
                            BorderBrush="#D0D8E6"
                            BorderThickness="1.5"
                            CornerRadius="28"
                            MaxWidth="740"
                            HorizontalAlignment="Stretch">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#000000" Direction="270"/>
                        </Border.Effect>

                        <!-- AutoCompleteBox fills the whole pill (icon + clear button are overlays on top of
                             it, not separate grid columns) so its dropdown — sized off the control's own
                             ActualWidth — lines up with the full pill instead of just a text sub-column. -->
                        <Grid>
                            <wpfInput:AutoCompleteBox x:Name="HeaderAutoBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ItemsSource="{Binding Suggestions}"
                                     FilterMode="None"
                                     MinimumPrefixLength="2"
                                     MinimumPopulateDelay="0"
                                     IsTextCompletionEnabled="False"
                                     ValueMemberPath="Primary"
                                     MaxDropDownHeight="260"
                                     Height="46" FontSize="13.5"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="46,0,40,0"
                                     Placeholder="Search by name, serial number, model, SetCode, or request…"
                                     TextBoxStyle="{StaticResource AutoBoxTextBoxStyle}"
                                     ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                     ItemContainerStyle="{StaticResource AutoBoxItemStyle}"
                                     Populating="SearchAutoBox_Populating"
                                     SelectionChanged="SearchAutoBox_SelectionChanged"
                                     PreviewKeyDown="SearchAutoBox_PreviewKeyDown"/>

                            <!-- Search icon (overlay, left) -->
                            <TextBlock Text="&#x1F50D;" FontSize="17"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="18,0,0,0" IsHitTestVisible="False"/>

                            <!-- Clear button (overlay, right — shown when text present) -->
                            <Button Content="✕" FontSize="11" Foreground="#A8B4C0"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Margin="0,0,12,0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding BackCommand}"
                                    Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── Filter button + dropdown (Col 2) ────────────────────── -->
                <Grid Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="FilterButton"
                            Style="{StaticResource FilterBtn}"
                            Command="{Binding ToggleFilterDropdownCommand}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Funnel icon -->
                            <Viewbox Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Path Fill="#3A6EA8"
                                      Data="M 0,0 L 20,0 L 13,9 L 13,18 L 7,15 L 7,9 Z"/>
                            </Viewbox>
                            <TextBlock Text="Filters" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <!-- Active count badge -->
                            <Border Background="#3A8EF6" CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveFilterCount}"
                                           FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <!-- Filter dropdown popup -->
                    <Popup IsOpen="{Binding FilterDropdownOpen}"
                           PlacementTarget="{Binding ElementName=FilterButton}"
                           Placement="Bottom"
                           HorizontalOffset="-160"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#D0D8E6" BorderThickness="1"
                                CornerRadius="12" Margin="4,4,4,0" MinWidth="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <!-- Popup header -->
                                <Grid Margin="14,12,14,8">
                                    <TextBlock Text="Filter by source" FontSize="12" FontWeight="SemiBold" Foreground="#1A2333"
                                               VerticalAlignment="Center"/>
                                    <Button HorizontalAlignment="Right" Content="Clear all"
                                            FontSize="11" Foreground="#3A8EF6"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" Padding="0"
                                            Command="{Binding ClearFiltersCommand}"
                                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#EEF1F6" Margin="0,0,0,4"/>

                                <!-- Filter options list -->
                                <ItemsControl ItemsSource="{Binding FilterOptions}" Margin="6,0,6,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Margin="0,1" Padding="10,7" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.ToggleFilterOptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding Name}"/>
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#EEF3FF"/>
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F4F7FF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               FontSize="12" Foreground="#2A3A50" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="✓"
                                                               FontSize="12" FontWeight="Bold" Foreground="#3A8EF6"
                                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Rectangle Height="1" Fill="#EEF1F6" Margin="6,0,6,6"/>
                                <CheckBox Content="Include Archived"
                                          IsChecked="{Binding IncludeArchived, Mode=TwoWay}"
                                          FontSize="12" Foreground="#2A3A50"
                                          Margin="14,0,14,10"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════
             CONTENT BODY  — four mutually-exclusive states
        ═══════════════════════════════════════════════════════════════════════ -->

        <!-- ── STATE 1 : Initial / Logo — Google-style centered search ────── -->
        <Grid Grid.Row="1" Visibility="{Binding IsInitial, Converter={StaticResource BoolToVis}}">
            <!-- Shifted well above vertical center (rather than the old -30) to leave clear room below
                 the search bar for the suggestions dropdown before it'd ever have to fight the taskbar. -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-170,0,0">

                <!-- Logo -->
                <Image x:Name="LogoImage" Width="380" Height="140" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,0,0,14"/>

                <!-- Centered search bar (Google-style) -->
                <Grid Width="640" HorizontalAlignment="Center">
                    <Border x:Name="CenterSearchBorder"
                            Background="White"
                            BorderBrush="#C8D4E4"
                            BorderThickness="1.5"
                            CornerRadius="32">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.10" Color="#000000" Direction="270"/>
                        </Border.Effect>

                        <!-- AutoCompleteBox fills the whole pill (icon is an overlay on top of it, not a
                             separate grid column) so its dropdown — sized off the control's own ActualWidth
                             — lines up with the full pill instead of just a text sub-column. -->
                        <Grid>
                            <wpfInput:AutoCompleteBox x:Name="CenterAutoBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ItemsSource="{Binding Suggestions}"
                                     FilterMode="None"
                                     MinimumPrefixLength="2"
                                     MinimumPopulateDelay="0"
                                     IsTextCompletionEnabled="False"
                                     ValueMemberPath="Primary"
                                     MaxDropDownHeight="260"
                                     Height="56" FontSize="15"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="54,0,16,0"
                                     Placeholder="Search by name, serial number, model, SetCode, or request…"
                                     TextBoxStyle="{StaticResource AutoBoxTextBoxStyle}"
                                     ItemTemplate="{StaticResource SuggestionItemTemplate}"
                                     ItemContainerStyle="{StaticResource AutoBoxItemStyle}"
                                     Populating="SearchAutoBox_Populating"
                                     SelectionChanged="SearchAutoBox_SelectionChanged"
                                     PreviewKeyDown="SearchAutoBox_PreviewKeyDown"/>

                            <!-- Search icon (overlay, left) -->
                            <TextBlock Text="&#x1F50D;" FontSize="20"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Margin="20,0,0,0" Foreground="#8A9AB8" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Hint text -->
                <TextBlock Text="Press Enter to search across all modules"
                           FontSize="12" Foreground="#A8B8CC"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── STATE 2 : Loading spinner ────────────────────────────────── -->
        <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Searching…" FontSize="15" Foreground="#5A6A7E"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ── STATE 3 : No results ──────────────────────────────────────── -->
        <Grid Grid.Row="1" Visibility="{Binding IsNoResults, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🔍" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                <TextBlock Text="{Binding NoResultsMessage}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#5A6A7E" HorizontalAlignment="Center"/>
                <TextBlock Text="Try searching by a different name, serial, or model number."
                           FontSize="12" Foreground="#A8B4C0"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ── STATE 4 : Results — split layout (cards + detail panel) ──── -->
        <Grid Grid.Row="1" Visibility="{Binding IsResults, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72*"/>
                <ColumnDefinition Width="28*"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT : Cards area ─────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
                    <RowDefinition Height="Auto"/>  <!-- filter chips + results count -->
                    <RowDefinition Height="*"/>     <!-- cards -->
                    <RowDefinition Height="Auto"/>  <!-- pagination bar -->
                </Grid.RowDefinitions>

                <!-- "Did you mean...?" banner — only shown when these results came from the fuzzy
                     fallback (SearchRepository.FuzzySearchFallbackAsync) rather than an exact match,
                     so typo-corrected guesses are never presented as if they were literal hits. -->
                <Border Grid.Row="0" Padding="18,9"
                        Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="0,0,0,1"
                        Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50D;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#7A5C00" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Filter chips + results count bar -->
                <Border Grid.Row="1" Padding="18,8,14,4"
                        Background="#F8FAFD"
                        BorderBrush="#DDE3EC" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Active filter chips (WrapPanel) -->
                        <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Filtered by:" FontSize="11" Foreground="#7A8FA6"
                                       VerticalAlignment="Center" Margin="0,0,8,3"
                                       Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding FilterOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                Background="#EEF3FF" BorderBrush="#3A8EF6" BorderThickness="1"
                                                CornerRadius="12" Padding="8,3,5,3" Margin="0,0,5,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="#3A6EA8"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="×" FontSize="12" FontWeight="Bold" Foreground="#3A6EA8"
                                                        Style="{StaticResource ChipRemoveBtn}" Margin="3,0,0,0"
                                                        Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Name}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Clear all" FontSize="11" Foreground="#5A6A7E" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="2,0,0,3"
                                    Command="{Binding ClearFiltersCommand}"
                                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>

                        <!-- Results count -->
                        <TextBlock Grid.Column="1" Text="{Binding ResultsCountLabel}"
                                   FontSize="11" Foreground="#9CAABB"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="18,14,14,0">
                    <ItemsControl ItemsSource="{Binding PageCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- ── CARD ─────────────────────────────── -->
                                <Border Style="{StaticResource ResultCard}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <!-- Destination accent bar (top) -->
                                        <Border Height="4" VerticalAlignment="Top" CornerRadius="10,10,0,0"
                                                Background="{Binding Destination, Converter={StaticResource DestBrush}}"/>

                                        <StackPanel Margin="14,14,14,12">

                                            <!-- Title row: name + count badge -->
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayTitle}"
                                                           FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="#1A2333"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DisplayTitle}"/>

                                                <!-- Count / stock badge -->
                                                <Border Grid.Column="1"
                                                        Background="{Binding CountBadgeValue, Converter={StaticResource StockBrush}}"
                                                        CornerRadius="10" Padding="7,2" Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CountBadgeText}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </Grid>

                                            <!-- Subtitle (item name when title differs) -->
                                            <TextBlock Text="{Binding DisplaySubtitle}"
                                                       FontSize="11" Foreground="#5A6A7E"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding DisplaySubtitle, Converter={StaticResource NullToVis}}"/>

                                            <!-- Category chip -->
                                            <Border Background="{Binding Destination, Converter={StaticResource DestLightBrush}}"
                                                    CornerRadius="5" Padding="7,2" Margin="0,7,0,0"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding Destination, Converter={StaticResource DestBrush}}"/>
                                            </Border>

                                            <!-- Type -->
                                            <TextBlock Text="{Binding ItemType}"
                                                       FontSize="10.5" Foreground="#7A8FA6"
                                                       Margin="0,5,0,0"/>

                                            <!-- Model -->
                                            <TextBlock Text="{Binding ModelLabel}"
                                                       FontSize="10" Foreground="#9CAABB"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding ModelLabel, Converter={StaticResource NullToVis}}"/>

                                            <!-- Serial -->
                                            <TextBlock Text="{Binding SerialLabel}"
                                                       FontSize="10" Foreground="#9CAABB"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"
                                                       Visibility="{Binding SerialLabel, Converter={StaticResource NullToVis}}"/>

                                            <!-- Footer: status + destination -->
                                            <Grid Margin="0,8,0,0" VerticalAlignment="Bottom">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Status pill -->
                                                <Border Grid.Column="0" CornerRadius="4" Padding="6,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E6F4EA"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="Archived">
                                                                    <Setter Property="Background" Value="#F5F5F5"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9.5" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="Inactive">
                                                                        <Setter Property="Foreground" Value="#BF360C"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="Archived">
                                                                        <Setter Property="Foreground" Value="#757575"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Destination label (bottom-right) -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                                    <Viewbox Width="8" Height="11" VerticalAlignment="Center" Margin="0,0,3,0">
                                                        <Path Fill="{Binding Destination, Converter={StaticResource DestBrush}}"
                                                              Data="M 10,0 C 4.477,0 0,4.477 0,10 C 0,15.523 10,24 10,24 C 10,24 20,15.523 20,10 C 20,4.477 15.523,0 10,0 Z"/>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding Destination}"
                                                               FontSize="9.5" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Destination, Converter={StaticResource DestBrush}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Pagination bar -->
                <Border Grid.Row="3"
                        Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Results per page -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Per page:" FontSize="11" Foreground="#7A8FA6"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ComboBox ItemsSource="{Binding PageSizeOptions}"
                                      SelectedItem="{Binding SelectedPageSize}"
                                      DisplayMemberPath="Label"
                                      FontSize="11.5" Width="58" Height="30"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Center: Prev / page label / Next (only when multiple pages) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding ShowPagination, Converter={StaticResource BoolToVis}}">
                            <Button Content="◀" Style="{StaticResource PagBtn}"
                                    Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"/>
                            <TextBlock Text="{Binding PageLabel}"
                                       Margin="16,0" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#5A6A7E" VerticalAlignment="Center"/>
                            <Button Content="▶" Style="{StaticResource PagBtn}"
                                    Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
                        </StackPanel>

                        <!-- Right: Jump to page (only when multiple pages) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowPagination, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Go to page:" FontSize="11" Foreground="#7A8FA6"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <Border BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="7">
                                <TextBox x:Name="JumpToPageBox"
                                         Text="{Binding JumpToPage, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11.5" Width="44" Height="28"
                                         BorderThickness="0" Padding="6,0"
                                         VerticalContentAlignment="Center"
                                         KeyDown="JumpToPageBox_KeyDown"/>
                            </Border>
                            <Button Content="→" Style="{StaticResource PagBtn}"
                                    Command="{Binding GoToPageCommand}"
                                    Margin="5,0,0,0" FontSize="13"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RIGHT : Detail panel ───────────────────────────────────── -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#DDE3EC"
                    BorderThickness="1,0,0,0">
                <Grid>

                <!-- Placeholder when nothing selected -->
                <Grid Visibility="{Binding NoSelectedCard, Converter={StaticResource BoolToVis}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <TextBlock Text="📋" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="Select a card to view details"
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#7A8FA6" HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Click any search result on the left to see full item information here."
                                   FontSize="11.5" Foreground="#A8B4C0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Detail content when card is selected -->
                <Grid Visibility="{Binding HasSelectedCard, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Destination accent header -->
                        <RowDefinition Height="*"/>      <!-- Scrollable detail rows -->
                        <RowDefinition Height="Auto"/>   <!-- Navigate button footer -->
                    </Grid.RowDefinitions>

                    <!-- Accent header -->
                    <Border Grid.Row="0"
                            Background="{Binding SelectedCard.Destination, Converter={StaticResource DestLightBrush}}"
                            BorderBrush="{Binding SelectedCard.Destination, Converter={StaticResource DestBrush}}"
                            BorderThickness="0,0,0,1"
                            Padding="22,14,22,16">
                        <StackPanel>
                            <!-- Destination pill -->
                            <Border Background="{Binding SelectedCard.Destination, Converter={StaticResource DestBrush}}"
                                    CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <TextBlock Text="{Binding DetailDestinationLabel}"
                                           FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <!-- Item name -->
                            <TextBlock Text="{Binding DetailItemName}"
                                       FontSize="16" FontWeight="Bold" Foreground="#1A2333"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable field rows -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,4,0,4">
                        <StackPanel>
                            <!-- Group note banner -->
                            <Border Margin="16,10,16,4"
                                    Background="#FFF8E6" BorderBrush="#FFD54F"
                                    BorderThickness="1" CornerRadius="6" Padding="10,6"
                                    Visibility="{Binding DetailHasGroupNote, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding DetailGroupNote}"
                                           FontSize="11" Foreground="#7A5C00" TextWrapping="Wrap"/>
                            </Border>

                            <!-- Detail field rows -->
                            <ItemsControl ItemsSource="{Binding DetailFields}" Margin="16,8,16,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2"
                                                    Background="#FAFBFC" CornerRadius="5" Padding="10,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="115"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#7A8FA6"
                                                               VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               FontSize="11.5" Foreground="#1A2333"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Navigate footer -->
                    <Border Grid.Row="2"
                            Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                            Padding="20,14">
                        <Button Content="{Binding DetailNavigateLabel}"
                                Command="{Binding NavigateToCardCommand}"
                                Style="{StaticResource NavBtn}"
                                HorizontalAlignment="Stretch"/>
                    </Border>
                </Grid>
                </Grid><!-- /wrapping Grid for Border's single-child constraint -->
            </Border>
        </Grid>
    </Grid>
</UserControl>
