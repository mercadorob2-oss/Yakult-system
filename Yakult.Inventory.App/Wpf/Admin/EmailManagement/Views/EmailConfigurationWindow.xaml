<Window x:Class="Yakult.Inventory.App.WPF.Admin.EmailManagement.Views.EmailConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Yakult.Inventory.App.WPF.Admin.EmailManagement.Views"
        Title="Email Configuration"
        Width="1300" Height="800"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource YakultPageBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/YakultPalette.xaml"/>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Admin/EmailManagement/Styles/EmailConfigStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="Email Configuration" FontSize="18" FontWeight="Bold" Foreground="{StaticResource YakultPrimaryBrush}"/>
                <TextBlock Text="Manage email addresses, SMTP profiles, and notification templates"
                           FontSize="10" Foreground="{StaticResource YakultTextMutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 1 · Tabs -->
        <TabControl x:Name="MainTabControl" Grid.Row="1" Margin="12" Background="Transparent" BorderThickness="0">
            <TabItem Header="Email Addresses">
                <views:EmailAddressesTabView x:Name="EmailAddressesTab"/>
            </TabItem>
            <TabItem Header="SMTP Profiles">
                <views:SmtpProfilesTabView x:Name="SmtpProfilesTab"/>
            </TabItem>
            <TabItem Header="Email Templates">
                <views:EmailTemplatesTabView x:Name="EmailTemplatesTab"/>
            </TabItem>
        </TabControl>

        <!-- Row 2 · Bottom bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnSendTestEmail" DockPanel.Dock="Left" Background="#9575CD"
                        Style="{StaticResource ActionButton}" Content="Send Test Email"
                        Click="BtnSendTestEmail_Click"/>
                <Button x:Name="BtnClose" DockPanel.Dock="Right" Background="{StaticResource YakultTextMutedBrush}"
                        Style="{StaticResource ActionButton}" Content="Close"
                        Click="BtnClose_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
