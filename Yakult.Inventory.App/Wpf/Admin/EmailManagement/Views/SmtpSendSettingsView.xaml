<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.EmailManagement.Views.SmtpSendSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             xmlns:smtpConv="clr-namespace:Yakult.Inventory.App.WPF.Admin.EmailManagement.Converters"
             Background="#F0F2F6">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Admin/EmailManagement/Styles/EmailConfigStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <smtpConv:NullableProfileIdConverter x:Key="NullableProfileId"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,14,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SMTP Send Settings" FontSize="18" FontWeight="Bold" Foreground="#1A2333"/>
                <TextBlock Text="Global SMTP switch · Default profile · Per-template profile and enable/disable."
                           FontSize="10" Foreground="#5A6A7A" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="BtnRefresh" Content="⟳" Width="40" Height="40" FontSize="16" FontWeight="Bold"
                    Foreground="White" Background="#4E9AFC" Cursor="Hand" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnRefresh_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A8EF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Row 1 · Two cards -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Global toggle card -->
            <Border x:Name="GlobalToggleCard" Grid.Column="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                    CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Global SMTP Switch" FontWeight="Bold" FontSize="12" Foreground="#3C3C3C"/>
                    <TextBlock x:Name="LblGlobalStatus" Text="Loading…" FontWeight="Bold" FontSize="11"
                               Foreground="#787878" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="BtnToggleGlobal" Content="…" Width="110" Height="34" Margin="0,12,0,0"
                            Foreground="White" Cursor="Hand" BorderThickness="0"
                            HorizontalAlignment="Left"
                            Style="{StaticResource ActionButton}" Click="BtnToggleGlobal_Click"/>
                </StackPanel>
            </Border>

            <!-- Apply profile card -->
            <Border Grid.Column="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                    CornerRadius="6" Padding="16">
                <StackPanel>
                    <TextBlock Text="Apply Profile to Templates" FontWeight="Bold" FontSize="12" Foreground="#3C3C3C"/>
                    <Grid Margin="0,10,0,0">
                        <ComboBox x:Name="CboGlobalProfile" Width="260" Height="26" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Profiles}"
                                  DisplayMemberPath="ProfileName"
                                  SelectedItem="{Binding SelectedGlobalProfile, Mode=TwoWay}"/>
                    </Grid>
                    <Button x:Name="BtnApplySome" Content="Apply to" Width="110" Height="34" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Background="#4E9AFC" Style="{StaticResource ActionButton}"
                            Click="BtnApplySome_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2 · Templates -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="6" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Email Templates" FontWeight="Bold" FontSize="12" Foreground="#3C3C3C"/>
                        <TextBlock Text="Choose a profile per template and check/uncheck SMTP Enabled to control per-template sending."
                                   FontSize="9.5" Foreground="#8C8C8C" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnTurnOffSome" Content="Turn Off Some…" Width="130" Height="26"
                            Background="#E74C3C" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnTurnOffSome_Click"/>
                </Grid>

                <DataGrid x:Name="GridTemplates" Grid.Row="1"
                          Background="White" BorderBrush="#DDE3EC" BorderThickness="0"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#EEF1F4" VerticalGridLinesBrush="#E4E8EF"
                          AlternationCount="2"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          AutoGenerateColumns="False" SelectionMode="Single"
                          RowHeaderWidth="0" FontFamily="Segoe UI" FontSize="11.5"
                          ItemsSource="{Binding Templates}"
                          VirtualizingPanel.IsVirtualizing="False">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TemplateId}" Width="80" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Template Key" Binding="{Binding TemplateKey}" Width="200" IsReadOnly="True"/>

                        <DataGridTextColumn Header="Subject" Binding="{Binding SubjectTemplate}" Width="*" IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="SMTP Profile" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.ProfilesWithNone, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DisplayMemberPath="ProfileName"
                                              SelectedValuePath="ProfileId"
                                              SelectedValue="{Binding DefaultSmtpProfileId, Mode=OneWay, Converter={StaticResource NullableProfileId}}"
                                              BorderThickness="0" Margin="2"
                                              SelectionChanged="ProfileCombo_SelectionChanged"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridCheckBoxColumn Header="SMTP Enabled" Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" Width="165">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <EventSetter Event="Click" Handler="ActiveCheckBox_Click"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
