<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.EmailManagement.Views.EmailLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Admin.EmailManagement.Views"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToCardBrushConverter  x:Key="BoolToCardBrush"/>
        <local:EmailLogStatusToBrushConverter x:Key="StatusBrush"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <!-- Clickable summary card: acts as a status filter toggle -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="96"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#B0BAC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow"
                                          DockPanel.Dock="Right"
                                          Width="8" Height="6"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="White" Opacity="0.4"
                                          Stretch="Uniform"
                                          Data="M 1,2.5 L 4,0 L 7,2.5 Z M 1,3.5 L 4,6 L 7,3.5 Z"/>
                                    <Button x:Name="FilterBtn"
                                            DockPanel.Dock="Right"
                                            Tag="{TemplateBinding Content}"
                                            Padding="3,0"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Filter this column">
                                        <Path Data="M 0,0 H 7 L 4.5,3.5 V 7 H 2.5 V 3.5 Z"
                                              Fill="White" Width="7" Height="7" Stretch="Fill" Opacity="0.75"/>
                                    </Button>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"  Width="8" Cursor="SizeWE" Opacity="0"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,5 L 4,0 L 8,5 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,0 L 4,5 L 8,0 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slim custom scrollbars (6px) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#4E9AFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Page header (left) + clickable summary cards (right) -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Email Logs" FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                    <TextBlock Text="Delivery history for every system email — click a card to filter by status"
                               FontSize="10" Foreground="#5A6A7A" Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatCard}"
                            Background="{Binding IsAllCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectStatusCommand}" CommandParameter="All"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="TOTAL LOGS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Foreground="#1A2333"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}"
                            Background="{Binding IsSentCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectStatusCommand}" CommandParameter="Sent"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="SENT" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SentCount}" FontSize="20" FontWeight="Bold" Foreground="#2E9E5B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}"
                            Background="{Binding IsFailedCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectStatusCommand}" CommandParameter="Failed"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="FAILED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding FailedCount}" FontSize="20" FontWeight="Bold" Foreground="#DC3545"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0"
                            Background="{Binding IsSkippedCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SelectStatusCommand}" CommandParameter="Skipped"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding SkippedCount}" FontSize="20" FontWeight="Bold" Foreground="#E0A106"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1 · Action panel: search + filters -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#B0BAC8" BorderThickness="1" CornerRadius="5"
                            Padding="8,0" Height="28" Margin="0,0,10,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                            <TextBox x:Name="TxtSearch"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="11" Width="210" VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Template, Recipients, Subject, Status or Sent By"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Status:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="110" Margin="0,0,12,8"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding StatusFilter, Mode=TwoWay}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Sent"/>
                        <ComboBoxItem Content="Failed"/>
                        <ComboBoxItem Content="Skipped"/>
                    </ComboBox>

                    <TextBlock Text="Template:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="200" Margin="0,0,12,8"
                              ItemsSource="{Binding TemplateOptions}"
                              SelectedItem="{Binding TemplateFilter, Mode=TwoWay}"/>

                    <TextBlock Text="From:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <DatePicker Width="120" Height="28" Margin="0,0,10,8" FontSize="11"
                                SelectedDate="{Binding FromDate, Mode=TwoWay}"/>

                    <TextBlock Text="To:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <DatePicker Width="120" Height="28" Margin="0,0,12,8" FontSize="11"
                                SelectedDate="{Binding ToDate, Mode=TwoWay}"/>

                    <Button Background="#8896A7" Style="{StaticResource ActionButton}"
                            Content="↺  Reset Filters" Command="{Binding ResetFiltersCommand}"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button x:Name="BtnRefresh" Background="#4E9AFC"
                            Style="{StaticResource ActionButton}" Content="⟳  Refresh" Margin="0"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2 · DataGrid -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="2"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#EEF1F4"
                  VerticalGridLinesBrush="#E4E8EF"
                  AlternationCount="2"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  IsReadOnly="True"
                  ItemsSource="{Binding PagedRows}"
                  VirtualizingPanel.IsVirtualizing="False"
                  Sorting="MainGrid_Sorting"
                  ButtonBase.Click="MainGrid_HeaderButtonClick">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#B8CEED"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#1A2333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#CDD8EE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding LogId}" Width="70" SortMemberPath="LogId">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"             Value="8,6"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Foreground"          Value="#7A8A9A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Date" Binding="{Binding SentDate, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150" SortMemberPath="SentDate">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"    Value="8,6"/>
                            <Setter Property="Foreground" Value="#5A6A7A"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Template" Binding="{Binding TemplateKey}" Width="200" SortMemberPath="TemplateKey">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="8,6"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Recipients" Binding="{Binding Recipients}" Width="*" SortMemberPath="Recipients">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="8,6"/>
                            <Setter Property="Foreground"   Value="#5A6A7A"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*" SortMemberPath="Subject">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="8,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" SortMemberPath="Status">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"             Value="8,6"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight"          Value="SemiBold"/>
                            <Setter Property="Foreground"          Value="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Sent By" Binding="{Binding SentByUserName}" Width="130" SortMemberPath="SentByUserName">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="8,6"/>
                            <Setter Property="Foreground"   Value="#5A6A7A"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3 · Pagination -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="«" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Command="{Binding FirstPageCommand}"/>
                <Button Content="‹" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Command="{Binding PrevPageCommand}"/>
                <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="8,0"/>
                <Button Content="›" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Command="{Binding NextPageCommand}"/>
                <Button Content="»" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Command="{Binding LastPageCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
