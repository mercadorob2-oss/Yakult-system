<Window x:Class="Yakult.Inventory.App.WPF.Admin.EmailManagement.Views.TurnOffTemplatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Turn Off SMTP for Selected Templates"
        Width="520" Height="500" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Admin/EmailManagement/Styles/EmailConfigStyles.xaml"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Select templates to disable SMTP sending:" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSelectAll" Content="Select All" Width="88" Height="26"
                        Background="#EEF3FA" Foreground="#3A8EF6" Style="{StaticResource ActionButton}"
                        Click="BtnSelectAll_Click"/>
                <Button x:Name="BtnClearAll" Content="Clear All" Width="88" Height="26"
                        Background="#EEF3FA" Foreground="#5A6A7A" Style="{StaticResource ActionButton}"
                        Click="BtnClearAll_Click"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" x:Name="LstTemplates" BorderBrush="#CDD5DE" BorderThickness="1"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding TemplateKey}" IsChecked="{Binding IsSelected}" Margin="4,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="LblSelectedCount" Text="0 selected" Foreground="#5A6A7A" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="32"
                        Background="#EEF3FA" Foreground="#5A6A7A" Style="{StaticResource ActionButton}"
                        IsCancel="True" Click="BtnCancel_Click"/>
                <Button x:Name="BtnTurnOff" Content="Turn Off" Width="100" Height="32"
                        Background="#E74C3C" Style="{StaticResource ActionButton}"
                        IsDefault="True" Click="BtnTurnOff_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
