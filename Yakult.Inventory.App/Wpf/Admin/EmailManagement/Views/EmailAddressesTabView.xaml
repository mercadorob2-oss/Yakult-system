<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.EmailManagement.Views.EmailAddressesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Admin/EmailManagement/Styles/EmailConfigStyles.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BtnAdd"        Background="#4E9AFC" Style="{StaticResource ActionButton}" Content="✚  Add Email"  Click="BtnAdd_Click"/>
                    <Button x:Name="BtnEdit"       Background="#3A8EF6" Style="{StaticResource ActionButton}" Content="✎  Edit"       Click="BtnEdit_Click"/>
                    <Button x:Name="BtnSave"       Background="#1E9E5E" Style="{StaticResource ActionButton}" Content="💾  Save Changes" Click="BtnSave_Click"/>
                    <Button x:Name="BtnDeactivate" Background="#C0392B" Style="{StaticResource ActionButton}" Content="Deactivate"    Click="BtnDeactivate_Click"/>
                    <Button x:Name="BtnDelete"     Background="#7A1E14" Style="{StaticResource ActionButton}" Content="🗑  Delete"   Click="BtnDelete_Click"/>
                    <Button x:Name="BtnLinked"     Background="#5A6A7A" Style="{StaticResource ActionButton}" Content="🔗  Linked Records" Click="BtnLinked_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button x:Name="BtnRefresh" Background="#4E9AFC" Style="{StaticResource ActionButton}" Content="⟳  Refresh" Click="BtnRefresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1 · Search -->
        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="#EEF1F4" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                <TextBox x:Name="TxtSearch"
                         Style="{StaticResource SearchBox}"
                         Width="320" Padding="8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by email address or display name"/>
            </StackPanel>
        </Border>

        <!-- Row 2 · DataGrid -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="2"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#EEF1F4"
                  VerticalGridLinesBrush="#E4E8EF"
                  AlternationCount="2"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  IsReadOnly="False"
                  ItemsSource="{Binding PagedRows}"
                  VirtualizingPanel.IsVirtualizing="False"
                  Sorting="MainGrid_Sorting"
                  ButtonBase.Click="MainGrid_HeaderButtonClick">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                    Color="#B8CEED"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                Color="#1A2333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"   Color="#CDD8EE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding EmailId}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Email Address" Binding="{Binding EmailAddress, UpdateSourceTrigger=LostFocus}" Width="*"/>
                <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, UpdateSourceTrigger=LostFocus}" Width="220"/>
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3 · Pagination -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnFirst" Content="«" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Click="BtnFirst_Click"/>
                <Button x:Name="BtnPrev"  Content="‹" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Click="BtnPrev_Click"/>
                <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="8,0"/>
                <Button x:Name="BtnNext" Content="›" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Click="BtnNext_Click"/>
                <Button x:Name="BtnLast" Content="»" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Click="BtnLast_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
