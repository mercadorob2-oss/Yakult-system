<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.ShowDeptPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Department Account Password"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A9AB0"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#1A2333"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <StackPanel Background="White">
        <!-- Header -->
        <Border Background="#4E9AFC" Padding="20,14">
            <TextBlock Text="Department Account Password" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <StackPanel Margin="24,18,24,0">
            <!-- Info -->
            <TextBlock Style="{StaticResource InfoLabel}" Text="COMPANY"/>
            <TextBlock x:Name="TxtCompany"  Style="{StaticResource InfoValue}"/>
            <TextBlock Style="{StaticResource InfoLabel}" Text="DEPARTMENT"/>
            <TextBlock x:Name="TxtDept"     Style="{StaticResource InfoValue}"/>
            <TextBlock Style="{StaticResource InfoLabel}" Text="BRANCH"/>
            <TextBlock x:Name="TxtBranch"   Style="{StaticResource InfoValue}"/>
            <TextBlock Style="{StaticResource InfoLabel}" Text="USERNAME"/>
            <TextBlock x:Name="TxtUsername" Style="{StaticResource InfoValue}" Margin="0,0,0,4"/>

            <Separator Background="#DDE3EC" Margin="0,0,0,14"/>

            <!-- Password display -->
            <TextBlock Text="PASSWORD" FontSize="9" FontWeight="SemiBold"
                       Foreground="#8A9AB0" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,24">
                <Button x:Name="BtnCopy" DockPanel.Dock="Right"
                        Content="Copy" Width="70" Height="36"
                        Background="#4E9AFC" Foreground="White"
                        BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Click="BtnCopy_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="8,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Background="#F4F6FA" BorderBrush="#DDE3EC" BorderThickness="1"
                        CornerRadius="5" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtPassword"
                               FontSize="14" FontWeight="Bold" Foreground="#1A2333"
                               Padding="10,8" TextWrapping="Wrap"
                               FontFamily="Consolas"/>
                </Border>
            </DockPanel>
        </StackPanel>

        <!-- Footer -->
        <Border Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Height="32" Padding="20,0"
                        Background="#4E9AFC" Foreground="White"
                        BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnClose_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
