<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.ExportFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Employees — Filter"
        Width="420"
        SizeToContent="Height"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#4E9AFC"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FooterBtn" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#C8D0DC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Background="White">
        <!-- Header -->
        <Border Background="#4E9AFC" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Export Employees" Foreground="White" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="Applies on top of your current search/filter — choose branches and status to include" Foreground="#EAF2FF" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="20,16,20,0">
            <!-- Branch multi-select -->
            <Grid Margin="0,0,0,8">
                <TextBlock Text="BRANCHES" FontSize="10" FontWeight="SemiBold" Foreground="#5A6A7A" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Select All" Style="{StaticResource LinkBtn}" Click="BtnSelectAllBranches_Click"/>
                    <TextBlock Text=" · " Foreground="#999" VerticalAlignment="Center" FontSize="11"/>
                    <Button Content="Clear All" Style="{StaticResource LinkBtn}" Click="BtnClearAllBranches_Click"/>
                </StackPanel>
            </Grid>

            <TextBox x:Name="TxtSearch" Style="{StaticResource SearchBox}" Margin="0,0,0,6"
                     TextChanged="TxtSearch_TextChanged"/>

            <Border BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="5">
                <ListBox x:Name="BranchList"
                         MaxHeight="260"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding"  Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EEF4FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      Content="{Binding Label}"
                                      Padding="8,5,8,5"
                                      FontSize="12"
                                      Foreground="#2D3A4A"
                                      Checked="AnyCheckBox_Changed"
                                      Unchecked="AnyCheckBox_Changed"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="TxtBranchCount" FontSize="10" Foreground="#8A97A6" Margin="0,4,0,0"/>

            <!-- Status -->
            <CheckBox x:Name="ChkIncludeArchived"
                      Content="Include archived employees"
                      FontSize="12" Foreground="#2D3A4A"
                      Margin="0,16,0,4"
                      Checked="AnyCheckBox_Changed"
                      Unchecked="AnyCheckBox_Changed"/>

            <TextBlock x:Name="TxtMatchCount" FontSize="10" Foreground="#8A97A6" Margin="0,4,0,18"/>
        </StackPanel>

        <!-- Footer -->
        <Border Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource FooterBtn}"
                        Background="White" Foreground="#5A6A7A" BorderBrush="#CDD5DE"
                        Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="Export" Style="{StaticResource FooterBtn}"
                        Background="#4E9AFC" Foreground="White" BorderThickness="0"
                        Click="BtnExport_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
