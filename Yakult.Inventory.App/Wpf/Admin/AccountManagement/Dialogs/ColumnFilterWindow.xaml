<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.ColumnFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Column Filter"
        Width="290"
        SizeToContent="Height"
        MaxHeight="540"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="#4E9AFC"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FooterBtn" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Header -->
        <Border Background="#4E9AFC" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="▾ " Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeader" Text="Filter" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Search box with placeholder -->
        <Border Padding="10,10,10,6">
            <Grid>
                <TextBox x:Name="TxtSearch"
                         Padding="8,5"
                         BorderBrush="#C8D0DC"
                         BorderThickness="1"
                         TextChanged="TxtSearch_TextChanged"/>
                <TextBlock IsHitTestVisible="False"
                           Text="Search values…"
                           Foreground="#AABBCC"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Select All / Clear All links -->
        <StackPanel Orientation="Horizontal" Margin="10,0,10,8">
            <Button Content="Select All" Style="{StaticResource LinkBtn}" Click="BtnSelectAll_Click"/>
            <TextBlock Text=" · " Foreground="#999" VerticalAlignment="Center" FontSize="11"/>
            <Button Content="Clear All" Style="{StaticResource LinkBtn}" Click="BtnClearAll_Click"/>
        </StackPanel>

        <Separator/>

        <!-- Checkbox list -->
        <ListBox x:Name="FilterList"
                 MaxHeight="220"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding"  Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#EEF4FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              Content="{Binding Label}"
                              Padding="8,5,8,5"
                              FontSize="12"
                              Foreground="#2D3A4A"
                              Checked="AnyCheckBox_Changed"
                              Unchecked="AnyCheckBox_Changed"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Separator/>

        <!-- Footer: count + buttons -->
        <Border Padding="10,8,10,10" Background="#F5F7FA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtCount"
                           Grid.Column="0"
                           FontSize="11"
                           Foreground="#6B7A8D"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Apply"
                            Style="{StaticResource FooterBtn}"
                            Background="#4E9AFC" Foreground="White" BorderBrush="#3A8EF6"
                            Margin="0,0,6,0"
                            Click="BtnApply_Click"/>
                    <Button Content="Clear Filter"
                            Style="{StaticResource FooterBtn}"
                            Background="#FFF3E0" Foreground="#E65100" BorderBrush="#FFB74D"
                            Margin="0,0,6,0"
                            Click="BtnClearFilter_Click"/>
                    <Button Content="Cancel"
                            Style="{StaticResource FooterBtn}"
                            Background="White" Foreground="#2D3A4A" BorderBrush="#C8D0DC"
                            Click="BtnCancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Window>
