<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.VerifyAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify Your Identity"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Background="White">
        <!-- Header -->
        <Border Background="#4E9AFC" Padding="20,14">
            <StackPanel>
                <TextBlock Text="🔒  Verify Your Identity" Foreground="White" FontSize="15" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,0">
            <TextBlock x:Name="TxtPrompt" FontSize="12" Foreground="#3A4A5A"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="YOUR PASSWORD" FontSize="10" FontWeight="SemiBold"
                       Foreground="#5A6A7A" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PwdEntry" Style="{StaticResource PwdBox}" Margin="0,0,0,24"/>
        </StackPanel>

        <!-- Footer -->
        <Border Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="32"
                        Background="White" Foreground="#5A6A7A"
                        BorderBrush="#CDD5DE" BorderThickness="1"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,8,0" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="8,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnConfirm" Content="Confirm" Height="32" Padding="20,0"
                        Background="#4E9AFC" Foreground="White"
                        BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
