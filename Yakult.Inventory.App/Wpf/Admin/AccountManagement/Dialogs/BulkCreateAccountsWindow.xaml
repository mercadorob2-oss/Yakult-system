<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.BulkCreateAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Create Accounts"
        Width="1180" Height="720" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F6"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A7A"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
        </Style>

        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,8"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow"
                                          DockPanel.Dock="Right"
                                          Width="8" Height="6" Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="White" Opacity="0.4" Stretch="Uniform"
                                          Data="M 1,2.5 L 4,0 L 7,2.5 Z M 1,3.5 L 4,6 L 7,3.5 Z"/>
                                    <Button x:Name="FilterBtn"
                                            DockPanel.Dock="Right"
                                            Tag="{TemplateBinding Content}"
                                            Padding="3,0" Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" ToolTip="Filter this column">
                                        <Path Data="M 0,0 H 7 L 4.5,3.5 V 7 H 2.5 V 3.5 Z"
                                              Fill="White" Width="7" Height="7" Stretch="Fill" Opacity="0.75"/>
                                    </Button>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,5 L 4,0 L 8,5 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,0 L 4,5 L 8,0 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Result grid header: same look, no filter button -->
        <Style x:Key="PlainHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#4E9AFC"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="BorderBrush"     Value="#3A8EF6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4E9AFC" Padding="20,12">
            <StackPanel>
                <TextBlock Text="Bulk Create Accounts" Foreground="White" FontSize="16" FontWeight="Bold"/>
                <TextBlock Foreground="#E6F0FF" FontSize="11" Margin="0,3,0,0"
                           Text="Accounts are created for the employees listed below. Use the column filters to narrow the list. Employees that already have an account are not listed."/>
            </StackPanel>
        </Border>

        <!-- Password options -->
        <Border x:Name="OptionsPanel" Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="20,12">
            <StackPanel>
                <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbTemp" GroupName="PwdMode" IsChecked="True" VerticalAlignment="Center"
                                 Content="Temporary password (auto-generated, different for each account)"
                                 FontSize="12" Margin="0,0,24,0" Checked="PwdMode_Changed"/>
                    <RadioButton x:Name="RbManual" GroupName="PwdMode" VerticalAlignment="Center"
                                 Content="Manual password (same for every account)"
                                 FontSize="12" Checked="PwdMode_Changed"/>
                </StackPanel>

                <StackPanel x:Name="ManualPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PwdPassword" Width="200" Style="{StaticResource PwdBox}"/>
                        <TextBox x:Name="TxtPwdVisible" Width="200" Style="{StaticResource InputBox}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="PwdConfirm" Width="200" Style="{StaticResource PwdBox}"/>
                        <TextBox x:Name="TxtConfVisible" Width="200" Style="{StaticResource InputBox}" Visibility="Collapsed"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkShow" Content="Show password" FontSize="11" Foreground="#5A6A7A"
                              VerticalAlignment="Bottom" Margin="0,0,0,6"
                              Checked="ChkShow_Changed" Unchecked="ChkShow_Changed"/>
                </StackPanel>

                <CheckBox x:Name="ChkMustChange" IsChecked="True" Margin="0,10,0,0" FontSize="12"
                          Content="Require the user to change the password at first login"/>

                <CheckBox x:Name="ChkAssignRole" IsChecked="True" Margin="0,6,0,0" FontSize="12"
                          Content="Assign the system role from position (Manager positions to Manager, Supervisor to Supervisor)"
                          ToolTip="IT Manager and IT Supervisor are IT Department roles and are never assigned here. Coordinators get no role."/>
            </StackPanel>
        </Border>

        <!-- Summary -->
        <Border Grid.Row="2" Padding="20,10,20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSummary" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearFilters" Content="Clear all filters" Margin="16,0,0,0" Padding="8,2"
                            FontSize="11" Cursor="Hand" Click="BtnClearFilters_Click"/>
                </StackPanel>
                <Border x:Name="SearchPanel" Grid.Column="1" Background="White" BorderBrush="#B0BAC8" BorderThickness="1"
                        CornerRadius="5" Padding="8,0" Height="28" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                        <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                                 FontSize="11" Width="280" VerticalContentAlignment="Center"
                                 ToolTip="Search any column: name, number, position, department, company, branch, role. Separate words to match all of them."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Preview grid (filterable) and results grid share one cell -->
        <Grid Grid.Row="3" Margin="20,0,20,0">
            <DataGrid x:Name="PreviewGrid"
                      Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#EEF1F4" VerticalGridLinesBrush="#E4E8EF"
                      AlternationCount="2"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AutoGenerateColumns="False" SelectionMode="Single"
                      RowHeaderWidth="0" FontSize="12" IsReadOnly="True"
                      Sorting="PreviewGrid_Sorting"
                      ButtonBase.Click="PreviewGrid_HeaderButtonClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False"
                                            HeaderStyle="{StaticResource PlainHeader}">
                        <DataGridTemplateColumn.Header>
                            <CheckBox x:Name="ChkAll" HorizontalAlignment="Center" Click="ChkAll_Click"
                                      ToolTip="Select / deselect all listed employees (all pages)"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          Click="RowCheck_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Employee #"    Binding="{Binding EmployeeNumber}" Width="90"/>
                    <DataGridTextColumn Header="Title"         Binding="{Binding Title}"          Width="70"/>
                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}"   Width="*"/>
                    <DataGridTextColumn Header="Position"      Binding="{Binding Position}"       Width="150"/>
                    <DataGridTextColumn Header="Department"    Binding="{Binding Department}"     Width="140"/>
                    <DataGridTextColumn Header="Company"       Binding="{Binding Company}"        Width="90"/>
                    <DataGridTextColumn Header="Branch"        Binding="{Binding Branch}"         Width="130"/>
                    <DataGridTextColumn Header="Is Approver"   Binding="{Binding IsApprover}"     Width="90"/>
                    <DataGridTextColumn Header="System Role(s)" Binding="{Binding SystemRoles}"   Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid x:Name="ResultsGrid" Visibility="Collapsed"
                      Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="#EEF1F4" VerticalGridLinesBrush="#E4E8EF"
                      AlternationCount="2"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      AutoGenerateColumns="False" SelectionMode="Extended"
                      RowHeaderWidth="0" FontSize="12" IsReadOnly="True"
                      ColumnHeaderStyle="{StaticResource PlainHeader}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Employee #"    Binding="{Binding EmployeeNumber}" Width="90"/>
                    <DataGridTextColumn Header="Employee Name" Binding="{Binding EmployeeName}"   Width="*"/>
                    <DataGridTextColumn Header="Username"      Binding="{Binding Username}"       Width="200"/>
                    <DataGridTextColumn Header="Email"         Binding="{Binding Email}"          Width="220"/>
                    <DataGridTextColumn Header="Role"          Binding="{Binding Role}"           Width="90"/>
                    <DataGridTextColumn Header="Password"      Binding="{Binding Password}"       Width="160"/>
                    <DataGridTextColumn Header="Status"        Binding="{Binding Status}"         Width="80"/>
                    <DataGridTextColumn Header="Note"          Binding="{Binding Message}"        Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Pagination -->
        <Border x:Name="PagerPanel" Grid.Row="4" Padding="20,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnFirst" Content="«" Style="{StaticResource PageButton}" Click="BtnFirst_Click"/>
                <Button x:Name="BtnPrev"  Content="‹" Style="{StaticResource PageButton}" Click="BtnPrev_Click"/>
                <TextBlock x:Name="TxtPageInfo" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="8,0"/>
                <Button x:Name="BtnNext"  Content="›" Style="{StaticResource PageButton}" Click="BtnNext_Click"/>
                <Button x:Name="BtnLast"  Content="»" Style="{StaticResource PageButton}" Click="BtnLast_Click"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="5" Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar x:Name="Progress" Height="6" Visibility="Collapsed" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtStatus" FontSize="11" Foreground="#5A6A7A" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnExport" Content="Save results as CSV" Background="#3A8EF6"
                            Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                            Visibility="Collapsed" Click="BtnExport_Click"/>
                    <Button x:Name="BtnCreate" Content="Create Accounts" Background="#4E9AFC"
                            Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnCreate_Click"/>
                    <Button x:Name="BtnClose" Content="Close" Background="#7A8A9A"
                            Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
