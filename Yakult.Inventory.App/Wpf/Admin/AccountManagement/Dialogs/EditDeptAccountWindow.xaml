<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.EditDeptAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Department Account"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A7A"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A9AB0"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#1A2333"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,12"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#43A047"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Background="White">
        <!-- Header -->
        <Border Background="#43A047" Padding="20,14">
            <TextBlock Text="Edit Department Account" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <StackPanel Margin="24,16,24,0">
            <!-- Info -->
            <TextBlock Style="{StaticResource InfoLabel}" Text="COMPANY"/>
            <TextBlock x:Name="TxtCompany"    Style="{StaticResource InfoValue}"/>
            <TextBlock Style="{StaticResource InfoLabel}" Text="DEPARTMENT"/>
            <TextBlock x:Name="TxtDept"       Style="{StaticResource InfoValue}"/>
            <TextBlock Style="{StaticResource InfoLabel}" Text="BRANCH"/>
            <TextBlock x:Name="TxtBranch"     Style="{StaticResource InfoValue}" Margin="0,0,0,4"/>

            <Separator Background="#DDE3EC" Margin="0,0,0,16"/>

            <!-- Username -->
            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtUsername" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

            <!-- Active -->
            <CheckBox x:Name="ChkIsActive" Content="Account is Active"
                      FontSize="12" Foreground="#1A2333" Margin="0,0,0,16"/>

            <!-- Email -->
            <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="CboEmail" Height="32" FontSize="12"
                      BorderBrush="#B0BAC8" BorderThickness="1"
                      Margin="0,0,0,24"/>
        </StackPanel>

        <!-- Footer -->
        <Border Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="32"
                        Background="White" Foreground="#5A6A7A"
                        BorderBrush="#CDD5DE" BorderThickness="1"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,8,0" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="8,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnSave" Content="Save Changes" Height="32" Padding="16,0"
                        Background="#43A047" Foreground="White"
                        BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnSave_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
