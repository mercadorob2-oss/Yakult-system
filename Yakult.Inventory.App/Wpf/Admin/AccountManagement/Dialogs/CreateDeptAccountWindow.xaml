<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.CreateDeptAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Department Account"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5A6A7A"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Background="White">
        <!-- Header -->
        <Border Background="#4E9AFC" Padding="20,14">
            <TextBlock Text="Create Department Account" Foreground="White"
                       FontSize="15" FontWeight="Bold"/>
        </Border>

        <StackPanel Margin="24,16,24,0">
            <!-- Info chip -->
            <Border Background="#EBF5FF" CornerRadius="5" Padding="10,6" Margin="0,0,0,18">
                <TextBlock x:Name="TxtInfo" FontSize="11" Foreground="#3A6A9A" TextWrapping="Wrap"/>
            </Border>

            <!-- Username -->
            <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="TxtUsername" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

            <!-- Password -->
            <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PwdPassword"  Style="{StaticResource PwdBox}"    Margin="0,0,0,14"/>
            <TextBox    x:Name="TxtPwdVisible" Style="{StaticResource InputBox}"  Margin="0,0,0,14" Visibility="Collapsed"/>

            <!-- Confirm Password -->
            <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PwdConfirm"   Style="{StaticResource PwdBox}"    Margin="0,0,0,10"/>
            <TextBox    x:Name="TxtConfVisible" Style="{StaticResource InputBox}" Margin="0,0,0,10" Visibility="Collapsed"/>

            <!-- Show password toggle -->
            <CheckBox x:Name="ChkShow" Content="Show password" FontSize="11" Foreground="#5A6A7A"
                      Margin="0,0,0,20" Checked="ChkShow_Changed" Unchecked="ChkShow_Changed"/>
        </StackPanel>

        <!-- Footer -->
        <Border Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="32"
                        Background="White" Foreground="#5A6A7A"
                        BorderBrush="#CDD5DE" BorderThickness="1"
                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,8,0" Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnCreate" Content="Create Account" Height="32" Padding="16,0"
                        Background="#4E9AFC" Foreground="White"
                        BorderThickness="0" FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnCreate_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
