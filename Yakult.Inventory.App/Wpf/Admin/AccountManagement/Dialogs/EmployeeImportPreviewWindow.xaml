<Window x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Dialogs.EmployeeImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Preview — Cross-Check Employees"
        Width="1280" Height="760"
        MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="FooterBtn" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#4E9AFC"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush"               Value="#C8D0DC"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="White" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#22303F"/>
        </Style>

        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#5A6A7A"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="New">
                    <Setter Property="Foreground" Value="#1E8E3E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Update">
                    <Setter Property="Foreground" Value="#B26A00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Unchanged">
                    <Setter Property="Foreground" Value="#8A97A6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusText}" Value="Invalid">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InFileTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding InFile}" Value="True">
                    <Setter Property="Foreground" Value="#1E8E3E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding InFile}" Value="False">
                    <Setter Property="Foreground" Value="#B26A00"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#4E9AFC" Padding="20,14">
            <StackPanel>
                <TextBlock Text="Import Preview — Cross-Check Employees" Foreground="White" FontSize="15" FontWeight="Bold"/>
                <TextBlock x:Name="TxtFileName" Foreground="#EAF2FF" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Summary strip -->
        <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="20,10">
            <TextBlock x:Name="TxtSummary" FontSize="12" Foreground="#3A4A5A" FontWeight="SemiBold"/>
        </Border>

        <!-- Two-panel cross-check -->
        <Grid Grid.Row="2" Margin="16,12,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Existing employees currently in the database -->
            <Border Grid.Column="0" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="Existing Employees (Database)" Style="{StaticResource PanelHeader}"/>
                            <TextBox x:Name="TxtSearchExisting" Style="{StaticResource SearchBox}" Margin="0,8,0,0"
                                     TextChanged="TxtSearchExisting_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridExisting"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="28"
                              FontSize="11"
                              BorderThickness="0"
                              AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Emp #"   Binding="{Binding EmployeeNumber}" Width="70"/>
                            <DataGridTextColumn Header="Name"    Binding="{Binding Name}"           Width="1.4*"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}"      Width="1.1*"/>
                            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}"    Width="0.7*"/>
                            <DataGridTextColumn Header="Branch"  Binding="{Binding BranchName}"     Width="1*"/>
                            <DataGridTextColumn Header="Dept"    Binding="{Binding DepartmentName}" Width="1*"/>
                            <DataGridTemplateColumn Header="In Import File?" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InFileText}" Style="{StaticResource InFileTextStyle}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Right: rows parsed from the import file -->
            <Border Grid.Column="2" BorderBrush="#DDE3EC" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Import File Rows" Style="{StaticResource PanelHeader}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Select All (New/Update)" Style="{StaticResource LinkBtn}" Click="BtnSelectAllValid_Click"/>
                                    <TextBlock Text=" · " Foreground="#999" VerticalAlignment="Center" FontSize="11"/>
                                    <Button Content="Clear All" Style="{StaticResource LinkBtn}" Click="BtnClearAll_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="TxtSearchImport" Style="{StaticResource SearchBox}" Margin="0,8,0,0"
                                     TextChanged="TxtSearchImport_TextChanged"/>
                        </StackPanel>
                    </Border>

                    <DataGrid x:Name="GridImport"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="28"
                              FontSize="11"
                              BorderThickness="0"
                              AlternatingRowBackground="#FAFBFC"
                              SelectionChanged="GridImport_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsIncluded, Mode=TwoWay}" Width="34"/>
                            <DataGridTemplateColumn Header="Status" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusTextStyle}"
                                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Emp #"    Binding="{Binding EmployeeNumber}" Width="65" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name"     Binding="{Binding Name}"           Width="1.3*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Position" Binding="{Binding Position}"       Width="1.1*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Company"  Binding="{Binding CompanyName}"    Width="0.65*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Branch"   Binding="{Binding BranchName}"     Width="0.9*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Dept"     Binding="{Binding DepartmentName}" Width="0.9*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Details"  Binding="{Binding ChangeSummary}"  Width="1.3*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F8FAFB" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <TextBlock FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" HorizontalAlignment="Left"
                           Text="Employees missing from this file can be individually selected for archiving on the next (review) screen."/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource FooterBtn}"
                            Background="White" Foreground="#5A6A7A" BorderBrush="#CDD5DE"
                            Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button Content="Review &amp; Import" Style="{StaticResource FooterBtn}"
                            Background="#4E9AFC" Foreground="White" BorderThickness="0"
                            Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
