<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.AccountManagement.Views.EmployeeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="110"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderBrush"     Value="#3A8EF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="#B0BAC8"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4E9AFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#B0BAC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow"
                                          DockPanel.Dock="Right"
                                          Width="8" Height="6"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="White" Opacity="0.4"
                                          Stretch="Uniform"
                                          Data="M 1,2.5 L 4,0 L 7,2.5 Z M 1,3.5 L 4,6 L 7,3.5 Z"/>
                                    <Button x:Name="FilterBtn"
                                            DockPanel.Dock="Right"
                                            Tag="{TemplateBinding Content}"
                                            Padding="3,0"
                                            Margin="2,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            ToolTip="Filter this column">
                                        <Path Data="M 0,0 H 7 L 4.5,3.5 V 7 H 2.5 V 3.5 Z"
                                              Fill="White" Width="7" Height="7" Stretch="Fill" Opacity="0.75"/>
                                    </Button>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"  Width="8" Cursor="SizeWE" Opacity="0"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,5 L 4,0 L 8,5 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,0 L 4,5 L 8,0 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                    <Setter Property="Background" Value="#E2E5EA"/>
                    <Setter Property="Foreground" Value="#7A8A9A"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#B8D4FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#4E9AFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Page header + stat cards -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Employee Management"
                               FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                    <TextBlock Text="Manage employee records, emails, and status  •  Click email cells to edit inline"
                               FontSize="10" Foreground="#5A6A7A" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="TOTAL" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalRecords}" FontSize="22" FontWeight="Bold" Foreground="#1A2333"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding ActiveCount}" FontSize="22" FontWeight="Bold" Foreground="#4E9AFC"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1 · Unified toolbar: actions + search + filters + refresh, all flowing in one row -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAdd"      Background="#4E9AFC" Style="{StaticResource ActionButton}" Content="✚  Add Employee"   Click="BtnAdd_Click"/>
                    <Button x:Name="BtnEdit"     Style="{StaticResource OutlineButton}"                     Content="✎  Edit"          Click="BtnEdit_Click"/>
                    <Button x:Name="BtnArchive"  Style="{StaticResource OutlineButton}"                     Content="📦  Archive"       Click="BtnArchive_Click"/>
                    <Button x:Name="BtnExport"   Style="{StaticResource OutlineButton}"                     Content="📤  Export"        Click="BtnExport_Click"/>
                    <Button x:Name="BtnImport"   Style="{StaticResource OutlineButton}"                     Content="📥  Import"        Click="BtnImport_Click"/>
                    <Button x:Name="BtnTemplate" Style="{StaticResource OutlineButton}"                     Content="📋  Template"      Click="BtnTemplate_Click"/>

                    <Border Background="#EBF5FF" CornerRadius="10" Padding="10,5" Margin="0,0,10,8" VerticalAlignment="Center"
                            Cursor="Hand" ToolTip="Click to view and unselect employees"
                            MouseLeftButtonUp="SelectedBadge_Click"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4E9AFC" TextDecorations="Underline">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text=" Selected"/>
                        </TextBlock>
                    </Border>

                    <Border Background="White" BorderBrush="#B0BAC8" BorderThickness="1" CornerRadius="5"
                            Padding="8,0" Height="28" Margin="0,0,10,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                            <TextBox x:Name="TxtSearch"
                                     BorderThickness="0" Background="Transparent"
                                     FontSize="11" Width="200" VerticalContentAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by name, number, position, company, department, branch, email"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Filter:" FontSize="11" Foreground="#5A6A7A"
                               VerticalAlignment="Center" Margin="0,0,6,8"/>
                    <ComboBox x:Name="CboFilter"
                              Style="{StaticResource FilterCombo}"
                              Width="130" Margin="0,0,10,8"
                              SelectedValuePath="Content"
                              SelectionChanged="CboFilter_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="Active Only"/>
                        <ComboBoxItem Content="Inactive Only"/>
                        <ComboBoxItem Content="Newly Added"/>
                        <ComboBoxItem Content="Oldest Added"/>
                    </ComboBox>
                    <CheckBox x:Name="ChkShowArchived"
                              Content="Show Archived"
                              IsChecked="{Binding ShowArchived}"
                              FontSize="11" Foreground="#5A6A7A"
                              VerticalAlignment="Center" Margin="0,0,10,8"/>

                    <!-- Status message -->
                    <Border x:Name="StatusBorder"
                            Background="#E8F5E9" CornerRadius="4" Padding="10,3"
                            Margin="0,0,0,8"
                            VerticalAlignment="Center"
                            Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#2E7D32"/>
                    </Border>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button x:Name="BtnRefresh" Background="#4E9AFC"
                            Style="{StaticResource ActionButton}"
                            Content="⟳  Refresh"
                            Margin="0"
                            Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2 · DataGrid -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="2"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#EEF1F4"
                  VerticalGridLinesBrush="#E4E8EF"
                  AlternationCount="2"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  ItemsSource="{Binding PagedRows}"
                  VirtualizingPanel.IsVirtualizing="False"
                  MouseDoubleClick="MainGrid_MouseDoubleClick"
                  CellEditEnding="MainGrid_CellEditEnding"
                  BeginningEdit="MainGrid_BeginningEdit"
                  Sorting="MainGrid_Sorting"
                  ButtonBase.Click="MainGrid_HeaderButtonClick">
            <DataGrid.Resources>
                <!-- Override system highlight brushes so custom row selection color actually shows -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                    Color="#B8CEED"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                Color="#1A2333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"   Color="#CDD8EE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
            </DataGrid.Resources>
            <DataGrid.Columns>

                <!-- Select checkbox -->
                <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#4E9AFC"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="#3A8EF6" BorderThickness="0,0,1,1">
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="Select / deselect all on this page"
                                                      Loaded="ChkSelectAllHeader_Loaded"
                                                      Click="ChkSelectAll_Click"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Employee # -->
                <DataGridTextColumn Header="Emp #" Binding="{Binding EmployeeNumber}" Width="SizeToHeader" MinWidth="75" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="Foreground"   Value="#3A4A5A"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Title -->
                <DataGridTextColumn Header="Title" Binding="{Binding TitleCode}" Width="SizeToHeader" MinWidth="55" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Name -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" MinWidth="150" Width="*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Position -->
                <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="Auto" MinWidth="95" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Company -->
                <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="Auto" MinWidth="85" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Department -->
                <DataGridTextColumn Header="Dept" Binding="{Binding DepartmentName}" Width="Auto" MinWidth="70" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Branch -->
                <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="Auto" MinWidth="95" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Distributor (optional posting, selected few only) -->
                <DataGridTextColumn Header="Distributor" Binding="{Binding DistributorName}" Width="Auto" MinWidth="95" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status -->
                <DataGridTextColumn Header="Status" Binding="{Binding ActiveDisplay}" Width="SizeToHeader" MinWidth="92" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"             Value="4,6,4,6"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping"        Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Dept Email (editable) -->
                <DataGridTextColumn x:Name="ColDeptEmail"
                                    Header="Dept Email ✎"
                                    Binding="{Binding DepartmentEmail, UpdateSourceTrigger=LostFocus}"
                                    Width="*" MinWidth="150" IsReadOnly="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="Foreground"   Value="#1664AA"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness"          Value="1"/>
                            <Setter Property="BorderBrush"              Value="#4E9AFC"/>
                            <Setter Property="Padding"                  Value="4,0,0,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- Branch Email (editable) -->
                <DataGridTextColumn x:Name="ColBranchEmail"
                                    Header="Branch Email ✎"
                                    Binding="{Binding BranchEmail, UpdateSourceTrigger=LostFocus}"
                                    Width="*" MinWidth="110" IsReadOnly="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="Foreground"   Value="#1664AA"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness"          Value="1"/>
                            <Setter Property="BorderBrush"              Value="#4E9AFC"/>
                            <Setter Property="Padding"                  Value="4,0,0,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="TextWrapping"             Value="Wrap"/>
                            <Setter Property="MinHeight"                Value="40"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <!-- Personal Email (editable) -->
                <DataGridTextColumn x:Name="ColPersonalEmail"
                                    Header="Personal Email ✎"
                                    Binding="{Binding PrimaryEmail, UpdateSourceTrigger=LostFocus}"
                                    Width="*" MinWidth="110" IsReadOnly="False">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="Foreground"   Value="#1664AA"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness"          Value="1"/>
                            <Setter Property="BorderBrush"              Value="#4E9AFC"/>
                            <Setter Property="Padding"                  Value="4,0,0,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                            <Setter Property="TextWrapping"             Value="Wrap"/>
                            <Setter Property="MinHeight"                Value="40"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3 · Pagination -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFirst"
                            Content="«"
                            Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}"
                            Click="BtnFirst_Click"/>
                    <Button x:Name="BtnPrev"
                            Content="‹"
                            Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}"
                            Click="BtnPrev_Click"/>
                    <TextBlock Text="{Binding PageInfo}"
                               FontSize="11" Foreground="#5A6A7A"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="BtnNext"
                            Content="›"
                            Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}"
                            Click="BtnNext_Click"/>
                    <Button x:Name="BtnLast"
                            Content="»"
                            Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}"
                            Click="BtnLast_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
