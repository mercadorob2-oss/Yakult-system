<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.ReferenceData.Views.AcronymListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="#4E9AFC"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height"   Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin"   Value="0,0,10,0"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="Foreground" Value="#7A8A9A"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Padding"           Value="8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Title -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                <TextBlock Text="Select a row and click Edit Acronym, double-click it, or press F2 to edit it in place.  Enter saves, Esc cancels, and a blank acronym clears it."
                           FontSize="10" Foreground="#5A6A7A" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Row 1 · Toolbar -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button Content="⟳  Refresh" Style="{StaticResource ActionButton}" Margin="0" Click="BtnRefresh_Click"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="✎  Edit Acronym" Style="{StaticResource ActionButton}" Click="BtnEdit_Click"/>

                    <Border Background="White" BorderBrush="#B0BAC8" BorderThickness="1" CornerRadius="5"
                            Padding="8,0" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                            <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                                     FontSize="11" Width="240" VerticalContentAlignment="Center"
                                     ToolTip="{Binding SearchHint}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Filter:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="120"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding FilterOption}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Active Only"/>
                        <ComboBoxItem Content="Inactive Only"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBranch, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Type:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Style="{StaticResource FilterCombo}" Width="140"
                                  ItemsSource="{Binding TypeOptions}"
                                  SelectedItem="{Binding SelectedType}"/>
                    </StackPanel>

                    <Border Background="#E8F5E9" CornerRadius="4" Padding="10,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#2E7D32"/>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Row 2 · Grid -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="2"
                  ItemsSource="{Binding PagedRows}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  AlternationCount="2"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEF1F4"
                  Background="White"
                  BorderThickness="0"
                  RowHeight="36"
                  FontSize="12"
                  Sorting="MainGrid_Sorting"
                  MouseDoubleClick="MainGrid_MouseDoubleClick"
                  PreviewKeyDown="MainGrid_PreviewKeyDown"
                  CellEditEnding="MainGrid_CellEditEnding">
            <DataGrid.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="#C8DFFE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="#1A2333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#D6E6FC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" Binding="{Binding Name}" SortMemberPath="Name"
                                    Width="3*" MinWidth="200" IsReadOnly="True"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="ColType" Header="Type" Binding="{Binding Detail}" SortMemberPath="Detail"
                                    Width="*" MinWidth="110" IsReadOnly="True"
                                    ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn x:Name="ColAcronym" Header="Acronym ✎" Binding="{Binding Acronym, Mode=OneWay}" SortMemberPath="Acronym"
                                    Width="*" MinWidth="120"
                                    ElementStyle="{StaticResource CellText}">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="BorderThickness"          Value="1"/>
                            <Setter Property="BorderBrush"              Value="#4E9AFC"/>
                            <Setter Property="Padding"                  Value="6,0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status"
                                    Width="120" IsReadOnly="True"
                                    ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3 · Pagination -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="«" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Click="BtnFirst_Click"/>
                <Button Content="‹" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Click="BtnPrev_Click"/>
                <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="8,0"/>
                <Button Content="›" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Click="BtnNext_Click"/>
                <Button Content="»" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Click="BtnLast_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
