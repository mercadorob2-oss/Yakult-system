<Window x:Class="Yakult.Inventory.App.WPF.Admin.ReferenceData.Views.HolidayEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#374150"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Width"           Value="90"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="8,0,0,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C8CDD2"/>
            <Setter Property="Background"      Value="White"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#3498DB" Padding="16,12">
            <TextBlock x:Name="TxtHeader" Foreground="White" FontSize="15" FontWeight="Bold"/>
        </Border>

        <StackPanel Margin="24,18,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Holiday Name *" Style="{StaticResource FieldLabel}"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TxtName" Style="{StaticResource Field}"/>

                <TextBlock  Grid.Row="1" Text="Date *" Style="{StaticResource FieldLabel}"/>
                <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DpDate" Style="{StaticResource Field}"
                            SelectedDateFormat="Long" SelectedDateChanged="Inputs_Changed"/>

                <TextBlock Grid.Row="2" Text="Type *" Style="{StaticResource FieldLabel}"/>
                <ComboBox  Grid.Row="2" Grid.Column="1" x:Name="CboType" Style="{StaticResource Field}">
                    <ComboBoxItem Content="Regular Holiday"/>
                    <ComboBoxItem Content="Special Non-Working"/>
                </ComboBox>

                <TextBlock Grid.Row="3" Text="Recurring" Style="{StaticResource FieldLabel}"/>
                <CheckBox  Grid.Row="3" Grid.Column="1" x:Name="ChkRecurring" Margin="0,0,0,12" VerticalAlignment="Center"
                           Content="Repeat every year (ignore year in date)"
                           Checked="Inputs_Changed" Unchecked="Inputs_Changed"/>

                <TextBlock Grid.Row="4" Text="Status" Style="{StaticResource FieldLabel}"/>
                <CheckBox  Grid.Row="4" Grid.Column="1" x:Name="ChkActive" Margin="0,0,0,12" VerticalAlignment="Center"
                           Content="Active"/>

                <TextBlock Grid.Row="5" Text="Notes" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,4,0,12"/>
                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TxtNotes" Height="64" Margin="0,0,0,12"
                           TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <Border BorderBrush="#DCE1E6" BorderThickness="0,1,0,0" Margin="-24,4,-24,8"/>

            <TextBlock x:Name="TxtDupeWarning" Foreground="#C0392B" FontSize="11" MinHeight="16" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Style="{StaticResource DialogButton}" IsDefault="True"
                        Background="#3498DB" Foreground="White" BorderThickness="0" FontWeight="Bold"
                        Click="BtnSave_Click"/>
                <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
