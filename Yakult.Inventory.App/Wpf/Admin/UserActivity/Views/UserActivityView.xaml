<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.UserActivity.Views.UserActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#7A8A9A"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#5A6A7A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,6,8"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="110"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Margin"          Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="BorderBrush"     Value="#3A8EF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Margin"          Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#B0BAC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,0"/>
            <Setter Property="Margin"          Value="0,0,10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterDate" TargetType="DatePicker">
            <Setter Property="Height"  Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#B0BAC8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFBFC"/>
                </Trigger>
                <DataTrigger Binding="{Binding ActionType}" Value="Approve">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ActionType}" Value="Reject">
                    <Setter Property="Background" Value="#FFEBEE"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DFFE"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#B8D4FC"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#4E9AFC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Page header + stat card -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="User Activity"
                               FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                    <TextBlock Text="Audit trail of user actions across the system"
                               FontSize="10" Foreground="#5A6A7A" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatCard}">
                        <StackPanel>
                            <TextBlock Text="RECORDS" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding TotalRecords}" FontSize="22" FontWeight="Bold" Foreground="#1A2333"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="0,0,8,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                    </Border>
                    <Button x:Name="BtnInsights" Style="{StaticResource OutlineButton}" Content="Insights" Margin="0,0,8,0" Click="BtnInsights_Click"/>
                    <Button x:Name="BtnRefresh" Background="#4E9AFC"
                            Style="{StaticResource ActionButton}"
                            Content="⟳  Refresh"
                            Margin="0"
                            Click="BtnRefresh_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1 · Unified toolbar: filters + actions, all flowing in one row -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="14,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="From:" Style="{StaticResource FilterLabel}"/>
                <DatePicker x:Name="DpFrom" Style="{StaticResource FilterDate}" Width="130"
                            SelectedDate="{Binding DateFrom}"/>
                <TextBlock Text="To:" Style="{StaticResource FilterLabel}"/>
                <DatePicker x:Name="DpTo" Style="{StaticResource FilterDate}" Width="130"
                            SelectedDate="{Binding DateTo}"/>
                <TextBlock Text="User:" Style="{StaticResource FilterLabel}"/>
                <ComboBox x:Name="CboUser" Style="{StaticResource FilterCombo}" Width="170"
                          ItemsSource="{Binding UserOptions}" SelectedItem="{Binding SelectedUser}"/>
                <TextBlock Text="Action:" Style="{StaticResource FilterLabel}"/>
                <ComboBox x:Name="CboAction" Style="{StaticResource FilterCombo}" Width="130"
                          ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}"/>
                <TextBlock Text="Entity:" Style="{StaticResource FilterLabel}"/>
                <ComboBox x:Name="CboEntity" Style="{StaticResource FilterCombo}" Width="140"
                          ItemsSource="{Binding EntityOptions}" SelectedItem="{Binding SelectedEntity}"/>
                <CheckBox x:Name="ChkAuditTrail" Content="Include Audit Trail" Margin="0,0,10,8"
                          VerticalAlignment="Center" FontSize="11"
                          IsChecked="{Binding IncludeAuditTrail}"/>

                <Button x:Name="BtnClear" Style="{StaticResource OutlineButton}" Content="Clear" Click="BtnClear_Click"/>
                <Button x:Name="BtnApply" Background="#4E9AFC" Style="{StaticResource ActionButton}" Content="Apply" Click="BtnApply_Click"/>
                <Button x:Name="BtnExportPdf" Background="#00968A" Style="{StaticResource ActionButton}"
                        Content="⬇ PDF" FontSize="10.5" Padding="10,0" Click="BtnExportPdf_Click"/>
            </WrapPanel>
        </Border>

        <!-- Row 2 · DataGrid -->
        <DataGrid x:Name="MainGrid"
                  Grid.Row="2"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="0"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#EEF1F4"
                  VerticalGridLinesBrush="#E4E8EF"
                  AlternationCount="2"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  RowHeaderWidth="0"
                  FontFamily="Segoe UI"
                  FontSize="12"
                  IsReadOnly="True"
                  ItemsSource="{Binding PagedRows}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False">
            <DataGrid.Resources>
                <!-- Override system highlight brushes so custom row selection color actually shows -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                    Color="#B8CEED"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                Color="#1A2333"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"   Color="#CDD8EE"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
            </DataGrid.Resources>
            <DataGrid.Columns>

                <DataGridTemplateColumn Header="Date &amp; Time" Width="120" SortMemberPath="CreatedDate">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6">
                                <TextBlock Text="{Binding CreatedDate, StringFormat=yyyy-MM-dd}" FontSize="11"/>
                                <TextBlock Text="{Binding CreatedDate, StringFormat=HH:mm:ss}" FontSize="10" Foreground="#7A8A9A"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="User" Binding="{Binding Name}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Email" Binding="{Binding EmailAddress}" Width="190">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="Foreground"   Value="#5A6A7A"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Action" Binding="{Binding ActionType}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Entity Type" Binding="{Binding EntityType}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"             Value="4,6,4,6"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,6,4,6"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Row 3 · Pagination -->
        <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnFirst" Content="«" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}" Click="BtnFirst_Click"/>
                    <Button x:Name="BtnPrev" Content="‹" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoPrev}" Click="BtnPrev_Click"/>
                    <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#5A6A7A"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button x:Name="BtnNext" Content="›" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}" Click="BtnNext_Click"/>
                    <Button x:Name="BtnLast" Content="»" Style="{StaticResource PageButton}"
                            IsEnabled="{Binding CanGoNext}" Click="BtnLast_Click"/>

                    <TextBlock Text="Items per page:" FontSize="11" Foreground="#5A6A7A"
                               VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="CboItemsPerPage" Width="70" Height="26" FontSize="11"
                              SelectionChanged="CboItemsPerPage_SelectionChanged">
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20" IsSelected="True"/>
                        <ComboBoxItem Content="50"/>
                        <ComboBoxItem Content="100"/>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</UserControl>
