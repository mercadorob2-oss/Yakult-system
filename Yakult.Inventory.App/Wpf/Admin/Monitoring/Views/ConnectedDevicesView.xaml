<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.Monitoring.Views.ConnectedDevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="{DynamicResource YakultPageBackgroundBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/YakultPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
            </Style>

            <Style x:Key="ActionButton" TargetType="Button">
                <Setter Property="Background"      Value="{StaticResource YakultPrimaryBrush}"/>
                <Setter Property="Foreground"      Value="White"/>
                <Setter Property="FontSize"        Value="11"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Padding"         Value="14,0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Height"          Value="32"/>
                <Setter Property="Margin"          Value="0,0,8,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
                <Setter Property="Background" Value="#DC3545"/>
                <Setter Property="Height"     Value="28"/>
                <Setter Property="Padding"    Value="12,0"/>
            </Style>

            <Style x:Key="FilterCombo" TargetType="ComboBox">
                <Setter Property="Height"   Value="28"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin"   Value="0,0,10,0"/>
            </Style>

            <Style x:Key="CountPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding"      Value="12,5"/>
                <Setter Property="Margin"       Value="0,0,8,0"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background"                 Value="{StaticResource YakultPrimaryBrush}"/>
                <Setter Property="Foreground"                 Value="White"/>
                <Setter Property="FontWeight"                 Value="SemiBold"/>
                <Setter Property="FontSize"                   Value="11"/>
                <Setter Property="Padding"                    Value="10,9"/>
                <Setter Property="BorderBrush"                Value="{StaticResource YakultPrimaryBrush}"/>
                <Setter Property="BorderThickness"            Value="0,0,1,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{StaticResource YakultSurfaceMutedBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource YakultSelectionBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background"  Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground"  Value="{StaticResource YakultTextDarkBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock Text="Connected Devices" FontSize="18" FontWeight="Bold" Foreground="{StaticResource YakultPrimaryBrush}"/>
                <TextBlock Text="Live desktops reporting presence. Use the STOP menu for surprise alerts and pranks on that PC within ~20 seconds."
                           FontSize="10" Foreground="{StaticResource YakultTextMutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource YakultAccentTintBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="{StaticResource YakultPrimaryBrush}"/>
                    </Border>
                    <Button Content="⟳  Refresh" Style="{StaticResource ActionButton}" Margin="0" Click="BtnRefresh_Click"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="#B0BAC8" BorderThickness="1" CornerRadius="5"
                            Padding="8,0" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource YakultTextMutedBrush}"/>
                            <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                                     FontSize="11" Width="220" VerticalContentAlignment="Center"
                                     ToolTip="Search by machine, user, or module"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Filter:" FontSize="11" Foreground="{StaticResource YakultTextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="110"
                              SelectedValuePath="Content"
                              SelectedValue="{Binding FilterOption}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Online Only"/>
                        <ComboBoxItem Content="Stale Only"/>
                    </ComboBox>

                    <Border Style="{StaticResource CountPill}" Background="#27AE60" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OnlineCount, StringFormat=● {0} online}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <Border Style="{StaticResource CountPill}" Background="#6C7A89" VerticalAlignment="Center">
                        <TextBlock Text="{Binding KnownCount, StringFormat={}{0} known}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <Border Background="#E8F5E9" CornerRadius="4" Padding="10,3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#2E7D32"/>
                    </Border>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <DataGrid x:Name="MainGrid"
                      ItemsSource="{Binding FilteredRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      AlternationCount="2"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource YakultBorderBrush}"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="36"
                      FontSize="12">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                      Color="{StaticResource YakultSelectionColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                  Color="{StaticResource YakultTextDarkColor}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#D6E6FC"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource YakultTextDarkColor}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="110" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Online}" Value="True">
                                        <Setter Property="Foreground" Value="#27AE60"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Online}" Value="False">
                                        <Setter Property="Foreground" Value="#7F8C8D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Machine" Binding="{Binding MachineName}" Width="*" MinWidth="130" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThisDevice}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="ToolTip" Value="This device"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="1.4*" MinWidth="160" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="110" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Version" Binding="{Binding ClientVersion}" Width="100" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenDisplay}" Width="170" IsReadOnly="True"
                                        ElementStyle="{StaticResource CellText}"/>
                    <DataGridTemplateColumn Header="Action" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="STOP" Style="{StaticResource DangerButton}" Click="StopButton_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Background="White" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No devices yet. Log in on another PC with the new build (or open Call Monitoring) and it shows up here."
                           FontSize="12" Foreground="{StaticResource YakultTextMutedBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="480"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
