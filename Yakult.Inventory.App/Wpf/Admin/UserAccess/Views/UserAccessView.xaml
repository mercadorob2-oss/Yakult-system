<UserControl x:Class="Yakult.Inventory.App.WPF.Admin.UserAccess.Views.UserAccessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#1A2333"/>
        </Style>

        <Style x:Key="Subtitle" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="#5A6A7A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#3A4A5A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="90"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background"      Value="#4E9AFC"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E2E6EC"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="BorderBrush"     Value="#CDD5DE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="#EBF5FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Portal selector pill (Pages / Role Pages tabs) -->
        <Style x:Key="PortalPill" TargetType="Button">
            <Setter Property="Background"      Value="#EBEEF2"/>
            <Setter Property="Foreground"      Value="#3C3C3C"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Margin"          Value="0,0,4,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPages}" Value="False">
                    <Setter Property="Foreground" Value="#B4B4B4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#4E9AFC"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PickerCombo" TargetType="ComboBox">
            <Setter Property="Height"   Value="28"/>
            <Setter Property="Width"    Value="280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Width"                    Value="200"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,8"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Focusable"       Value="False"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared body for the Portals / Actions grid tabs (DataContext = PermissionGridViewModel) -->
        <DataTemplate x:Key="PermissionGridTemplate">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Subtitle + search -->
                <DockPanel Grid.Row="0" Margin="16,10,16,10" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Background="White" BorderBrush="#B0BAC8" BorderThickness="1"
                            CornerRadius="5" Padding="8,0" Height="28" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                            <TextBox Style="{StaticResource SearchBox}" ToolTip="Search users by name"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                </DockPanel>

                <DataGrid Grid.Row="1"
                          Tag="PermissionGrid"
                          Loaded="PermissionGrid_Loaded"
                          ItemsSource="{Binding PagedRows}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          RowHeaderWidth="0"
                          AlternationCount="2"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#E4E8EF"
                          VerticalGridLinesBrush="#E4E8EF"
                          BorderThickness="0,1,0,0"
                          BorderBrush="#DDE3EC"
                          Background="White"
                          RowHeight="40"
                          FontSize="12"/>

                <!-- Footer: Edit / Save / Cancel + status + pagination -->
                <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Edit" Style="{StaticResource ActionButton}" Width="90"
                                    Click="GridEdit_Click"
                                    Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Save Changes" Style="{StaticResource ActionButton}"
                                    Click="GridSave_Click"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90"
                                    Click="GridCancel_Click"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#4E9AFC"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="«" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Click="GridFirst_Click"/>
                            <Button Content="‹" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoPrev}" Click="GridPrev_Click"/>
                            <TextBlock Text="{Binding PageInfo}" FontSize="11" Foreground="#5A6A7A"
                                       VerticalAlignment="Center" Margin="8,0"/>
                            <Button Content="›" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Click="GridNext_Click"/>
                            <Button Content="»" Style="{StaticResource PageButton}" IsEnabled="{Binding CanGoNext}" Click="GridLast_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Shared body for the Pages / Role Pages tabs (DataContext = PageAccessEditorViewModel) -->
        <DataTemplate x:Key="PageEditorTemplate">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Subtitle}" Style="{StaticResource Subtitle}" Margin="16,10,16,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
                    <TextBlock Text="{Binding SubjectLabel}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource PickerCombo}"
                              ItemsSource="{Binding Subjects}"
                              DisplayMemberPath="Name"
                              IsEditable="True" IsTextSearchEnabled="True"
                              SelectedItem="{Binding SelectedSubject}"/>
                </StackPanel>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Portals}" Margin="16,4,16,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PortalPill}" Content="{Binding DisplayName}"
                                    Tag="{Binding Key}" Click="PortalPill_Click"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="16,4,16,8">
                    <TextBlock Text="Main Menu:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource PickerCombo}"
                              ItemsSource="{Binding Menus}"
                              SelectedItem="{Binding SelectedMenu}"/>
                </StackPanel>

                <Border Grid.Row="4" Margin="16,0,16,8" BorderBrush="#E2E6EB" BorderThickness="1" CornerRadius="6"
                        Background="#FAFBFC" Padding="16,8">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasPages, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsChecked}"
                                                  FontSize="12" Margin="2,6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="No restrictable pages under this portal yet."
                                   FontStyle="Italic" Foreground="#A0A0A0" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding HasPages, Converter={StaticResource InvBoolToVis}}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="14,8">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Restore to Default" Style="{StaticResource SecondaryButton}"
                                    Click="PageRestore_Click"
                                    Visibility="{Binding IsRole, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="Save" Style="{StaticResource ActionButton}" Width="100" Margin="0"
                                    Click="PageSave_Click"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#4E9AFC" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="#EBF5FF" CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="User Access" FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                    <TextBlock Text="Grant or restrict individual users' access, in addition to their role-based access. Changes take effect on the user's next login."
                               FontSize="10" Foreground="#5A6A7A" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Background="White" BorderBrush="#DDE3EC" FontSize="12">
            <TabItem Header="Portals">
                <ContentControl Content="{Binding PortalsGrid}" ContentTemplate="{StaticResource PermissionGridTemplate}"/>
            </TabItem>

            <TabItem Header="Pages">
                <ContentControl Content="{Binding PagesEditor}" ContentTemplate="{StaticResource PageEditorTemplate}"/>
            </TabItem>

            <TabItem Header="Role Pages">
                <ContentControl Content="{Binding RolePagesEditor}" ContentTemplate="{StaticResource PageEditorTemplate}"/>
            </TabItem>

            <TabItem Header="Item Categories">
                <Grid Background="White" DataContext="{Binding Categories}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource Subtitle}" Margin="16,10,16,8"
                               Text="Restrict which item categories a user may add via the batch Add Item / Add Request dialogs. Changes apply immediately."/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
                        <TextBlock Text="User:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource PickerCombo}"
                                  ItemsSource="{Binding Users}"
                                  DisplayMemberPath="Name"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  SelectedItem="{Binding SelectedUser}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="16,0,16,8">
                        <TextBlock Text="Category:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource PickerCombo}"
                                  ItemsSource="{Binding AvailableCategories}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="+  Restrict" Style="{StaticResource ActionButton}" Margin="10,0,0,0"
                                Click="CategoryAdd_Click"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#4E9AFC"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Text="{Binding Header}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#3C3C3C" Margin="16,8,16,6"/>

                    <Border Grid.Row="4" Margin="16,0,16,16" BorderBrush="#E2E6EB" BorderThickness="1" CornerRadius="6"
                            Background="#FAFBFC" Padding="10">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasRestrictions, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding RestrictedCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFEBEB" BorderBrush="#EBBEBE" BorderThickness="1"
                                                    CornerRadius="14" Padding="12,4,6,4" Margin="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" Foreground="#A03232" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="✕" Tag="{Binding}" Click="CategoryRemove_Click"
                                                            Foreground="#A03232" Background="Transparent" BorderThickness="0"
                                                            FontSize="10" FontWeight="Bold" Cursor="Hand"
                                                            Padding="4,0" Margin="6,0,0,0"
                                                            ToolTip="Remove this restriction"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="No restrictions for this user, all categories are available."
                                       FontStyle="Italic" Foreground="#A0A0A0" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasRestrictions, Converter={StaticResource InvBoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Actions">
                <ContentControl Content="{Binding ActionsGrid}" ContentTemplate="{StaticResource PermissionGridTemplate}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
