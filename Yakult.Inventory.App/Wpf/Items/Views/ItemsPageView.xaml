<UserControl x:Class="Yakult.Inventory.App.WPF.Items.Views.ItemsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Items.Views"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             Background="{DynamicResource YakultPageBackgroundBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/YakultPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:BoolToYesNoConverter              x:Key="BoolToYesNo"/>
        <local:StockLevelToBrushConverter      x:Key="StockLevelToBrush"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextMutedBrush}"/>
        </Style>

        <!-- ══ Workspace redesign (2026-10): micro label + clickable summary tiles that
             mirror the redesigned dashboard cards instead of the old thin colour-bar
             cards. ═══════════════════════════════════════════════════════════════════ -->
        <Style x:Key="MicroLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextMutedBrush}"/>
        </Style>

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Width"           Value="152"/>
            <Setter Property="MinHeight"       Value="76"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
        </Style>

        <Style x:Key="StatTileLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{StaticResource YakultTextMutedBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="StatTileValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="120"/>
        </Style>

        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="{StaticResource YakultSurfaceMutedBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource YakultInputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent (soft tint) primary button, matching the redesigned workspace CTA. -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="{StaticResource YakultPrimaryBrush}"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{StaticResource YakultAccentTintBrush}"
                                BorderBrush="{StaticResource YakultAccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource YakultSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource YakultSelectionHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Background"  Value="#FDECEA"/>
            <Setter Property="Foreground"  Value="#C0392B"/>
            <Setter Property="BorderBrush" Value="#F1B7B0"/>
        </Style>

        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Width"           Value="32"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="2,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource YakultSurfaceMutedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource YakultInputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="{StaticResource YakultInputBorderBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="FontSize"                 Value="12.5"/>
            <Setter Property="Height"                   Value="34"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource YakultPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="10,7"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="3,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultSurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height"                 Value="34"/>
            <Setter Property="FontSize"               Value="12.5"/>
            <Setter Property="Foreground"             Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="ItemContainerStyle"     Value="{StaticResource FilterComboItem}"/>
            <Setter Property="FocusVisualStyle"       Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="White"
                                                BorderBrush="{StaticResource YakultInputBorderBrush}" BorderThickness="1" CornerRadius="6"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource YakultPrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"
                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource YakultTextMutedBrush}" StrokeThickness="1.6"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,4,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Page-local redesign styles (not shared — this page keeps its own full style
             dictionary rather than merging ListPageStyles.xaml) ═══════════════════════════ -->
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="{StaticResource YakultTextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource YakultTextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin"          Value="0"/>
        </Style>

        <!-- Section caption inside the More Actions popup (Export / Request / Invoice / Item). -->
        <Style x:Key="DropdownSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8896A7"/>
            <Setter Property="Margin"     Value="10,8,10,3"/>
        </Style>

        <!-- Dropdown menu item inside the Import/More Actions split-button popups. -->
        <Style x:Key="DropdownMenuItemBtn" TargetType="Button">
            <Setter Property="Height"                     Value="36"/>
            <Setter Property="Padding"                    Value="10,0"/>
            <Setter Property="FontSize"                   Value="12.5"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown-style ToggleButton for "Advanced Filters" (this page has no checkbox
             multi-select filters, so it's a plain popup trigger, not a CategoryFilterToggleBtn). -->
        <Style x:Key="AdvancedFiltersToggleBtn" TargetType="ToggleButton">
            <Setter Property="BorderBrush" Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{TemplateBinding Content}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource YakultTextMutedBrush}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultSurfaceMutedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource YakultInputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource YakultPrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Grid header: light micro-caps header with a hairline underline, matching the
             redesigned dashboard tables (no more solid maroon band). ═══════════════════ -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="{StaticResource YakultTextMutedBrush}"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="10.5"/>
            <Setter Property="Padding"                    Value="10,0,10,9"/>
            <Setter Property="Height"                     Value="40"/>
            <Setter Property="BorderBrush"                Value="{StaticResource YakultBorderBrush}"/>
            <Setter Property="BorderThickness"            Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <DockPanel>
                                    <Path x:Name="SortArrow"
                                          DockPanel.Dock="Right"
                                          Width="8" Height="6"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          Fill="{StaticResource YakultTextMutedBrush}" Opacity="0.35"
                                          Stretch="Uniform"
                                          Data="M 1,2.5 L 4,0 L 7,2.5 Z M 1,3.5 L 4,6 L 7,3.5 Z"/>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Bottom"/>
                                </DockPanel>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"  Width="8" Cursor="SizeWE" Opacity="0"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource YakultSurfaceMutedBrush}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,5 L 4,0 L 8,5 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortArrow" Property="Data"    Value="M 0,0 L 4,5 L 8,0 Z"/>
                                <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FAFAFA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource YakultSelectionBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected"  Value="True"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource YakultSelectionHoverBrush}"/>
                </MultiTrigger>
                <DataTrigger Binding="{Binding UsedDefaultCartridgeModel}" Value="True">
                    <Setter Property="Background" Value="#FFEFC9"/>
                    <Setter Property="ToolTip" Value="Using default 'Unassigned' cartridge model"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="10,9"/>
            <Setter Property="Foreground"               Value="{StaticResource YakultTextDarkBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ClipToBounds"              Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Foreground"  Value="{StaticResource YakultTextDarkBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColumnFilterButton" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource YakultTextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Margin"          Value="4,0,0,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ToolTip"         Value="Filter this column"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource YakultSelectionBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource YakultPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width"    Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Tb" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Tb" Property="Background" Value="{StaticResource YakultPrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width"  Value="Auto"/>
                                <Setter Property="Height" Value="8"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Flat workspace tabs: muted labels with a red underline for the selected tab,
             sitting on a hairline strip inside the page card. ═══════════════════════════ -->
        <Style x:Key="FlatTabItem" TargetType="TabItem">
            <Setter Property="FontSize"    Value="12.5"/>
            <Setter Property="Foreground"  Value="{StaticResource YakultTextMutedBrush}"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="14,13,14,11">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource YakultPrimaryBrush}"/>
                                <Setter Property="Foreground"       Value="{StaticResource YakultTextDarkBrush}"/>
                                <Setter Property="FontWeight"       Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource YakultTextDarkBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTabControl" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="White"
                                    BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="14,0">
                                <TabPanel IsItemsHost="True" Margin="2,0,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Row 0: Workspace header — kicker + title (left) and clickable summary tiles
             (right), mirroring the redesigned dashboards. ══════════════════════════════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="INVENTORY MASTER DATA" Style="{StaticResource MicroLabel}"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="View Items" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Search, filter, and manage all inventory items" FontSize="12.5"
                               Foreground="{StaticResource YakultTextMutedBrush}" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="CardTotal" Style="{StaticResource StatTile}" ToolTip="Click to show all items">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource YakultPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="TOTAL ITEMS" Style="{StaticResource StatTileLabel}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalItemsCount}" Style="{StaticResource StatTileValue}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CardActive" Style="{StaticResource StatTile}" ToolTip="Click to filter active items">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ActiveCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#1E9E5E" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="ACTIVE" Style="{StaticResource StatTileLabel}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveItemsCount}" Style="{StaticResource StatTileValue}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CardInactive" Style="{StaticResource StatTile}" Margin="0" ToolTip="Click to filter inactive items">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding InactiveCardCommand}"/>
                        </Border.InputBindings>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#9AA1AC" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="INACTIVE" Style="{StaticResource StatTileLabel}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding InactiveItemsCount}" Style="{StaticResource StatTileValue}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ══ Row 1: Action bar — item actions + Search + Advanced Filters (left), Refresh (right) ═ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="14,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddItemsCommand}" IsEnabled="{Binding IsItemsTabActive}">
                        <TextBlock Text="➕  Add Items"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding EditCommand}" IsEnabled="{Binding IsItemsTabActive}">
                        <TextBlock Text="✎  Edit"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding ArchiveCommand}" IsEnabled="{Binding IsItemsTabActive}">
                        <TextBlock Text="📦  Archive"/>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}" Command="{Binding DeleteCommand}" IsEnabled="{Binding IsItemsTabActive}">
                        <TextBlock Text="🗑  Delete"/>
                    </Button>

                    <!-- Import split/dropdown: Import, Template, Get from Mobile -->
                    <ToggleButton x:Name="ImportDropdownToggle" Style="{StaticResource AdvancedFiltersToggleBtn}"
                                  Width="104" Height="34" Margin="0,0,8,0" Content="⬆  Import"
                                  IsEnabled="{Binding IsItemsTabActive}"/>
                    <Popup PlacementTarget="{Binding ElementName=ImportDropdownToggle}"
                           IsOpen="{Binding IsChecked, ElementName=ImportDropdownToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="6" MinWidth="200">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="{StaticResource YakultTextDarkColor}"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding ImportCommand}" Click="CloseImportDropdown">
                                    <TextBlock Text="⬆  Import"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding DownloadTemplateCommand}" Click="CloseImportDropdown">
                                    <TextBlock Text="📄  Download Template"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding GetFromMobileCommand}" Click="CloseImportDropdown">
                                    <TextBlock Text="📱  Get from Mobile"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- More Actions split/dropdown: PDF, Bulk Add Request, Sub-Type Groups, Update Cellphone Details -->
                    <ToggleButton x:Name="MoreActionsDropdownToggle" Style="{StaticResource AdvancedFiltersToggleBtn}"
                                  Width="136" Height="34" Margin="0,0,16,0" Content="More Actions"/>
                    <Popup PlacementTarget="{Binding ElementName=MoreActionsDropdownToggle}"
                           IsOpen="{Binding IsChecked, ElementName=MoreActionsDropdownToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="6" MinWidth="210">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="{StaticResource YakultTextDarkColor}"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="EXPORT" Style="{StaticResource DropdownSectionLabel}"/>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding ExportSelectedPdfCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🧾  PDF (Selected)"/>
                                </Button>

                                <TextBlock Text="REQUEST" Style="{StaticResource DropdownSectionLabel}"/>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding BulkAddRequestCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🧺  Bulk Add Request"/>
                                </Button>

                                <TextBlock Text="INVOICE" Style="{StaticResource DropdownSectionLabel}"/>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding AddToContractGroupCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="📄  Add to Contract Group"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding AddToSubscriptionGroupCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🔁  Add to Subscription Group"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding AddToLicenseGroupCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🔑  Add to License Group"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding AddToServiceGroupCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="🛠  Add to Service Group"/>
                                </Button>

                                <TextBlock Text="ITEM" Style="{StaticResource DropdownSectionLabel}"/>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding BulkEditItemsCommand}" IsEnabled="{Binding IsItemsTabActive}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="📝  Bulk Edit Item"/>
                                </Button>
                                <Button Style="{StaticResource DropdownMenuItemBtn}" Command="{Binding UpdateCellphoneDetailsCommand}" Click="CloseMoreActionsDropdown">
                                    <TextBlock Text="📱  Update Cellphone Details"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Border Background="{StaticResource YakultAccentTintBrush}" BorderBrush="{StaticResource YakultAccentBorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="10,5" Margin="0,0,16,0" VerticalAlignment="Center"
                            Cursor="Hand" ToolTip="Click to view and unselect items"
                            MouseLeftButtonUp="SelectedBadge_Click"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource YakultPrimaryBrush}" TextDecorations="Underline">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text=" Selected"/>
                        </TextBlock>
                    </Border>

                    <!-- Search -->
                    <Border BorderBrush="{StaticResource YakultInputBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Background="White" Height="34" Width="260" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="{StaticResource YakultTextMutedBrush}"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="12.5"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Name, Category, Model, Serial, Unit, Condition, Type..."/>
                        </Grid>
                    </Border>

                    <!-- Advanced Filters (Items tab only — Category Stock Summary has none) -->
                    <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource AdvancedFiltersToggleBtn}"
                                  Width="146" Height="34" Margin="0,0,8,0" Content="Advanced Filters"
                                  IsEnabled="{Binding IsItemsTabActive}"/>
                    <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                           IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                           HorizontalOffset="-910" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="20" Width="960">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="{StaticResource YakultTextDarkColor}"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                                <StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Category" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ToggleButton x:Name="CategoryFilterToggle" Style="{StaticResource AdvancedFiltersToggleBtn}"
                                                  HorizontalAlignment="Stretch" Content="{Binding CategoryFilterSummary}"/>
                                    <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                                           IsOpen="{Binding IsChecked, ElementName=CategoryFilterToggle, Mode=TwoWay}"
                                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" MinWidth="200">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="{StaticResource YakultTextDarkColor}"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Padding="4,0" Margin="2,4" FontSize="11"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                                <Separator Margin="0,6,0,4"/>
                                                <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                        Style="{StaticResource SmallBtn}" Margin="0"
                                                        Command="{Binding ClearCategoryFilterCommand}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Serial #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                             Text="{Binding SerialFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SortByOptions}"
                                              SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Sub-Type" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ToggleButton x:Name="SubTypeFilterToggle" Style="{StaticResource AdvancedFiltersToggleBtn}"
                                                  HorizontalAlignment="Stretch" Content="{Binding SubTypeFilterSummary}"/>
                                    <Popup PlacementTarget="{Binding ElementName=SubTypeFilterToggle}"
                                           IsOpen="{Binding IsChecked, ElementName=SubTypeFilterToggle, Mode=TwoWay}"
                                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" MinWidth="200">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="{StaticResource YakultTextDarkColor}"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <CheckBox Content="Non-Subtype" IsChecked="{Binding SubTypeFilterNonSubType, Mode=TwoWay}"
                                                          Padding="4,0" Margin="2,4" FontSize="11"/>
                                                <Separator Margin="0,4,0,4"/>
                                                <CheckBox Content="Subtype" IsChecked="{Binding SubTypeFilterAnySubtype, Mode=TwoWay}"
                                                          Padding="4,0" Margin="2,4" FontSize="11" FontWeight="Bold"
                                                          ToolTip="Any item with a Sub-Type, unspecified which"/>
                                                <CheckBox Content="Contract" IsChecked="{Binding SubTypeFilterContract, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                <CheckBox Content="Subscription" IsChecked="{Binding SubTypeFilterSubscription, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                <CheckBox Content="License" IsChecked="{Binding SubTypeFilterLicense, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                <CheckBox Content="Services" IsChecked="{Binding SubTypeFilterServices, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,4" FontSize="11"/>
                                                <Separator Margin="0,6,0,4"/>
                                                <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                        Style="{StaticResource SmallBtn}" Margin="0"
                                                        Command="{Binding ClearSubTypeFilterCommand}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Set Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Document #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Company" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="6">
                                        <TextBlock Text="Department" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="8">
                                        <TextBlock Text="Branch" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="10">
                                        <TextBlock Text="Employee" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 2: Reference Code | Parent Tag -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Reference Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Parent Tag" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Req ID -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Req ID" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                </StackPanel>
                                </ScrollViewer>

                                <Separator Margin="0,2,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="Show Inactive" IsChecked="{Binding ShowInactive}" VerticalAlignment="Center"
                                              FontSize="11" Foreground="{StaticResource YakultTextMutedBrush}"/>
                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                        <TextBlock Text="↺  Reset Filters"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>

                <Button Grid.Column="1" x:Name="BtnRefresh" Style="{StaticResource SmallBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Row 2: Tabs — workspace card with a flat tab strip ═══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
            <TabControl x:Name="MainTabs" Style="{StaticResource FlatTabControl}"
                        ItemContainerStyle="{StaticResource FlatTabItem}"
                        SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="Items">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- "Did you mean...?" banner — only shown when these rows came from the fuzzy
                         fallback (FuzzyMatchItems) rather than an exact search-text match, so
                         typo-corrected guesses are never presented as if they were literal hits. -->
                    <Border Grid.Row="0" Padding="14,9" Margin="14,10,14,0"
                            Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#7A5C00" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Items grid -->
                    <DataGrid Grid.Row="1" x:Name="ItemsGrid"
                              Background="White" BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F2"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserReorderColumns="False"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended" SelectionUnit="FullRow"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              FontSize="12.5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinRowHeight="42"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              ItemsSource="{Binding PagedItems}"
                              MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                              Sorting="ItemsGrid_Sorting">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"                    Color="{StaticResource YakultSelectionColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"                Color="{StaticResource YakultTextDarkColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"   Color="{StaticResource YakultSelectionColor}"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource YakultTextDarkColor}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource YakultBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridColumnHeader">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="0,0,0,2">
                                                        <CheckBox x:Name="SelectAllCheckBox" IsThreeState="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  ToolTip="Select / deselect all matching rows"
                                                                  IsChecked="{Binding SelectAllState, Mode=OneWay}"
                                                                  Click="SelectAllCheckBox_Click"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding Selected, Mode=OneWay}"
                                                  Click="RowSelectCheckBox_Changed"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="ID" Binding="{Binding ItemId}" Width="55" SortMemberPath="ItemId"/>

                            <DataGridTextColumn Width="190" SortMemberPath="Name" Binding="{Binding Name}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Name" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnFilterName" DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="Name" Click="ColumnFilterButton_Click"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontWeight"   Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220" SortMemberPath="Description">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="180" SortMemberPath="Remarks">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="130" SortMemberPath="Category" Binding="{Binding Category}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Category" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnFilterCategory" DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="Category" Click="ColumnFilterButton_Click"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="100" SortMemberPath="ItemType" Binding="{Binding ItemType}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Type" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnFilterItemType" DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="ItemType" Click="ColumnFilterButton_Click"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="130" SortMemberPath="ModelNumber" Binding="{Binding ModelNumber}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Model Number" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnFilterModelNumber" DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="ModelNumber" Click="ColumnFilterButton_Click"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="130" SortMemberPath="SerialNumber" Binding="{Binding SerialNumber}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Serial Number" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnFilterSerialNumber" DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="SerialNumber" Click="ColumnFilterButton_Click"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Invoice Type" Binding="{Binding SubType}" Width="110" SortMemberPath="SubType"/>

                            <DataGridTextColumn Header="Stock On Hand" Binding="{Binding StockOnHand}" Width="100" SortMemberPath="StockOnHand"/>
                            <DataGridTextColumn Header="Condition" Binding="{Binding ConditionName}" Width="90" SortMemberPath="ConditionName"/>

                            <DataGridTextColumn Width="140" SortMemberPath="VendorName" Binding="{Binding VendorName}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Vendor" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnFilterVendorName" DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="VendorName" Click="ColumnFilterButton_Click"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Status" Binding="{Binding LatestStatus}" Width="90" SortMemberPath="LatestStatus"/>

                            <DataGridTemplateColumn Header="Active" Width="60" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" IsHitTestVisible="False" IsChecked="{Binding Active, Mode=OneWay}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Fixed Asset" Binding="{Binding IsTrackedAsset, Converter={StaticResource BoolToYesNo}}" Width="90" CanUserSort="False"/>
                            <DataGridTextColumn Header="Acquisition Type" Binding="{Binding AcquisitionType}" Width="120" SortMemberPath="AcquisitionType"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitOfMeasure}" Width="70" SortMemberPath="UnitOfMeasure"/>
                            <DataGridTextColumn Header="Date Created" Binding="{Binding DateCreated, StringFormat=MM/dd/yyyy}" Width="100" SortMemberPath="DateCreated"/>
                            <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="110" SortMemberPath="CreatedByName"/>
                            <DataGridTextColumn Header="Date Modified" Binding="{Binding DateModified, StringFormat=MM/dd/yyyy}" Width="100" SortMemberPath="DateModified"/>
                            <DataGridTextColumn Header="Modified By" Binding="{Binding ModifiedByName}" Width="110" SortMemberPath="ModifiedByName"/>
                            <DataGridTextColumn Header="Warranty (Years)" Binding="{Binding WarrantyYears}" Width="110" SortMemberPath="WarrantyYears"/>
                            <DataGridTextColumn Header="Warranty Start" Binding="{Binding WarrantyStartDate, StringFormat=MM/dd/yyyy}" Width="100" SortMemberPath="WarrantyStartDate"/>
                            <DataGridTextColumn Header="Warranty End" Binding="{Binding WarrantyEndDate, StringFormat=MM/dd/yyyy}" Width="100" SortMemberPath="WarrantyEndDate"/>
                            <DataGridTextColumn Header="Date Purchased" Binding="{Binding DatePurchased, StringFormat=MM/dd/yyyy}" Width="100" SortMemberPath="DatePurchased"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination + legend -->
                    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding FirstPageCommand}"/>
                                <Button Content="‹" Style="{StaticResource PageButton}" Command="{Binding PrevPageCommand}"/>
                                <TextBlock Text="{Binding PageInfo}" FontSize="12.5" Foreground="{StaticResource YakultTextMutedBrush}" VerticalAlignment="Center" Margin="10,0"/>
                                <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding NextPageCommand}"/>
                                <Button Content="»" Style="{StaticResource PageButton}" Command="{Binding LastPageCommand}"/>
                            </StackPanel>

                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Category Stock Summary">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0"
                              Background="White" BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F0F0F2"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeaderWidth="0"
                              FontSize="12.5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MinRowHeight="36"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ItemsSource="{Binding PagedCategorySummaries}">

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{Binding ActiveStock, Converter={StaticResource StockLevelToBrush}}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource YakultAccentTintBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource YakultSelectionBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected"  Value="True"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="{StaticResource YakultSelectionHoverBrush}"/>
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="2*"/>
                            <DataGridTextColumn Header="Active Stock" Binding="{Binding ActiveStock, StringFormat=N0}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Requested Items" Binding="{Binding RequestedItems, StringFormat=N0}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Good" Binding="{Binding GoodCount, StringFormat=N0}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#2F855A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Damaged" Binding="{Binding DamagedCount, StringFormat=N0}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="#C0392B"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="«" Style="{StaticResource PageButton}" Command="{Binding CategoryFirstPageCommand}"/>
                            <Button Content="‹" Style="{StaticResource PageButton}" Command="{Binding CategoryPrevPageCommand}"/>
                            <TextBlock Text="{Binding CategoryPageInfo}" FontSize="12.5" Foreground="{StaticResource YakultTextMutedBrush}" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="›" Style="{StaticResource PageButton}" Command="{Binding CategoryNextPageCommand}"/>
                            <Button Content="»" Style="{StaticResource PageButton}" Command="{Binding CategoryLastPageCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            </TabControl>
        </Border>

        <!-- Full-screen loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#80F0F2F6"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Background="White" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="36,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource YakultPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Loading items…" FontSize="13" Foreground="{StaticResource YakultTextDarkBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
