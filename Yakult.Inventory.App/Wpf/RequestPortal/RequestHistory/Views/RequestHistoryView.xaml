<UserControl
    x:Class="Yakult.Inventory.App.WPF.RequestPortal.RequestHistory.Views.RequestHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestPortal.RequestHistory.ViewModels"
    xmlns:ctrl="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Background="#F0F2F6"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Override: keep cell foreground dark on selection so white-text glitch doesn't show -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background"  Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground"  Value="#1A2333"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border x:Name="HistoryHeaderBar"
                Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Request History"
                               FontSize="18" FontWeight="Bold" Foreground="#2272D9"
                               VerticalAlignment="Center"/>
                    <Border Background="#D6E8FF"
                            CornerRadius="10"
                            Padding="10,4"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCount}"
                                   FontSize="12" FontWeight="Bold" Foreground="#2272D9"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#x21BB; Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Background="#4E9AFC"
                        Height="34" Padding="16,0"/>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Row="1" Margin="20,16,20,16">

            <!-- Loading overlay -->
            <Border Background="#CCFFFFFF"
                    CornerRadius="8"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#x27F3;" FontSize="32" Foreground="{StaticResource YakultBlue}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="13" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- DataGrid card -->
            <Border Style="{StaticResource SectionCard}"
                    Padding="0"
                    Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                <Grid>
                    <!-- Empty state -->
                    <Border Background="{StaticResource SurfaceGray}"
                            CornerRadius="8"
                            Padding="24,32"
                            Visibility="{Binding HasRows, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4CB;" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="No requests found."
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Your submitted requests will appear here."
                                       FontSize="12" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  x:Name="HistoryGrid"
                                  ItemsSource="{Binding PagedRows}"
                                  SelectedItem="{Binding SelectedRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F3F7"
                                  BorderThickness="0"
                                  Background="White"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="36"
                                  MinRowHeight="40"
                                  Cursor="Hand"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  MouseDoubleClick="HistoryGrid_MouseDoubleClick">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <!-- Notification highlight -->
                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                            <Setter Property="Background" Value="#FFF8E1"/>
                                            <Setter Property="BorderBrush" Value="#F59E0B"/>
                                            <Setter Property="BorderThickness" Value="0,2,0,2"/>
                                        </DataTrigger>
                                        <!-- Hover: visible but readable — dark text enforced -->
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#D6E8FF"/>
                                            <Setter Property="Foreground" Value="#1A2333"/>
                                        </MultiTrigger>
                                        <!-- Selected -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#B8D9FF"/>
                                            <Setter Property="Foreground" Value="#1A2333"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Set Code" Binding="{Binding SetCode}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="8,4"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Cartridge Model(s)" Binding="{Binding CartridgeDisplay}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Qty" Binding="{Binding TotalQty}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Empties" Binding="{Binding ReturnInfo}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Setter Property="FontSize" Value="11"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Fulfillment" Binding="{Binding FulfillmentMethod}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="Padding" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Branch" Binding="{Binding DestinationBranch}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}"
                                                       Foreground="{Binding StatusColorBrush}"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextAlignment="Center"
                                                       Padding="6,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tour-targeting phantom zones: invisible, zero hit-test, sized to match grid areas -->
                        <Border x:Name="HistoryColumnHeaderZone"
                                Grid.Row="0"
                                Height="36"
                                VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                Opacity="0"/>

                        <Border x:Name="HistoryDemoRowsZone"
                                Grid.Row="0"
                                Height="80"
                                VerticalAlignment="Top"
                                Margin="0,36,0,0"
                                IsHitTestVisible="False"
                                Opacity="0"/>

                        <Border x:Name="HistoryStatusZone"
                                Grid.Row="0"
                                Width="140"
                                HorizontalAlignment="Right"
                                IsHitTestVisible="False"
                                Opacity="0"/>

                        <!-- Demo data notice (shown when dummy rows are active) -->
                        <Border Grid.Row="1"
                                Background="#FFF8E1"
                                BorderBrush="#FFE082"
                                BorderThickness="0,1,0,0"
                                Padding="16,8"
                                Visibility="{Binding IsDemoDataActive, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ  "
                                           FontSize="12"
                                           Foreground="#856404"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Demo data for this tour."
                                           FontSize="12"
                                           FontStyle="Italic"
                                           Foreground="#856404"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Pagination bar -->
                        <Border x:Name="PaginationBar"
                                Grid.Row="2"
                                Background="#F8FAFC"
                                BorderBrush="#E8EDF3"
                                BorderThickness="0,1,0,0"
                                Padding="16,8"
                                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Record count (left) -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TotalCount, StringFormat='{}{0} records total'}"
                                           FontSize="12"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"/>

                                <!-- Prev / Page info / Next (center) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="&#x276E;"
                                            Command="{Binding PreviousPageCommand}"
                                            Width="30" Height="30"
                                            FontSize="13"
                                            Margin="0,0,6,0"
                                            Background="White"
                                            BorderBrush="#D1D9E0"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <TextBlock Text="{Binding PageInfo}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"
                                               VerticalAlignment="Center"
                                               Margin="4,0"/>

                                    <Button Content="&#x276F;"
                                            Command="{Binding NextPageCommand}"
                                            Width="30" Height="30"
                                            FontSize="13"
                                            Margin="6,0,0,0"
                                            Background="White"
                                            BorderBrush="#D1D9E0"
                                            BorderThickness="1"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
