<UserControl
    x:Class="Yakult.Inventory.App.WPF.RequestPortal.NewRequest.Views.NewRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestPortal.NewRequest.ViewModels"
    xmlns:ctrl="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
    Background="#F0F2F6"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>

        <!-- ── Converters ─────────────────────────────────────────────────── -->
        <ctrl:BoolToVisibilityConverter         x:Key="BoolToVis"/>
        <ctrl:InverseBoolToVisibilityConverter  x:Key="InvBoolToVis"/>
        <ctrl:NullToVisibilityConverter         x:Key="NullToVis"/>

        <!-- ── Color resources ──────────────────────────────────────────── -->
        <SolidColorBrush x:Key="YakultBlue"     Color="#3A8EF6"/>
        <SolidColorBrush x:Key="YakultDarkBlue" Color="#1A6DD0"/>
        <SolidColorBrush x:Key="CardBorder"     Color="#DDE3EC"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#1A2333"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#5A6A7E"/>
        <SolidColorBrush x:Key="ErrorRed"       Color="#E03C31"/>
        <SolidColorBrush x:Key="SuccessGreen"   Color="#1E9E5E"/>
        <SolidColorBrush x:Key="WarningAmber"   Color="#E08A00"/>
        <SolidColorBrush x:Key="SurfaceGray"    Color="#F3F5F8"/>

        <!-- ── Global text style ────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- ── Section card ─────────────────────────────────────────────── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="10"/>
            <Setter Property="Padding"          Value="28,22"/>
            <Setter Property="Margin"           Value="0,0,0,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.07" Color="#0A1A2A" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Section header label ─────────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="{StaticResource YakultBlue}"/>
            <Setter Property="Margin"       Value="0,0,0,16"/>
        </Style>

        <!-- ── Field label ──────────────────────────────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Modern input TextBox ──────────────────────────────────────── -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Padding"                  Value="11,8"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource YakultBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceGray}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Modern ComboBox ───────────────────────────────────────────── -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="BorderBrush"      Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness"  Value="1.5"/>
            <Setter Property="Padding"          Value="11,8"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="Foreground"       Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height"           Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Toggle spans full control — opens dropdown on click -->
                                    <ToggleButton Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press"/>

                                    <ContentPresenter x:Name="ContentSite"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="10,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsHitTestVisible="False"/>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Grid.Column="0"
                                             Margin="8,0,0,0"
                                             Padding="0"
                                             VerticalAlignment="Center"
                                             FontSize="{TemplateBinding FontSize}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"
                                             Visibility="Collapsed"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{StaticResource TextMuted}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="0,1,0,0"
                                          IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="{StaticResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="220">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.12" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite"          Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource YakultBlue}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SurfaceGray}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox item hover ────────────────────────────────────────── -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding"    Value="11,8"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#EBF5FB"/>
                    <Setter Property="Foreground" Value="{StaticResource YakultDarkBlue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Primary action button ──────────────────────────────────────── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource YakultBlue}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="22,11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary (ghost) button ──────────────────────────────────── -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceGray}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Add-item (green) button ────────────────────────────────────── -->
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#27AE60"/>
            <Setter Property="Padding"    Value="16,9"/>
        </Style>

        <!-- ── Remove (red ghost) button ──────────────────────────────────── -->
        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground"      Value="{StaticResource ErrorRed}"/>
            <Setter Property="BorderBrush"     Value="#FFCDD2"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="10,0"/>
        </Style>

        <!-- ── Fulfillment radio-toggle ───────────────────────────────────── -->
        <Style x:Key="FulfillmentRadio" TargetType="RadioButton">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="root"
                                CornerRadius="5"
                                Padding="18,8"
                                BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="root" Property="Background"   Value="{StaticResource YakultBlue}"/>
                                <Setter TargetName="root" Property="BorderBrush"  Value="{StaticResource YakultBlue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="root" Property="Background"   Value="White"/>
                                <Setter TargetName="root" Property="BorderBrush"  Value="{StaticResource CardBorder}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="root" Property="BorderBrush" Value="{StaticResource YakultBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource YakultBlue}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Up/Down arrow button inside spinner ────────────────────────── -->
        <Style x:Key="SpinArrowBtn" TargetType="Button">
            <Setter Property="Background"       Value="#F5F5F5"/>
            <Setter Property="BorderBrush"      Value="#D0D8E0"/>
            <Setter Property="Foreground"       Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"         Value="6"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Focusable"        Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#E0E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#C8D8E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid headers ────────────────────────────────────────────── -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#EEF2F7"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="BorderBrush"     Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
        </Style>

        <!-- ── DataGrid rows ──────────────────────────────────────────────── -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EBF5FB"/>
                    <Setter Property="Foreground" Value="{StaticResource YakultDarkBlue}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F9FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGrid cell ──────────────────────────────────────────────── -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Minimalist scrollbar ───────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Background="#C0C8D0"
                                                        CornerRadius="3" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#90A0B0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Root"       Property="Width"  Value="Auto"/>
                                <Setter TargetName="Root"       Property="Height" Value="6"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" VerticalAlignment="Center">
                    <TextBlock Text="New Cartridge Request"
                               FontSize="18" FontWeight="Bold" Foreground="#2272D9"
                               VerticalAlignment="Center"/>
                </Border>

                <Border Grid.Column="1"
                        Background="#D6E8FF"
                        CornerRadius="14"
                        Padding="14,7"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="15" Foreground="#2272D9"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" FontStyle="Italic" Foreground="#2272D9"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SCROLLABLE FORM -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalFirst">
            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Center"
                        Margin="28,18,28,8">

                <!-- Validation error banner -->
                <Border Background="#FFF3F3"
                        BorderBrush="#FFCDD2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="15" Foreground="{StaticResource ErrorRed}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ValidationError}"
                                   FontSize="12" Foreground="{StaticResource ErrorRed}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1 — REQUESTER IDENTITY -->
                <Border x:Name="RequestDetailsCard" Style="{StaticResource SectionCard}" Height="215">
                    <StackPanel>
                        <TextBlock Text="REQUEST DETAILS" Style="{StaticResource SectionLabel}"/>

                        <!-- Normal mode: read-only identity panel -->
                        <Border x:Name="RequesterIdentityPanel"
                                Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12"
                                Visibility="{Binding IsDeptAccountMode, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="👤  " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RequesterDisplay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢  " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RequesterOrgDisplay}"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="#FFF8E1"
                                        BorderBrush="#FFE082"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12,8"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding HasLinkedEmployee, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource WarningAmber}"
                                               TextWrapping="Wrap">
                                        ⚠  No employee profile linked to your account. Contact IT to link your account, or use the Assisted Request tab.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Dept-account mode: employee selector -->
                        <StackPanel x:Name="DeptEmployeeSelectorPanel" Visibility="{Binding IsDeptAccountMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Select Employee"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding DeptEmployees}"
                                      SelectedItem="{Binding SelectedDeptEmployee}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ModernComboBox}"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="DisplayName"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Margin="0,0,0,10"/>

                            <Border Background="{StaticResource SurfaceGray}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="14,10">
                                <TextBlock Text="{Binding DeptEmployeeInfoText}"
                                           FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2 — CARTRIDGE SELECTION -->
                <Border x:Name="CartridgeSelectionCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="CartridgeSelectionHeader" Text="ITEM SELECTION" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Category"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryCombo"
                                      Grid.Column="1"
                                      ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Style="{StaticResource ModernComboBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CartridgeModelCombo"
                                      Grid.Column="1"
                                      ItemsSource="{Binding CartridgeModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      DisplayMemberPath="ShortDisplayName"
                                      Style="{StaticResource ModernComboBox}"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ShortDisplayName"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"/>
                        </Grid>

                        <Border Background="#EBF5FB"
                                BorderBrush="#AED6F1"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding ShowNoStockWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource YakultDarkBlue}"
                                       TextWrapping="Wrap">
                                ℹ  No current stock for this model. You may still submit your request — the IT team will fulfil it once stock becomes available.
                            </TextBlock>
                        </Border>

                        <!-- Qty row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Qty Requested"
                                       Style="{StaticResource FieldLabel}"/>
                            <Border x:Name="QtySpinnerBorder"
                                    Grid.Column="1"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Quantity}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="▲"
                                                Command="{Binding IncrementQuantityCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="▼"
                                                Command="{Binding DecrementQuantityCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Returned Empty Cartridges label — Cartridge category only -->
                        <TextBlock x:Name="ReturnedEmptyLabel"
                                   Text="Returned Empty Cartridges:"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsCartridgeCategory, Converter={StaticResource BoolToVis}}"/>

                        <!-- Good + Damaged sub-row — Cartridge category only -->
                        <Grid x:Name="ReturnedEmptyRow" Margin="0,0,0,16"
                              Visibility="{Binding IsCartridgeCategory, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Good:"
                                       Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GoodEmptyQty}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessGreen}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="▲"
                                                Command="{Binding IncrementGoodCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="▼"
                                                Command="{Binding DecrementGoodCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="Damaged:"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="40,0,0,0"/>
                            <Border Grid.Column="3"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DamagedEmptyQty}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource ErrorRed}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="▲"
                                                Command="{Binding IncrementDamagedCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="▼"
                                                Command="{Binding DecrementDamagedCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Button x:Name="AddToRequestButton"
                                Content="+ Add to Request"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource AddButton}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 3 — REQUEST ITEMS GRID -->
                <Border x:Name="RequestItemsCard" Style="{StaticResource SectionCard}" Height="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="RequestItemsHeader" Text="REQUEST ITEMS" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Border Background="{StaticResource YakultBlue}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding RequestItems.Count}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RequestItems}"
                                  SelectedItem="{Binding SelectedRequestItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F3F7"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource CardBorder}"
                                  Background="White"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="34"
                                  MinRowHeight="36"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  helpers:ScrollBubbleBehavior.BubbleScroll="True"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Model"
                                                    Binding="{Binding CartridgeModel}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Qty"
                                                    Binding="{Binding Quantity}"
                                                    Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                            <Setter Property="FontWeight"          Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Good"
                                                    Binding="{Binding GoodDisplay}"
                                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                            <Setter Property="Foreground"          Value="{StaticResource SuccessGreen}"/>
                                            <Setter Property="FontWeight"          Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Damaged"
                                                    Binding="{Binding DamagedDisplay}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                            <Setter Property="Foreground"          Value="{StaticResource ErrorRed}"/>
                                            <Setter Property="FontWeight"          Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

<DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Style="{StaticResource RemoveButton}"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="16,14"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="No items yet. Select a cartridge model above and click '+ Add to Request'."
                                       FontSize="12" FontStyle="Italic"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- SECTION 4 — FULFILLMENT & DELIVERY -->
                <Border x:Name="FulfillmentCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="FulfillmentHeader" Text="FULFILLMENT &amp; DELIVERY" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fulfillment Method"
                                       Style="{StaticResource FieldLabel}"/>
                            <RadioButton Grid.Column="1"
                                         Content="PICKUP"
                                         IsChecked="{Binding IsPickup}"
                                         Style="{StaticResource FulfillmentRadio}"
                                         GroupName="FulfillmentGroup"/>
                            <RadioButton Grid.Column="2"
                                         Content="DELIVERY"
                                         IsChecked="{Binding IsDelivery}"
                                         Style="{StaticResource FulfillmentRadio}"
                                         GroupName="FulfillmentGroup"
                                         Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,14"
                              Visibility="{Binding ShowReceivedBy, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="To Be Received By" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Required" FontSize="10" FontStyle="Italic"
                                           Foreground="{StaticResource ErrorRed}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <!-- Org filters row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <StackPanel Width="160">
                                        <TextBlock Text="Company" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbCompanies}"
                                                  SelectedItem="{Binding SelectedRbCompany}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="8,0,0,0">
                                        <TextBlock Text="Branch" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbBranches}"
                                                  SelectedItem="{Binding SelectedRbBranch}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Width="155" Margin="8,0,0,0">
                                        <TextBlock Text="Department" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbDepartments}"
                                                  SelectedItem="{Binding SelectedRbDepartment}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <Button Command="{Binding ClearRbFiltersCommand}"
                                            Content="×" ToolTip="Clear filters"
                                            Margin="6,0,0,0" Width="38" Height="38"
                                            VerticalAlignment="Bottom" Cursor="Hand"
                                            FontSize="14" FontWeight="Bold"
                                            Background="White" Foreground="{StaticResource TextMuted}"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="rbClearRoot" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rbClearRoot" Property="Background" Value="{StaticResource SurfaceGray}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Name search box -->
                                <Grid Margin="0,0,0,4">
                                    <TextBox Text="{Binding RbSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}"
                                             Height="36"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Search by name (type any part)…"
                                               Foreground="#AAB" FontStyle="Italic" FontSize="12"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RbSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Selected employee chip -->
                                <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="1"
                                        CornerRadius="4" Padding="8,4" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedReceivedBy, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓ " Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedReceivedBy.Name}"
                                                   Foreground="#1B5E20" FontWeight="SemiBold"/>
                                        <TextBlock Text=" — " Foreground="#555"/>
                                        <TextBlock Text="{Binding SelectedReceivedBy.DepartmentName}"
                                                   Foreground="#555"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtered employee list (hidden until a filter or search is active) -->
                                <Border BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding ShowRbList, Converter={StaticResource BoolToVis}}">
                                    <ListBox ItemsSource="{Binding FilteredReceivedByEmployees}"
                                             SelectedItem="{Binding SelectedReceivedBy}"
                                             MaxHeight="180"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             helpers:ScrollBubbleBehavior.BubbleScroll="True"
                                             BorderThickness="0"
                                             Background="White">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="{Binding Position}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding BranchName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding DepartmentName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Additional Remarks"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,8,0,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10,8"
                                     MaxLength="500"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM ACTION BAR -->
        <Border x:Name="ActionBar"
                Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="-2" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource YakultBlue}"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Submit Request"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
