<UserControl
    x:Class="Yakult.Inventory.App.WPF.RequestPortal.NewRequest.Views.NewRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestPortal.NewRequest.ViewModels"
    xmlns:ctrl="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
    Background="#F6F5F2"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="New Cartridge Request"
                               FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Choose a category and model, then add each item to your request."
                               FontSize="11.5" Foreground="{StaticResource TextMuted}"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{StaticResource SurfaceGray}"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⟳" FontSize="15" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SCROLLABLE FORM -->
        <ScrollViewer x:Name="FormScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalFirst">
            <StackPanel MaxWidth="900"
                        HorizontalAlignment="Stretch"
                        Margin="28,18,28,8">

                <!-- Validation error banner -->
                <Border Background="#FFF3F3"
                        BorderBrush="#FFCDD2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="15" Foreground="{StaticResource ErrorRed}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ValidationError}"
                                   FontSize="12" Foreground="{StaticResource ErrorRed}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1 — REQUESTER IDENTITY -->
                <Border x:Name="RequestDetailsCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="REQUEST DETAILS" Style="{StaticResource SectionLabel}"/>

                        <!-- Normal mode: read-only identity panel -->
                        <Border x:Name="RequesterIdentityPanel"
                                Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12"
                                Visibility="{Binding IsDeptAccountMode, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="👤  " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RequesterDisplay}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏢  " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding RequesterOrgDisplay}"
                                               FontSize="12" Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Border Background="#FFF8E1"
                                        BorderBrush="#FFE082"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="12,8"
                                        Margin="0,12,0,0"
                                        Visibility="{Binding HasLinkedEmployee, Converter={StaticResource InvBoolToVis}}">
                                    <TextBlock FontSize="11" FontStyle="Italic"
                                               Foreground="{StaticResource WarningAmber}"
                                               TextWrapping="Wrap">
                                        ⚠  No employee profile linked to your account. Contact IT to link your account, or use the Assisted Request tab.
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Dept-account mode: employee selector -->
                        <StackPanel x:Name="DeptEmployeeSelectorPanel" Visibility="{Binding IsDeptAccountMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Select Employee"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding DeptEmployees}"
                                      SelectedItem="{Binding SelectedDeptEmployee}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ModernComboBox}"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="DisplayName"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      Margin="0,0,0,10"/>

                            <Border Background="{StaticResource SurfaceGray}"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="14,10">
                                <TextBlock Text="{Binding DeptEmployeeInfoText}"
                                           FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2 — CARTRIDGE SELECTION -->
                <Border x:Name="CartridgeSelectionCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="CartridgeSelectionHeader" Text="ITEM SELECTION" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Category"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryCombo"
                                      Grid.Column="1"
                                      ItemsSource="{Binding CategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Style="{StaticResource ModernComboBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model"
                                       Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CartridgeModelCombo"
                                      Grid.Column="1"
                                      ItemsSource="{Binding CartridgeModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      DisplayMemberPath="ShortDisplayName"
                                      Style="{StaticResource ModernComboBox}"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ShortDisplayName"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding ShowNoStockWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap">
                                ℹ  No current stock for this model. You may still submit your request — the IT team will fulfil it once stock becomes available.
                            </TextBlock>
                        </Border>

                        <!-- Qty row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Qty Requested"
                                       Style="{StaticResource FieldLabel}"/>
                            <Border x:Name="QtySpinnerBorder"
                                    Grid.Column="1"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Quantity}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="▲"
                                                Command="{Binding IncrementQuantityCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="▼"
                                                Command="{Binding DecrementQuantityCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Returned Empty Cartridges label — Cartridge category only -->
                        <TextBlock x:Name="ReturnedEmptyLabel"
                                   Text="Returned Empty Cartridges:"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsCartridgeCategory, Converter={StaticResource BoolToVis}}"/>

                        <!-- Good + Damaged sub-row — Cartridge category only -->
                        <Grid x:Name="ReturnedEmptyRow" Margin="0,0,0,16"
                              Visibility="{Binding IsCartridgeCategory, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Good:"
                                       Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding GoodEmptyQty}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessGreen}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="▲"
                                                Command="{Binding IncrementGoodCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="▼"
                                                Command="{Binding DecrementGoodCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="Damaged:"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="40,0,0,0"/>
                            <Border Grid.Column="3"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DamagedEmptyQty}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource ErrorRed}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="▲"
                                                Command="{Binding IncrementDamagedCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="▼"
                                                Command="{Binding DecrementDamagedCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Button x:Name="AddToRequestButton"
                                Content="+ Add to Request"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource AddButton}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 3 — REQUEST ITEMS GRID -->
                <Border x:Name="RequestItemsCard" Style="{StaticResource SectionCard}" Height="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock x:Name="RequestItemsHeader" Text="REQUEST ITEMS" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Border Background="{StaticResource YakultAccentTintBrush}"
                                    BorderBrush="{StaticResource YakultAccentBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding RequestItems.Count}"
                                           Foreground="{StaticResource YakultBlue}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RequestItems}"
                                  SelectedItem="{Binding SelectedRequestItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource CardBorder}"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource CardBorder}"
                                  Background="White"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="34"
                                  MinRowHeight="36"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  helpers:ScrollBubbleBehavior.BubbleScroll="True"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Model"
                                                    Binding="{Binding CartridgeModel}"
                                                    Width="*"
                                                    MinWidth="240">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Qty"
                                                    Binding="{Binding Quantity}"
                                                    Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                            <Setter Property="FontWeight"          Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Good"
                                                    Binding="{Binding GoodDisplay}"
                                                    Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                            <Setter Property="Foreground"          Value="{StaticResource SuccessGreen}"/>
                                            <Setter Property="FontWeight"          Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Damaged"
                                                    Binding="{Binding DamagedDisplay}"
                                                    Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment"   Value="Center"/>
                                            <Setter Property="Foreground"          Value="{StaticResource ErrorRed}"/>
                                            <Setter Property="FontWeight"          Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

<DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Style="{StaticResource RemoveButton}"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="16,14"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="No items yet. Select a cartridge model above and click '+ Add to Request'."
                                       FontSize="12" FontStyle="Italic"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- SECTION 4 — FULFILLMENT & DELIVERY -->
                <Border x:Name="FulfillmentCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock x:Name="FulfillmentHeader" Text="FULFILLMENT &amp; DELIVERY" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fulfillment Method"
                                       Style="{StaticResource FieldLabel}"/>
                            <RadioButton Grid.Column="1"
                                         Content="PICKUP"
                                         IsChecked="{Binding IsPickup}"
                                         Style="{StaticResource FulfillmentRadio}"
                                         GroupName="FulfillmentGroup"/>
                            <RadioButton Grid.Column="2"
                                         Content="DELIVERY"
                                         IsChecked="{Binding IsDelivery}"
                                         Style="{StaticResource FulfillmentRadio}"
                                         GroupName="FulfillmentGroup"
                                         Margin="10,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,14"
                              Visibility="{Binding ShowReceivedBy, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="To Be Received By" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="Required" FontSize="10" FontStyle="Italic"
                                           Foreground="{StaticResource ErrorRed}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <!-- Org filters row -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <StackPanel Width="160">
                                        <TextBlock Text="Company" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbCompanies}"
                                                  SelectedItem="{Binding SelectedRbCompany}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="8,0,0,0">
                                        <TextBlock Text="Branch" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbBranches}"
                                                  SelectedItem="{Binding SelectedRbBranch}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Width="155" Margin="8,0,0,0">
                                        <TextBlock Text="Department" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbDepartments}"
                                                  SelectedItem="{Binding SelectedRbDepartment}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <Button Command="{Binding ClearRbFiltersCommand}"
                                            Content="×" ToolTip="Clear filters"
                                            Margin="6,0,0,0" Width="38" Height="38"
                                            VerticalAlignment="Bottom" Cursor="Hand"
                                            FontSize="14" FontWeight="Bold"
                                            Background="White" Foreground="{StaticResource TextMuted}"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="rbClearRoot" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="rbClearRoot" Property="Background" Value="{StaticResource SurfaceGray}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Name search box -->
                                <Grid Margin="0,0,0,4">
                                    <TextBox Text="{Binding RbSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputBox}"
                                             Height="36"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="Search by name (type any part)…"
                                               Foreground="#AAB" FontStyle="Italic" FontSize="12"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RbSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Selected employee chip -->
                                <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1"
                                        CornerRadius="4" Padding="8,4" Margin="0,0,0,4"
                                        Visibility="{Binding SelectedReceivedBy, Converter={StaticResource NullToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓ " Foreground="#15803D" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SelectedReceivedBy.Name}"
                                                   Foreground="#166534" FontWeight="SemiBold"/>
                                        <TextBlock Text=" — " Foreground="#555"/>
                                        <TextBlock Text="{Binding SelectedReceivedBy.DepartmentName}"
                                                   Foreground="#555"/>
                                    </StackPanel>
                                </Border>

                                <!-- Filtered employee list (hidden until a filter or search is active) -->
                                <Border BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="6"
                                        Visibility="{Binding ShowRbList, Converter={StaticResource BoolToVis}}">
                                    <ListBox ItemsSource="{Binding FilteredReceivedByEmployees}"
                                             SelectedItem="{Binding SelectedReceivedBy}"
                                             MaxHeight="180"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             helpers:ScrollBubbleBehavior.BubbleScroll="True"
                                             BorderThickness="0"
                                             Background="White">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock FontSize="11" Foreground="#666">
                                                        <Run Text="{Binding Position}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding BranchName}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding DepartmentName}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Additional Remarks"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top"
                                       Margin="0,8,0,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Height="80"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10,8"
                                     MaxLength="500"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM ACTION BAR -->
        <Border x:Name="ActionBar"
                Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Grid MaxWidth="900" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Submit Request"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
