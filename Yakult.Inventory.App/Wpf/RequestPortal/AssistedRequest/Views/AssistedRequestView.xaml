<UserControl
    x:Class="Yakult.Inventory.App.WPF.RequestPortal.AssistedRequest.Views.AssistedRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.RequestPortal.AssistedRequest.ViewModels"
    xmlns:ctrl="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
    Background="#F0F2F6"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="28,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="34" VerticalAlignment="Center">
                    <TextBlock Text="IT Assisted Request"
                               FontSize="18" FontWeight="Bold" Foreground="#2272D9"
                               VerticalAlignment="Center"/>
                </Border>
                <!-- Dept Level toggle -->
                <Border Grid.Column="1"
                        Background="#F0F7FF"
                        BorderBrush="#AED6F1"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsDeptLevel}"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"/>
                        <TextBlock Text="Dept. Level (no employee)"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#2272D9"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2"
                        Background="#D6E8FF"
                        CornerRadius="14"
                        Padding="14,7"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x27F3;" FontSize="15" Foreground="#2272D9"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="11" FontStyle="Italic" Foreground="#2272D9"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SCROLLABLE FORM -->
        <ScrollViewer x:Name="tourScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalFirst">
            <StackPanel MaxWidth="900" HorizontalAlignment="Center" Margin="28,18,28,8">

                <!-- Validation error banner -->
                <Border Background="#FFF3F3"
                        BorderBrush="#FFCDD2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A0;" FontSize="15" Foreground="{StaticResource ErrorRed}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding ValidationError}"
                                   FontSize="12" Foreground="{StaticResource ErrorRed}"
                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1 — ASSISTED REQUEST BANNER -->
                <Border x:Name="tourAssistedBanner" Style="{StaticResource SectionCard}">
                    <Border Background="#FFF8E8"
                            BorderBrush="#FFD580"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A1;" FontSize="18" Foreground="{StaticResource WarningAmber}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="IT Assisted Request Mode"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource WarningAmber}"/>
                                <TextBlock Text="You are creating this request on behalf of an employee. All fields except cartridge details are optional — useful when encoding historical records."
                                           FontSize="11" Foreground="#A06000"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- SECTION 2 — TARGET EMPLOYEE -->
                <Border x:Name="tourTargetEmployeeCard" Style="{StaticResource SectionCard}"
                        Visibility="{Binding ShowTargetEmployee, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="TARGET EMPLOYEE (Optional)" Style="{StaticResource SectionLabel}"/>

                        <!-- Employee filter row -->
                        <Grid x:Name="tourEmpFilterRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Filter by" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <StackPanel Width="170">
                                    <TextBlock Text="Company" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding Companies}"
                                              SelectedItem="{Binding SelectedEmpFilterCompany}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="Name"
                                              StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <StackPanel Width="150" Margin="8,0,0,0">
                                    <TextBlock Text="Branch" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding EmpFilterBranches}"
                                              SelectedItem="{Binding SelectedEmpFilterBranch}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="Name"
                                              StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <StackPanel Width="165" Margin="8,0,0,0">
                                    <TextBlock Text="Department" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                    <ComboBox ItemsSource="{Binding EmpFilterDepartments}"
                                              SelectedItem="{Binding SelectedEmpFilterDepartment}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBox}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              TextSearch.TextPath="Name"
                                              StaysOpenOnEdit="True"/>
                                </StackPanel>
                                <Button Command="{Binding ClearEmpFiltersCommand}"
                                        Content="×" ToolTip="Clear filters"
                                        Margin="6,0,0,0" Width="38" Height="38"
                                        VerticalAlignment="Bottom" Cursor="Hand"
                                        FontSize="14" FontWeight="Bold"
                                        Background="White" Foreground="{StaticResource TextMuted}"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="root" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceGray}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Select Employee" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="_selectEmployeeCombo"
                                      Grid.Column="1"
                                      ItemsSource="{Binding FilteredEmployees}"
                                      SelectedItem="{Binding SelectedEmployee}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      TextBoxBase.TextChanged="OnSelectEmployeeTextChanged"/>
                        </Grid>

                        <Border Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="14,10">
                            <TextBlock Text="{Binding EmployeeInfoText}"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- SECTION 2b — DEPT LEVEL TARGET (replaces TARGET EMPLOYEE in dept-level mode) -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding IsDeptLevel, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="DEPT LEVEL TARGET (Optional)" Style="{StaticResource SectionLabel}"/>

                        <Border Background="#EBF5FB"
                                BorderBrush="#AED6F1"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,8"
                                Margin="0,0,0,12">
                            <TextBlock FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource YakultDarkBlue}"
                                       TextWrapping="Wrap">
                                &#x2139;  Fill in only what you have — Company, Branch, and Department are all optional.
                            </TextBlock>
                        </Border>

                        <!-- Company -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Company" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Companies}"
                                      SelectedItem="{Binding SelectedCompany}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      StaysOpenOnEdit="True"/>
                        </Grid>

                        <!-- Branch -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Branch" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Branches}"
                                      SelectedItem="{Binding SelectedBranch}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      StaysOpenOnEdit="True"/>
                        </Grid>

                        <!-- Department -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Department" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Departments}"
                                      SelectedItem="{Binding SelectedDepartment}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="Name"
                                      StaysOpenOnEdit="True"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 2c — REQUEST SCOPE -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="REQUEST SCOPE" Style="{StaticResource SectionLabel}"/>

                        <RadioButton GroupName="RequestScope"
                                     IsChecked="{Binding IsCartridgeOnlyScope}"
                                     Cursor="Hand"
                                     Margin="0,0,0,8">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Option 1 — Cartridge only"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="This request only contains cartridges. The Category field below is locked to Cartridge."
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="RequestScope"
                                     IsChecked="{Binding IsMixedConsumableScope}"
                                     Cursor="Hand">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Option 2 — Cartridge + other consumables"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="This request may also include Ink, Printhead, and/or Toner Cartridge items."
                                           FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- SECTION 3 — CARTRIDGE SELECTION -->
                <Border x:Name="tourCartridgeSelectionCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="ITEM SELECTION" Style="{StaticResource SectionLabel}"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableCategoryOptions}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Style="{StaticResource ModernComboBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CartridgeModels}"
                                      SelectedItem="{Binding SelectedModel}"
                                      DisplayMemberPath="ShortDisplayName"
                                      Style="{StaticResource ModernComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      TextSearch.TextPath="ShortDisplayName"
                                      StaysOpenOnEdit="True"/>
                        </Grid>

                        <Border Background="#EBF5FB"
                                BorderBrush="#AED6F1"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding ShowNoStockWarning, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="11" FontStyle="Italic"
                                       Foreground="{StaticResource YakultDarkBlue}"
                                       TextWrapping="Wrap">
                                &#x2139;  No current stock for this model. You may still submit — the team will fulfil it when stock is available.
                            </TextBlock>
                        </Border>

                        <!-- Qty spinner row -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Qty Requested" Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Quantity}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="&#x25B2;"
                                                Command="{Binding IncrementQuantityCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="&#x25BC;"
                                                Command="{Binding DecrementQuantityCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Returned Empty Cartridges label — Cartridge category only -->
                        <TextBlock Text="Returned Empty Cartridges:"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding IsCartridgeCategory, Converter={StaticResource BoolToVis}}"/>

                        <!-- Good + Damaged spinners — Cartridge category only -->
                        <Grid Margin="0,0,0,16"
                              Visibility="{Binding IsCartridgeCategory, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Good:" Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding GoodEmptyQty}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource SuccessGreen}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="&#x25B2;"
                                                Command="{Binding IncrementGoodCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="&#x25BC;"
                                                Command="{Binding DecrementGoodCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Column="2" Text="Damaged:"
                                       Style="{StaticResource FieldLabel}"
                                       Margin="20,0,0,0"/>
                            <Border Grid.Column="3"
                                    BorderBrush="{StaticResource CardBorder}"
                                    BorderThickness="1" CornerRadius="5"
                                    Width="120" Height="34" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="22"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DamagedEmptyQty}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource ErrorRed}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.Row="0" Content="&#x25B2;"
                                                Command="{Binding IncrementDamagedCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0,0,0.5"/>
                                        <Button Grid.Row="1" Content="&#x25BC;"
                                                Command="{Binding DecrementDamagedCommand}"
                                                Style="{StaticResource SpinArrowBtn}"
                                                BorderThickness="1,0.5,0,0"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Button Content="+ Add to Request"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource AddButton}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 4 — REQUEST ITEMS -->
                <Border x:Name="tourRequestItemsCard" Style="{StaticResource SectionCard}" Height="320">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="REQUEST ITEMS" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,0,0"/>
                            <Border Background="{StaticResource YakultBlue}"
                                    CornerRadius="10" Padding="8,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RequestItems.Count}"
                                           Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding RequestItems}"
                                  SelectedItem="{Binding SelectedRequestItem}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="False"
                                  VirtualizingPanel.IsVirtualizing="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F3F7"
                                  BorderThickness="1"
                                  BorderBrush="{StaticResource CardBorder}"
                                  Background="White"
                                  RowHeaderWidth="0"
                                  ColumnHeaderHeight="34"
                                  MinRowHeight="36"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  helpers:ScrollBubbleBehavior.BubbleScroll="True"
                                  Margin="0,0,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Model" Binding="{Binding CartridgeModel}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Good" Binding="{Binding GoodDisplay}" Width="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Damaged" Binding="{Binding DamagedDisplay}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Style="{StaticResource RemoveButton}"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="4,4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="1"
                                Background="{StaticResource SurfaceGray}"
                                BorderBrush="{StaticResource CardBorder}"
                                BorderThickness="1" CornerRadius="5"
                                Padding="16,14"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasItems, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="No items yet. Select a cartridge model above and click '+ Add to Request'."
                                       FontSize="12" FontStyle="Italic"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- SECTION 5 — DESTINATION & FULFILLMENT -->
                <Border x:Name="tourDestinationCard" Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="DESTINATION &amp; FULFILLMENT" Style="{StaticResource SectionLabel}"/>

                        <!-- Fulfillment method -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fulfillment Method" Style="{StaticResource FieldLabel}"/>
                            <RadioButton Grid.Column="1"
                                         Content="PICKUP"
                                         IsChecked="{Binding IsPickup}"
                                         Style="{StaticResource FulfillmentRadio}"
                                         GroupName="AssistedFulfillmentGroup"/>
                            <RadioButton Grid.Column="2"
                                         Content="DELIVERY"
                                         IsChecked="{Binding IsDelivery}"
                                         Style="{StaticResource FulfillmentRadio}"
                                         GroupName="AssistedFulfillmentGroup"
                                         Margin="10,0,0,0"/>
                        </Grid>

                        <!-- Received By (PICKUP only) -->
                        <StackPanel Visibility="{Binding ShowReceivedBy, Converter={StaticResource BoolToVis}}"
                                    Margin="0,0,0,14">
                            <!-- Received By filter row -->
                            <Grid x:Name="tourRbFilterRow" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Filter by" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <StackPanel Width="170">
                                        <TextBlock Text="Company" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding Companies}"
                                                  SelectedItem="{Binding SelectedRbFilterCompany}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Width="150" Margin="8,0,0,0">
                                        <TextBlock Text="Branch" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbFilterBranches}"
                                                  SelectedItem="{Binding SelectedRbFilterBranch}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <StackPanel Width="165" Margin="8,0,0,0">
                                        <TextBlock Text="Department" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}" Margin="2,0,0,3"/>
                                        <ComboBox ItemsSource="{Binding RbFilterDepartments}"
                                                  SelectedItem="{Binding SelectedRbFilterDepartment}"
                                                  DisplayMemberPath="Name"
                                                  Style="{StaticResource ModernComboBox}"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  TextSearch.TextPath="Name"
                                                  StaysOpenOnEdit="True"/>
                                    </StackPanel>
                                    <Button Command="{Binding ClearRbFiltersCommand}"
                                            Content="×" ToolTip="Clear filters"
                                            Margin="6,0,0,0" Width="38" Height="38"
                                            VerticalAlignment="Bottom" Cursor="Hand"
                                            FontSize="14" FontWeight="Bold"
                                            Background="White" Foreground="{StaticResource TextMuted}"
                                            BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="root" Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="root" Property="Background" Value="{StaticResource SurfaceGray}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Received By picker -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="To Be Received By" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="Optional" FontSize="10" FontStyle="Italic"
                                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="_receivedByCombo"
                                          Grid.Column="1"
                                          ItemsSource="{Binding FilteredReceivedByEmployees}"
                                          SelectedItem="{Binding SelectedReceivedBy}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          TextBoxBase.TextChanged="OnReceivedByTextChanged"/>
                            </Grid>
                        </StackPanel>

                        <!-- Remarks -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Additional Remarks"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Top" Margin="0,8,0,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputBox}"
                                     Height="80" TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10,8" MaxLength="500"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 6 — MANUAL AUTHORIZATION -->
                <Border x:Name="tourManualAuthCard" Style="{StaticResource SectionCard}">
                    <StackPanel>

                        <!-- Section header with toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="MANUAL AUTHORIZATION" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <CheckBox IsChecked="{Binding IsManualAuthEnabled}"
                                      VerticalAlignment="Center"
                                      FontSize="12" FontWeight="SemiBold"
                                      Foreground="{StaticResource TextMuted}"
                                      Content="Enable"
                                      Cursor="Hand"
                                      Margin="0,0,16,0"/>
                            <CheckBox IsChecked="{Binding IsQuickAutoApproved}"
                                      VerticalAlignment="Center"
                                      FontSize="12" FontWeight="SemiBold"
                                      Foreground="{StaticResource TextMuted}"
                                      Content="Auto-Approved"
                                      Cursor="Hand"
                                      ToolTip="Check this when the approver has no portal access and the request should be treated as auto-approved. No additional details needed."/>
                        </StackPanel>

                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" Margin="0,0,0,12">
                            Toggle ON if the approver of the target employee does not have access to the portal.
                            Toggle OFF if the approver has portal access.
                        </TextBlock>

                        <!-- Manual Authorization fields — shown when toggle is ON -->
                        <StackPanel Visibility="{Binding ShowManualAuth, Converter={StaticResource BoolToVis}}">

                            <!-- DEBUG: approver load result -->
                            <Border Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,0,8"
                                    Visibility="{Binding ApproverDebugMessage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ApproverDebugMessage}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Foreground="#856404"/>
                            </Border>

                            <!-- Info banner -->
                            <Border Background="#FFF8E8"
                                    BorderBrush="#FFD580"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10"
                                    Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x26A1;" FontSize="15" Foreground="{StaticResource WarningAmber}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="11" Foreground="#A06000" TextWrapping="Wrap">
                                        Select the approver and choose Approved or Rejected. Add remarks if needed.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Decision radios -->
                            <Grid x:Name="tourDecisionRow" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Decision" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="Required" FontSize="10" FontStyle="Italic"
                                               Foreground="{StaticResource ErrorRed}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1"
                                             Content="Auto-Approved"
                                             IsChecked="{Binding ITDecisionAutoApproved}"
                                             Style="{StaticResource FulfillmentRadio}"
                                             GroupName="ITDecisionGroup"/>
                                <RadioButton Grid.Column="2"
                                             Content="Approved"
                                             IsChecked="{Binding ITDecisionApproved}"
                                             Style="{StaticResource FulfillmentRadio}"
                                             GroupName="ITDecisionGroup"
                                             Margin="10,0,0,0"/>
                                <RadioButton Grid.Column="3"
                                             Content="Rejected"
                                             IsChecked="{Binding ITDecisionRejected}"
                                             Style="{StaticResource FulfillmentRadio}"
                                             GroupName="ITDecisionGroup"
                                             Margin="10,0,0,0"/>
                            </Grid>

                            <!-- Authorized By picker (hidden when Auto-Approved) -->
                            <Grid x:Name="tourAuthorizedByRow" Margin="0,0,0,12"
                                  Visibility="{Binding ShowAuthorizedByPicker, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Authorized By" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="Optional" FontSize="10" FontStyle="Italic"
                                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="_authorizedByCombo"
                                          Grid.Column="1"
                                          ItemsSource="{Binding FilteredApprovers}"
                                          SelectedItem="{Binding SelectedApprover}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource ModernComboBox}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          TextBoxBase.TextChanged="OnAuthorizedByTextChanged"/>
                            </Grid>

                            <!-- Remarks (required when Rejected) -->
                            <Grid x:Name="tourAuthRemarksRow">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Auth Remarks" Style="{StaticResource FieldLabel}"
                                               VerticalAlignment="Top" Margin="0,8,0,0"/>
                                    <TextBlock FontSize="10" FontStyle="Italic"
                                               Foreground="{StaticResource ErrorRed}" Margin="0,2,0,0"
                                               Visibility="{Binding ITRemarksRequired, Converter={StaticResource BoolToVis}}">
                                        Required when Rejected
                                    </TextBlock>
                                    <TextBlock FontSize="10" FontStyle="Italic"
                                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                               Visibility="{Binding ITRemarksRequired, Converter={StaticResource InvBoolToVis}}">
                                        Optional
                                    </TextBlock>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding ITAuthRemarks, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InputBox}"
                                         Height="70" TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         VerticalContentAlignment="Top"
                                         Padding="10,8" MaxLength="500"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- BOTTOM ACTION BAR -->
        <Border x:Name="tourActionBar"
                Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="28,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="-2" Opacity="0.05" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           FontSize="12" FontStyle="Italic"
                           Foreground="{StaticResource WarningAmber}"
                           VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="Submit Request"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
