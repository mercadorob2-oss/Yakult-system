<UserControl
    x:Class="Yakult.Inventory.App.WPF.RequestPortal.NotificationBellControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="46" Height="46"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <!--
        44×44 grid: the bell button sits in the center, the badge floats
        over the top-right corner. ClipToBounds is False by default on Grid,
        so negative margins let the badge extend slightly beyond the button.
    -->
    <Grid ClipToBounds="False">

        <!-- Silent mode indicator: diagonal line across the bell -->
        <Line x:Name="SilentLine"
              X1="7" Y1="7" X2="27" Y2="27"
              Stroke="White" StrokeThickness="2.5"
              Panel.ZIndex="10"
              IsHitTestVisible="False"
              Visibility="Collapsed"/>

        <!-- ── Bell button ── -->
        <Button x:Name="BellButton"
                Click="OnBellClicked"
                Width="34" Height="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Cursor="Hand"
                ToolTip="Notifications"
                FocusVisualStyle="{x:Null}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            Background="Transparent"
                            CornerRadius="7"
                            Padding="5">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="#28FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background"
                                    Value="#48FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>

            <!-- Bell icon -->
            <TextBlock Text="&#x1F514;"
                       FontFamily="Segoe UI Emoji"
                       FontSize="16"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>

        <!-- ── Badge (floats over top-right of bell) ── -->
        <Border x:Name="BadgeBorder"
                Visibility="Collapsed"
                Background="#DC3232"
                CornerRadius="9"
                MinWidth="18" Height="18"
                Padding="3,0,3,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="4"
                                  ShadowDepth="1" Opacity="0.35"
                                  Direction="270"/>
            </Border.Effect>
            <TextBlock x:Name="BadgeText"
                       Text="0"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
