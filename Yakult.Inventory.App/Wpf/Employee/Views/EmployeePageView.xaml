<UserControl x:Class="Yakult.Inventory.App.WPF.Employee.Views.EmployeePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <!-- Column header with a per-column filter button, based on the shared header
                 chrome but adding a funnel-icon Button ("FilterBtn") next to the sort arrow.
                 Same pattern as EmployeeManagementView.xaml (Admin Portal). -->
            <Style x:Key="EmployeeGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListDataGridColumnHeader}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <DockPanel>
                                        <Path x:Name="SortArrow"
                                              DockPanel.Dock="Right"
                                              Width="8" Height="6"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"
                                              Fill="White" Opacity="0.4"
                                              Stretch="Uniform"
                                              Data="M 1,2.5 L 4,0 L 7,2.5 Z M 1,3.5 L 4,6 L 7,3.5 Z"/>
                                        <Button x:Name="FilterBtn"
                                                DockPanel.Dock="Right"
                                                Tag="{TemplateBinding Content}"
                                                Padding="3,0"
                                                Margin="2,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Filter this column">
                                            <Path Data="M 0,0 H 7 L 4.5,3.5 V 7 H 2.5 V 3.5 Z"
                                                  Fill="White" Width="7" Height="7" Stretch="Fill" Opacity="0.75"/>
                                        </Button>
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <Thumb x:Name="PART_LeftHeaderGripper"  HorizontalAlignment="Left"  Width="8" Cursor="SizeWE" Opacity="0"/>
                                <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortArrow" Property="Data"    Value="M 0,5 L 4,0 L 8,5 Z"/>
                                    <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortArrow" Property="Data"    Value="M 0,0 L 4,5 L 8,0 Z"/>
                                    <Setter TargetName="SortArrow" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Employees" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Manage employee records" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryBtn}" Command="{Binding RefreshCommand}" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Toolbar: actions + search + Advanced Filters ════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ToolbarBar}">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryBtn}" Command="{Binding AddCommand}">
                    <TextBlock Text="➕  Add Employee"/>
                </Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding EditCommand}">
                    <TextBlock Text="✎  Edit"/>
                </Button>
                <Button Style="{StaticResource SmallBtn}" Command="{Binding ArchiveCommand}">
                    <TextBlock Text="📦  Archive"/>
                </Button>
                <Button Style="{StaticResource DangerBtn}" Command="{Binding DeleteCommand}" Margin="0,0,8,8">
                    <TextBlock Text="🗑  Delete"/>
                </Button>

                <Border Background="#EBF5FF" CornerRadius="10" Padding="10,5" Margin="0,0,16,8" VerticalAlignment="Center"
                        Cursor="Hand" ToolTip="Click to view and unselect employees"
                        MouseLeftButtonUp="SelectedBadge_Click"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#4E9AFC" TextDecorations="Underline">
                        <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                        <Run Text=" Selected"/>
                    </TextBlock>
                </Border>

                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#7A8A9A"/>
                <TextBox Style="{StaticResource SearchBox}" Width="260" Margin="0,0,8,8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Name, Employee #, Position, Company, Branch, or Department..."/>

                <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                              Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                       IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                       StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Width="280">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Filter By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                      ItemsSource="{Binding FilterByOptions}"
                                      SelectedItem="{Binding SelectedFilterBy, Mode=TwoWay}"/>

                            <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                            <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                      ItemsSource="{Binding SortByOptions}"
                                      SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>

                            <Separator Margin="0,2,0,12"/>

                            <Button HorizontalAlignment="Right" Style="{StaticResource SmallBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                <TextBlock Text="↺  Reset Filters"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </WrapPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" Margin="14,0,14,0">
            <DataGrid x:Name="EmployeesGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      ColumnHeaderStyle="{StaticResource EmployeeGridColumnHeader}"
                      IsReadOnly="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ItemsSource="{Binding PagedEmployees}"
                      Sorting="EmployeesGrid_Sorting"
                      MouseDoubleClick="EmployeesGrid_MouseDoubleClick"
                      ButtonBase.Click="EmployeesGrid_HeaderButtonClick">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False" CellStyle="{StaticResource SelectColumnCell}">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource PrimaryHoverBrush}" BorderThickness="0,0,1,1">
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Select / deselect all rows on this page"
                                                          Click="SelectAllCheckBox_Click"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          Checked="RowSelectCheckBox_Changed"
                                          Unchecked="RowSelectCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ID" Binding="{Binding EmpId}" Width="55" SortMemberPath="EmpId"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.6*" MinWidth="140" SortMemberPath="Name"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding TitleCode}" Width="*" MinWidth="70" SortMemberPath="TitleCode"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Employee #" Binding="{Binding EmployeeNumber}" Width="*" MinWidth="100" SortMemberPath="EmployeeNumber"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Position" Binding="{Binding Position}" Width="1.2*" MinWidth="120" SortMemberPath="Position"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.8*" MinWidth="160" SortMemberPath="Description"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.2*" MinWidth="110" SortMemberPath="CompanyName"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Branch" Binding="{Binding BranchName}" Width="1.2*" MinWidth="110" SortMemberPath="BranchName"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="1.2*" MinWidth="110" SortMemberPath="DepartmentName"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Distributor" Binding="{Binding DistributorName}" Width="1.2*" MinWidth="110" SortMemberPath="DistributorName"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                    <DataGridTextColumn Header="Date Created" Binding="{Binding DateCreated, StringFormat=MM/dd/yyyy}" Width="*" MinWidth="110" SortMemberPath="DateCreated"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Created By" Binding="{Binding CreatedByName}" Width="1.1*" MinWidth="110" SortMemberPath="CreatedByName"
                                        ElementStyle="{StaticResource WrapCellText}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Pagination ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <shared:PagingControl HorizontalAlignment="Left"
                                   FirstPageCommand="{Binding FirstPageCommand}"
                                   PrevPageCommand="{Binding PrevPageCommand}"
                                   NextPageCommand="{Binding NextPageCommand}"
                                   LastPageCommand="{Binding LastPageCommand}"
                                   PageInfoText="{Binding PageInfoText}"/>
        </Border>
    </Grid>
</UserControl>
