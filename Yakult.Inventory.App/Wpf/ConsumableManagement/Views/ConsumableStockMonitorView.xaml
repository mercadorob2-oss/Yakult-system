<UserControl x:Class="Yakult.Inventory.App.WPF.ConsumableManagement.Views.ConsumableStockMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.ConsumableManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BucketToAccentBrushConverter x:Key="Accent"/>
        <conv:BucketToTintBrushConverter   x:Key="Tint"/>
        <conv:DeltaToBrushConverter        x:Key="DeltaBrush"/>
        <conv:DeltaToGlyphConverter        x:Key="DeltaGlyph"/>
        <conv:SignedNumberConverter        x:Key="Signed"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A2333"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="#4E9AFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#4E9AFC"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="FontSize"                   Value="11"/>
            <Setter Property="Padding"                    Value="10,9"/>
            <Setter Property="BorderBrush"                Value="#3A8EF6"/>
            <Setter Property="BorderThickness"            Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <!-- Outstanding request lines: tinted + italic so they read as "not posted yet" -->
                <DataTrigger Binding="{Binding IsPending}" Value="True">
                    <Setter Property="Background" Value="#FFF8E7"/>
                    <Setter Property="FontStyle"  Value="Italic"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0 · Header + live controls -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,14,18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Consumable Stock Monitor"
                                   FontSize="18" FontWeight="Bold" Foreground="#4E9AFC"/>
                        <Border x:Name="LivePill" CornerRadius="9" Padding="8,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E9E54"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Background" Value="#E67E22"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLive}" Value="False">
                                            <Setter Property="Background" Value="#7A8A9A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="10" Foreground="#5A6A7A" Margin="0,5,0,0"
                               Text="Live quantity changes on Ink, Toner, Printhead and Cartridge catalog items — polled from the database and diffed on an interval"/>
                    <TextBlock FontSize="10" Foreground="#7A8A9A" Margin="0,3,0,0">
                        <Run Text="{Binding WatchedItemCount, Mode=OneWay}"/><Run Text=" items watched · "/><Run Text="{Binding TotalWatchedStock, Mode=OneWay}"/><Run Text=" total on hand · "/><Run Text="{Binding LastCheckedText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Every" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="60" Height="30" VerticalContentAlignment="Center"
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"/>
                    <TextBlock Text="s" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="4,0,14,0"/>

                    <Button Style="{StaticResource ToolButton}" Background="#E67E22"
                            Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="⟳  Refresh now" Command="{Binding RefreshNowCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Background="#7A8A9A"
                            Content="🗑  Clear feed" Command="{Binding ClearFeedCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 1 · Bucket colour-coded summary chips -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Summaries}" Margin="18,12,18,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,10,0" CornerRadius="8" Padding="14,10"
                            Background="{Binding Bucket, Converter={StaticResource Tint}}"
                            BorderThickness="1,1,1,4"
                            BorderBrush="{Binding Bucket, Converter={StaticResource Accent}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Bucket}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding Bucket, Converter={StaticResource Accent}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding TotalStock}" FontSize="24" FontWeight="Bold" Foreground="#1A2333"/>
                                <TextBlock Text="{Binding ItemCount, StringFormat={}{0} items}" FontSize="10"
                                           Foreground="#5A6A7A" VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LastChangeText}" FontSize="9" Foreground="#7A8A9A" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 2 · Feed toolbar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="18,10" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Change feed" FontSize="12" FontWeight="Bold" Foreground="#1A2333" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FeedCount, StringFormat={}({0})}" FontSize="11" Foreground="#7A8A9A"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>

                <TextBlock Text="Show:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="18,0,6,0"/>
                <ComboBox Width="150" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding RangeOptions}"
                          SelectedItem="{Binding SelectedRange, Mode=TwoWay}"/>

                <TextBlock Text="Category:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="14,0,6,0"/>
                <ComboBox Width="150" Height="28" VerticalContentAlignment="Center"
                          ItemsSource="{Binding BucketFilterOptions}"
                          SelectedItem="{Binding SelectedBucketFilter, Mode=TwoWay}"/>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Movement:" FontSize="11" Foreground="#5A6A7A" VerticalAlignment="Center" Margin="14,0,6,0"/>
                    <ComboBox Width="140" Height="28" VerticalContentAlignment="Center"
                              ItemsSource="{Binding MovementDirectionOptions}"
                              SelectedItem="{Binding SelectedMovementDirection, Mode=TwoWay}"/>
                    <CheckBox Content="Include pending requests" VerticalAlignment="Center" Margin="14,0,0,0"
                              FontSize="11" Foreground="#5A6A7A"
                              IsChecked="{Binding IncludePendingRequests, Mode=TwoWay}"
                              ToolTip="Show unfulfilled dbo.Request lines (assisted / combo sets) that have not hit the ledger yet"/>
                </StackPanel>

                <TextBlock Text="{Binding RangeCaption}" FontSize="10" Foreground="#7A8A9A"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>

                <Border Background="#EBF5FF" CornerRadius="4" Padding="8,3" Margin="14,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingHistory}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="⟳ Loading…" FontSize="10" Foreground="#4E9AFC"/>
                </Border>

                <Border Background="#FDECEC" CornerRadius="4" Padding="8,3" Margin="14,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorText}" FontSize="10" Foreground="#D03A3A"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Row 3 · Live feed -->
        <Grid Grid.Row="3">
            <DataGrid x:Name="FeedGrid"
                      Background="White"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEF1F4"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFBFC"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      FontSize="12"
                      ItemsSource="{Binding Feed}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding WhenText}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,6,4,6"/>
                                <Setter Property="Foreground" Value="#5A6A7A"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Category" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" Margin="6,4"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{Binding Bucket, Converter={StaticResource Tint}}">
                                    <TextBlock Text="{Binding Bucket}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding Bucket, Converter={StaticResource Accent}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Item" Binding="{Binding ItemName}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="Foreground" Value="#5A6A7A"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="LineHeight" Value="13"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Detail" Binding="{Binding ChangeText}" Width="260">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="LineHeight" Value="13"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Padding" Value="4,6"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Change" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Delta, Converter={StaticResource DeltaGlyph}}"
                                               Foreground="{Binding Delta, Converter={StaticResource DeltaBrush}}"
                                               FontSize="11" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Delta, Converter={StaticResource Signed}}"
                                               Foreground="{Binding Delta, Converter={StaticResource DeltaBrush}}"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Type / By" Binding="{Binding TypeText}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="Foreground" Value="#7A8A9A"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Foreground="#9AA7B4" FontSize="12" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Text" Value="Waiting for the first stock change…  Changes appear here the moment a poll detects one."/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                <Setter Property="Text" Value="No stock movements match this range and the current Movement filter."/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FeedCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
