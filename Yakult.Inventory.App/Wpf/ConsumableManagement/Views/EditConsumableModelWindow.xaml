<Window x:Class="Yakult.Inventory.App.WPF.ConsumableManagement.Views.EditConsumableModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Consumable Model"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        Background="#F0F2F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="BorderBrush"              Value="#C8D0DC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#4E9AFC"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"                 Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"     Value="#4E9AFC"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Width"          Value="90"/>
            <Setter Property="Height"         Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#5A6A7A"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderBrush"     Value="#C8D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Width"           Value="90"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF1F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>  <!-- Header -->
            <RowDefinition Height="*"/>   <!-- Body   -->
            <RowDefinition Height="58"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#4E9AFC">
            <TextBlock Text="Edit Consumable Model"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0"/>
        </Border>

        <!-- ── Body ───────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="White"
                Margin="16,12,16,8"
                CornerRadius="8"
                BorderBrush="#DDE3EC"
                BorderThickness="1">
            <Grid Margin="20,16,20,16">

                <!-- Loading state -->
                <TextBlock x:Name="LoadingText"
                           Text="Loading…"
                           FontSize="13"
                           Foreground="#8A9AB0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <!-- Form (hidden until data loaded) -->
                <StackPanel x:Name="FormPanel" Visibility="Collapsed">

                    <TextBlock Text="MODEL NUMBER"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#7A8A9A"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtModelNumber" Style="{StaticResource FormInput}"/>

                    <TextBlock Text="CATEGORY"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#7A8A9A"
                               Margin="0,14,0,5"/>
                    <ComboBox x:Name="CmbCategory" Style="{StaticResource FormCombo}">
                        <ComboBoxItem Content="Ink"/>
                        <ComboBoxItem Content="Toner"/>
                        <ComboBoxItem Content="Print Head"/>
                    </ComboBox>

                    <StackPanel Margin="2,14,0,0">
                        <CheckBox x:Name="ChkRequestable"
                                  Content="Is Requestable"
                                  FontSize="13"
                                  Foreground="#1A2333"
                                  Cursor="Hand"
                                  VerticalContentAlignment="Center"/>
                        <CheckBox x:Name="ChkActive"
                                  Content="Is Active"
                                  FontSize="13"
                                  Foreground="#1A2333"
                                  Cursor="Hand"
                                  VerticalContentAlignment="Center"
                                  Margin="0,10,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Footer ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#F8F9FB"
                BorderBrush="#DDE3EC"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0" LastChildFill="False" VerticalAlignment="Center">
                <Button x:Name="BtnSave"
                        Content="Save"
                        DockPanel.Dock="Right"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnSave_Click"/>
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        DockPanel.Dock="Right"
                        Margin="0,0,8,0"
                        Style="{StaticResource GhostButton}"
                        Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>

    </Grid>
</Window>
