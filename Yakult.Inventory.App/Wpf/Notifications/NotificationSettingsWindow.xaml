<Window
    x:Class="Yakult.Inventory.App.Wpf.Notifications.NotificationSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Notification Settings"
    Width="520" Height="310"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    ShowInTaskbar="False"
    FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Toggle switch control template -->
        <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="54" Height="28" VerticalAlignment="Center">
                            <!-- Track -->
                            <Border x:Name="Track"
                                    CornerRadius="14"
                                    Background="#CBD5E1"/>
                            <!-- Thumb -->
                            <Ellipse x:Name="Thumb"
                                     Width="22" Height="22"
                                     Fill="White"
                                     HorizontalAlignment="Left"
                                     Margin="3,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="1" BlurRadius="4"
                                                      Opacity="0.3" Color="Black"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4E9AFC"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded button style factory -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DADAE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F0F4FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E4EEFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Blue header ────────────────────────────────────────────── -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4E9AFC" Offset="0"/>
                    <GradientStop Color="#3A86E8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <TextBlock Text="&#x1F514;"
                           FontFamily="Segoe UI Emoji"
                           FontSize="20"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Notification Settings"
                           FontSize="16" FontWeight="Bold"
                           Foreground="White"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Body ──────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Background="White" Margin="28,20,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toggle row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Enable Notifications"
                           FontSize="13" FontWeight="Bold"
                           Foreground="#161628"
                           VerticalAlignment="Center"/>
                <ToggleButton x:Name="toggleSwitch"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Margin="16,0,0,0"/>
                <TextBlock x:Name="lblToggleState"
                           Text="ON"
                           FontSize="11" FontWeight="Bold"
                           Foreground="#4E9AFC"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Description -->
            <TextBlock Grid.Row="2"
                       TextWrapping="Wrap"
                       FontSize="10.5"
                       Foreground="#505064"
                       LineHeight="18"
                       Text="When silenced, no badge or alerts will appear and the bell shows a slash — but all notification records are still saved so you can read them anytime. This is silent mode, not a full disable."/>

            <!-- Separator -->
            <Rectangle Grid.Row="4" Fill="#DADAE6" Height="1"/>

            <!-- Status message -->
            <TextBlock x:Name="lblStatus"
                       Grid.Row="6"
                       FontSize="10.5"
                       Height="18"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="8" Orientation="Horizontal">
                <Button x:Name="btnSave"
                        Content="Save"
                        Style="{StaticResource PrimaryBtn}"
                        Background="#D50032"
                        Width="100" Height="36"
                        Margin="0,0,8,0"
                        Click="BtnSave_Click"/>
                <Button x:Name="btnTest"
                        Content="Test Notification"
                        Style="{StaticResource SecondaryBtn}"
                        Foreground="#505064"
                        Width="152" Height="36"
                        Margin="0,0,8,0"
                        Click="BtnTest_Click"/>
                <Button x:Name="btnClose"
                        Content="Close"
                        Style="{StaticResource SecondaryBtn}"
                        Foreground="#808090"
                        Width="90" Height="36"
                        Click="BtnClose_Click"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
