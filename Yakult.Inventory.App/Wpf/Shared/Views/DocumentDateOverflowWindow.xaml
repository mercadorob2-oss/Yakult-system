<Window
    x:Class="Yakult.Inventory.App.WPF.Shared.Views.DocumentDateOverflowWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Document Date Filters"
    Width="620" MinWidth="560" SizeToContent="Height" MaxHeight="720"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    FontFamily="Segoe UI"
    ShowInTaskbar="False"
    WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,20,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Document Date"
                   FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

        <ScrollViewer Grid.Row="1" MaxHeight="520" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox Style="{StaticResource FilterCombo}" Width="150" Margin="0,0,8,0"
                                      ItemsSource="{Binding MonthOptions}"
                                      SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                      ToolTip="Month"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="100" Margin="0,0,8,0"
                                      ItemsSource="{Binding DayOptions}"
                                      SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                      ToolTip="Day"/>
                            <ComboBox Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,8,0"
                                      ItemsSource="{Binding YearOptions}"
                                      SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                      ToolTip="Year"/>
                            <Button Style="{StaticResource SmallBtn}" Command="{Binding RemoveCommand}" Margin="0"
                                    ToolTip="Remove this date row" Padding="8,0">
                                <TextBlock Text="✕"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Grid.Row="2" HorizontalAlignment="Left" Style="{StaticResource SmallBtn}"
                Command="{Binding AddRowCommand}" Margin="0,0,0,16">
            <TextBlock Text="➕  Add Date Row"/>
        </Button>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource PrimaryBtn}" Content="Done" Click="DoneButton_Click" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
