<Window
    x:Class="Yakult.Inventory.App.WPF.Archive.Views.ArchiveDetailsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.Archive.ViewModels"
    Title="{Binding DialogTitle}"
    MinWidth="680" MinHeight="520"
    Width="720" Height="680"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringToColorBrushConverter      x:Key="HexToBrush"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"                     Value="Segoe UI"/>
            <Setter Property="Foreground"                     Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ── Section card ───────────────────────────────────────────────── -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <!-- ── Section title inside card ─────────────────────────────────── -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#5A6A7E"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- ── Field label (key) ─────────────────────────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7A8D"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <!-- ── Read-only field value box ─────────────────────────────────── -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="IsReadOnly"              Value="True"/>
            <Setter Property="Background"              Value="#F5F7FA"/>
            <Setter Property="BorderBrush"             Value="#DDE3EC"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="8,5"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="Foreground"              Value="#1A2333"/>
            <Setter Property="Margin"                  Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Multiline read-only field box ─────────────────────────────── -->
        <Style x:Key="MultilineFieldBox" TargetType="TextBox">
            <Setter Property="IsReadOnly"              Value="True"/>
            <Setter Property="Background"              Value="#F5F7FA"/>
            <Setter Property="BorderBrush"             Value="#DDE3EC"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="Padding"                 Value="8,5"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="Foreground"              Value="#1A2333"/>
            <Setter Property="Margin"                  Value="0,0,0,8"/>
            <Setter Property="TextWrapping"            Value="Wrap"/>
            <Setter Property="AcceptsReturn"           Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="MinHeight"               Value="52"/>
            <Setter Property="MaxHeight"               Value="100"/>
        </Style>

        <!-- ── Action button base ────────────────────────────────────────── -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid column header ────────────────────────────────────── -->
        <Style x:Key="SubGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="#EEF2F7"/>
            <Setter Property="Foreground"      Value="#3A4A5A"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- ── Thin scrollbar ────────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C0CAD4" CornerRadius="3" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Dynamic entity field DataTemplate ─────────────────────────── -->
        <DataTemplate x:Key="EntityFieldTemplate" DataType="{x:Type vm:EntityFieldDto}">
            <Grid Margin="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding FieldName}"
                           Style="{StaticResource FieldLabel}"/>
                <!-- Single-line value -->
                <TextBox Grid.Row="1" Text="{Binding FieldValue, Mode=OneWay}"
                         Style="{StaticResource FieldBox}"
                         Visibility="{Binding IsMultiline, Converter={StaticResource InvBoolToVis}}"/>
                <!-- Multiline value -->
                <TextBox Grid.Row="1" Text="{Binding FieldValue, Mode=OneWay}"
                         Style="{StaticResource MultilineFieldBox}"
                         Visibility="{Binding IsMultiline, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="#F0F2F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- Blue header band -->
            <RowDefinition Height="*"/>    <!-- Scrollable body -->
            <RowDefinition Height="Auto"/> <!-- Footer buttons -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0: Header band ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#1A3A6A">
            <Grid Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Archive Details"
                                   FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding EntityBadge}"
                                   FontSize="10" Foreground="#AABBCC" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Status badge: Archived / Restored -->
                <Border Grid.Column="1" VerticalAlignment="Center"
                        CornerRadius="12" Padding="12,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsArchived}" Value="False">
                                    <Setter Property="Background" Value="#1E9E5E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                        <Setter Property="Text" Value="ARCHIVED"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsArchived}" Value="False">
                                        <Setter Property="Text" Value="RESTORED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Row 1: Scrollable body ══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">
            <StackPanel Margin="16,14,16,14">

                <!-- Loading overlay inside body -->
                <Border Background="#F0F2F6" Padding="20"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="16" Foreground="#3A8EF6"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Loading archive details…"
                                   FontSize="12" Foreground="#4A5A6A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- ── Section 1: Archive Information ────────────────────── -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#C0392B" Offset="0"/>
                            <GradientStop Color="#DDE3EC" Offset="0.05"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness Left="1" Top="3" Right="1" Bottom="1"/>
                    </Border.BorderThickness>
                    <StackPanel>
                        <TextBlock Text="ARCHIVE INFORMATION" Style="{StaticResource SectionTitle}"
                                   Foreground="#C0392B"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Archive ID -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="ARCHIVE ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ArchiveId, Mode=OneWay}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>

                            <!-- Entity Type -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="ENTITY TYPE" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EntityType, Mode=OneWay}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>

                            <!-- Archived At -->
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="ARCHIVED AT" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ArchivedAt, Mode=OneWay}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>

                            <!-- Archived By -->
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="ARCHIVED BY" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ArchivedBy, Mode=OneWay}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>

                            <!-- Archive Reason (full width) -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="ARCHIVE REASON" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ArchiveReason, Mode=OneWay}"
                                         Style="{StaticResource MultilineFieldBox}"
                                         MinHeight="38" MaxHeight="70"/>
                            </StackPanel>

                            <!-- Restored info (only if restored) -->
                            <StackPanel Grid.Row="3" Grid.Column="0"
                                        Visibility="{Binding IsArchived, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="RESTORED AT" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding RestoredAt, Mode=OneWay}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="2"
                                        Visibility="{Binding IsArchived, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="RESTORED BY" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding RestoredBy, Mode=OneWay}" Style="{StaticResource FieldBox}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Section 2: Entity Details ──────────────────────────── -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding IsLoading, Converter={StaticResource InvBoolToVis}}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A8EF6" Offset="0"/>
                            <GradientStop Color="#DDE3EC" Offset="0.05"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness Left="1" Top="3" Right="1" Bottom="1"/>
                    </Border.BorderThickness>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Foreground="#2E7EE8">
                            <Run Text="{Binding EntityType, Mode=OneWay}"/>
                            <Run Text=" DETAILS"/>
                        </TextBlock>

                        <!-- Entity not found message -->
                        <Border Background="#FFF3F3" BorderBrush="#F5C6CB" BorderThickness="1"
                                CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                                Visibility="{Binding EntityNotFound, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#C0392B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding EntityNotFoundMessage}"
                                           FontSize="11" Foreground="#C0392B"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Dynamic two-column field grid -->
                        <ItemsControl ItemsSource="{Binding EntityFields}"
                                      ItemTemplate="{StaticResource EntityFieldTemplate}"
                                      Visibility="{Binding EntityNotFound, Converter={StaticResource InvBoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Two-column wrap panel: single-line fields share columns, multiline take full width -->
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Width" Value="330"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                            <Setter Property="Width" Value="NaN"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ── Section 3: Set Items (only for Set type) ───────────── -->
                <Border Style="{StaticResource SectionCard}"
                        Visibility="{Binding ShowSetItems, Converter={StaticResource BoolToVis}}">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E9E5E" Offset="0"/>
                            <GradientStop Color="#DDE3EC" Offset="0.05"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>
                        <Thickness Left="1" Top="3" Right="1" Bottom="1"/>
                    </Border.BorderThickness>
                    <StackPanel>
                        <TextBlock Text="ITEMS IN THIS SET" Style="{StaticResource SectionTitle}" Foreground="#1E7A4A"/>

                        <DataGrid ItemsSource="{Binding SetItems}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  RowHeaderWidth="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF2F7"
                                  BorderThickness="1" BorderBrush="#DDE3EC"
                                  Background="White"
                                  MaxHeight="220"
                                  ColumnHeaderStyle="{StaticResource SubGridHeader}"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Req #"    Binding="{Binding ReqId}"        Width="55"/>
                                <DataGridTextColumn Header="Status"   Binding="{Binding Status}"       Width="80"/>
                                <DataGridTextColumn Header="Item"     Binding="{Binding ItemName}"     Width="*"/>
                                <DataGridTextColumn Header="Model #"  Binding="{Binding ModelNumber}"  Width="90"/>
                                <DataGridTextColumn Header="Qty"      Binding="{Binding Qty}"          Width="40"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}"     Width="80"/>
                                <DataGridTextColumn Header="Serial #" Binding="{Binding SerialNumber}" Width="90"/>
                                <DataGridTextColumn Header="Employee" Binding="{Binding Employee}"     Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Status / error message -->
                <Border Background="#FFF3F3" BorderBrush="#F5C6CB" BorderThickness="1"
                        CornerRadius="6" Padding="12,8"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11" Foreground="#C0392B" TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ Row 2: Footer buttons ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDE3EC"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="-2" Opacity="0.07" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Restore note -->
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           FontSize="10" Foreground="#8A9AAA" FontStyle="Italic"
                           Visibility="{Binding IsArchived, Converter={StaticResource InvBoolToVis}}">
                    This record has already been restored.
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <!-- Restoring indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#1E9E5E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Restoring…" FontSize="11" Foreground="#1E9E5E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Restore button -->
                    <Button Background="#1E9E5E" Foreground="White"
                            Style="{StaticResource ActionBtn}"
                            Command="{Binding RestoreCommand}"
                            IsEnabled="{Binding IsArchived}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Restore Record" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Close button -->
                    <Button Background="#6C757D" Foreground="White"
                            Style="{StaticResource ActionBtn}"
                            x:Name="CloseBtn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Close" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
