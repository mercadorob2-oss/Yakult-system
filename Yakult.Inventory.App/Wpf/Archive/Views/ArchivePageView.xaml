<UserControl
    x:Class="Yakult.Inventory.App.WPF.Archive.Views.ArchivePageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Background="#F0F2F6"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringToColorBrushConverter      x:Key="HexToBrush"/>
        <conv:BoolToCardBrushConverter         x:Key="BoolToCardBrush"/>

        <!-- ── Global TextBlock ─────────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"                     Value="Segoe UI"/>
            <Setter Property="Foreground"                     Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"  Value="ClearType"/>
        </Style>

        <!-- ── Summary card ─────────────────────────────────────────────────── -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,10"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="140"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7A8D"/>
        </Style>
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ── Content card (wraps grid) ────────────────────────────────────── -->
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- ── Search TextBox ───────────────────────────────────────────────── -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="#C2CCDA"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="#F8F9FB"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="8,5"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Filter ComboBox ──────────────────────────────────────────────── -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="BorderBrush"              Value="#C2CCDA"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="#F8F9FB"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="6,0"/>
        </Style>

        <!-- ── DatePicker ───────────────────────────────────────────────────── -->
        <Style x:Key="CleanDatePicker" TargetType="DatePicker">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="MinWidth"        Value="108"/>
            <Setter Property="FontSize"        Value="10.5"/>
            <Setter Property="Background"      Value="#F8F9FB"/>
            <Setter Property="BorderBrush"     Value="#C2CCDA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TextBox"
                                         Grid.Column="0"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         FontSize="{TemplateBinding FontSize}"
                                         Padding="6,0" VerticalContentAlignment="Center"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False" VerticalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd" Background="{TemplateBinding Background}" CornerRadius="0,3,3,0">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                           Foreground="#6B7A8D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBd" Property="Background" Value="#EEF1F5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small util button ────────────────────────────────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C2CCDA"/>
            <Setter Property="Background"      Value="#F8F9FB"/>
            <Setter Property="Foreground"      Value="#3A4A5A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF1F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Advanced Filters toggle button ───────────────────────────────── -->
        <Style x:Key="FilterToggleBtn" TargetType="ToggleButton">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="12,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#C2CCDA"/>
            <Setter Property="Background"      Value="#F8F9FB"/>
            <Setter Property="Foreground"      Value="#3A4A5A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF1F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3A8EF6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary action button ────────────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid header ──────────────────────────────────────────────── -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"                 Value="#3A8EF6"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="FontSize"                   Value="10.5"/>
            <Setter Property="FontWeight"                 Value="SemiBold"/>
            <Setter Property="Padding"                    Value="10,0"/>
            <Setter Property="Height"                     Value="34"/>
            <Setter Property="BorderBrush"                Value="#2E7EE8"/>
            <Setter Property="BorderThickness"            Value="0,0,1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid row ─────────────────────────────────────────────────── -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FE"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGrid cell ────────────────────────────────────────────────── -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Thin scrollbar ───────────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="MinWidth"   Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="6">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" Background="#B8C4D0" CornerRadius="3" Margin="1,2"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#7A90A4"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#3A8EF6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header: title + cards -->
            <RowDefinition Height="Auto"/>   <!-- Toolbar: actions + search + Advanced Filters -->
            <RowDefinition Height="*"/>      <!-- DataGrid + pagination -->
        </Grid.RowDefinitions>

        <!-- ══ Row 0: Page header: title (left) + compact summary cards (right) ══ -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"
                Padding="18,10,18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="#E74C3C" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Archive Records"
                                   FontSize="15" FontWeight="Bold" Foreground="#1A2333"/>
                        <TextBlock Text="Soft-deleted records — view, inspect, and restore archived entities"
                                   FontSize="9.5" Foreground="#6B7A8D" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">

                    <!-- Total -->
                    <Border Style="{StaticResource SummaryCard}" Cursor="Hand" Background="{Binding IsTotalCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                        </Border.InputBindings>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TOTAL ARCHIVED" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="all entity types" FontSize="9" Foreground="#9AAABB"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalCount}"
                                       Style="{StaticResource CardValue}" Foreground="#E74C3C"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Items -->
                    <Border Style="{StaticResource SummaryCard}" Cursor="Hand" Background="{Binding IsItemsCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ItemsCardCommand}"/>
                        </Border.InputBindings>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="ITEMS" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="archived items" FontSize="9" Foreground="#9AAABB"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ItemCount}"
                                       Style="{StaticResource CardValue}" Foreground="#3A8EF6"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Sets -->
                    <Border Style="{StaticResource SummaryCard}" Cursor="Hand" Background="{Binding IsSetsCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SetsCardCommand}"/>
                        </Border.InputBindings>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="SETS" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="archived sets" FontSize="9" Foreground="#9AAABB"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding SetCount}"
                                       Style="{StaticResource CardValue}" Foreground="#9B59B6"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Requests -->
                    <Border Style="{StaticResource SummaryCard}" Cursor="Hand" Background="{Binding IsRequestsCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding RequestsCardCommand}"/>
                        </Border.InputBindings>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="REQUESTS" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="archived requests" FontSize="9" Foreground="#9AAABB"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding RequestCount}"
                                       Style="{StaticResource CardValue}" Foreground="#E67E22"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Others -->
                    <Border Style="{StaticResource SummaryCard}" Margin="0" Cursor="Hand" Background="{Binding IsOtherCardActive, Converter={StaticResource BoolToCardBrush}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding OtherCardCommand}"/>
                        </Border.InputBindings>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="OTHER TYPES" Style="{StaticResource CardLabel}"/>
                                <TextBlock Text="employees, vendors…" FontSize="9" Foreground="#9AAABB"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding OtherCount}"
                                       Style="{StaticResource CardValue}" Foreground="#1E9E5E"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Reload data" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Row 1: Toolbar: actions + search + Advanced Filters ════════════ -->
        <Border Grid.Row="1"
                Background="#FFFFFF" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"
                Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <Button Style="{StaticResource PrimaryBtn}"
                        Command="{Binding ViewDetailsCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="View Details" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SmallBtn}"
                        Command="{Binding ExportCommand}"
                        Margin="0,0,16,8" ToolTip="Export to CSV">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Export" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRestoreSelected"
                        Style="{StaticResource SmallBtn}"
                        IsEnabled="{Binding HasCheckedSelection}"
                        Click="BtnRestoreSelected_Click"
                        Margin="0,0,8,8" ToolTip="Restore the checked records">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Restore Record" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPermanentDeleteSelected"
                        Style="{StaticResource SmallBtn}"
                        Background="#D9534F" Foreground="White"
                        IsEnabled="{Binding HasCheckedSelection}"
                        Click="BtnPermanentDeleteSelected_Click"
                        Margin="0,0,16,8" ToolTip="Permanently delete the checked records — cannot be undone">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Permanently Delete" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <!-- Search -->
                <Grid Margin="0,0,8,8" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource SearchBox}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="220"
                             ToolTip="Search by name, archived by, or reason"/>
                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#9AAABB" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,8,0"
                               IsHitTestVisible="False"/>
                </Grid>

                <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource FilterToggleBtn}"
                              Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters ▾"/>
                <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                       IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                       StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                    <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                            CornerRadius="8" Padding="18" Width="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="Type" FontSize="10" FontWeight="SemiBold" Foreground="#6B7A8D" Margin="0,0,0,4"/>
                            <ToggleButton x:Name="TypeFilterToggle" Style="{StaticResource FilterToggleBtn}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Content="{Binding TypeFilterSummary}" Margin="0,0,0,12"/>
                            <Popup PlacementTarget="{Binding ElementName=TypeFilterToggle}"
                                   IsOpen="{Binding IsChecked, ElementName=TypeFilterToggle, Mode=TwoWay}"
                                   StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                                        CornerRadius="4" Padding="8" MinWidth="200">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="#1A2333"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding EntityTypeCheckItems}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Type}"
                                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                  Padding="4,0" Margin="2,4" FontSize="11"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Separator Margin="0,6,0,4"/>
                                        <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                Style="{StaticResource SmallBtn}" Margin="0"
                                                Command="{Binding ClearTypeFilterCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <TextBlock Text="Category" FontSize="10" FontWeight="SemiBold" Foreground="#6B7A8D" Margin="0,0,0,4"/>
                            <ToggleButton x:Name="CategoryFilterToggle" Style="{StaticResource FilterToggleBtn}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          Content="{Binding CategoryFilterSummary}" Margin="0,0,0,12"/>
                            <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                                   IsOpen="{Binding IsChecked, ElementName=CategoryFilterToggle, Mode=TwoWay}"
                                   StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                                        CornerRadius="4" Padding="8" MinWidth="200">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.15" Color="#1A2333"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  Padding="4,0" Margin="2,4" FontSize="11"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <Separator Margin="0,6,0,4"/>
                                        <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                Style="{StaticResource SmallBtn}" Margin="0"
                                                Command="{Binding ClearCategoryFilterCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Popup>

                            <TextBlock Text="From" FontSize="10" FontWeight="SemiBold" Foreground="#6B7A8D" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource CleanDatePicker}" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                                        SelectedDate="{Binding DateFrom, Mode=TwoWay}"/>

                            <TextBlock Text="To" FontSize="10" FontWeight="SemiBold" Foreground="#6B7A8D" Margin="0,0,0,4"/>
                            <DatePicker Style="{StaticResource CleanDatePicker}" HorizontalAlignment="Stretch"
                                        SelectedDate="{Binding DateTo, Mode=TwoWay}"/>

                            <Separator Margin="0,12,0,12"/>

                            <Button HorizontalAlignment="Right" Style="{StaticResource SmallBtn}" Command="{Binding ClearFiltersCommand}" Margin="0">
                                <TextBlock Text="↺  Reset Filters"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Loading indicator -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,8"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                               Foreground="#3A8EF6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Loading…" FontSize="10" FontStyle="Italic"
                               Foreground="#3A8EF6" VerticalAlignment="Center"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ══ Row 2: DataGrid + pagination ════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="16,6,16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- DataGrid -->
                <DataGrid Grid.Row="0"
                          x:Name="ArchiveGrid"
                          ItemsSource="{Binding PagedRecords}"
                          SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF1F5"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#FAFBFC"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          RowStyle="{StaticResource GridRow}"
                          CellStyle="{StaticResource GridCell}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          ScrollViewer.CanContentScroll="True">

                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding ViewDetailsCommand}"/>
                    </DataGrid.InputBindings>

                    <DataGrid.Columns>

                        <!-- Select checkbox -->
                        <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}">
                                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              ToolTip="Select / deselect all on this page"
                                                              Loaded="ChkSelectAllHeader_Loaded"
                                                              Click="ChkSelectAll_Click"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Checked="RowSelectCheckBox_Changed"
                                              Unchecked="RowSelectCheckBox_Changed"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Archive ID (narrow) -->
                        <DataGridTextColumn Header="ID" Binding="{Binding ArchiveId}" Width="55" MinWidth="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="10.5"/>
                                    <Setter Property="Foreground" Value="#7A8A9E"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Entity type badge -->
                        <DataGridTemplateColumn Header="Type" Width="120" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding EntityTypeBadgeColor, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="10" Padding="8,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="0,3">
                                        <TextBlock Text="{Binding EntityType}"
                                                   Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Entity ID -->
                        <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId}" Width="70" MinWidth="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#2A3A4A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Record name (fill) -->
                        <DataGridTextColumn Header="Record Name / Code" Binding="{Binding RecordName}" Width="*" MinWidth="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"     Value="11"/>
                                    <Setter Property="FontWeight"   Value="SemiBold"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Archived At -->
                        <DataGridTextColumn Header="Archived At" Binding="{Binding ArchivedAtDisplay}" Width="130" MinWidth="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="10.5"/>
                                    <Setter Property="Foreground" Value="#3A4A5A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Archived By -->
                        <DataGridTextColumn Header="Archived By" Binding="{Binding ArchivedBy}" Width="130" MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Reason (fill) -->
                        <DataGridTextColumn Header="Archive Reason" Binding="{Binding ArchiveReason}" Width="*" MinWidth="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"     Value="10.5"/>
                                    <Setter Property="Foreground"   Value="#5A6A7E"/>
                                    <Setter Property="FontStyle"    Value="Italic"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Pagination bar -->
                <Border Grid.Row="1" Background="#F8F9FB" BorderBrush="#EEF1F5"
                        BorderThickness="0,1,0,0" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoFirst}"
                                    Style="{StaticResource SmallBtn}" Padding="7,0" Height="26" Margin="0,0,2,0">
                                <TextBlock Text="«" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}"
                                    Style="{StaticResource SmallBtn}" Padding="7,0" Height="26">
                                <TextBlock Text="‹" FontSize="12"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                   FontSize="10" Foreground="#6B7A8D"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"
                                    Style="{StaticResource SmallBtn}" Padding="7,0" Height="26" Margin="0,0,2,0">
                                <TextBlock Text="›" FontSize="12"/>
                            </Button>
                            <Button Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoLast}"
                                    Style="{StaticResource SmallBtn}" Padding="7,0" Height="26">
                                <TextBlock Text="»" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2" Background="#FFF3F3" BorderBrush="#F5C6CB" BorderThickness="1"
                CornerRadius="6" Margin="16,6,16,10" Padding="14,10"
                VerticalAlignment="Top"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#C0392B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                           Foreground="#C0392B" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Full-screen loading overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3"
                Background="#80F0F2F6"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" BorderBrush="#DDE3EC" BorderThickness="1"
                    CornerRadius="10" Padding="36,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Foreground="#3A8EF6"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Loading archive records…"
                               FontSize="13" Foreground="#3A4A5A"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
