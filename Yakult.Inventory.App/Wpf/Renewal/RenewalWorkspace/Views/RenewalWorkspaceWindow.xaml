<Window
    x:Class="Yakult.Inventory.App.WPF.Renewal.RenewalWorkspace.Views.RenewalWorkspaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Title="Renewal Details"
    MinWidth="1100" MinHeight="700"
    WindowState="Maximized"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToColorBrushConverter        x:Key="HexBrush"/>
            <conv:BoolToVisibilityConverter          x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter   x:Key="InvBoolToVis"/>

            <Style x:Key="ModernTabItem" TargetType="TabItem">
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Padding"         Value="22,12"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,3">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="root" Property="BorderBrush" Value="{StaticResource YakultBlue}"/>
                                    <Setter TargetName="root" Property="Background"  Value="White"/>
                                    <Setter Property="Foreground" Value="{StaticResource YakultBlue}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected"  Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="root" Property="Background" Value="#E8F0FE"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="{Binding RowBackground, Converter={StaticResource HexBrush}}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EEF5FF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E2EDFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ReadOnlyFieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="Auto"/>   <!-- Chain -->
            <RowDefinition Height="Auto"/>   <!-- Editable header row -->
            <RowDefinition Height="*"/>      <!-- Tabs -->
            <RowDefinition Height="Auto"/>   <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════ ROW 0 · HEADER ══════════════ -->
        <Border Grid.Row="0" Background="{StaticResource YakultBlue}" Padding="28,18,24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="12" Foreground="#AADDFF" Margin="0,4,0,10"/>

                    <StackPanel Orientation="Horizontal">
                        <Border Background="{Binding ExpiryStatusColor, Converter={StaticResource HexBrush}}"
                                CornerRadius="4" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ExpiryStatusText}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="countdown paused" FontSize="11" FontStyle="Italic"
                                   Foreground="#DCE6F0" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding PausedNoteVisible, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ExpiryWarningText}" FontSize="11"
                                   Foreground="{Binding ExpiryWarningColor, Converter={StaticResource HexBrush}}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"
                                   Visibility="{Binding PausedNoteVisible, Converter={StaticResource InvBoolToVis}}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"
                        Padding="14,8" Cursor="Hand" BorderThickness="0"
                        Background="#22FFFFFF" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="root" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="root" Property="Background" Value="#44FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✕  Close" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════ ROW 1 · RENEWAL CHAIN STRIP ══════════════ -->
        <Border Grid.Row="1" Background="#F3F5F8" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="0,10"
                Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="RENEWAL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="CHAIN"   FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding ChainNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border CornerRadius="8"
                                            Background="{Binding NodeBackground, Converter={StaticResource HexBrush}}"
                                            BorderBrush="{Binding NodeBorderColor, Converter={StaticResource HexBrush}}"
                                            BorderThickness="1.5"
                                            Padding="13,9" Width="155" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.NavigateToNodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding SetId}"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="8" FontWeight="Bold"
                                                       Foreground="{Binding LabelForeground, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Text="{Binding SetCode}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{Binding NodeForeground, Converter={StaticResource HexBrush}}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Period}" FontSize="9"
                                                       Foreground="{Binding LabelForeground, Converter={StaticResource HexBrush}}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="›" FontSize="20" Foreground="#AABBC8" VerticalAlignment="Center" Margin="8,0"
                                               Visibility="{Binding IsLast, Converter={StaticResource InvBoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════ ROW 2 · EDITABLE DOCUMENT HEADER ══════════════ -->
        <Border Grid.Row="2" Background="#F5F8FC" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="24,10"
                Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Document #:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding DocumentNumberEdit, UpdateSourceTrigger=PropertyChanged}" Width="160" Padding="6,4" Margin="0,0,20,0"/>

                <TextBlock Text="Reference #:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding ReferenceNumberEdit, UpdateSourceTrigger=PropertyChanged}" Width="160" Padding="6,4" Margin="0,0,20,0"/>

                <TextBlock Text="Document Date:" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker SelectedDate="{Binding DocumentDateEdit}" Width="140" Margin="0,0,20,0"/>

                <Button Style="{StaticResource SecondaryButton}" Content="Save Header" Command="{Binding SaveHeaderCommand}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════ ROW 3 · TAB CONTROL ══════════════ -->
        <TabControl Grid.Row="3" Background="White" BorderThickness="0,1,0,0" BorderBrush="#DDE3EC"
                    ItemContainerStyle="{StaticResource ModernTabItem}">

            <!-- ── TAB 1 : Invoice Items ── -->
            <TabItem Header="Invoice Items" Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
                <ScrollViewer Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ItemCountsText}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>

                        <!-- Table / Grouped view toggle -->
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ToggleViewCommand}" Margin="0,0,8,0"
                                ToolTip="Switch between the flat table and Sub-Type Group sections">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ViewModeIcon}" FontSize="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ViewModeText}" FontSize="12"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Renew Items"
                                Command="{Binding RenewItemsCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="Attach Receipt"
                                Command="{Binding AttachReceiptCommand}" Margin="0,0,8,0"/>
                        <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Content="View Chain Receipts"
                                Command="{Binding ViewChainReceiptsCommand}"/>
                    </Grid>

                    <!-- ── Sub-Type Group financial cards — same feature as "View Details" ── -->
                    <Border Padding="12,4,12,4"
                            Visibility="{Binding HasGroupCards, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SUB-TYPE GROUPS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding GroupCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="6"
                                                Padding="14,12" Margin="0,0,10,10" Background="White" MinWidth="260">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SubType}" FontWeight="Bold" FontSize="14" Foreground="#1B6EC2"/>

                                                <Grid Margin="0,4,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ReferenceCodeLabel}" FontSize="11" Foreground="#707880" Margin="0,1,10,1"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceCodeDisplay}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Start Date" FontSize="11" Foreground="#707880" Margin="0,1,10,1"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BeginDateDisplay}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="End Date" FontSize="11" Foreground="#707880" Margin="0,1,10,1"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EndDateDisplay}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Subtotal, StringFormat=N2}"
                                                               HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="VAT (%)" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VatPercent, StringFormat=N2}"
                                                               HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WHT (%)" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WhtPercent, StringFormat=N2}"
                                                               HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Discount (%)" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiscountPercent, StringFormat=N2}"
                                                               HorizontalAlignment="Right" Margin="0,3,0,3"/>
                                                </Grid>

                                                <Border Height="1" Background="#EEEEEE" Margin="0,10,0,8"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Total" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=N2}" FontWeight="Bold" FontSize="14"
                                                               HorizontalAlignment="Right" Foreground="#1B6EC2"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <DataGrid ItemsSource="{Binding InvoiceItems}"
                              Visibility="{Binding IsTableView, Converter={StaticResource BoolToVis}}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              ColumnHeaderHeight="42" MinRowHeight="42" SelectionMode="Single"
                              RowStyle="{StaticResource StatusRow}" HeadersVisibility="Column" BorderThickness="0"
                              MinHeight="200" MaxHeight="480" VerticalScrollBarVisibility="Auto"
                              Margin="12,0,12,0">
                        <DataGrid.Resources>
                            <Style x:Key="WrapCell" TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Padding" Value="6,6"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground, Converter={StaticResource HexBrush}}"
                                                CornerRadius="4" Padding="9,4" Margin="8,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusForeground, Converter={StaticResource HexBrush}}"
                                                       FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Description" Width="*" MinWidth="220" Binding="{Binding DisplayDescription}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Item Code" Width="110" Binding="{Binding ItemCode}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Qty" Width="60" Binding="{Binding QuantityDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="UoM" Width="80" Binding="{Binding UnitOfMeasure}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Unit Price" Width="115" Binding="{Binding UnitPriceDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Amount" Width="115" Binding="{Binding AmountDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Line Start" Width="115" Binding="{Binding StartDateDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Line End" Width="115" Binding="{Binding EndDateDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Sub-Type Group" Width="150" Binding="{Binding GroupDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Reference Code" Width="150" Binding="{Binding ReferenceCodeDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                            <DataGridTextColumn Header="Parent Tag" Width="130" Binding="{Binding ParentTagDisplay}" ElementStyle="{StaticResource WrapCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ── GROUPED VIEW — one card per Sub-Type Group ──────────── -->
                    <ItemsControl ItemsSource="{Binding InvoiceItemGroups}" Margin="12,0,12,8"
                                  Visibility="{Binding IsGroupedView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,14" BorderBrush="#DDE3EC" BorderThickness="1"
                                        CornerRadius="8" Background="White">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06"
                                                          Color="#0A1A2A" Direction="270"/>
                                    </Border.Effect>

                                    <StackPanel>
                                        <!-- Group banner -->
                                        <Border Background="{StaticResource YakultBlue}"
                                                CornerRadius="8,8,0,0" Padding="16,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding GroupHeader}"
                                                           FontSize="13" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CountDisplay}"
                                                           FontSize="11" Foreground="#D6EAF8"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- Rows, nested one level by Parent Tag — an independent,
                                             orthogonal grouping from Sub-Type above. The banner is
                                             collapsed for the untagged section (HasLabel=false) so a
                                             plain Sub-Type bucket with no Parent Tags shows no extra
                                             empty banner. -->
                                        <ItemsControl ItemsSource="{Binding ParentTagGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border Background="#FDF3D7" BorderBrush="#F0D88A"
                                                                BorderThickness="0,0,0,1" Padding="16,7"
                                                                Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                                           FontSize="12" FontWeight="Bold" Foreground="#8A5A00"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding CountDisplay}"
                                                                           FontSize="10.5" Foreground="#8A5A00"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>

                                                        <ItemsControl ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="#EEF2F7" BorderThickness="0,0,0,1"
                                                                            Background="{Binding RowBackground, Converter={StaticResource HexBrush}}"
                                                                            Padding="12,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="120"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="110"/>
                                                                                <ColumnDefinition Width="60"/>
                                                                                <ColumnDefinition Width="80"/>
                                                                                <ColumnDefinition Width="115"/>
                                                                                <ColumnDefinition Width="115"/>
                                                                                <ColumnDefinition Width="115"/>
                                                                                <ColumnDefinition Width="115"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <Border Grid.Column="0"
                                                                                    Background="{Binding StatusBackground, Converter={StaticResource HexBrush}}"
                                                                                    CornerRadius="4" Padding="8,4"
                                                                                    HorizontalAlignment="Left" VerticalAlignment="Top">
                                                                                <TextBlock Text="{Binding DisplayStatus}"
                                                                                           Foreground="{Binding StatusForeground, Converter={StaticResource HexBrush}}"
                                                                                           FontSize="10" FontWeight="Bold" TextWrapping="Wrap"/>
                                                                            </Border>

                                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayDescription}"
                                                                                       FontSize="12" TextWrapping="Wrap"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding ItemCode}"
                                                                                       FontSize="11" FontFamily="Consolas"
                                                                                       Foreground="{StaticResource TextMuted}"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding QuantityDisplay}"
                                                                                       FontSize="12" TextAlignment="Center"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="4" Text="{Binding UnitOfMeasure}"
                                                                                       FontSize="12"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="5" Text="{Binding UnitPriceDisplay}"
                                                                                       FontSize="12" TextAlignment="Right"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="6" Text="{Binding AmountDisplay}"
                                                                                       FontSize="12" FontWeight="SemiBold" TextAlignment="Right"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="7" Text="{Binding StartDateDisplay}"
                                                                                       FontSize="11"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="8" Text="{Binding EndDateDisplay}"
                                                                                       FontSize="11"
                                                                                       Margin="8,0" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#F0F2F8" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="0,0,12,0">
                        <TextBlock Text="{Binding FinancialStripText}" FontSize="11" Foreground="#373737"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Height="28"/>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 2 : Renewal Details ── -->
            <TabItem Header="Renewal Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F7FA">
                    <StackPanel Margin="20,16,20,20">

                        <!-- Invoice Details — shown for a Set-backed renewal (HasSet). Set/invoice-level
                             fields (Type, Company, Vendor, Start/End Date, item counts), not one
                             single item's info — a Set can hold several items with different
                             Sub-Type Groups, see the "ALL ITEMS IN THIS SET" grid below for those. -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16"
                                Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="INVOICE DETAILS" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Set Type"  Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceSetType}" Style="{StaticResource ReadOnlyFieldValue}" FontWeight="Bold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Items"     Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding InvoiceItemSummary}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Company"   Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceCompanyName}" Style="{StaticResource ReadOnlyFieldValue}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Vendor"    Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InvoiceVendorName}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Date" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InvoiceStartDateDisplay}" Style="{StaticResource ReadOnlyFieldValue}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="End Date"   Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding InvoiceEndDateDisplay}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sub-Types" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding InvoiceSubTypeSummary}"
                                               Style="{StaticResource ReadOnlyFieldValue}" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Item Information / Renewal Info — only for a standalone item renewal
                             (opened without a Set, e.g. from the Warranty page) where there is no
                             invoice to describe and exactly one item is in scope. -->
                        <Grid Margin="0,0,0,16" Visibility="{Binding HasSet, Converter={StaticResource InvBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Item Information -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="ITEM INFORMATION" Style="{StaticResource SectionLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Item Name"  Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ItemName}" Style="{StaticResource ReadOnlyFieldValue}" FontWeight="Bold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Type"        Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ItemType}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Category"    Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CategoryName}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Serial #"    Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SerialNumber}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Model #"     Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ModelNumber}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="License #"   Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LicenseNumber}" Style="{StaticResource ReadOnlyFieldValue}"/>

                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Part #"      Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PartNumber}" Style="{StaticResource ReadOnlyFieldValue}" Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Renewal Info (editable Start/End Date) -->
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="RENEWAL INFO" Style="{StaticResource SectionLabel}"/>

                                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding RenewalStatusText}" Style="{StaticResource ReadOnlyFieldValue}" FontWeight="Bold"/>

                                    <TextBlock Text="Start Date" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding StartDateEdit}" Margin="0,0,0,10"/>

                                    <TextBlock Text="End Date" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding EndDateEdit}" Margin="0,0,0,10"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Days Left: " FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DaysLeftText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                                   Foreground="{Binding DaysLeftColor, Converter={StaticResource HexBrush}}"/>
                                    </StackPanel>

                                    <Button Style="{StaticResource PrimaryButton}" Content="Save Dates"
                                            Command="{Binding SaveDatesCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vendor Info -->
                            <Border Grid.Column="0" Style="{StaticResource SectionCard}">
                                <StackPanel IsEnabled="{Binding VendorEditable}">
                                    <TextBlock Text="VENDOR INFO" Style="{StaticResource SectionLabel}"/>

                                    <TextBlock Text="Vendor" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}"
                                              DisplayMemberPath="VendorName" Margin="0,0,0,10"/>

                                    <TextBlock Text="Address" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding VendorAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <TextBlock Text="TIN" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding VendorTIN, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <Button Style="{StaticResource PrimaryButton}" Content="Save Vendor"
                                            Command="{Binding SaveVendorCommand}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Site Info -->
                            <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="SITE INFO" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding SiteDisplay}" Style="{StaticResource ReadOnlyFieldValue}" TextWrapping="Wrap" Margin="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Financial Info -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="FINANCIAL SUMMARY" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Subtotal" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SubtotalDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VAT" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding VatAmountDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WHT" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding WhtAmountDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Discount" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding DiscountAmountDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                    <Border Grid.Column="4" Background="#EFF6FF" CornerRadius="8" Padding="18,12" Margin="16,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL AMOUNT DUE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource YakultBlue}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding TotalAmountDueDisplay}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource YakultBlue}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Archive Info -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="ARCHIVE INFO" Style="{StaticResource SectionLabel}"/>
                                <CheckBox Content="Archived" IsChecked="{Binding IsArchived}" IsEnabled="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Renewal Notes — the free-text note typed once in the "Renew Items" dialog's
                             NOTES box for this renewal action (dbo.Renewals.RenewalNotes). Shown once
                             here rather than per item, since it's entered once per renewal and applies
                             to every item renewed together in that same action. -->
                        <Border Style="{StaticResource SectionCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="RENEWAL NOTES" Style="{StaticResource SectionLabel}"/>
                                <TextBox Text="{Binding CurrentRenewalNotes, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="70"
                                         Padding="8" Margin="0,0,0,10"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Save Renewal Notes"
                                        Command="{Binding SaveRenewalNotesCommand}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <!-- All set items grid -->
                        <Border Style="{StaticResource SectionCard}" Visibility="{Binding HasSet, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ALL ITEMS IN THIS SET" Style="{StaticResource SectionLabel}"/>
                                <DataGrid ItemsSource="{Binding InvoiceItems}" Height="300"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7"
                                          CanUserReorderColumns="False" CanUserResizeRows="False"
                                          ColumnHeaderHeight="36" MinRowHeight="38" SelectionMode="Single"
                                          RowStyle="{StaticResource StatusRow}" HeadersVisibility="Column" BorderThickness="0">
                                    <DataGrid.Resources>
                                        <Style x:Key="WrapCell2" TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="Padding" Value="6,6"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Description" Width="*" MinWidth="180" Binding="{Binding DisplayDescription}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Item Code" Width="110" Binding="{Binding ItemCode}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Qty" Width="55" Binding="{Binding QuantityDisplay}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="UoM" Width="60" Binding="{Binding UnitOfMeasure}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Unit Price" Width="100" Binding="{Binding UnitPriceDisplay}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Amount" Width="100" Binding="{Binding AmountDisplay}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Start" Width="95" Binding="{Binding StartDateDisplay}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="End" Width="95" Binding="{Binding EndDateDisplay}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Status" Width="80" Binding="{Binding DisplayStatus}" ElementStyle="{StaticResource WrapCell2}"/>
                                        <DataGridTextColumn Header="Sub-Type Group" Width="140" Binding="{Binding GroupDisplay}" ElementStyle="{StaticResource WrapCell2}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3 : Renewal History ── -->
            <TabItem Header="Renewal History">
                <Grid Background="#F5F7FA">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#EBF5FB" BorderBrush="#CFE3F5" BorderThickness="0,0,0,1"
                            Padding="20,10" Visibility="{Binding HasNoHistory, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                            <Run Text="Each card below counts how many times "/>
                            <Run Text="that specific item" FontWeight="Bold"/>
                            <Run Text=" has been renewed, which can be lower than the Set-level chain shown above if the item was only added starting partway through it (e.g. as a replacement item)."/>
                        </TextBlock>
                    </Border>

                    <TextBlock Grid.Row="1" Text="No renewal history found for this set."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="{StaticResource TextMuted}"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasNoHistory, Converter={StaticResource InvBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding HistoryItems}" Margin="20,16,20,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                            CornerRadius="10" Margin="0,0,0,12" Padding="0">
                                        <Grid>
                                            <Border Width="5" HorizontalAlignment="Left"
                                                    Background="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                                    CornerRadius="10,0,0,10"/>
                                            <StackPanel Margin="20,16,20,16">
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{Binding StatusBackground, Converter={StaticResource HexBrush}}"
                                                            CornerRadius="5" Padding="10,4" Margin="0,0,10,0"
                                                            ToolTip="{Binding StatusExplanation}">
                                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                                                   FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="5" Padding="8,4">
                                                        <TextBlock Text="{Binding CounterLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding DateDisplay}"
                                                               FontSize="11" Foreground="{StaticResource TextMuted}" Margin="12,0,0,0"/>
                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding AmountDisplay}"
                                                               FontSize="15" FontWeight="Bold" Foreground="{StaticResource YakultBlue}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ItemDisplay}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Period" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding PeriodDisplay}" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Duration" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding YearsDisplay}" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Created By" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding CreatedByUsername}" FontSize="12"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                                        Background="#F8F9FA" CornerRadius="5" Padding="12,8" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding RenewalNotes}" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══════════════ ROW 4 · FOOTER ══════════════ -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding CreatedByText}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding CreatedAtText}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Archive" Command="{Binding ArchiveCommand}"
                            Visibility="{Binding ArchiveVisible, Converter={StaticResource BoolToVis}}"
                            Background="#E03C31" Foreground="White" BorderThickness="0"
                            Padding="16,9" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" Content="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LOADING / ERROR OVERLAYS -->
        <Grid Grid.RowSpan="5" Background="#C8FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Loading renewal details…" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.RowSpan="5" Background="#C8FFFFFF" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="32,24" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Failed to Load" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErrorRed}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="400"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}" Content="Close" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
