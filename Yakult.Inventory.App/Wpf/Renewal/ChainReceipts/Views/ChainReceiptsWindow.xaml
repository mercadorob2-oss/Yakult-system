<Window
    x:Class="Yakult.Inventory.App.WPF.Renewal.ChainReceipts.Views.ChainReceiptsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Title="Renewal Chain Receipts"
    MinWidth="700" MinHeight="500"
    Width="820" Height="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToColorBrushConverter      x:Key="HexBrush"/>
            <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource YakultBlue}" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Renewal Chain Receipts" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Every scanned document (SI/DR/PO) attached across this renewal chain, from Original to Latest."
                           FontSize="11" Foreground="#CCE4FF" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Background="#F5F7FA">
            <TextBlock Text="No receipts have been attached to any set in this renewal chain."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13" Foreground="{StaticResource TextMuted}"
                       Visibility="{Binding HasNoReceipts, Converter={StaticResource BoolToVis}}"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasNoReceipts, Converter={StaticResource InvBoolToVis}}">
                <ItemsControl ItemsSource="{Binding Groups}" Margin="20,16,20,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                    CornerRadius="10" Margin="0,0,0,14" Padding="0">
                                <Grid>
                                    <Border Width="5" HorizontalAlignment="Left"
                                            Background="{Binding BadgeColor, Converter={StaticResource HexBrush}}"
                                            CornerRadius="10,0,0,10"/>
                                    <StackPanel Margin="20,14,20,14">

                                        <!-- Group header -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Border Background="{Binding BadgeColor, Converter={StaticResource HexBrush}}"
                                                    CornerRadius="5" Padding="10,4" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding PositionLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding SetCode}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- No receipts for this set -->
                                        <TextBlock Text="No receipts attached to this set."
                                                   FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextMuted}"
                                                   Visibility="{Binding HasReceipts, Converter={StaticResource InvBoolToVis}}"/>

                                        <!-- Receipt rows -->
                                        <ItemsControl ItemsSource="{Binding Receipts}"
                                                      Visibility="{Binding HasReceipts, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8F9FA" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}">
                                                                    <Run Text="{Binding SupplierDisplay, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding DocNumbersDisplay}" FontSize="11"
                                                                           Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                                                <TextBlock Text="{Binding ImageCountsDisplay}" FontSize="11"
                                                                           Foreground="{StaticResource YakultBlue}" Margin="0,2,0,0"/>
                                                                <TextBlock FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0">
                                                                    <Run Text="Added "/>
                                                                    <Run Text="{Binding CreatedAtDisplay, Mode=OneWay}"/>
                                                                    <Run Text=" by "/>
                                                                    <Run Text="{Binding CreatedByUsername, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>

                                                            <Button Grid.Column="1" Content="View" VerticalAlignment="Center"
                                                                    Style="{StaticResource SecondaryButton}" Padding="14,6"
                                                                    Command="{Binding DataContext.ViewReceiptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading overlay -->
            <Grid Background="#C8FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Loading chain receipts…" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Content="Close" Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
