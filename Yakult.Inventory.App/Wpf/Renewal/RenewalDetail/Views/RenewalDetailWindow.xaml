<Window
    x:Class="Yakult.Inventory.App.WPF.Renewal.RenewalDetail.Views.RenewalDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Title="Renewal Details"
    MinWidth="980" MinHeight="640"
    Width="1120" Height="740"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:StringToColorBrushConverter        x:Key="HexBrush"/>
            <conv:BoolToVisibilityConverter          x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter   x:Key="InvBoolToVis"/>
            <conv:NullToVisibilityConverter          x:Key="NullToVis"/>

            <!-- ── Tab item style ───────────────────────────────────────────── -->
            <Style x:Key="ModernTabItem" TargetType="TabItem">
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Padding"         Value="22,12"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="root"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,3">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Selected -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="root" Property="BorderBrush" Value="{StaticResource YakultBlue}"/>
                                    <Setter TargetName="root" Property="Background"  Value="White"/>
                                    <Setter Property="Foreground" Value="{StaticResource YakultBlue}"/>
                                </Trigger>
                                <!-- Hover (non-selected only via MultiTrigger) -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected"  Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="root" Property="Background" Value="#E8F0FE"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── Mini stat card ───────────────────────────────────────────── -->
            <Style x:Key="MiniCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource CardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="8"/>
                <Setter Property="Padding"         Value="16,10"/>
                <Setter Property="Margin"          Value="0,0,12,0"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="#0A1A2A" Direction="270"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── DataGrid row style with status-driven background ──────────── -->
            <Style x:Key="StatusRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="{Binding RowBackground, Converter={StaticResource HexBrush}}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EEF5FF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E2EDFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header           -->
            <RowDefinition Height="Auto"/>   <!-- Chain timeline   -->
            <RowDefinition Height="Auto"/>   <!-- Stat bar         -->
            <RowDefinition Height="*"/>      <!-- Tab control      -->
            <RowDefinition Height="Auto"/>   <!-- Footer           -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 0 · HEADER
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource YakultBlue}" Padding="28,18,24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">

                    <!-- Set Code · Invoice Number -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SetCode}"
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text=" · " FontSize="24" Foreground="#80BBDD"/>
                        <TextBlock Text="{Binding DocumentNumber}"
                                   FontSize="24" FontWeight="Light" Foreground="#CCEEFF"/>
                    </StackPanel>

                    <!-- Company · Vendor -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding CompanyName}"
                                   FontSize="13" Foreground="#AADDFF" FontWeight="SemiBold"/>
                        <TextBlock Text=" · " FontSize="13" Foreground="#6699AA"/>
                        <TextBlock FontSize="13" Foreground="#99CCEE">
                            <Run Text="Vendor: "/>
                            <Run Text="{Binding VendorName, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Type badge · Status badge · Dates · Days remaining -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                        <Border Background="#22FFFFFF" CornerRadius="4" Padding="9,0" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SetType}" FontSize="10" FontWeight="Bold"
                                       Foreground="#BBDDFF" VerticalAlignment="Center" Padding="0,5"/>
                        </Border>

                        <Border Background="{Binding StatusBadgeColor, Converter={StaticResource HexBrush}}"
                                CornerRadius="4" Padding="12,5" Margin="0,0,18,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <!-- Dates block: labels row then values+arrow row -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,14,0">
                            <!-- Labels row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="START" FontSize="8" FontWeight="Bold" Foreground="White" Width="95"/>
                                <TextBlock Text="" Width="44"/>
                                <TextBlock Text="END" FontSize="8" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                            <!-- Values + arrow row -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StartDateDisplay, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="White" Width="95"/>
                                <TextBlock Text="→" FontSize="12" Foreground="White"
                                           VerticalAlignment="Center" Width="44" TextAlignment="Center"/>
                                <TextBlock Text="{Binding EndDateDisplay, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="White" CornerRadius="4" Padding="14,6" Margin="14,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding DaysRemainingText}" FontSize="11" FontWeight="Bold"
                                       Foreground="{Binding DaysRemainingColor, Converter={StaticResource HexBrush}}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Close button -->
                <Button Grid.Column="1" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}"
                        Padding="14,8" Cursor="Hand" BorderThickness="0"
                        Background="#22FFFFFF" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="root" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="root" Property="Background" Value="#44FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="root" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="✕  Close" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 1 · RENEWAL CHAIN TIMELINE
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#F3F5F8" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="0,10">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Label -->
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="RENEWAL" FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="CHAIN"   FontSize="8" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>

                <!-- Chain nodes (horizontal, scrollable) -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding ChainNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                    <!-- Node card -->
                                    <Border CornerRadius="8"
                                            Background="{Binding NodeBackground, Converter={StaticResource HexBrush}}"
                                            BorderBrush="{Binding NodeBorderColor, Converter={StaticResource HexBrush}}"
                                            BorderThickness="1.5"
                                            Padding="13,9" Width="155" Cursor="Hand">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.NavigateToNodeCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding SetId}"/>
                                        </Border.InputBindings>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Color="#0A1A2A" Direction="270"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="8" FontWeight="Bold"
                                                       Foreground="{Binding LabelForeground, Converter={StaticResource HexBrush}}"/>
                                            <TextBlock Text="{Binding SetCode}"
                                                       FontSize="13" FontWeight="Bold"
                                                       Foreground="{Binding NodeForeground, Converter={StaticResource HexBrush}}"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Period}"
                                                       FontSize="9"
                                                       Foreground="{Binding LabelForeground, Converter={StaticResource HexBrush}}"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Arrow connector (hidden for last node) -->
                                    <TextBlock Text="›" FontSize="20" Foreground="#AABBC8"
                                               VerticalAlignment="Center" Margin="8,0"
                                               Visibility="{Binding IsLast, Converter={StaticResource InvBoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Count badge -->
                <Border Grid.Column="2" Background="#DDE3EC" CornerRadius="12" Padding="10,4"
                        VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}">
                        <Run Text="{Binding TotalRenewalsInChain, Mode=OneWay}"/>
                        <Run Text=" sets"/>
                    </TextBlock>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 2 · SUMMARY STAT BAR
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1" Padding="24,10">
            <StackPanel Orientation="Horizontal">

                <!-- Renewals in chain -->
                <Border Style="{StaticResource MiniCard}">
                    <StackPanel>
                        <TextBlock Text="RENEWALS IN CHAIN" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalRenewalsInChain}"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <!-- Current version -->
                <Border Style="{StaticResource MiniCard}">
                    <StackPanel>
                        <TextBlock Text="VERSION" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}">
                            <Run Text="v"/><Run Text="{Binding CurrentVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Style="{StaticResource MiniCard}">
                    <StackPanel>
                        <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <Border Background="{Binding StatusBadgeColor, Converter={StaticResource HexBrush}}"
                                CornerRadius="5" Padding="12,5" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Last renewal -->
                <Border Style="{StaticResource MiniCard}" MinWidth="170">
                    <StackPanel>
                        <TextBlock Text="LAST RENEWAL" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding LastRenewalDate}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Border>

                <!-- Items summary -->
                <Border Style="{StaticResource MiniCard}" MinWidth="220" Margin="0">
                    <StackPanel>
                        <TextBlock Text="ITEMS" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#EAFAF1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1E9E5E">
                                    <Run Text="{Binding ActiveItems, Mode=OneWay}"/>
                                    <Run Text=" Active"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#EBF5FB" CornerRadius="4" Padding="8,3" Margin="0,0,6,0">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#1A6DD0">
                                    <Run Text="{Binding RenewedItems, Mode=OneWay}"/>
                                    <Run Text=" Renewed"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#F3F4F6" CornerRadius="4" Padding="8,3">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}">
                                    <Run Text="{Binding ArchivedItems, Mode=OneWay}"/>
                                    <Run Text=" Archived"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 3 · TAB CONTROL
             ══════════════════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="3" Background="White" BorderThickness="0,1,0,0"
                    BorderBrush="#DDE3EC" Padding="0"
                    ItemContainerStyle="{StaticResource ModernTabItem}">

            <!-- ── TAB 1: Invoice Items ─────────────────────────────────────── -->
            <TabItem Header="Invoice Items">
                <ScrollViewer Background="White" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- ── Sub-Type Group financial cards ─────────────────────── -->
                    <Border Padding="16,14,16,4"
                            Visibility="{Binding HasGroupCards, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="SUB-TYPE GROUPS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding GroupCards}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDE2E8" BorderThickness="1" CornerRadius="6"
                                                Padding="14,12" Margin="0,0,10,10" Background="White" MinWidth="260">
                                            <StackPanel>
                                                <TextBlock Text="{Binding SubType}" FontWeight="Bold" FontSize="14" Foreground="#1B6EC2"/>

                                                <Grid Margin="0,4,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ReferenceCodeLabel}" FontSize="11" Foreground="#707880" Margin="0,1,10,1"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceCodeDisplay}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Start Date" FontSize="11" Foreground="#707880" Margin="0,1,10,1"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BeginDateDisplay}" FontSize="11" HorizontalAlignment="Right"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="End Date" FontSize="11" Foreground="#707880" Margin="0,1,10,1"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EndDateDisplay}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                        <RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Width="90" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,3,0,3"
                                                             Text="{Binding Subtotal, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="VAT (%)" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Width="90" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,3,0,3"
                                                             Text="{Binding VatPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WHT (%)" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Width="90" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,3,0,3"
                                                             Text="{Binding WhtPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Discount (%)" VerticalAlignment="Center" Margin="0,3,10,3"/>
                                                    <TextBox Grid.Row="3" Grid.Column="1" Width="90" TextAlignment="Right" HorizontalAlignment="Right" Margin="0,3,0,3"
                                                             Text="{Binding DiscountPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>

                                                <Border Height="1" Background="#EEEEEE" Margin="0,10,0,8"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Total" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=N2}" FontWeight="Bold" FontSize="14"
                                                               HorizontalAlignment="Right" Foreground="#1B6EC2"/>
                                                </Grid>

                                                <Button Content="Save" Command="{Binding SaveCommand}"
                                                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="8,4"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="INVOICE ITEMS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" Margin="16,14,16,8"/>

                    <DataGrid ItemsSource="{Binding InvoiceItems}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF2F7"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False"
                              ColumnHeaderHeight="42"
                              MinRowHeight="42"
                              SelectionMode="Single"
                              RowStyle="{StaticResource StatusRow}"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              MinHeight="200"
                              MaxHeight="480"
                              VerticalScrollBarVisibility="Auto"
                              Margin="16,0,16,16">
                        <DataGrid.Columns>

                            <!-- Status badge column -->
                            <DataGridTemplateColumn Header="Status" Width="120" SortMemberPath="DisplayStatus">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground, Converter={StaticResource HexBrush}}"
                                                CornerRadius="4" Padding="9,4" Margin="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayStatus}"
                                                       Foreground="{Binding StatusForeground, Converter={StaticResource HexBrush}}"
                                                       FontSize="11" FontWeight="Bold" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Description (falls back to Item Name when blank) -->
                            <DataGridTextColumn Header="Description" Width="*" MinWidth="220" Binding="{Binding DisplayDescription}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Item Code -->
                            <DataGridTextColumn Header="Item Code" Width="110" Binding="{Binding ItemCode}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontFamily"        Value="Consolas"/>
                                        <Setter Property="FontSize"          Value="11"/>
                                        <Setter Property="Foreground"        Value="{StaticResource TextMuted}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Qty -->
                            <DataGridTextColumn Header="Qty" Width="60" Binding="{Binding QuantityDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="8,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment"     Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- UoM -->
                            <DataGridTextColumn Header="UoM" Width="80" Binding="{Binding UnitOfMeasure}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="8,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Unit Price -->
                            <DataGridTextColumn Header="Unit Price" Width="115" Binding="{Binding UnitPriceDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment"     Value="Right"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Amount -->
                            <DataGridTextColumn Header="Amount" Width="115" Binding="{Binding AmountDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment"     Value="Right"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                        <Setter Property="FontWeight"        Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Line Start -->
                            <DataGridTextColumn Header="Line Start" Width="115" Binding="{Binding StartDateDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Line End -->
                            <DataGridTextColumn Header="Line End" Width="115" Binding="{Binding EndDateDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Sub-Type Group -->
                            <DataGridTextColumn Header="Sub-Type Group" Width="150" Binding="{Binding GroupDisplay}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding"           Value="10,6"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextWrapping"      Value="Wrap"/>
                                        <Setter Property="FontSize"          Value="12"/>
                                        <Setter Property="Foreground"        Value="{StaticResource TextMuted}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 2: Renewal Information ──────────────────────────────── -->
            <TabItem Header="Renewal Information">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F7FA">
                    <Grid Margin="20,16,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Document Details card -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="DOCUMENT DETAILS" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Set Code"     Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SetCode}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,0,12" Foreground="{StaticResource TextPrimary}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Document #"  Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DocumentNumber}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Reference #" Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReferenceNumber}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Doc Date"    Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DocumentDateDisplay}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Created By"  Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CreatedByUsername}" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Vendor &amp; Site card -->
                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="VENDOR &amp; SITE" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompanyName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Vendor"  Style="{StaticResource FieldLabel}" Margin="0,0,0,12"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VendorName}" FontSize="12" VerticalAlignment="Center" Margin="0,0,0,12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Site"    Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SiteDisplay}" FontSize="12" VerticalAlignment="Top" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Financial Summary card (full width) -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="FINANCIAL SUMMARY" Style="{StaticResource SectionLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="220"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Subtotal"  Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding SubtotalDisplay}"     FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="VAT (12%)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding VatAmountDisplay}"    FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="WHT (2%)"  Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding WhtAmountDisplay}"    FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Discount"  Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding DiscountAmountDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>

                                    <Border Grid.Column="4" Background="#EFF6FF" CornerRadius="8" Padding="18,12" Margin="16,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL AMOUNT DUE" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource YakultBlue}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding TotalAmountDueDisplay}"
                                                       FontSize="22" FontWeight="Bold"
                                                       Foreground="{StaticResource YakultBlue}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Renewal Notes — entered once in the "Renew Items" dialog's NOTES box for
                             this renewal action (dbo.Renewals.RenewalNotes) and applied to every item
                             renewed together in that action — a Renewal-level field, not per-item. -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                Style="{StaticResource SectionCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RENEWAL NOTES" Style="{StaticResource SectionLabel}"/>
                                <Border Background="#F5F7FA" BorderBrush="#DDE3EC" BorderThickness="1"
                                        CornerRadius="4" Padding="10" MinHeight="50">
                                    <TextBlock Text="{Binding CurrentRenewalNotesDisplay}"
                                               TextWrapping="Wrap" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ── TAB 3: Renewal History ───────────────────────────────────── -->
            <TabItem Header="Renewal History">
                <Grid Background="#F5F7FA">

                    <!-- Empty state -->
                    <TextBlock Text="No renewal history found for this set."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" Foreground="{StaticResource TextMuted}"
                               Visibility="{Binding HasNoHistory, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasNoHistory, Converter={StaticResource InvBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding HistoryItems}" Margin="20,16,20,20">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- History card -->
                                    <Border Background="White"
                                            BorderBrush="{StaticResource CardBorder}"
                                            BorderThickness="1,1,1,1"
                                            CornerRadius="10"
                                            Margin="0,0,0,12"
                                            Padding="0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Color="#0A1A2A" Direction="270"/>
                                        </Border.Effect>
                                        <Grid>
                                            <!-- Left status accent bar -->
                                            <Border Width="5" HorizontalAlignment="Left"
                                                    Background="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                                    CornerRadius="10,0,0,10"/>

                                            <StackPanel Margin="20,16,20,16">

                                                <!-- Top row: status badge + counter + date + amount -->
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Background="{Binding StatusBackground, Converter={StaticResource HexBrush}}"
                                                            CornerRadius="5" Padding="10,4" Margin="0,0,10,0"
                                                            ToolTip="{Binding StatusExplanation}">
                                                        <TextBlock Text="{Binding DisplayStatus}"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource HexBrush}}"
                                                                   FontSize="11" FontWeight="Bold"/>
                                                    </Border>

                                                    <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="5" Padding="8,4" Margin="0,0,0,0">
                                                        <TextBlock Text="{Binding CounterLabel}"
                                                                   FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextMuted}"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                               Text="{Binding DateDisplay}"
                                                               FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               Margin="12,0,0,0"/>

                                                    <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                                               Text="{Binding AmountDisplay}"
                                                               FontSize="15" FontWeight="Bold"
                                                               Foreground="{StaticResource YakultBlue}"/>
                                                </Grid>

                                                <!-- Detail fields: Period | Duration | Created By -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Period" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding PeriodDisplay}" FontSize="12"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Duration" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding YearsDisplay}" FontSize="12"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Created By" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                                                        <TextBlock Text="{Binding CreatedByUsername}" FontSize="12"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Notes (conditional) -->
                                                <Border Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}"
                                                        Background="#F8F9FA" CornerRadius="5" Padding="12,8" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding RenewalNotes}"
                                                               FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 4 · FOOTER
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding NavigatePreviousCommand}"
                            IsEnabled="{Binding HasPreviousSet}"
                            Margin="0,0,8,0"
                            Content="&#8249; Previous Set"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding NavigateNextCommand}"
                            IsEnabled="{Binding HasNextSet}"
                            Content="Next Set &#8250;"/>
                </StackPanel>

                <!-- Close -->
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Command="{Binding CloseCommand}"
                        Content="Close"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             LOADING OVERLAY
             ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="5" Background="#C8FFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading renewal details…"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             ERROR OVERLAY
             ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="5" Background="#C8FFFFFF"
              Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="12" Padding="32,24"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Failed to Load" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource ErrorRed}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="400"/>
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding CloseCommand}"
                            Content="Close" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
