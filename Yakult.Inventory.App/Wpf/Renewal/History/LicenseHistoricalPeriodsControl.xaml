<UserControl x:Class="Yakult.Inventory.App.WPF.Renewal.History.LicenseHistoricalPeriodsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="HistoryControl" FontFamily="Segoe UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="20,16,20,8">
        <DockPanel LastChildFill="True" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Click="OnRefresh" Margin="0,0,8,0"/>
                <Button x:Name="AddPeriodButton" Content="Add Past Period" IsEnabled="False"
                        Style="{StaticResource PrimaryButton}" Click="OnAddPeriod"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PREVIOUS RENEWALS / BACKLOG" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Earlier coverage and the items included in each period."
                           FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <TextBlock x:Name="HistoryStatus" Text="Loading previous renewals…" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Periods, ElementName=HistoryControl}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14" Margin="0,0,0,10">
                        <Expander>
                            <Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="Historical Period" Foreground="#7B4BA8" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="{Binding PeriodDisplay}" Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" FontSize="14" Margin="0,3,0,4"/>
                                    <TextBlock Text="{Binding ReferenceDisplay}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock Text="{Binding AmountDisplay}" Foreground="{StaticResource YakultBlue}"
                                               FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Margin="22,12,0,0">
                                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" MaxHeight="320" RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Item / Description" Binding="{Binding ItemName}" Width="*" MinWidth="180"/>
                                        <DataGridTextColumn Header="Item Code" Binding="{Binding ItemCode}" Width="150"/>
                                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat=N2}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding EnteredDisplay}" Foreground="{StaticResource TextMuted}"
                                           TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </Expander>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
