<Window x:Class="Yakult.Inventory.App.WPF.Renewal.History.AddLicenseHistoricalPeriodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Previous Renewal Period" Width="1400" Height="880" MinWidth="1100" MinHeight="640"
        WindowState="Maximized" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Segoe UI" Background="{DynamicResource SurfaceGray}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Yakult.Inventory.App;component/WPF/RequestPortal/RequestPortalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="InputLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,5"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="ScrollBar"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="4,0,0,18">
            <TextBlock Text="Add Previous Renewal Period" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock x:Name="CoverageHint" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,7,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" x:Name="Editor">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="560"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*" MinWidth="440"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="PREVIOUS RENEWAL DETAILS" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                            <TextBlock Text="Reference / Invoice Number" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="ReferenceBox" MaxLength="100" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}" Padding="24,18">
                        <StackPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="+ Add Row" Style="{StaticResource SecondaryButton}" Padding="12,4" Click="OnAddCatalogItems"/>
                                <TextBlock Text="SELECT ITEMS COVERED" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="Check the items included in this previous renewal. Edit their descriptions, codes, and quantities to match the old records. Use Add Row to select catalog items, or Add Historical Item for items recorded only by name."
                                       FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Check All" Click="OnCheckAll" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,6"/>
                                <Button Content="Uncheck All" Click="OnUncheckAll" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,6"/>
                                <Button Content="Copy Invoice Items" Click="OnCopyItems" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,6"/>
                                <Button Content="Add Historical Item" Click="OnAddTextItem" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,8,6"/>
                                <Button Content="Remove Selected" Click="OnRemoveItems" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" RowHeaderWidth="0"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CardBorder}"
                                      BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Background="White"
                                      ColumnHeaderHeight="32" MinRowHeight="36" Height="440"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#A9E5B8"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDF0D8"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                                </DataGrid.Resources>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Included}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                <Setter Property="Background" Value="#F3F5F8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="42" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Included, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Item Code" Width="115" Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Description *" Width="*" MinWidth="230" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <DataGridTextColumn Header="Qty *" Width="85" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                    <DataGridTextColumn Header="Source" Width="110" IsReadOnly="True" Binding="{Binding SourceDisplay}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ItemSelectionSummary" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource SectionCard}" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="COVERAGE SETTINGS" Style="{StaticResource SectionLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Coverage Start *" Style="{StaticResource InputLabel}"/>
                                    <DatePicker x:Name="StartDatePicker" SelectedDateChanged="OnCoverageChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Coverage End *" Style="{StaticResource InputLabel}"/>
                                    <DatePicker x:Name="EndDatePicker" SelectedDateChanged="OnCoverageChanged"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel Margin="0,14,0,0">
                                <TextBlock Text="Years:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="YearsBox" Text="1" Width="55" Style="{StaticResource InputBox}" Margin="0,0,10,0"/>
                                <Button Content="Calculate End Date" Click="OnCalculateEndDate" Style="{StaticResource SecondaryButton}" Padding="12,5"/>
                            </WrapPanel>
                            <TextBlock Text="The same coverage dates apply to all checked items in this period." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="PERIOD AMOUNT" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="Total Amount (optional)" Style="{StaticResource InputLabel}"/>
                            <TextBox x:Name="AmountBox" Style="{StaticResource InputBox}" TextChanged="OnAmountChanged"/>
                            <TextBlock Text="Enter the total from the previous renewal, or leave it blank if unknown." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="NOTES" Style="{StaticResource SectionLabel}"/>
                            <TextBox x:Name="NotesBox" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Style="{StaticResource InputBox}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SectionCard}" Padding="24,18">
                        <StackPanel>
                            <TextBlock Text="PREVIOUS RENEWAL SUMMARY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock x:Name="PeriodSummary" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="AmountSummary" FontSize="18" FontWeight="Bold" Foreground="{StaticResource YakultBlue}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="16,12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Save this period and its checked items to previous renewal history." Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ValidationMessage" TextWrapping="Wrap" Foreground="#B42318" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                    <Button x:Name="SaveButton" Content="Save Previous Renewal" Style="{StaticResource PrimaryButton}" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
