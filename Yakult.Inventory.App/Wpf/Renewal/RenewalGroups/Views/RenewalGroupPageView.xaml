<UserControl x:Class="Yakult.Inventory.App.WPF.Renewal.RenewalGroups.Views.RenewalGroupPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Renewal.RenewalGroups.Views"
             xmlns:vm="clr-namespace:Yakult.Inventory.App.WPF.Renewal.RenewalGroups.ViewModels"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:StatusToBrushConverter x:Key="StatusToBrush"/>
            <local:BoolToExpandedBrushConverter x:Key="BoolToExpandedBrush"/>
            <local:BoolToWeightConverter x:Key="BoolToWeight"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToCardBrushConverter x:Key="BoolToCardBrush"/>

            <Style x:Key="ColumnFilterHeaderButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="4,0">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#DAE2F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Column widths shared between the sticky header strip and each card's header row -->
            <GridLength x:Key="ColSpacerW">54</GridLength>
            <GridLength x:Key="ColSetCodeW">110</GridLength>
            <GridLength x:Key="ColCompanyW">160</GridLength>
            <GridLength x:Key="ColTypeW">140</GridLength>
            <GridLength x:Key="ColSetsW">80</GridLength>
            <GridLength x:Key="ColStatusW">140</GridLength>
            <GridLength x:Key="ColDaysW">150</GridLength>
            <GridLength x:Key="ColCreatedW">110</GridLength>

            <Style x:Key="CardFieldText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ChainColHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ChainCellText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="ViewDetailsLinkButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ Page-local redesign styles (this page only — not shared) ═══════ -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>

            <Style x:Key="StatCardShell" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="7"/>
                <Setter Property="Margin"          Value="0,0,8,0"/>
                <Setter Property="Width"           Value="122"/>
                <Setter Property="Height"          Value="44"/>
                <Setter Property="Cursor"          Value="Hand"/>
            </Style>

            <Style x:Key="StatValueText" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="StatLabelText" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="7"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin"          Value="0"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,20,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header: title (left) + compact summary cards (right) ═══════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#E9F2FF" Margin="0,0,12,0">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Renewals (Grouped)" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Renewal chains grouped by root set, newest first" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsAllCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#4E9AFC"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueText}" Foreground="#4E9AFC"/>
                            <TextBlock Text="TOTAL GROUPS" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsExpiredCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ExpiredCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#E74C3C"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource StatValueText}" Foreground="#E74C3C"/>
                            <TextBlock Text="EXPIRED" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsExpiringCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ExpiringCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#FFC107"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ExpiringCount}" Style="{StaticResource StatValueText}" Foreground="#E6A800"/>
                            <TextBlock Text="EXPIRING (≤30)" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsWarningCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding WarningCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#E67E22"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding WarningCount}" Style="{StaticResource StatValueText}" Foreground="#E67E22"/>
                            <TextBlock Text="WARNING (31-90)" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Margin="0" Background="{Binding IsActiveCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ActiveCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#2ECC71"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource StatValueText}" Foreground="#2ECC71"/>
                            <TextBlock Text="ACTIVE" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ Action bar: Generate Report + Search + Advanced Filters (left), Refresh (right) ═ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <Button Command="{Binding GenerateReportCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                                <Setter Property="Background" Value="#D6F5E6"/>
                                <Setter Property="Foreground" Value="#27AE60"/>
                                <Setter Property="BorderBrush" Value="#27AE60"/>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Generate Report"/>
                    </Button>

                    <shared:SelectedCountBadge Count="{Binding SelectedCount}" EntityLabel="renewal groups"
                                                Click="SelectedBadge_Click" Margin="10,0,0,8"/>

                    <!-- Search -->
                    <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                            CornerRadius="5" Background="White" Height="30" Width="220" Margin="16,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#7A8A9A"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="11"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Set Code, Document #, Company, Type, Item Name..."/>
                        </Grid>
                    </Border>

                    <!-- Advanced Filters -->
                    <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                  Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                    <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                           IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                           HorizontalOffset="-830" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                CornerRadius="8" Padding="18" Width="960">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,12"/>

                                <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                                <StackPanel>

                                <!-- Row 1: Status / Type -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Status" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding StatusOptions}"
                                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Type" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding TypeOptions}"
                                                  SelectedItem="{Binding SelectedType, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 1b: Sub-Type -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Sub-Type" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ToggleButton x:Name="SubTypeFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                                  HorizontalAlignment="Stretch" Content="{Binding SubTypeFilterSummary}"/>
                                    <Popup PlacementTarget="{Binding ElementName=SubTypeFilterToggle}"
                                           IsOpen="{Binding IsChecked, ElementName=SubTypeFilterToggle, Mode=TwoWay}"
                                           StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                                CornerRadius="4" Padding="8" MinWidth="200">
                                            <StackPanel>
                                                <CheckBox Content="Non-Subtype" IsChecked="{Binding SubTypeFilterNonSubType, Mode=TwoWay}"
                                                          Padding="4,0" Margin="2,4" FontSize="11"/>
                                                <Separator Margin="0,4,0,4"/>
                                                <CheckBox Content="Subtype" IsChecked="{Binding SubTypeFilterAnySubtype, Mode=TwoWay}"
                                                          Padding="4,0" Margin="2,4" FontSize="11" FontWeight="Bold"
                                                          ToolTip="Any renewal chain with a Sub-Type item, unspecified which"/>
                                                <CheckBox Content="Contract" IsChecked="{Binding SubTypeFilterContract, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                <CheckBox Content="Subscription" IsChecked="{Binding SubTypeFilterSubscription, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                <CheckBox Content="License" IsChecked="{Binding SubTypeFilterLicense, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                <CheckBox Content="Services" IsChecked="{Binding SubTypeFilterServices, Mode=TwoWay}"
                                                          Padding="4,0" Margin="18,2,2,4" FontSize="11"/>
                                                <Separator Margin="0,6,0,4"/>
                                                <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                        Style="{StaticResource SmallBtn}" Margin="0"
                                                        Command="{Binding ClearSubTypeFilterCommand}"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>

                                <!-- Row 2: Document Date (one or more rows, OR'd together) -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Document Date" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding VisibleDocumentDateFilterRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <ComboBox Style="{StaticResource FilterCombo}" Width="130" Margin="0,0,8,0"
                                                              ItemsSource="{Binding MonthOptions}"
                                                              SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                                              ToolTip="Month"/>
                                                    <ComboBox Style="{StaticResource FilterCombo}" Width="90" Margin="0,0,8,0"
                                                              ItemsSource="{Binding DayOptions}"
                                                              SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                                              ToolTip="Day"/>
                                                    <ComboBox Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,8,0"
                                                              ItemsSource="{Binding YearOptions}"
                                                              SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                                              ToolTip="Year"/>
                                                    <Button Style="{StaticResource SmallBtn}" Command="{Binding RemoveCommand}" Margin="0"
                                                            ToolTip="Remove this date row" Padding="8,0">
                                                        <TextBlock Text="✕"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Style="{StaticResource SmallBtn}" Command="{Binding AddDocumentDateRowCommand}" Margin="0"
                                            Visibility="{Binding HasMoreDocumentDateFilterRows, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="➕  Add Date Row"/>
                                    </Button>
                                    <TextBlock Visibility="{Binding HasMoreDocumentDateFilterRows, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Left" Cursor="Hand" FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                                               TextDecorations="Underline" MouseLeftButtonUp="MoreDocumentDates_Click">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="More ({0} more)">
                                                <Binding Path="MoreDocumentDateFilterRowsCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Set Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Document #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Company" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="6">
                                        <TextBlock Text="Department" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="8">
                                        <TextBlock Text="Branch" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="10">
                                        <TextBlock Text="Employee" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 2: Reference Code | Parent Tag -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Reference Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Parent Tag" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Req ID -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Req ID" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                </StackPanel>
                                </ScrollViewer>

                                <Separator Margin="0,2,0,12"/>

                                <!-- Row 3: Show Archived + Reset Filters -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" Content="Show Archived" VerticalAlignment="Center"
                                              IsChecked="{Binding ShowArchived, Mode=TwoWay}"/>
                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                        <TextBlock Text="↺  Reset Filters"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- "Did you mean...?" banner — only shown when these rows came from the fuzzy fallback
             (FuzzyMatchRenewalGroups) rather than an exact search-text match, so typo-corrected
             guesses are never presented as if they were literal hits. -->
        <Border Grid.Row="2" Padding="14,9" Margin="0,0,0,10"
                Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#7A5C00" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ Sticky column header strip (group-level columns) ════════════ -->
        <Border Grid.Row="3" Background="#E6ECF5" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColSpacerW}"/>
                    <ColumnDefinition Width="{StaticResource ColSetCodeW}"/>
                    <ColumnDefinition Width="{StaticResource ColCompanyW}"/>
                    <ColumnDefinition Width="{StaticResource ColTypeW}"/>
                    <ColumnDefinition Width="{StaticResource ColSetsW}"/>
                    <ColumnDefinition Width="{StaticResource ColStatusW}"/>
                    <ColumnDefinition Width="{StaticResource ColDaysW}"/>
                    <ColumnDefinition Width="{StaticResource ColCreatedW}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Style="{StaticResource ColumnFilterHeaderButton}" Content="Set Code ▾" Tag="SetCode" Click="ColumnHeader_Click"/>
                <Button Grid.Column="2" Style="{StaticResource ColumnFilterHeaderButton}" Content="Company ▾" Tag="Company" Click="ColumnHeader_Click"/>
                <Button Grid.Column="3" Style="{StaticResource ColumnFilterHeaderButton}" Content="Type ▾" Tag="Type" Click="ColumnHeader_Click"/>
                <Button Grid.Column="4" Style="{StaticResource ColumnFilterHeaderButton}" Content="Sets ▾" Tag="Sets" Click="ColumnHeader_Click"/>
                <Button Grid.Column="5" Style="{StaticResource ColumnFilterHeaderButton}" Content="Status ▾" Tag="Status" Click="ColumnHeader_Click"/>
                <Button Grid.Column="6" Style="{StaticResource ColumnFilterHeaderButton}" Content="Days Left ▾" Tag="DaysLeft" Click="ColumnHeader_Click"/>
                <Button Grid.Column="7" Style="{StaticResource ColumnFilterHeaderButton}" Content="Created At ▾" Tag="CreatedAt" Click="ColumnHeader_Click"/>
            </Grid>
        </Border>

        <!-- ══ Group cards (scrollable) ═════════════════════════════════════ -->
        <Border Grid.Row="4" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" Margin="0,0,0,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="14,10,14,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RenewalGroupRow}">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Card header (clickable to expand/collapse) -->
                                    <Border Cursor="Hand" MouseLeftButtonUp="CardHeader_Click"
                                            Background="{Binding IsExpanded, Converter={StaticResource BoolToExpandedBrush}}">
                                        <Grid Height="44" Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="{StaticResource ColSetCodeW}"/>
                                                <ColumnDefinition Width="{StaticResource ColCompanyW}"/>
                                                <ColumnDefinition Width="{StaticResource ColTypeW}"/>
                                                <ColumnDefinition Width="{StaticResource ColSetsW}"/>
                                                <ColumnDefinition Width="{StaticResource ColStatusW}"/>
                                                <ColumnDefinition Width="{StaticResource ColDaysW}"/>
                                                <ColumnDefinition Width="{StaticResource ColCreatedW}"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- ButtonBase marks its own MouseLeftButtonUp handled before raising Click,
                                                 so this naturally does not bubble to the header Border's toggle handler
                                                 (mirrors the original's explicit "if (s == chkSelect) return;" guard). -->
                                            <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                      Checked="GroupCheckBox_Changed" Unchecked="GroupCheckBox_Changed"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ArrowText}" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding RootSetCode}" Style="{StaticResource CardFieldText}" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding CompanyName}" Style="{StaticResource CardFieldText}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SetType}" Style="{StaticResource CardFieldText}" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="5" Text="{Binding SetsCountDisplay}" Style="{StaticResource CardFieldText}" Foreground="{StaticResource TextSubtleBrush}" FontSize="9.5"/>
                                            <TextBlock Grid.Column="6" Text="{Binding OverallStatus}" Style="{StaticResource CardFieldText}" FontSize="9.5"
                                                       Foreground="{Binding OverallStatus, Converter={StaticResource StatusToBrush}}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding DaysDisplay}" Style="{StaticResource CardFieldText}" FontSize="9.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                            <TextBlock Grid.Column="8" Text="{Binding CreatedAtDisplay}" Style="{StaticResource CardFieldText}" FontSize="9.5" Foreground="{StaticResource TextSubtleBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Card body (chain rows, visible only when expanded) -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                Tag="{Binding}">
                                        <!-- Chain column header -->
                                        <Grid Background="#F1F5F9" Height="26">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="155"/>
                                                <ColumnDefinition Width="128"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="138"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="1" Text="Set Code" Style="{StaticResource ChainColHeaderText}" Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="Document #" Style="{StaticResource ChainColHeaderText}"/>
                                            <TextBlock Grid.Column="3" Text="Start Date" Style="{StaticResource ChainColHeaderText}"/>
                                            <TextBlock Grid.Column="4" Text="End Date" Style="{StaticResource ChainColHeaderText}"/>
                                            <TextBlock Grid.Column="5" Text="Days Left" Style="{StaticResource ChainColHeaderText}" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="6" Text="Status" Style="{StaticResource ChainColHeaderText}"/>
                                            <TextBlock Grid.Column="7" Text="Created At" Style="{StaticResource ChainColHeaderText}"/>
                                        </Grid>

                                        <!-- Chain rows -->
                                        <ItemsControl ItemsSource="{Binding ChainRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:RenewalChainRowVm}">
                                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                        <Grid Height="32">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="155"/>
                                                                <ColumnDefinition Width="128"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="100"/>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="138"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Selectively include/exclude this specific set from the generated
                                                                 report even though its chain's root group is checked. Clicking
                                                                 this also auto-checks the root card checkbox above (Click
                                                                 handler), since a chain whose root box was never manually
                                                                 checked gets silently dropped and CommitGenerateReport falls
                                                                 back to including every chain. -->
                                                            <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      IsChecked="{Binding Selected, Mode=TwoWay}"
                                                                      Click="ChildCheckBox_Click"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SetCodeDisplay}" Style="{StaticResource ChainCellText}" Margin="12,0,0,0"
                                                                       FontWeight="{Binding IsLatest, Converter={StaticResource BoolToWeight}}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DocumentNumber}" Style="{StaticResource ChainCellText}"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding StartDateDisplay}" Style="{StaticResource ChainCellText}"/>
                                                            <TextBlock Grid.Column="4" Text="{Binding EndDateDisplay}" Style="{StaticResource ChainCellText}"/>
                                                            <TextBlock Grid.Column="5" Text="{Binding DaysDisplay}" Style="{StaticResource ChainCellText}" HorizontalAlignment="Center"
                                                                       FontWeight="{Binding DaysBold, Converter={StaticResource BoolToWeight}}"/>
                                                            <TextBlock Grid.Column="6" Text="{Binding StatusDisplay}" Style="{StaticResource ChainCellText}"
                                                                       Foreground="{Binding StatusDisplay, Converter={StaticResource StatusToBrush}}"/>
                                                            <TextBlock Grid.Column="7" Text="{Binding CreatedAtDisplay}" Style="{StaticResource ChainCellText}"/>
                                                            <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="8,0,0,0">
                                                                <Button Style="{StaticResource ViewDetailsLinkButton}" Content="View Details"
                                                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}"/>
                                                                <Button Style="{StaticResource ViewDetailsLinkButton}" Content="Manage Items" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.ManageItemsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Footer: Renewal History -->
                                        <Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="12,7">
                                            <Button HorizontalAlignment="Left" Content="Renewal History"
                                                    Command="{Binding DataContext.HistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                                                        <Setter Property="Background" Value="#EFF6FF"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ══ Footer / paging ══════════════════════════════════════════════ -->
        <Border Grid.Row="5" Background="Transparent" Padding="0,0,0,16">
            <shared:PagingControl HorizontalAlignment="Left"
                                   FirstPageCommand="{Binding FirstPageCommand}"
                                   PrevPageCommand="{Binding PrevPageCommand}"
                                   NextPageCommand="{Binding NextPageCommand}"
                                   LastPageCommand="{Binding LastPageCommand}"
                                   PageInfoText="{Binding PageInfoText}"/>
        </Border>
    </Grid>
</UserControl>
