<Window x:Class="Yakult.Inventory.App.WPF.Renewal.RenewalGroups.Views.RenewalHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Renewal.RenewalGroups.Views"
        xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
        Title="Renewal History"
        Width="920" Height="640" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI">

    <Window.Resources>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
        <local:BoolToMutedBrushConverter x:Key="BoolToMutedBrush"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border Grid.Row="0" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding HeaderTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="9.5" Foreground="#94A3B8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scrollable timeline -->
        <ScrollViewer Grid.Row="1" Background="#F8FAFC" Padding="10,8">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="14,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderThickness" Value="4,0,0,0"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="4" Margin="-14,-10,10,-10"
                                        Background="{Binding IsLatest, Converter={StaticResource BoolToMutedBrush}}"/>

                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number, StringFormat='#{0}'}" FontSize="9" FontWeight="Bold"
                                                   Foreground="{Binding IsLatest, Converter={StaticResource BoolToMutedBrush}}"/>
                                        <TextBlock Text="Latest" FontSize="8.5" Foreground="#3B82F6" Margin="8,0,0,0"
                                                   Visibility="{Binding IsLatest, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>

                                    <TextBlock Margin="0,3,0,6" FontSize="12" FontWeight="Bold" Foreground="#1E293B">
                                        <Run Text="{Binding SetCode, Mode=OneWay}"/>
                                        <Run Text="   ·   "/>
                                        <Run Text="{Binding DocumentNumber, Mode=OneWay}"/>
                                    </TextBlock>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Ref #: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding RefNumber}" FontSize="9" Foreground="#1E293B"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Document Date: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding DocumentDateDisplay}" FontSize="9" Foreground="#1E293B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Company: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Company}" FontSize="9" Foreground="#1E293B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Site: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Site}" FontSize="9" Foreground="#1E293B"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Duration: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding Duration}" FontSize="9" Foreground="#1E293B"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Days: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding DaysDisplay}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding IsRenewed, Converter={StaticResource BoolToMutedBrush}}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="Status: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{Binding StatusDisplay, Converter={StaticResource StatusToBrush}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="Amount: " FontSize="8.5" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding AmountDisplay}" FontSize="9" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                        <TextBlock Text="Items:" FontSize="8.5" FontWeight="Bold" Foreground="#475569"/>
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="8.5" Foreground="#94A3B8" Margin="0,0,0,3"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="16,8" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <Button Content="Close" Width="88" Height="28" HorizontalAlignment="Right" Click="BtnClose_Click"/>
        </Border>
    </Grid>
</Window>
