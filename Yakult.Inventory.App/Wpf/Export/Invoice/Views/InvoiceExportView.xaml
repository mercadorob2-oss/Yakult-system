<UserControl x:Class="Yakult.Inventory.App.WPF.Export.Invoice.Views.InvoiceExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RightCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SmallBtn}" Command="{Binding BackCommand}" Margin="0,0,14,0">
                    <TextBlock Text="← Back"/>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Export Invoice" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Select invoices to export" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" Margin="0,0,8,0">
                    <TextBlock Text="📄  Export Selected"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource SmallBtn}" Command="{Binding RefreshCommand}" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Toolbar: search only ═════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource FilterBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                <TextBox Style="{StaticResource SearchBox}" Width="320"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Invoice Code, No., Company, Site…"/>
            </StackPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" Margin="14,0,14,0">
            <DataGrid x:Name="InvoicesGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      IsReadOnly="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ItemsSource="{Binding PagedRows}"
                      Sorting="InvoicesGrid_Sorting">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource PrimaryHoverBrush}" BorderThickness="0,0,1,1">
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Select / deselect all rows on this page"
                                                          Click="SelectAllCheckBox_Click"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Invoice Code" Binding="{Binding SetCode}" Width="1.1*" MinWidth="120" SortMemberPath="SetCode"/>
                    <DataGridTextColumn Header="Invoice No." Binding="{Binding DocumentNumber}" Width="*" MinWidth="110" SortMemberPath="DocumentNumber"/>
                    <DataGridTextColumn Header="PO No." Binding="{Binding ReferenceNumber}" Width="*" MinWidth="100" SortMemberPath="ReferenceNumber"/>
                    <DataGridTextColumn Header="Invoice Date" Binding="{Binding InvoiceDate}" Width="*" MinWidth="100" SortMemberPath="InvoiceDate"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="0.8*" MinWidth="80" SortMemberPath="Site"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.5*" MinWidth="150" SortMemberPath="CompanyName"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.8*" MinWidth="80" SortMemberPath="Status"/>
                    <DataGridTextColumn Header="Subtotal (₱)" Binding="{Binding Subtotal}" Width="*" MinWidth="100" SortMemberPath="Subtotal"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="VAT (₱)" Binding="{Binding VatAmount}" Width="*" MinWidth="90" SortMemberPath="VatAmount"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="Total (₱)" Binding="{Binding TotalAmountDue}" Width="*" MinWidth="100" SortMemberPath="TotalAmountDue">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightCellText}">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Footer: paging + page size + count ══════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <shared:PagingControl HorizontalAlignment="Left"
                                           FirstPageCommand="{Binding FirstPageCommand}"
                                           PrevPageCommand="{Binding PrevPageCommand}"
                                           NextPageCommand="{Binding NextPageCommand}"
                                           LastPageCommand="{Binding LastPageCommand}"
                                           PageInfoText="{Binding PageInfoText}"/>
                    <TextBlock Text="Rows:" VerticalAlignment="Center" Margin="20,0,6,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="70"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
