<UserControl x:Class="Yakult.Inventory.App.WPF.Export.Renewal.Views.RenewalExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Export.Renewal.Views"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:StatusToBrushConverter x:Key="StatusToBrush"/>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="RightCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="StatusCellText" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
                <Setter Property="Foreground" Value="{Binding SetLevelStatus, Converter={StaticResource StatusToBrush}}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SmallBtn}" Command="{Binding BackCommand}" Margin="0,0,14,0">
                    <TextBlock Text="← Back"/>
                </Button>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Export Renewals" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Select renewals to export" Style="{StaticResource PageSubtitle}"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource PrimaryBtn}" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" Margin="0,0,8,0">
                    <TextBlock Text="📄  Export Selected"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource SmallBtn}" Command="{Binding RefreshCommand}" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Toolbar: search only ═════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource FilterBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#7A8A9A"/>
                <TextBox Style="{StaticResource SearchBox}" Width="360"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by Set Code, Document #, Company, Site, Status, Part #…"/>
            </StackPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="White" Margin="14,0,14,0">
            <DataGrid x:Name="RenewalsGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      IsReadOnly="False"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      ItemsSource="{Binding PagedRows}"
                      Sorting="RenewalsGrid_Sorting">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False" CanUserReorder="False">
                        <DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource PrimaryHoverBrush}" BorderThickness="0,0,1,1">
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="Select / deselect all rows across all pages"
                                                          Click="SelectAllCheckBox_Click"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Selected, Mode=TwoWay}"
                                          Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Set Code" Binding="{Binding SetCode}" Width="*" MinWidth="100" SortMemberPath="SetCode"/>
                    <DataGridTextColumn Header="Renewal Of" Binding="{Binding RenewalOfSetId}" Width="0.7*" MinWidth="75" SortMemberPath="RenewalOfSetId"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding SetType}" Width="0.8*" MinWidth="80" SortMemberPath="SetType"/>
                    <DataGridTextColumn Header="Document #" Binding="{Binding DocumentNumber}" Width="*" MinWidth="100" SortMemberPath="DocumentNumber"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.3*" MinWidth="130" SortMemberPath="CompanyName"/>
                    <DataGridTextColumn Header="Site (Branch-Dept)" Binding="{Binding SiteDisplay}" Width="1.2*" MinWidth="130" SortMemberPath="SiteDisplay"/>
                    <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat=MM/dd/yyyy}" Width="0.9*" MinWidth="95" SortMemberPath="StartDate"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="End Date" Binding="{Binding EndDate, StringFormat=MM/dd/yyyy}" Width="0.9*" MinWidth="95" SortMemberPath="EndDate"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Days Left" Binding="{Binding DaysUntilExpiry}" Width="0.7*" MinWidth="75" SortMemberPath="DaysUntilExpiry"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding SetLevelStatus}" Width="*" MinWidth="95" SortMemberPath="SetLevelStatus"
                                        ElementStyle="{StaticResource StatusCellText}"/>
                    <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="0.6*" MinWidth="55" SortMemberPath="ItemCount"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="Amount (₱)" Binding="{Binding TotalAmountDue, StringFormat=N2}" Width="0.8*" MinWidth="85" SortMemberPath="TotalAmountDue"
                                        ElementStyle="{StaticResource RightCellText}"/>
                    <DataGridTextColumn Header="Renewed Date" Binding="{Binding RenewedDate, StringFormat=MM/dd/yyyy}" Width="0.9*" MinWidth="95" SortMemberPath="RenewedDate"
                                        ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Part #" Binding="{Binding PartNumber}" Width="0.9*" MinWidth="90" SortMemberPath="PartNumber"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Footer: paging + page size + count ══════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <shared:PagingControl HorizontalAlignment="Left"
                                           FirstPageCommand="{Binding FirstPageCommand}"
                                           PrevPageCommand="{Binding PrevPageCommand}"
                                           NextPageCommand="{Binding NextPageCommand}"
                                           LastPageCommand="{Binding LastPageCommand}"
                                           PageInfoText="{Binding PageInfoText}"/>
                    <TextBlock Text="Rows:" VerticalAlignment="Center" Margin="20,0,6,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="70"
                              ItemsSource="{Binding PageSizeOptions}"
                              SelectedItem="{Binding SelectedPageSize, Mode=TwoWay}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
