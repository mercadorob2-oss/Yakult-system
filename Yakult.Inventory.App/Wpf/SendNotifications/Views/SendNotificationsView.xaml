<UserControl
    x:Class="Yakult.Inventory.App.WPF.SendNotifications.Views.SendNotificationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
    Background="#F0F2F6"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    RenderOptions.ClearTypeHint="Enabled">

    <UserControl.Resources>
        <!-- ── Converters ────────────────────────────────────────────────── -->
        <conv:StringToColorBrushConverter      x:Key="HexToBrush"/>
        <conv:BoolToVisibilityConverter        x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:NullToVisibilityConverter        x:Key="NullToVis"/>

        <!-- ── Global TextBlock ──────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily"                         Value="Segoe UI"/>
            <Setter Property="Foreground"                         Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode"     Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode"      Value="ClearType"/>
        </Style>

        <!-- ── Summary card ─────────────────────────────────────────────── -->
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Margin"          Value="0,0,10,0"/>
            <Setter Property="MinWidth"        Value="160"/>
        </Style>

        <!-- ── Card top label ─────────────────────────────────────────── -->
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7A8D"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <!-- ── Card big number ───────────────────────────────────────── -->
        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A2333"/>
        </Style>

        <!-- ── Filter bar outer card ─────────────────────────────────── -->
        <Style x:Key="FilterBar" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="10,6"/>
        </Style>

        <!-- ── Search TextBox ────────────────────────────────────────── -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="BorderBrush"              Value="#C2CCDA"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="#F8F9FB"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height"                   Value="30"/>
        </Style>

        <!-- ── Filter ComboBox ───────────────────────────────────────── -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="BorderBrush"              Value="#C2CCDA"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="#F8F9FB"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="6,4"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── DatePicker with classic icon ──────────────────────────── -->
        <Style x:Key="CleanDatePicker" TargetType="DatePicker">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="MinWidth"        Value="110"/>
            <Setter Property="FontSize"        Value="10.5"/>
            <Setter Property="Background"      Value="#F8F9FB"/>
            <Setter Property="BorderBrush"     Value="#C2CCDA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="dpBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_TextBox"
                                         Grid.Column="0"
                                         Foreground="{TemplateBinding Foreground}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="{TemplateBinding FontSize}"
                                         Padding="6,0"
                                         VerticalContentAlignment="Center"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="0,3,3,0">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="#6B7A8D"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="btnBd"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#EEF1F5" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Normal"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Small icon button (Refresh / Clear) ───────────────────── -->
        <Style x:Key="SmallBtn" TargetType="Button">
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Padding"          Value="10,0"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="#C2CCDA"/>
            <Setter Property="Background"       Value="#F8F9FB"/>
            <Setter Property="Foreground"       Value="#3A4A5A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF1F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDE3EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Main content card ─────────────────────────────────────── -->
        <Style x:Key="ContentCard" TargetType="Border">
            <Setter Property="Background"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- ── Section label ─────────────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7A8D"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>

        <!-- ── Detail value text ─────────────────────────────────────── -->
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ── Save receiver button ──────────────────────────────────── -->
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Padding"         Value="14,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E7EE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2470CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B0C4DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Send Notification primary button ──────────────────────── -->
        <Style x:Key="SendBtn" TargetType="Button">
            <Setter Property="Height"          Value="44"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="20,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E7EE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2470CC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#A8C4E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid header style ─────────────────────────────────── -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"               Value="#3A8EF6"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="FontSize"                 Value="10.5"/>
            <Setter Property="FontWeight"               Value="SemiBold"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="Height"                   Value="34"/>
            <Setter Property="BorderBrush"              Value="#2E7EE8"/>
            <Setter Property="BorderThickness"          Value="0,0,1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DataGrid row style ─────────────────────────────────────── -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8F0FE"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F6FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGrid cell style ────────────────────────────────────── -->
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <!-- Painted by the cell (not the row) so the selection highlight sits on top of
                 the DataGrid's RowBackground / AlternatingRowBackground local values. -->
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#C8DEFC"/>
                    <Setter Property="Foreground" Value="#1A2333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Notes TextBox ─────────────────────────────────────────── -->
        <Style x:Key="NotesBox" TargetType="TextBox">
            <Setter Property="Background"         Value="#F8F9FB"/>
            <Setter Property="BorderBrush"        Value="#C2CCDA"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="8,6"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="Foreground"         Value="#1A2333"/>
            <Setter Property="AcceptsReturn"      Value="True"/>
            <Setter Property="TextWrapping"       Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ── Thin scrollbar ─────────────────────────────────────────── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#C8D0DC" CornerRadius="3" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page header ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"
                Padding="16,8,16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="#3A8EF6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock Text="Send Notifications"
                                   FontSize="14" FontWeight="Bold" Foreground="#1A2333"/>
                        <TextBlock Text="Cartridge fulfillment notifications for portal requesters"
                                   FontSize="9.5" Foreground="#6B7A8D" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource SmallBtn}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Reload data">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Summary cards ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,8,16,0">

            <!-- Pending -->
            <Border Style="{StaticResource SummaryCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PENDING" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="need attention" FontSize="9" Foreground="#9AAABB"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PendingCount}"
                               Style="{StaticResource CardValue}" Foreground="#C0392B"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Sent Today -->
            <Border Style="{StaticResource SummaryCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVITY TODAY" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="sets updated today" FontSize="9" Foreground="#9AAABB"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding SentTodayCount}"
                               Style="{StaticResource CardValue}" Foreground="#3A8EF6"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Fulfilled Sets -->
            <Border Style="{StaticResource SummaryCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="FULFILLED SETS" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="in last 90 days" FontSize="9" Foreground="#9AAABB"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding FulfilledCount}"
                               Style="{StaticResource CardValue}" Foreground="#1E9E5E"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Last Refresh -->
            <Border Style="{StaticResource SummaryCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="LAST REFRESH" Style="{StaticResource CardLabel}"/>
                        <TextBlock Text="data loaded at" FontSize="9" Foreground="#9AAABB"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding LastRefresh}"
                               Style="{StaticResource CardValue}" Foreground="#5A6A7E"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>

        <!-- ── Filter bar ────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource FilterBar}" Margin="16,6,16,0">
            <StackPanel Orientation="Horizontal">

                <!-- Search box -->
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Width="200"
                         ToolTip="Search by Set Code, Requester, Company, or Branch">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="#9AAABB" VerticalAlignment="Center" Margin="-26,0,10,0"/>

                <!-- Status filter -->
                <ComboBox Style="{StaticResource FilterCombo}"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding SelectedStatus}"
                          Width="160"
                          Margin="8,0,0,0"/>

                <!-- Date From -->
                <TextBlock Text="From:" FontSize="10" Foreground="#6B7A8D"
                           VerticalAlignment="Center" Margin="16,0,6,0"/>
                <DatePicker Style="{StaticResource CleanDatePicker}"
                            SelectedDate="{Binding DateFrom, Mode=TwoWay}"
                            Width="116"/>

                <!-- Date To -->
                <TextBlock Text="To:" FontSize="10" Foreground="#6B7A8D"
                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker Style="{StaticResource CleanDatePicker}"
                            SelectedDate="{Binding DateTo, Mode=TwoWay}"
                            Width="116"/>

                <!-- Clear filters -->
                <Button Style="{StaticResource SmallBtn}"
                        Command="{Binding ClearFiltersCommand}"
                        Margin="10,0,0,0"
                        ToolTip="Clear all filters">
                    <TextBlock Text="Clear" FontSize="11"/>
                </Button>

            </StackPanel>
        </Border>

        <!-- ── Main content area ─────────────────────────────────────────── -->
        <Grid Grid.Row="3" Margin="16,6,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── DataGrid panel ──────────────────────────────────────── -->
            <Border Grid.Column="0" Style="{StaticResource ContentCard}" ClipToBounds="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          x:Name="NotificationsGrid"
                          ItemsSource="{Binding PagedRows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF1F5"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#FAFBFC"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          RowStyle="{StaticResource GridRow}"
                          CellStyle="{StaticResource GridCell}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True">
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width"    Value="6"/>
                            <Setter Property="MinWidth" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Width="6" Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border Background="#C8D0DC" CornerRadius="3" Margin="1"/>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <!-- Date -->
                        <DataGridTextColumn Header="Date"
                                            Binding="{Binding DateDisplay}"
                                            Width="120"
                                            MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="10.5"/>
                                    <Setter Property="Foreground" Value="#3A4A5A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Set Code -->
                        <DataGridTextColumn Header="Set Code"
                                            Binding="{Binding SetCode}"
                                            Width="100"
                                            MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"   Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1A2333"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Requester -->
                        <DataGridTextColumn Header="Requester"
                                            Binding="{Binding RequesterName}"
                                            Width="*"
                                            MinWidth="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"     Value="11"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Company -->
                        <DataGridTextColumn Header="Company"
                                            Binding="{Binding CompanyName}"
                                            Width="*"
                                            MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"     Value="11"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Branch / Dept -->
                        <DataGridTextColumn Header="Branch / Dept"
                                            Binding="{Binding BranchDept}"
                                            Width="1.2*"
                                            MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"     Value="11"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Distribution -->
                        <DataGridTemplateColumn Header="Distribution" Width="90" MinWidth="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DistributionMethod}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="#4A5A6A"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Received By -->
                        <DataGridTextColumn Header="Received By"
                                            Binding="{Binding ReceivedByDisplay}"
                                            Width="*"
                                            MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize"     Value="11"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReceivedByName}" Value="">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                            <Setter Property="FontStyle"  Value="Italic"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Header="Status" Width="130" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="12"
                                            Padding="10,3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="4,3">
                                        <TextBlock Text="{Binding FriendlyStatus}"
                                                   Foreground="{Binding StatusFg, Converter={StaticResource HexToBrush}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

                <!-- ── Pagination bar ──────────────────────────────── -->
                <Border Grid.Row="1"
                        Background="#F8F9FB"
                        BorderBrush="#EEF1F5"
                        BorderThickness="0,1,0,0"
                        Padding="10,5">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Prev buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                      <Button Command="{Binding FirstPageCommand}"
                              IsEnabled="{Binding CanGoFirst}"
                              Style="{StaticResource SmallBtn}"
                              Padding="7,0" Height="26" Margin="0,0,2,0"
                              ToolTip="First page">
                        <TextBlock Text="«" FontSize="11"/>
                      </Button>
                      <Button Command="{Binding PrevPageCommand}"
                              IsEnabled="{Binding CanGoPrev}"
                              Style="{StaticResource SmallBtn}"
                              Padding="7,0" Height="26"
                              ToolTip="Previous page">
                        <TextBlock Text="‹" FontSize="11"/>
                      </Button>
                    </StackPanel>

                    <!-- Page info -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding PageInfo}"
                               FontSize="10" Foreground="#6B7A8D"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Next buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button Command="{Binding NextPageCommand}"
                              IsEnabled="{Binding CanGoNext}"
                              Style="{StaticResource SmallBtn}"
                              Padding="7,0" Height="26" Margin="0,0,2,0"
                              ToolTip="Next page">
                        <TextBlock Text="›" FontSize="11"/>
                      </Button>
                      <Button Command="{Binding LastPageCommand}"
                              IsEnabled="{Binding CanGoLast}"
                              Style="{StaticResource SmallBtn}"
                              Padding="7,0" Height="26"
                              ToolTip="Last page">
                        <TextBlock Text="»" FontSize="11"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>

              </Grid>
            </Border>

            <!-- ── Detail panel ────────────────────────────────────────── -->
            <Border Grid.Column="2" Style="{StaticResource ContentCard}">
                <Grid>

                    <!-- No selection placeholder -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                                   Foreground="#DDE3EC" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a row to view details"
                                   FontSize="12" Foreground="#9AAABB"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" TextAlignment="Center"
                                   MaxWidth="200" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Detail content -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="18,16,18,16">

                            <!-- Header row: Set Code + Status badge -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SET DETAILS" Style="{StaticResource CardLabel}"/>
                                    <TextBlock Text="{Binding DetailSetCode}"
                                               FontSize="16" FontWeight="Bold" Foreground="#1A2333"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{Binding DetailStatusBg, Converter={StaticResource HexToBrush}}"
                                        CornerRadius="12"
                                        Padding="10,4"
                                        VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding DetailStatus}"
                                               Foreground="{Binding DetailStatusFg, Converter={StaticResource HexToBrush}}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Divider -->
                            <Border Background="#EEF1F5" Height="1" Margin="0,0,0,12"/>

                            <!-- Requester -->
                            <TextBlock Text="REQUESTER" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding DetailRequester}"
                                       Style="{StaticResource DetailValue}"
                                       Margin="0,0,0,10"/>

                            <!-- Company -->
                            <TextBlock Text="COMPANY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding DetailCompany}"
                                       Style="{StaticResource DetailValue}"
                                       Margin="0,0,0,10"/>

                            <!-- Branch / Dept -->
                            <TextBlock Text="BRANCH / DEPARTMENT" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding DetailBranchDept}"
                                       Style="{StaticResource DetailValue}"
                                       Margin="0,0,0,10"/>

                            <!-- Distribution Method -->
                            <TextBlock Text="DISTRIBUTION METHOD" Style="{StaticResource SectionLabel}"/>
                            <Border HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="{Binding DetailDistribution}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="#3A4A5A"/>
                            </Border>

                            <!-- Received By (read-only display) -->
                            <TextBlock Text="RECEIVED BY" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding DetailReceivedBy}"
                                       Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource DetailValue}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailReceivedBy}" Value="— Not Set —">
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- ── Receiver picker (PICKUP only) ─────────── -->
                            <StackPanel Visibility="{Binding IsPickup, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,10">
                                <Border Background="#F0F6FF" BorderBrush="#B8D4F8"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="UPDATE RECEIVED BY" Style="{StaticResource SectionLabel}"
                                                   Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0"
                                                      Style="{StaticResource FilterCombo}"
                                                      ItemsSource="{Binding ReceiverOptions}"
                                                      SelectedItem="{Binding SelectedReceiver}"
                                                      Height="28"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SaveBtn}"
                                                    Command="{Binding SaveReceiverCommand}"
                                                    Content="Save"/>
                                        </Grid>
                                        <TextBlock Text="Select who physically collects the cartridges."
                                                   FontSize="9.5" Foreground="#6B8DAA" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Background="#EEF1F5" Height="1" Margin="0,4,0,12"/>

                            <!-- Notes section -->
                            <TextBlock Text="NOTES (OPTIONAL)" Style="{StaticResource SectionLabel}"
                                       Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource NotesBox}"
                                     Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="80"
                                     MaxHeight="160"
                                     Margin="0,0,0,14">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Divider -->
                            <Border Background="#EEF1F5" Height="1" Margin="0,0,0,14"/>

                            <!-- Preview HTML button -->
                            <Button Style="{StaticResource SmallBtn}"
                                    Command="{Binding PreviewEmailCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="34"
                                    Margin="0,0,0,8"
                                    ToolTip="Preview the email HTML before sending">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Preview HTML" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Send Notification button -->
                            <Button Style="{StaticResource SendBtn}"
                                    Command="{Binding SendNotificationCommand}"
                                    IsEnabled="{Binding CanSendNotification}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Send Notification" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Sending indicator overlay -->
                            <Border Margin="0,6,0,0"
                                    Visibility="{Binding IsSending, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#3A8EF6"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Sending…"
                                               FontSize="11" Foreground="#3A8EF6"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Status message -->
                            <Border Margin="0,8,0,0"
                                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding StatusMessage}"
                                           Foreground="{Binding StatusMessageColor, Converter={StaticResource HexToBrush}}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold"/>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>

        <!-- ── Full-screen loading overlay ────────────────────────────────── -->
        <Border Grid.Row="0" Grid.RowSpan="4"
                Background="#80F0F2F6"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" BorderBrush="#DDE3EC" BorderThickness="1"
                    CornerRadius="10" Padding="32,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                               FontSize="18" Foreground="#3A8EF6"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Loading notifications…"
                               FontSize="13" Foreground="#3A4A5A"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
