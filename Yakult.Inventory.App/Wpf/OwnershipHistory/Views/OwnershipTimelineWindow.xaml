<Window x:Class="Yakult.Inventory.App.Wpf.OwnershipHistory.Views.OwnershipTimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
        Title="Full History" Height="640" Width="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F0F2F6" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!-- New-value text in a change line: green/bold for a real old->new diff,
                 muted gray for an unchanged field shown only for context, plain dark for a note. -->
            <Style x:Key="ChangeValueText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="#1E9E5E"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnchanged}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPlainNote}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" Text="Full History" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="TxtSubtitle" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListTimeline" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Vertical spine: connecting line + colored dot per event -->
                            <Grid Grid.Column="0">
                                <Rectangle Width="2" Fill="#DDE3EC" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,6,0,-20"/>
                                <Ellipse Width="14" Height="14" Fill="{Binding AccentBrush}" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>

                            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="8,0,0,20">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                                   Foreground="{Binding AccentBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="8,2,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,6"
                                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>

                                    <ItemsControl ItemsSource="{Binding ChangeLines}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                    <TextBlock Text="{Binding Label, StringFormat={}{0}:}" FontWeight="SemiBold" FontSize="11"
                                                               Foreground="{StaticResource TextDarkBrush}" Margin="0,0,5,0"
                                                               Visibility="{Binding IsPlainNote, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <TextBlock Text="{Binding OldValue}" Foreground="#C0392B" TextDecorations="Strikethrough"
                                                               FontSize="11" Margin="0,0,5,0" TextWrapping="Wrap"
                                                               Visibility="{Binding IsRealDiff, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="→" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,5,0"
                                                               Visibility="{Binding IsRealDiff, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Text="{Binding NewValue}" Style="{StaticResource ChangeValueText}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
