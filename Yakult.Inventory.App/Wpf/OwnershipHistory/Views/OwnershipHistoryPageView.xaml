<UserControl x:Class="Yakult.Inventory.App.Wpf.OwnershipHistory.Views.OwnershipHistoryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PageHeaderBar}">
            <StackPanel>
                <TextBlock Text="Ownership &amp; Site Change History" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Full record of Set ownership transfers (Department/Employee level) and Invoice sender/site changes"
                           Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- Filter bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnPreviewSelected" Content="Preview" Style="{StaticResource SmallBtn}" Margin="0,0,16,0" VerticalAlignment="Center"
                        ToolTip="Open the selected row's Set/Invoice detail page" Click="BtnPreviewSelected_Click"/>

                <TextBlock Text="Entity Type" Style="{StaticResource FilterLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbEntityType" Style="{StaticResource FilterCombo}" Width="140" Margin="0,0,16,0" VerticalAlignment="Center"
                          SelectionChanged="CmbEntityType_SelectionChanged">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="Set"/>
                    <ComboBoxItem Content="Invoice"/>
                </ComboBox>

                <TextBlock Text="Entity Id" Style="{StaticResource FilterLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtEntityId" Style="{StaticResource SearchBox}" Width="100" Margin="0,0,16,0" VerticalAlignment="Center"
                         KeyDown="TxtEntityId_KeyDown"/>

                <Button x:Name="BtnSearch" Content="Search" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" VerticalAlignment="Center" Click="BtnSearch_Click"/>
                <Button x:Name="BtnRefresh" Content="Refresh" Style="{StaticResource SmallBtn}" Margin="0" VerticalAlignment="Center" Click="BtnRefresh_Click"/>
            </StackPanel>
        </Border>

        <!-- Content: history grid (left) + transfer cycle detail (right) -->
        <Grid Grid.Row="2" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="GridHistory" Style="{StaticResource ListDataGridChrome}"
                          ColumnHeaderStyle="{StaticResource ListDataGridColumnHeader}"
                          RowStyle="{StaticResource ListDataGridRow}"
                          CellStyle="{StaticResource ListDataGridCell}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionChanged="GridHistory_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm}" Width="130"/>
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityLabel}" Width="120"/>
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="130"/>
                        <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                        <DataGridTemplateColumn Header="Change Summary" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Headline}" Foreground="{Binding AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Full View" Style="{StaticResource SmallBtn}" Tag="{Binding}" Click="BtnFullView_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Ownership Transfer Cycle"
                               FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextDarkBrush}"
                               Margin="10,10,10,4"/>
                    <TextBlock DockPanel.Dock="Top" Text="Select a Set row to see its Initiated → Completed transfer cycle"
                               FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                               Margin="10,0,10,8"/>
                    <ListBox x:Name="ListTransferCycle" BorderThickness="0" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="0,6,8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" Margin="0,1,8,1" CornerRadius="2" Background="{Binding AccentBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding AccentBrush}"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
