<Window x:Class="Yakult.Inventory.App.Wpf.Receipt.ReceiptSetViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt Set Viewer"
        Width="1220" Height="800"
        MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#EEF1F6">
    <Window.Resources>
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.87"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#E8ECF2"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A98A8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#20303F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D6DCE4" BorderThickness="1"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A8EF6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#AAB8C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#20303F"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6DCE4"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="DocTab" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" CornerRadius="8,8,0,0" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                                <Border x:Name="bdUnderline" Height="2.5" Background="#3A8EF6"
                                        VerticalAlignment="Bottom" Margin="0,7,0,-11" Opacity="0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1C7ED6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Foreground" Value="#8A98A8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FBFCFD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#E2E7EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.05" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── Header ─── -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="#3A8EF6" Margin="0,0,14,0">
                    <TextBlock Text="🧾" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Receipt Set Viewer"
                               FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#1A2A3A"/>
                    <TextBlock x:Name="TxtSubtitle"
                               FontFamily="Segoe UI" FontSize="12" Foreground="#8A98A8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRefresh" Content="🔄  Refresh" Style="{StaticResource SecondaryBtn}"
                        Click="BtnRefresh_Click" Margin="0,0,8,0"
                        ToolTip="Reload this Set's header and receipt documents from the database"/>
                <Button x:Name="BtnSave" Content="💾  Save" Background="#3A8EF6"
                        Style="{StaticResource Btn}" Click="BtnSave_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnRevert" Content="⏪  Revert" Background="#E67E22"
                        Style="{StaticResource Btn}" Click="BtnRevert_Click"
                        Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button Content="Close" Style="{StaticResource SecondaryBtn}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- ─── Period tabs: Current | Previous | History ─── -->
        <Border Grid.Row="1" Background="#F4F6F9" BorderBrush="#E2E7EE" BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0" Padding="10,6,10,0" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabPeriodCurrent" GroupName="PeriodTabs" Style="{StaticResource DocTab}"
                             IsChecked="True" Checked="PeriodTab_Checked" Tag="Current">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" Margin="0,0,6,0"/>
                        <TextBlock Text="Current"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabPeriodPrevious" GroupName="PeriodTabs" Style="{StaticResource DocTab}"
                             Checked="PeriodTab_Checked" Tag="Previous" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏪" Margin="0,0,6,0"/>
                        <TextBlock Text="Previous"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TabPeriodHistory" GroupName="PeriodTabs" Style="{StaticResource DocTab}"
                             Checked="PeriodTab_Checked" Tag="History" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📜" Margin="0,0,6,0"/>
                        <TextBlock Text="History"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- ─── Fields card ─── -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="22,18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SUPPLIER *" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="CmbSupplier" Style="{StaticResource FieldCombo}" IsEditable="True"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SI #" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtSiNumber" Style="{StaticResource FieldBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="DR #" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtDrNumber" Style="{StaticResource FieldBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="6">
                    <TextBlock Text="PO #" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtPoNumber" Style="{StaticResource FieldBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── Content area: Gallery (Current/Previous) or History split panel ─── -->
        <Grid Grid.Row="3">

            <!-- Gallery view for Current / Previous tabs -->
            <Grid x:Name="GalleryContent">

                <!-- ─── Document tabs + multi-image gallery ─── -->
                <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Document type tabs -->
                <Border Grid.Row="0" Background="#F4F6F9" CornerRadius="10,10,0,0" Padding="10,10,10,0"
                        BorderBrush="#E2E7EE" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSi" GroupName="DocTabs" Style="{StaticResource DocTab}"
                                     IsChecked="True" Checked="DocTab_Checked" Tag="SI">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,7,0"/>
                                <TextBlock Text="Sales Invoice"/>
                                <Border x:Name="BadgeSi" Background="#DCE8FB" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCountSi" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#3A6EA5"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabDr" GroupName="DocTabs" Style="{StaticResource DocTab}"
                                     Checked="DocTab_Checked" Tag="DR" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,7,0"/>
                                <TextBlock Text="Delivery Receipt"/>
                                <Border x:Name="BadgeDr" Background="#DCE8FB" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCountDr" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#3A6EA5"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabPo" GroupName="DocTabs" Style="{StaticResource DocTab}"
                                     Checked="DocTab_Checked" Tag="PO" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" Margin="0,0,7,0"/>
                                <TextBlock Text="Purchase Order"/>
                                <Border x:Name="BadgePo" Background="#DCE8FB" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCountPo" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#3A6EA5"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="TabPdf" GroupName="DocTabs" Style="{StaticResource DocTab}"
                                     Checked="DocTab_Checked" Tag="PDF" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📕" Margin="0,0,7,0"/>
                                <TextBlock Text="PDF Document"/>
                                <Border x:Name="BadgePdf" Background="#FDE8D0" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtCountPdf" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="#B6581A"/>
                                </Border>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Gallery -->
                <Grid Grid.Row="1" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtGalleryHint" Grid.Column="0"
                                   Text="Drag and drop images here, or use Add Image(s)."
                                   FontFamily="Segoe UI" FontSize="12.5" FontStyle="Italic"
                                   Foreground="#9AA6B4" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnAddImages" Content="＋  Add Image(s)" Background="#1E9E5E"
                                    Style="{StaticResource Btn}" Click="BtnAddImages_Click"/>
                            <Button x:Name="BtnAddPdf" Content="＋  Add PDF" Background="#D4380D"
                                    Margin="8,0,0,0" Style="{StaticResource Btn}" Click="BtnAddPdf_Click"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" x:Name="DropZone" BorderBrush="#D6DCE4" BorderThickness="1.5"
                            CornerRadius="8" Background="#FAFBFD"
                            AllowDrop="True" DragEnter="DropZone_DragEnter" Drop="DropZone_Drop">
                        <Border.Resources>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#D6DCE4"/>
                            </Style>
                        </Border.Resources>
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                                <ItemsControl x:Name="ImageGallery">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" Margin="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Empty-state placeholder shown when the current tab has no content -->
                            <StackPanel x:Name="EmptyGalleryState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                        IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="EmptyStateIcon" Text="🖼" FontSize="46" Foreground="#D4DCE6" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock x:Name="EmptyStateTitle" Text="No images attached yet" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="#6A7A8A" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyStateHint" Text="Drag and drop image files here, or click Add Image(s) above."
                                           FontSize="12" Foreground="#9AA6B4" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
            </Grid>

            <!-- ─── History view: split panel (list + details) ─── -->
            <Grid x:Name="HistoryContent" Visibility="Collapsed" Margin="0">
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F4F6F9" BorderBrush="#E2E7EE" BorderThickness="0,0,0,1"
                                CornerRadius="10,10,0,0" Padding="14,10">
                            <TextBlock Text="Receipt History" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#20303F"/>
                        </Border>

                        <Grid Grid.Row="1" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- History DataGrid -->
                            <Border Grid.Column="0" Margin="12,12,0,12">
                                <DataGrid x:Name="HistoryGrid"
                                          Background="White" BorderThickness="0"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#EEF1F5"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F7F9FC"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          AutoGenerateColumns="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          RowHeaderWidth="0"
                                          FontSize="12"
                                          RowHeight="40"
                                          ColumnHeaderHeight="36"
                                          IsReadOnly="True"
                                          EnableRowVirtualization="True"
                                          MouseDoubleClick="HistoryGrid_MouseDoubleClick"
                                          SelectionChanged="HistoryGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Version / Period" Binding="{Binding VersionLabel}" Width="110"/>
                                        <DataGridTextColumn Header="Saved" Binding="{Binding SavedAtText}" Width="110"/>
                                        <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="*"/>
                                        <DataGridTextColumn Header="Doc #" Binding="{Binding DocText}" Width="120"/>
                                        <DataGridTextColumn Header="Imgs" Binding="{Binding ImageIndicators}" Width="80"/>
                                        <DataGridTextColumn Header="Changed" Binding="{Binding ChangeSummary}" Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- Grid splitter -->
                            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Center"
                                          Background="#DDE3EC"/>

                            <!-- History details panel -->
                            <Border Grid.Column="2" Margin="0,12,12,12" Background="#F7F9FC"
                                    CornerRadius="8" Padding="12" BorderBrush="#E2E7EE" BorderThickness="1">
                                <StackPanel x:Name="HistoryDetailsPanel" VerticalAlignment="Top">
                                    <TextBlock Text="Details" FontSize="11" FontWeight="Bold"
                                               Foreground="#8A98A8" Margin="0,0,0,8"/>

                                    <TextBlock x:Name="HistDetailVersion" Text="—"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#20303F"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="HistDetailSaved" Text="—"
                                               FontSize="11" Foreground="#6A7A8A" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="HistDetailSupplier" Text="—"
                                               FontSize="11" Foreground="#6A7A8A" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="HistDetailDoc" Text="—"
                                               FontSize="11" Foreground="#6A7A8A" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="HistDetailChanged" Text="—"
                                               FontSize="11" FontStyle="Italic" Foreground="#6A7A8A"
                                               Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <TextBlock Text="Image indicators" FontSize="10" FontWeight="Bold"
                                               Foreground="#8A98A8" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="HistDetailImgs" Text="—"
                                               FontSize="11" Foreground="#6A7A8A" Margin="0,0,0,12"/>

                                    <Button x:Name="BtnHistOpen" Content="Open (read-only)"
                                            Style="{StaticResource SecondaryBtn}"
                                            Height="34" MinWidth="120"
                                            Click="BtnHistOpen_Click" Margin="0,0,0,6"/>
                                    <Button x:Name="BtnHistMakeCurrent" Content="Make current"
                                            Style="{StaticResource SecondaryBtn}"
                                            Height="34" MinWidth="120"
                                            Click="BtnHistMakeCurrent_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
