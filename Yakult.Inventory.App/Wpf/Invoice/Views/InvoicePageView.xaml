<UserControl x:Class="Yakult.Inventory.App.WPF.Invoice.Views.InvoicePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             xmlns:helpers="clr-namespace:Yakult.Inventory.App.WPF.Shared.Helpers"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Invoice.Views"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:DaysLeftToBrushConverter x:Key="DaysLeftToBrush"/>
            <conv:BoolToCardBrushConverter x:Key="BoolToCardBrush"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="WrappedCenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- ══ Page-local redesign styles (Invoice page only — not shared) ═══ -->
            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>

            <Style x:Key="StatCardShell" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="7"/>
                <Setter Property="Margin"          Value="0,0,8,0"/>
                <Setter Property="Width"           Value="122"/>
                <Setter Property="Height"          Value="44"/>
                <Setter Property="Cursor"          Value="Hand"/>
            </Style>

            <Style x:Key="StatValueText" TargetType="TextBlock">
                <Setter Property="FontSize"   Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="StatLabelText" TargetType="TextBlock">
                <Setter Property="FontSize"     Value="7"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin"          Value="0"/>
            </Style>

            <Style x:Key="OutlineAccentBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"  Value="White"/>
                <Setter Property="Foreground"  Value="#27AE60"/>
                <Setter Property="BorderBrush" Value="#27AE60"/>
            </Style>

            <!-- Lighter, less-saturated grid header than the shared ListDataGridColumnHeader.
                 Kept blue (not a pale tint) because the base template's sort arrow is a hardcoded
                 white Fill — a light background would make it unreadable. -->
            <Style x:Key="InvoiceGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListDataGridColumnHeader}">
                <Setter Property="Background"  Value="#6FAEFB"/>
                <Setter Property="BorderBrush" Value="#5FA0F2"/>
            </Style>

            <Style x:Key="InvoiceGridCell" TargetType="DataGridCell" BasedOn="{StaticResource ListDataGridCell}">
                <Setter Property="Padding" Value="10,9"/>
            </Style>

            <Style x:Key="InvoiceSelectColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource SelectColumnHeader}">
                <Setter Property="Background"  Value="#6FAEFB"/>
                <Setter Property="BorderBrush" Value="#5FA0F2"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,20,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  <!-- "did you mean" fuzzy-match banner -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Page header: title (left) + compact clickable summary cards (right) ═ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="8" Background="#E9F2FF" Margin="0,0,12,0">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Invoice Reports" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Browse, report on, and manage software/service invoices" Style="{StaticResource PageSubtitle}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsAllCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding TotalCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#4E9AFC"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueText}" Foreground="#4E9AFC"/>
                            <TextBlock Text="TOTAL" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsExpiredCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ExpiredCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#E74C3C"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ExpiredCount}" Style="{StaticResource StatValueText}" Foreground="#E74C3C"/>
                            <TextBlock Text="EXPIRED" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsExpiringCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ExpiringCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#E67E22"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ExpiringCount}" Style="{StaticResource StatValueText}" Foreground="#E67E22"/>
                            <TextBlock Text="EXPIRING (≤90)" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Background="{Binding IsActiveCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ActiveCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#2ECC71"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource StatValueText}" Foreground="#2ECC71"/>
                            <TextBlock Text="ACTIVE" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource StatCardShell}" Margin="0" Background="{Binding IsNoEndDateCardActive, Converter={StaticResource BoolToCardBrush}}">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding NoEndDateCardCommand}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="#787878"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                            <TextBlock Text="{Binding NoEndDateCount}" Style="{StaticResource StatValueText}" Foreground="#787878"/>
                            <TextBlock Text="NO END DATE" Style="{StaticResource StatLabelText}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ══ Action bar: primary actions + Search + Advanced Filters (left), Refresh (right) ═ -->
        <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="16,12" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Primary action -->
                    <Button Style="{StaticResource PrimaryBtn}" Command="{Binding GenerateReportCommand}">
                        <TextBlock Text="📄  Generate Report"/>
                    </Button>

                    <!-- Generate Sheet button hidden per request
                    <Button Command="{Binding GenerateSheetCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                                <Setter Property="Background" Value="#27AE60"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="📊  Generate Sheet"/>
                    </Button>
                    -->


                    <!-- Universal actions: operate on checked row(s) rather than a per-row column.
                         Open/Edit require exactly one checked row; Delete supports checking many. -->
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding OpenCommand}" Margin="16,0,8,8">
                        <TextBlock Text="🔍  Open"/>
                    </Button>
                    <Button Style="{StaticResource SmallBtn}" Command="{Binding EditCommand}">
                        <TextBlock Text="✎  Edit"/>
                    </Button>
                    <Button Style="{StaticResource DangerBtn}" Command="{Binding DeleteCommand}" Margin="0,0,8,8">
                        <TextBlock Text="🗑  Delete"/>
                    </Button>
                    <!-- Search -->
                    <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                            CornerRadius="5" Background="White" Height="30" Width="220" Margin="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#7A8A9A"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="11"
                                     VerticalContentAlignment="Center" Padding="0,0,10,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Search by Document #, Reference #, Company, Status, Created By, Item, Serial #..."/>
                        </Grid>
                    </Border>

                    <!-- Advanced Filters -->
                    <ToggleButton x:Name="AdvancedFiltersToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                  Width="140" Height="30" Margin="0,0,8,8" Content="Advanced Filters"/>
                    <Popup PlacementTarget="{Binding ElementName=AdvancedFiltersToggle}"
                           IsOpen="{Binding IsChecked, ElementName=AdvancedFiltersToggle, Mode=TwoWay}"
                           StaysOpen="False" Placement="Bottom" helpers:PopupPlacementHelper.ClampToWorkArea="True"
                           HorizontalOffset="-820" AllowsTransparency="True">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                CornerRadius="8" Padding="18" Width="960">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Advanced Filters" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ActiveFiltersText}" FontSize="9.5" FontStyle="Italic"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                                <!-- Capped so the popup can never grow past the screen/taskbar; scrolls internally instead. -->
                                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0" Padding="0,0,14,0">
                                <StackPanel>

                                <!-- Row 1: Filter By / Sort By / Rows -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Filter By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding FilterByOptions}"
                                                  SelectedItem="{Binding SelectedFilterBy, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Sort By" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="SortByCombo" Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding SortByOptions}"
                                                  SelectedItem="{Binding SelectedSortBy, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Rows" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding PageSizeOptions}"
                                                  SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: From / To / Timeline -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="From" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding FromDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="To" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding ToDate, Mode=TwoWay}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Timeline" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ComboBox Style="{StaticResource FilterCombo}" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding QuickRangeOptions}"
                                                  SelectedItem="{Binding SelectedQuickRange, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Document Date (one or more rows, OR'd together) -->
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Document Date" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding VisibleDocumentDateFilterRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <ComboBox Style="{StaticResource FilterCombo}" Width="150" Margin="0,0,8,0"
                                                              ItemsSource="{Binding MonthOptions}"
                                                              SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
                                                              ToolTip="Month"/>
                                                    <ComboBox Style="{StaticResource FilterCombo}" Width="100" Margin="0,0,8,0"
                                                              ItemsSource="{Binding DayOptions}"
                                                              SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                                              ToolTip="Day"/>
                                                    <ComboBox Style="{StaticResource FilterCombo}" Width="120" Margin="0,0,8,0"
                                                              ItemsSource="{Binding YearOptions}"
                                                              SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                                                              ToolTip="Year"/>
                                                    <Button Style="{StaticResource SmallBtn}" Command="{Binding RemoveCommand}" Margin="0"
                                                            ToolTip="Remove this date row" Padding="8,0">
                                                        <TextBlock Text="✕"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button HorizontalAlignment="Left" Style="{StaticResource SmallBtn}" Command="{Binding AddDocumentDateRowCommand}" Margin="0"
                                            Visibility="{Binding HasMoreDocumentDateFilterRows, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="➕  Add Date Row"/>
                                    </Button>
                                    <TextBlock Visibility="{Binding HasMoreDocumentDateFilterRows, Converter={StaticResource BoolToVis}}"
                                               HorizontalAlignment="Left" Cursor="Hand" FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                                               TextDecorations="Underline" MouseLeftButtonUp="MoreDocumentDates_Click">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="More ({0} more)">
                                                <Binding Path="MoreDocumentDateFilterRowsCount"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Row 4: Category / Item Type / Sub-Type -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Category" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ToggleButton x:Name="CategoryFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                                      HorizontalAlignment="Stretch" Content="{Binding CategoryFilterSummary}"/>
                                        <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                                               IsOpen="{Binding IsChecked, ElementName=CategoryFilterToggle, Mode=TwoWay}"
                                               StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8" MinWidth="200">
                                                <StackPanel>
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                              Padding="4,0" Margin="2,4" FontSize="11"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <Separator Margin="0,6,0,4"/>
                                                    <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                            Style="{StaticResource SmallBtn}" Margin="0"
                                                            Command="{Binding ClearCategoryFilterCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="Item Type" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ToggleButton x:Name="ItemTypeFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                                      HorizontalAlignment="Stretch" Content="{Binding ItemTypeFilterSummary}"/>
                                        <Popup PlacementTarget="{Binding ElementName=ItemTypeFilterToggle}"
                                               IsOpen="{Binding IsChecked, ElementName=ItemTypeFilterToggle, Mode=TwoWay}"
                                               StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8" MinWidth="200">
                                                <StackPanel>
                                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                                        <ItemsControl ItemsSource="{Binding ItemTypeFilterOptions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                              Padding="4,0" Margin="2,4" FontSize="11"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <Separator Margin="0,6,0,4"/>
                                                    <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                            Style="{StaticResource SmallBtn}" Margin="0"
                                                            Command="{Binding ClearItemTypeFilterCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Sub-Type" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <ToggleButton x:Name="SubTypeFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                                      HorizontalAlignment="Stretch" Content="{Binding SubTypeFilterSummary}"/>
                                        <Popup PlacementTarget="{Binding ElementName=SubTypeFilterToggle}"
                                               IsOpen="{Binding IsChecked, ElementName=SubTypeFilterToggle, Mode=TwoWay}"
                                               StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                                    CornerRadius="4" Padding="8" MinWidth="200">
                                                <StackPanel>
                                                    <CheckBox Content="Non-Subtype" IsChecked="{Binding SubTypeFilterNonSubType, Mode=TwoWay}"
                                                              Padding="4,0" Margin="2,4" FontSize="11"/>
                                                    <Separator Margin="0,4,0,4"/>
                                                    <CheckBox Content="Subtype" IsChecked="{Binding SubTypeFilterAnySubtype, Mode=TwoWay}"
                                                              Padding="4,0" Margin="2,4" FontSize="11" FontWeight="Bold"
                                                              ToolTip="Any invoice with a Sub-Type item, unspecified which"/>
                                                    <CheckBox Content="Contract" IsChecked="{Binding SubTypeFilterContract, Mode=TwoWay}"
                                                              Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                    <CheckBox Content="Subscription" IsChecked="{Binding SubTypeFilterSubscription, Mode=TwoWay}"
                                                              Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                    <CheckBox Content="License" IsChecked="{Binding SubTypeFilterLicense, Mode=TwoWay}"
                                                              Padding="4,0" Margin="18,2,2,2" FontSize="11"/>
                                                    <CheckBox Content="Services" IsChecked="{Binding SubTypeFilterServices, Mode=TwoWay}"
                                                              Padding="4,0" Margin="18,2,2,4" FontSize="11"/>
                                                    <Separator Margin="0,6,0,4"/>
                                                    <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                                            Style="{StaticResource SmallBtn}" Margin="0"
                                                            Command="{Binding ClearSubTypeFilterCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SET / INVOICE" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Set Code | Document # | Company | Department | Branch | Employee -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Set Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding SetCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Document #" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DocumentNumberFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Company" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding CompanyFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="6">
                                        <TextBlock Text="Department" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding DepartmentFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="8">
                                        <TextBlock Text="Branch" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding BranchFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="10">
                                        <TextBlock Text="Employee" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding EmployeeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <!-- Row 2: Reference Code | Parent Tag -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Reference Code" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReferenceCodeFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Parent Tag" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ParentTagFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="REQUEST" FontSize="10" FontWeight="Bold" Foreground="#8A97A6" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Req ID -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Req ID" Style="{StaticResource FilterLabel}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource SearchBox}" HorizontalAlignment="Stretch"
                                                 Text="{Binding ReqIdFilter, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                </StackPanel>
                                </ScrollViewer>

                                <Separator Margin="0,2,0,12"/>

                                <!-- Row 5: Reset Filters -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding ResetFiltersCommand}" ClickMode="Press" Margin="0">
                                        <TextBlock Text="↺  Reset Filters"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>

                <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                    <TextBlock Text="⟳  Refresh"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ Legend ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="Transparent" Padding="0,0,0,10">
            <WrapPanel>
                <TextBlock Text="Legend:" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="● Expired" FontSize="9" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,10,0"/>
                <TextBlock Text="● Critical (≤30)" FontSize="9" FontWeight="Bold" Foreground="#D35400" Margin="0,0,10,0"/>
                <TextBlock Text="● Warning (≤90)" FontSize="9" FontWeight="Bold" Foreground="#B7950B" Margin="0,0,10,0"/>
                <TextBlock Text="● Active" FontSize="9" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,10,0"/>
                <TextBlock Text="● No End Date" FontSize="9" FontWeight="Bold" Foreground="#787878" Margin="0,0,10,0"/>
            </WrapPanel>
        </Border>

        <!-- "Did you mean...?" banner — only shown when these rows came from the fuzzy fallback
             (FuzzyMatchInvoices) rather than an exact search-text match, so typo-corrected guesses
             are never presented as if they were literal hits. -->
        <Border Grid.Row="3" Padding="14,9" Margin="0,0,0,10"
                Background="#FFF8E6" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="6"
                Visibility="{Binding IsFuzzyResults, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D;" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FuzzyNoticeText}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="#7A5C00" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ Grid ═════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,20">
            <DataGrid x:Name="InvoicesGrid"
                      Style="{StaticResource ListDataGridChrome}"
                      ColumnHeaderStyle="{StaticResource InvoiceGridColumnHeader}"
                      CellStyle="{StaticResource InvoiceGridCell}"
                      MinRowHeight="42"
                      IsReadOnly="True"
                      EnableColumnVirtualization="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      ItemsSource="{Binding Rows}"
                      Sorting="InvoicesGrid_Sorting">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="44" MinWidth="44" CanUserResize="False" CanUserSort="False" HeaderStyle="{StaticResource InvoiceSelectColumnHeader}" CellStyle="{StaticResource SelectColumnCell}">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding DataContext.SelectAllState, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Mode=OneWay + explicit Click: a DataGridTemplateColumn CheckBox's
                                     TwoWay IsChecked binding does not reliably commit back to the row
                                     when clicked (WPF DataGridCell/virtualization quirk) — the box
                                     visually toggles but the bound property never updates. Reading the
                                     toggled state explicitly in Click and writing it back manually
                                     works reliably. -->
                                <CheckBox IsChecked="{Binding Selected, Mode=OneWay}" Click="RowCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Document No." Binding="{Binding DocumentNumber}" SortMemberPath="DocumentNumber" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Reference No." Binding="{Binding ReferenceNumber}" SortMemberPath="ReferenceNumber" Width="1.1*" MinWidth="100" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Document Date" Binding="{Binding DocumentDate, StringFormat='MM/dd/yyyy'}" SortMemberPath="DocumentDate" Width="*" MinWidth="95" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn SortMemberPath="StartDate" Binding="{Binding StartDate, StringFormat='MM/dd/yyyy'}" Width="*" MinWidth="95" ElementStyle="{StaticResource CenteredCellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Start Date" DockPanel.Dock="Left"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="StartDate" Click="DateColumnFilterButton_Click"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn SortMemberPath="EndDate" Binding="{Binding EndDateDisplay}" Width="*" MinWidth="95" ElementStyle="{StaticResource CenteredCellText}">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="End Date" DockPanel.Dock="Left"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource ColumnFilterButton}" Content="▾" Tag="EndDate" Click="DateColumnFilterButton_Click"/>
                                </DockPanel>
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Company" Binding="{Binding Company}" SortMemberPath="Company" Width="1.6*" MinWidth="140" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Distributor" Binding="{Binding Distributor}" SortMemberPath="Distributor" Width="1.6*" MinWidth="140" ElementStyle="{StaticResource WrappedCenteredCellText}"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="*" MinWidth="85" ElementStyle="{StaticResource CenteredCellText}"/>
                    <DataGridTextColumn Header="Date Added" Binding="{Binding CreatedAt, StringFormat='MM/dd/yyyy'}" SortMemberPath="CreatedAt" Width="*" MinWidth="95" ElementStyle="{StaticResource CenteredCellText}"/>

                    <DataGridTemplateColumn Header="Days Left" SortMemberPath="DaysLeft" Width="*" MinWidth="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DaysLeftDisplay}" FontSize="11" FontWeight="Bold"
                                           Foreground="{Binding DaysLeft, Converter={StaticResource DaysLeftToBrush}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ Totals bar ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="5" Background="Transparent" Padding="0,0,0,6">
            <TextBlock Text="{Binding TotalsText}" HorizontalAlignment="Right" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>

        <!-- ══ Footer / paging ══════════════════════════════════════════════ -->
        <Border Grid.Row="6" Background="Transparent" Padding="0,0,0,16">
            <shared:PagingControl HorizontalAlignment="Left"
                                   FirstPageCommand="{Binding FirstPageCommand}"
                                   PrevPageCommand="{Binding PrevPageCommand}"
                                   NextPageCommand="{Binding NextPageCommand}"
                                   LastPageCommand="{Binding LastPageCommand}"
                                   PageInfoText="{Binding PageInfoText}"/>
        </Border>
    </Grid>
</UserControl>
