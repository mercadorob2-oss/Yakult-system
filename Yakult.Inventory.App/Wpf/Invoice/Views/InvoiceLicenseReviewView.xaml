<UserControl x:Class="Yakult.Inventory.App.WPF.Invoice.Views.InvoiceLicenseReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Yakult.Inventory.App.WPF.CartridgeManagement.Converters"
             xmlns:local="clr-namespace:Yakult.Inventory.App.WPF.Invoice.Views"
             xmlns:shared="clr-namespace:Yakult.Inventory.App.WPF.Shared.Controls"
             Background="#F0F2F6"
             FontFamily="Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/ListPageStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
            <local:PendingDecisionToBrushConverter x:Key="PendingDecisionToBrush"/>

            <Style x:Key="SectionCard" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius"    Value="10"/>
            </Style>

            <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{StaticResource TextMutedBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin"          Value="0"/>
            </Style>

            <Style x:Key="CenteredCellText" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Review-queue grid row: tint background while a classification decision is
                 staged but not yet saved, so pending work is obviously visible at a glance. -->
            <Style x:Key="ReviewGridRow" TargetType="DataGridRow" BasedOn="{StaticResource ListDataGridRow}">
                <Setter Property="Background" Value="{Binding PendingDecision, Converter={StaticResource PendingDecisionToBrush}}"/>
            </Style>

            <!-- Drop-target panel shell shared by both classification panels. -->
            <Style x:Key="DropPanelShell" TargetType="Border">
                <Setter Property="Background"      Value="White"/>
                <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush1}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="CornerRadius"    Value="10"/>
                <Setter Property="Padding"         Value="12"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="20,20,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.3*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.7*" MinHeight="260"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Page header + action panel, side by side ═══════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#FFF1E0" Margin="0,0,12,0">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="#D08A1E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Invoice License Review" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,3,0,0">
                            <Run Text="Review hardware invoice lines not yet classified as licensed or non-licensed —"/>
                            <Run Text=" "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" pending"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- ══ Action panel: search + filters + refresh + preview ═══════ -->
                <Border Grid.Column="1" Style="{StaticResource SectionCard}" Padding="16,10" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- Search -->
                        <Border BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                CornerRadius="5" Background="White" Height="30" Width="260" Margin="0,0,8,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#7A8A9A"/>
                                <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" FontSize="11"
                                         VerticalContentAlignment="Center" Padding="0,0,10,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Search by Invoice #, Item, Category, Company, Department, Employee, Vendor..."/>
                            </Grid>
                        </Border>

                        <!-- Category filter -->
                        <ToggleButton x:Name="CategoryFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                      Width="160" Height="30" Margin="0,0,8,8" Content="{Binding CategoryFilterSummary}"/>
                        <Popup PlacementTarget="{Binding ElementName=CategoryFilterToggle}"
                               IsOpen="{Binding IsChecked, ElementName=CategoryFilterToggle, Mode=TwoWay}"
                               StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                    CornerRadius="4" Padding="8" MinWidth="200">
                                <StackPanel>
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CategoryFilterOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Padding="4,0" Margin="2,4" FontSize="11"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Separator Margin="0,6,0,4"/>
                                    <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                            Style="{StaticResource SmallBtn}" Margin="0"
                                            Command="{Binding ClearCategoryFilterCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- Item Type filter -->
                        <ToggleButton x:Name="ItemTypeFilterToggle" Style="{StaticResource CategoryFilterToggleBtn}"
                                      Width="160" Height="30" Margin="0,0,8,8" Content="{Binding ItemTypeFilterSummary}"/>
                        <Popup PlacementTarget="{Binding ElementName=ItemTypeFilterToggle}"
                               IsOpen="{Binding IsChecked, ElementName=ItemTypeFilterToggle, Mode=TwoWay}"
                               StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1"
                                    CornerRadius="4" Padding="8" MinWidth="200">
                                <StackPanel>
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ItemTypeFilterOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                              Padding="4,0" Margin="2,4" FontSize="11"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <Separator Margin="0,6,0,4"/>
                                    <Button Content="Clear" HorizontalAlignment="Left" Padding="10,0"
                                            Style="{StaticResource SmallBtn}" Margin="0"
                                            Command="{Binding ClearItemTypeFilterCommand}"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button Style="{StaticResource SmallBtn}" Click="PreviewButton_Click" Margin="8,0,8,8">
                            <TextBlock Text="🔍  Preview Invoice"/>
                        </Button>
                    </WrapPanel>

                    <Button Grid.Column="1" Style="{StaticResource SmallBtn}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="0">
                        <TextBlock Text="⟳  Refresh"/>
                    </Button>
                </Grid>
                </Border>
            </Grid>

            <!-- ══ Grid ═════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="0" Margin="0,0,0,16">
                <DataGrid x:Name="ReviewGrid"
                          Style="{StaticResource ListDataGridChrome}"
                          RowStyle="{StaticResource ReviewGridRow}"
                          MinRowHeight="38"
                          IsReadOnly="True"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          ItemsSource="{Binding Rows}"
                          PreviewMouseLeftButtonDown="ReviewGrid_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="ReviewGrid_PreviewMouseMove">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#B8CEED"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A2333"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CDD8EE"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A2333"/>
                    </DataGrid.Resources>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Mark as Licensed" Click="MarkAsLicensedMenuItem_Click"/>
                            <MenuItem Header="Mark as Non-Licensed" Click="MarkAsNonLicensedMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="Preview Invoice" Click="PreviewButton_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="1.1*" MinWidth="90"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat='MM/dd/yyyy'}" Width="0.8*" MinWidth="85" ElementStyle="{StaticResource CenteredCellText}"/>
                        <!-- Every category found anywhere on this invoice, not just this row's own
                             item — the per-row Category column was redundant with this and was removed. -->
                        <DataGridTextColumn Header="Categories on Invoice" Binding="{Binding CategoriesOnInvoiceDisplay}" Width="1.5*" MinWidth="140" ElementStyle="{StaticResource WrapCellText}"/>
                        <DataGridTextColumn Header="Item Types on Invoice" Binding="{Binding ItemTypesOnInvoiceDisplay}" Width="1.5*" MinWidth="140" ElementStyle="{StaticResource WrapCellText}"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N0}" Width="0.55*" MinWidth="55" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.6*" MinWidth="60" ElementStyle="{StaticResource CenteredCellText}"/>
                        <!-- The whole invoice's total (dbo.[Set].TotalAmountDue), not a per-line
                             amount — the same figure repeats across every pending row that shares
                             an Invoice #, since this page classifies items, not invoice financials. -->
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding InvoiceTotalAmount, StringFormat=N2}" Width="1*" MinWidth="100" ElementStyle="{StaticResource CenteredCellText}"/>
                        <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource WrapCellText}"/>
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource WrapCellText}"/>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource WrapCellText}"/>
                        <DataGridTextColumn Header="Vendor" Binding="{Binding VendorName}" Width="1.2*" MinWidth="100" ElementStyle="{StaticResource WrapCellText}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding PendingDecisionDisplay}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource CenteredCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ══ Pagination + classification instructions ═══════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Drag selected row(s) here to classify, or right-click / use the buttons above."
                           Style="{StaticResource PageSubtitle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Rows:" Style="{StaticResource FilterLabel}" VerticalAlignment="Center"/>
                    <ComboBox Style="{StaticResource FilterCombo}" Width="70" Margin="0,0,12,0"
                              ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize, Mode=TwoWay}"/>
                    <shared:PagingControl FirstPageCommand="{Binding FirstPageCommand}"
                                           PrevPageCommand="{Binding PrevPageCommand}"
                                           NextPageCommand="{Binding NextPageCommand}"
                                           LastPageCommand="{Binding LastPageCommand}"
                                           PageInfoText="{Binding PageInfoText}"/>
                </StackPanel>
            </Grid>

            <!-- ══ Two drop panels ══════════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Non-Licensed -->
                <Border x:Name="NonLicensedDropPanel" Grid.Column="0" Style="{StaticResource DropPanelShell}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        AllowDrop="True" DragEnter="DropPanel_DragEnter" DragLeave="DropPanel_DragLeave" Drop="NonLicensedDropPanel_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Non-Licensed Hardware Invoices" FontWeight="Bold" FontSize="13" Foreground="{StaticResource DangerBrush}"/>
                            <Border Background="{StaticResource DangerBgBrush}" CornerRadius="9" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding PendingNonLicensedCount}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                            </Border>
                            <Button Style="{StaticResource DangerBtn}" Margin="12,0,0,0" Click="MarkAsNonLicensedMenuItem_Click">
                                <TextBlock Text="Mark Selected as Non-Licensed" FontSize="10"/>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#FDECEA" CornerRadius="6" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PendingNonLicensedRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="5" Padding="8,5" Margin="0,0,0,4" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ItemName}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Click="UndoPendingRow_Click"
                                                            Padding="6,0" Margin="0" ToolTip="Undo this pending change">
                                                        <TextBlock Text="✕" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: Licensed -->
                <Border x:Name="LicensedDropPanel" Grid.Column="2" Style="{StaticResource DropPanelShell}"
                        BorderBrush="{StaticResource SuccessBrush}"
                        AllowDrop="True" DragEnter="DropPanel_DragEnter" DragLeave="DropPanel_DragLeave" Drop="LicensedDropPanel_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Licensed Hardware Invoices" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SuccessBrush}"/>
                            <Border Background="#E3F6EC" CornerRadius="9" Padding="7,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding PendingLicensedCount}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <Button Margin="12,0,0,0" Click="MarkAsLicensedMenuItem_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SmallBtn}">
                                        <Setter Property="Background" Value="#E3F6EC"/>
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Mark Selected as Licensed" FontSize="10"/>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#EEFAF3" CornerRadius="6" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PendingLicensedRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" CornerRadius="5" Padding="8,5" Margin="0,0,0,4" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ItemName}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource GhostBtn}" Click="UndoPendingRow_Click"
                                                            Padding="6,0" Margin="0" ToolTip="Undo this pending change">
                                                        <TextBlock Text="✕" FontSize="10"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ Footer: Undo / Save ══════════════════════════════════════ -->
            <Border Grid.Row="4" Background="Transparent" Padding="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Nothing is saved to the database until you click"/>
                        <Run Text=" Save Changes." FontWeight="Bold"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource SmallBtn}" Command="{Binding UndoChangesCommand}" Margin="0,0,8,0">
                            <TextBlock Text="↺  Undo Changes"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryBtn}" Command="{Binding SaveChangesCommand}" Margin="0">
                            <TextBlock Text="💾  Save Changes"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Busy overlay ═════════════════════════════════════════════════ -->
        <Border Background="#B3FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" CornerRadius="10" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrush1}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#1A2333"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding BusyMessage}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
