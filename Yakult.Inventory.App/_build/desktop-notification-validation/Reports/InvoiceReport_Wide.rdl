                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>=IIF(Fields!RightName.Value = "", "White", "#1e293b")</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                        <Style>
