  <DataSets>
    <DataSet Name="InvoiceData">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT
  vw_InvoiceItems.DocumentDate
  ,vw_InvoiceItems.SetCode
  ,vw_InvoiceItems.ItemId
  ,vw_InvoiceItems.Status
  ,vw_InvoiceItems.Subtotal
  ,vw_InvoiceItems.VatAmount
  ,vw_InvoiceItems.WhtAmount
  ,vw_InvoiceItems.DiscountAmount
  ,vw_InvoiceItems.TotalAmountDue
  ,vw_InvoiceItems.DocumentNumber
  ,vw_InvoiceItems.ReferenceNumber
  ,vw_InvoiceItems.StartDate
  ,vw_InvoiceItems.EndDate
  ,vw_InvoiceItems.Site
  ,vw_InvoiceItems.CompanyName
  ,vw_InvoiceItems.Quantity
  ,vw_InvoiceItems.ItemDescription
  ,vw_InvoiceItems.ItemName
  ,vw_InvoiceItems.ModelNumber
  ,vw_InvoiceItems.LineTotal
  ,vw_InvoiceItems.Year
  ,vw_InvoiceItems.Month
FROM
  vw_InvoiceItems</CommandText>
      </Query>
