<?xml version="1.0" encoding="utf-8"?>
<!--
  RepairReportBatch.rdlc
  ══════════════════════════════════════════════════════════════════════
  Multi-ticket Repair Report, GROUPED BY REQUESTER. Bound to ONE flat
  dataset ("RepairReportBatchItems", one row per selected ticket) built
  by Helpers/RepairReportBuilder.BuildBatchTable.

  STRUCTURAL PRINCIPLE: this is RepairReport.rdlc's FULL single-ticket
  content (Asset Information / Reported Problem / Repair Details / Work
  Performed / Parts / Diagnosis & Resolution / Recommendations /
  Attachments — every field, unabridged) repeated once per item WITHIN
  a requester group, not a simplified summary. Two levels of grouping:
  outer "RequesterGroup" (by GroupIndex, one PAGE-BROKEN copy per
  requester), inner "ItemDetails" (by ticket, one full detail block per
  item belonging to that requester) — the same nested-grouping technique
  this codebase's own WarrantyReport.rdlc already uses for Year→Month,
  just Group→Item here. Two top-level TablixColumns (90mm each) so the
  Asset Info fields pair up exactly like RepairReport.rdlc's AssetC1-C8.

  Each group opens with the same Report No./Repair ID/Status/Date header
  block RepairReport.rdlc uses (reproduced in the Body since a Page
  Header can't vary per group — see RectGroupPageHeader) plus a
  Requester Information line, then one full detail block per item, then
  ONE shared Signatures block for the whole group.
  A4 portrait.
  ══════════════════════════════════════════════════════════════════════
-->
<Report MustUnderstand="df"
        xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
        xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>b7e1a2c3-2222-4a7b-8c9d-000000000020</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="RepairReportBatchItems">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>/* Provided at runtime via ReportDataSource */</CommandText>
      </Query>
      <Fields>
        <Field Name="GroupIndex">              <DataField>GroupIndex</DataField>              <rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="GroupCount">              <DataField>GroupCount</DataField>              <rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="GroupMetaBoldLine">       <DataField>GroupMetaBoldLine</DataField>       <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="GroupMetaRestLines">      <DataField>GroupMetaRestLines</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="RequesterInfoText">       <DataField>RequesterInfoText</DataField>       <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PreparedByName">          <DataField>PreparedByName</DataField>          <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PreparedByPosition">      <DataField>PreparedByPosition</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PreparedByDateText">      <DataField>PreparedByDateText</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReviewedByName">          <DataField>ReviewedByName</DataField>          <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReviewedByPosition">      <DataField>ReviewedByPosition</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReviewedByDateText">      <DataField>ReviewedByDateText</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReceivedByName">          <DataField>ReceivedByName</DataField>          <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReceivedByPosition">      <DataField>ReceivedByPosition</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReceivedByDateText">      <DataField>ReceivedByDateText</DataField>      <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ItemTitleText">           <DataField>ItemTitleText</DataField>           <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetL1">                 <DataField>AssetL1</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetR1">                 <DataField>AssetR1</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetL2">                 <DataField>AssetL2</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetR2">                 <DataField>AssetR2</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetL3">                 <DataField>AssetL3</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetR3">                 <DataField>AssetR3</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetL4">                 <DataField>AssetL4</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AssetR4">                 <DataField>AssetR4</DataField>                 <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowReportedProblem">     <DataField>ShowReportedProblem</DataField>     <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="ProblemText">             <DataField>ProblemText</DataField>             <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DetailsText">              <DataField>DetailsText</DataField>              <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowWorkPerformed">       <DataField>ShowWorkPerformed</DataField>       <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="WorkPerformedText">       <DataField>WorkPerformedText</DataField>       <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowParts">               <DataField>ShowParts</DataField>               <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="PartsText">               <DataField>PartsText</DataField>               <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowDiagnosis">           <DataField>ShowDiagnosis</DataField>           <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="DiagnosisText">           <DataField>DiagnosisText</DataField>           <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowItemDisposition">     <DataField>ShowItemDisposition</DataField>     <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="ItemDispositionText">     <DataField>ItemDispositionText</DataField>     <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowRecommendations">     <DataField>ShowRecommendations</DataField>     <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="RecommendationsText">     <DataField>RecommendationsText</DataField>     <rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ShowAttachments">         <DataField>ShowAttachments</DataField>         <rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="AttachmentsPreviewImage"> <DataField>AttachmentsPreviewImage</DataField> <rd:TypeName>System.Byte[]</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>

          <Tablix Name="BatchTablix">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>90mm</Width></TablixColumn>
                <TablixColumn><Width>90mm</Width></TablixColumn>
              </TablixColumns>

              <TablixRows>

                <!-- R1: full reproduction of RepairReport.rdlc's Page Header block — company
                     name/dept LEFT, Report No./Repair ID/Status/Date metadata as a second column
                     RIGHT (same Top=0 row, Left=95mm), "Repair Report" title full-width below both,
                     then the divider. Reproduced once per requester group in the Body instead of a
                     global Page Header, purely because the metadata varies per group. -->
                <TablixRow>
                  <Height>30mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Rectangle Name="RectGroupPageHeader">
                        <ReportItems>
                          <Textbox Name="TxtCompanyName">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Yakult Philippines Inc.</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#DC2626</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>0mm</Top><Left>0mm</Left><Height>5mm</Height><Width>90mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="TxtDeptName">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Information Technology Dept.</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>4.5mm</Top><Left>0mm</Left><Height>4mm</Height><Width>90mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="TxtGroupMeta">
                            <CanGrow>true</CanGrow>
                            <Paragraphs><Paragraph><TextRuns>
                              <TextRun>
                                <Value>=Fields!GroupMetaBoldLine.Value</Value>
                                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                              </TextRun>
                              <TextRun>
                                <Value>=Fields!GroupMetaRestLines.Value</Value>
                                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>#334155</Color></Style>
                              </TextRun>
                            </TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>0mm</Top><Left>95mm</Left><Height>22mm</Height><Width>85mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="TxtReportTitle">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Repair Report</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>13pt</FontSize><FontWeight>Bold</FontWeight><Color>#2563EB</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>23mm</Top><Left>0mm</Left><Height>6mm</Height><Width>180mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="TxtRule">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value /></TextRun></TextRuns></Paragraph></Paragraphs>
                            <Top>29mm</Top><Left>0mm</Left><Height>1mm</Height><Width>180mm</Width>
                            <Style><Border><Style>None</Style></Border>
                              <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1.5pt</Width></TopBorder></Style>
                          </Textbox>
                        </ReportItems>
                        <Top>0mm</Top><Left>0mm</Left><Height>30mm</Height><Width>180mm</Width>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Rectangle>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R2: REQUESTER INFORMATION -->
                <TablixRow>
                  <Height>13mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtRequesterInfo">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!RequesterInfoText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R3: item title bar (per item) -->
                <TablixRow>
                  <Height>8mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtItemTitle">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!ItemTitleText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#0f172a</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#2563EB</Color><Style>Solid</Style><Width>1.5pt</Width></TopBorder>
                          <PaddingTop>4pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R4: ASSET INFORMATION header -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrAsset">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>ASSET INFORMATION</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R5-R8: Asset Info paired fields (2 real columns, matches RepairReport.rdlc) -->
                <TablixRow>
                  <Height>5.5mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="AssetC1"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetL1.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="AssetC2"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetR1.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>5.5mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="AssetC3"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetL2.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="AssetC4"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetR2.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>5.5mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="AssetC5"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetL3.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="AssetC6"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetR3.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="AssetC7"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetL4.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop><PaddingBottom>3pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="AssetC8"><CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AssetR4.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                      </TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style><Border><Style>None</Style></Border><PaddingTop>1pt</PaddingTop><PaddingBottom>3pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- R9-R10: REPORTED PROBLEM (only if data) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrProblem">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>REPORTED PROBLEM</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtProblem">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!ProblemText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><Color>#0f172a</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R11-R12: REPAIR DETAILS (always) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrDetails">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>REPAIR DETAILS</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>22mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtDetails">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!DetailsText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R13-R14: WORK PERFORMED (only if data) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrWork">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>WORK PERFORMED</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtWork">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!WorkPerformedText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R15-R16: PARTS (only if data) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrParts">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>PARTS</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtParts">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!PartsText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R17-R18: DIAGNOSIS & RESOLUTION (only if data) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrDiagnosis">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>DIAGNOSIS &amp; RESOLUTION</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>12mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtDiagnosis">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!DiagnosisText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R18b-R18c: ITEM DISPOSITION (only if Spare assigned and/or Replace disposition) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrItemDisposition">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>ITEM DISPOSITION</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtItemDisposition">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!ItemDispositionText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R19-R20: RECOMMENDATIONS (only if data) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrRecommendations">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>RECOMMENDATIONS</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>10mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="TxtRecommendations">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!RecommendationsText.Value</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><Color>#334155</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border><PaddingBottom>4pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R21: ATTACHMENTS header (only if this item has any) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrAttachments">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>ATTACHMENTS</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R22: Attachments preview — every image attachment for THIS item composited into
                     one montage image (RepairReportBuilder.BuildAttachmentsMontage), no filenames. -->
                <TablixRow>
                  <Height>62mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Image Name="ImgAttachmentsPreview">
                        <Source>Database</Source>
                        <Value>=Fields!AttachmentsPreviewImage.Value</Value>
                        <MIMEType>image/jpeg</MIMEType>
                        <Sizing>FitProportional</Sizing>
                        <Top>0mm</Top><Left>0mm</Left><Height>60mm</Height><Width>170mm</Width>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Image>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R23: SIGNATURES header (once per requester group, not per item) -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>
                      <Textbox Name="HdrSignatures">
                        <CanGrow>true</CanGrow>
                        <Paragraphs><Paragraph><TextRuns><TextRun><Value>SIGNATURES</Value>
                          <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                        </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                        <Style><Border><Style>None</Style></Border>
                          <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>1pt</Width></TopBorder>
                          <PaddingTop>3pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                      </Textbox>
                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- R24: SIGNATURES block (once per requester group). Each column, top to bottom:
                     signature line, NAME (bold), Position, plain role word (no parenthetical), then
                     the actual signed date (picked via RepairSignatoryPickerWindow's own DatePicker)
                     instead of a blank fill-in line. -->
                <TablixRow>
                  <Height>33mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents>

                      <Rectangle Name="RectGroupSignatures">
                        <ReportItems>
                          <Textbox Name="SigNamePrepared">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PreparedByName.Value</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>12mm</Top><Left>0mm</Left><Height>5mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border>
                              <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><VerticalAlign>Middle</VerticalAlign></Style>
                          </Textbox>
                          <Textbox Name="SigPositionPrepared">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!PreparedByPosition.Value</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#334155</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>17mm</Top><Left>0mm</Left><Height>4mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="SigRolePrepared">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Prepared By</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>21mm</Top><Left>0mm</Left><Height>4mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="SigDatePrepared">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun>
                              <Value>=IIF(Fields!PreparedByDateText.Value = "", "Date: ____________________", "Date: " &amp; Fields!PreparedByDateText.Value)</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>26mm</Top><Left>0mm</Left><Height>5mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>

                          <Textbox Name="SigNameReviewed">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ReviewedByName.Value</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>12mm</Top><Left>62mm</Left><Height>5mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border>
                              <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><VerticalAlign>Middle</VerticalAlign></Style>
                          </Textbox>
                          <Textbox Name="SigPositionReviewed">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ReviewedByPosition.Value</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#334155</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>17mm</Top><Left>62mm</Left><Height>4mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="SigRoleReviewed">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Reviewed By</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>21mm</Top><Left>62mm</Left><Height>4mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="SigDateReviewed">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun>
                              <Value>=IIF(Fields!ReviewedByDateText.Value = "", "Date: ____________________", "Date: " &amp; Fields!ReviewedByDateText.Value)</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>26mm</Top><Left>62mm</Left><Height>5mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>

                          <Textbox Name="SigNameReceived">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ReceivedByName.Value</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#1e293b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>12mm</Top><Left>124mm</Left><Height>5mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border>
                              <TopBorder><Color>#1e293b</Color><Style>Solid</Style><Width>0.5pt</Width></TopBorder><VerticalAlign>Middle</VerticalAlign></Style>
                          </Textbox>
                          <Textbox Name="SigPositionReceived">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ReceivedByPosition.Value</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#334155</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>17mm</Top><Left>124mm</Left><Height>4mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="SigRoleReceived">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Received By</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>21mm</Top><Left>124mm</Left><Height>4mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                          <Textbox Name="SigDateReceived">
                            <CanGrow>false</CanGrow>
                            <Paragraphs><Paragraph><TextRuns><TextRun>
                              <Value>=IIF(Fields!ReceivedByDateText.Value = "", "Date: ____________________", "Date: " &amp; Fields!ReceivedByDateText.Value)</Value>
                              <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><Color>#64748b</Color></Style>
                            </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                            <Top>26mm</Top><Left>124mm</Left><Height>5mm</Height><Width>56mm</Width>
                            <Style><Border><Style>None</Style></Border></Style>
                          </Textbox>
                        </ReportItems>
                        <Top>0mm</Top><Left>0mm</Left><Height>33mm</Height><Width>180mm</Width>
                        <Style><Border><Style>None</Style></Border></Style>
                      </Rectangle>

                      <ColSpan>2</ColSpan>
                    </CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers><TablixMember /><TablixMember /></TablixMembers>
            </TablixColumnHierarchy>

            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="RequesterGroup">
                    <GroupExpressions><GroupExpression>=Fields!GroupIndex.Value</GroupExpression></GroupExpressions>
                    <PageBreak><BreakLocation>Between</BreakLocation></PageBreak>
                  </Group>
                  <SortExpressions><SortExpression><Value>=Fields!GroupIndex.Value</Value></SortExpression></SortExpressions>
                  <TablixMembers>
                    <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>  <!-- R1  Page header block -->
                    <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>  <!-- R2  Requester info -->
                    <TablixMember>
                      <!-- Inner group: one full detail block per item within this requester. -->
                      <Group Name="ItemDetails" />
                      <TablixMembers>
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>  <!-- R3  Item title -->
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>  <!-- R4  Asset header -->
                        <TablixMember /><TablixMember /><TablixMember /><TablixMember />   <!-- R5-R8  Asset fields -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowReportedProblem.Value)</Hidden></Visibility></TablixMember> <!-- R9 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowReportedProblem.Value)</Hidden></Visibility></TablixMember> <!-- R10 -->
                        <TablixMember />                                                                                     <!-- R11 Details header -->
                        <TablixMember />                                                                                     <!-- R12 Details text -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowWorkPerformed.Value)</Hidden></Visibility></TablixMember>   <!-- R13 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowWorkPerformed.Value)</Hidden></Visibility></TablixMember>   <!-- R14 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowParts.Value)</Hidden></Visibility></TablixMember>           <!-- R15 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowParts.Value)</Hidden></Visibility></TablixMember>           <!-- R16 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowDiagnosis.Value)</Hidden></Visibility></TablixMember>       <!-- R17 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowDiagnosis.Value)</Hidden></Visibility></TablixMember>       <!-- R18 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowItemDisposition.Value)</Hidden></Visibility></TablixMember> <!-- R18b -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowItemDisposition.Value)</Hidden></Visibility></TablixMember> <!-- R18c -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowRecommendations.Value)</Hidden></Visibility></TablixMember> <!-- R19 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowRecommendations.Value)</Hidden></Visibility></TablixMember> <!-- R20 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowAttachments.Value)</Hidden></Visibility></TablixMember>     <!-- R21 -->
                        <TablixMember><Visibility><Hidden>=Not(Fields!ShowAttachments.Value)</Hidden></Visibility></TablixMember>     <!-- R22 -->
                      </TablixMembers>
                    </TablixMember>
                    <TablixMember />  <!-- R23 Signatures header -->
                    <TablixMember />  <!-- R24 Signatures block -->
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

            <DataSetName>RepairReportBatchItems</DataSetName>
            <Top>0mm</Top><Left>0mm</Left>
            <Height>150mm</Height><Width>180mm</Width>
            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

        </ReportItems>
        <Height>150mm</Height>
        <Style><Border><Style>None</Style></Border></Style>
      </Body>

      <Width>180mm</Width>
      <Page>
        <!-- No global Page Header — the full company/title/metadata header block is reproduced
             once per requester group directly in the Body (RectGroupPageHeader, Row template 1)
             instead, since the Report No./Repair ID/Status/Date metadata varies per group and a
             Page Header cannot vary between groups. Each group already starts its own page via
             Group.PageBreak, so this still renders at the top of every page exactly like a repeating
             Page Header would. -->
        <PageHeight>29.7cm</PageHeight>
        <PageWidth>21cm</PageWidth>
        <LeftMargin>1.5cm</LeftMargin><RightMargin>1.5cm</RightMargin>
        <TopMargin>1.5cm</TopMargin><BottomMargin>1.5cm</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
