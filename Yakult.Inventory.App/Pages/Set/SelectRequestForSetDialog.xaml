<Window x:Class="Yakult.Inventory.App.Pages.Set.SelectRequestForSetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Request to Set"
        Width="1100" Height="660"
        MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <Style x:Key="FilterField" TargetType="TextBox">
            <Setter Property="Height"                   Value="28"/>
            <Setter Property="FontSize"                 Value="11.5"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#C8D2DC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#A9DFC2"/>
            <Setter Property="Foreground"      Value="#282828"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#B0C4DE"/>
            <Setter Property="Foreground" Value="#282828"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"               Value="#3498DB"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="FontWeight"               Value="Bold"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="Height"                   Value="36"/>
            <Setter Property="BorderBrush"              Value="#5AAFE5"/>
            <Setter Property="BorderThickness"          Value="0,0,1,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background"      Value="White"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F0F8FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#5DADE2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                Padding="6,3">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Calendar button override: replaces the "15" day-number with a 📅 icon ── -->
        <Style x:Key="CalBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Cursor="Hand" Padding="3,0">
                            <TextBlock Text="📅" FontSize="13" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Pagination nav button ─────────────────────────────────────────── -->
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Width"          Value="28"/>
            <Setter Property="Height"         Value="24"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"    Value="#C8D2DC"/>
            <Setter Property="Background"     Value="White"/>
            <Setter Property="Foreground"     Value="#3A4A5A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EAF4FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border CornerRadius="8" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- Title bar   -->
                <RowDefinition Height="46"/>   <!-- Filter bar  -->
                <RowDefinition Height="*"/>    <!-- Body        -->
                <RowDefinition Height="34"/>   <!-- Pagination  -->
                <RowDefinition Height="60"/>   <!-- Footer      -->
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ═══ -->
            <Border Grid.Row="0" Background="#3498DB" CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll">
                <DockPanel Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="✕" FontSize="13" FontWeight="Bold"
                               Foreground="#BDD9FF" Cursor="Hand" VerticalAlignment="Center"
                               Padding="8,0" MouseLeftButtonDown="OnCloseClick"/>
                    <TextBlock Text="Add Request to Set" FontSize="12" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ═══ FILTER BAR ═══ -->
            <Border Grid.Row="1" Background="#F5F8FC" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">

                    <TextBlock Text="Search:" VerticalAlignment="Center" FontSize="11"
                               Foreground="#4A5A6A" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtSearch" Width="240" Style="{StaticResource FilterField}"
                             Margin="0,0,18,0" TextChanged="TxtSearch_TextChanged"/>

                    <CheckBox x:Name="ChkDateFilter" Content="Date range:" VerticalAlignment="Center"
                              FontSize="11" Foreground="#4A5A6A" Margin="0,0,8,0"
                              Checked="DateFilter_Changed" Unchecked="DateFilter_Changed"/>

                    <TextBlock Text="From:" VerticalAlignment="Center" FontSize="11"
                               Foreground="#4A5A6A" Margin="0,0,4,0"/>
                    <DatePicker x:Name="DtpFrom" Width="130" Height="28" IsEnabled="False"
                                Margin="0,0,12,0" SelectedDateChanged="DateFilter_Changed"
                                BorderBrush="#C8D2DC" BorderThickness="1">
                        <DatePicker.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource CalBtn}"/>
                        </DatePicker.Resources>
                    </DatePicker>

                    <TextBlock Text="To:" VerticalAlignment="Center" FontSize="11"
                               Foreground="#4A5A6A" Margin="0,0,4,0"/>
                    <DatePicker x:Name="DtpTo" Width="130" Height="28" IsEnabled="False"
                                SelectedDateChanged="DateFilter_Changed"
                                BorderBrush="#C8D2DC" BorderThickness="1">
                        <DatePicker.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource CalBtn}"/>
                        </DatePicker.Resources>
                    </DatePicker>

                </WrapPanel>
            </Border>

            <!-- ═══ BODY ═══ -->
            <Grid Grid.Row="2" Margin="10,6,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblTitle" Grid.Row="0"
                           Text="Select a request to add to this set:"
                           FontSize="10.5" FontWeight="SemiBold" Foreground="#3A4A5A"
                           Margin="0,0,0,5" TextWrapping="Wrap"/>

                <DataGrid Grid.Row="1" x:Name="DgvRequests"
                          Background="White"
                          BorderBrush="#DDE3EC" BorderThickness="1"
                          GridLinesVisibility="None"
                          AlternationCount="2"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserResizeColumns="True"
                          AutoGenerateColumns="False"
                          RowHeight="36"
                          ColumnHeaderHeight="36"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          IsReadOnly="True"
                          MouseDoubleClick="DgvRequests_DoubleClick"
                          Sorting="DgvRequests_Sorting">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Req ID"     Binding="{Binding ReqId}"        Width="80"  SortMemberPath="ReqId"/>
                        <DataGridTextColumn Header="Employee"   Binding="{Binding EmployeeName}"  Width="160" SortMemberPath="EmployeeName"/>
                        <DataGridTextColumn Header="Item"       Binding="{Binding ItemName}"      Width="190" SortMemberPath="ItemName"/>
                        <DataGridTextColumn Header="Qty"        Binding="{Binding Quantity}"      Width="55"  SortMemberPath="Quantity"/>
                        <DataGridTextColumn Header="Date"       Binding="{Binding DateCreated, StringFormat=MM/dd/yyyy}"
                                            Width="90"  SortMemberPath="DateCreated"/>
                        <DataGridTextColumn Header="Date Requested" Binding="{Binding DateRequested, StringFormat=MM/dd/yyyy}"
                                            Width="115" SortMemberPath="DateRequested"/>
                        <DataGridTextColumn Header="Status"     Binding="{Binding Status}"        Width="110" SortMemberPath="Status"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}"  Width="*"   SortMemberPath="Description"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

            <!-- ═══ PAGINATION ═══ -->
            <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0">
                <DockPanel Margin="10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LblPageInfo"
                               DockPanel.Dock="Left"
                               FontSize="10.5" Foreground="#5A6A7A"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnFirstPage" Content="«" Style="{StaticResource PageBtn}"
                                Margin="0,0,3,0" Click="BtnFirstPage_Click" ToolTip="First page"/>
                        <Button x:Name="BtnPrevPage"  Content="‹" Style="{StaticResource PageBtn}"
                                Margin="0,0,3,0" Click="BtnPrevPage_Click"  ToolTip="Previous page"/>
                        <Button x:Name="BtnNextPage"  Content="›" Style="{StaticResource PageBtn}"
                                Margin="0,0,3,0" Click="BtnNextPage_Click"  ToolTip="Next page"/>
                        <Button x:Name="BtnLastPage"  Content="»" Style="{StaticResource PageBtn}"
                                Click="BtnLastPage_Click" ToolTip="Last page"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ FOOTER ═══ -->
            <Border Grid.Row="4" Background="#F5F8FC" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,0" VerticalAlignment="Center" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecBtn}"
                                Margin="0,0,8,0" Click="BtnCancel_Click" IsCancel="True"/>
                        <Button x:Name="BtnAdd"    Content="Add to Set" Style="{StaticResource PrimaryBtn}"
                                Click="BtnAdd_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
