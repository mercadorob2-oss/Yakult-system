<Window x:Class="Yakult.Inventory.App.Pages.Item.InvoiceBuilderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yakult.Inventory.App.Pages.Item"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize"
        Width="1400" Height="820" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3A8EF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2272D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A5C8F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#5B6A7D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C8D0DC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineBtn" TargetType="Button">
            <Setter Property="Background" Value="#EEF4FF"/>
            <Setter Property="Foreground" Value="#3A8EF6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDD0F8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small destructive action (remove group / remove line) -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource InlineBtn}">
            <Setter Property="Background" Value="#FDECEC"/>
            <Setter Property="Foreground" Value="#C62828"/>
            <Setter Property="BorderBrush" Value="#F3C0C0"/>
        </Style>

        <!-- Field label above an input -->
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="BorderBrush" Value="#C8D0DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldDate" TargetType="DatePicker">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3A8EF6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Header stays single-line on purpose: it is a short fixed label ("Item Name *",
             "Warranty Start"), and wrapping it would make the header row's own height fight the
             data rows below it, which DO wrap. TextTrimming means a header that somehow runs
             out of room clips with an ellipsis instead of silently overlapping the next one. -->
        <Style x:Key="GridCol" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F2F6"/>
            <Setter Property="Foreground" Value="#5B6A7D"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- Display-side style for the line-item grid's plain text columns. Rows are left to
             auto-size (see DataGrid.MinRowHeight below) so a long Item Name, Description or
             Remarks value wraps onto a second line and stays fully visible instead of being
             clipped or requiring horizontal scrolling to read. -->
        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>

        <!-- Left nav row for a Sub-Type group. Self-labelling (name + item count), current group
             highlighted — the primary way to move between groups now that only one editor is ever
             on screen. Ungrouped uses the same amber caution palette it has carried since the pill
             version: still a first-class nav entry, not hidden away, but visually flagged because
             its lines carry no Sub-Type. -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
            <Setter Property="Background" Value="{Binding TabBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <!-- Title bar and bottom summary bar stay pinned. Between them: a compact Invoice
                 Details card (Auto), then the group nav + editor workspace, which gets whatever
                 height is left ("*") — that is what lets the DataGrid inside the editor actually
                 grow to fill the window instead of shrink-wrapping its own rows. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Title bar ═══ -->
            <Border Grid.Row="0" Background="#3A8EF6" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag" Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" Text="✕" FontSize="14" FontWeight="Bold"
                               Foreground="#CFE3FF" Cursor="Hand" VerticalAlignment="Center"
                               Padding="8,0" MouseLeftButtonDown="OnCloseClick"/>
                    <TextBlock x:Name="TxtMaximizeIcon" DockPanel.Dock="Right" Text="❐" FontSize="13" FontWeight="Bold"
                               Foreground="#CFE3FF" Cursor="Hand" VerticalAlignment="Center"
                               Padding="8,0" ToolTip="Maximize" MouseLeftButtonDown="OnMaximizeRestoreClick"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Build Invoice" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Pick or create a Sub-Type group, add its items, review its financials — then create the Items and the Sales Invoice Set in one pass."
                                   FontSize="10" Foreground="#D6E8FF" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Compact Invoice Details summary + lookup helpers ═══ -->
            <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"
                    Padding="16,12">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Edit Invoice Details"
                            Style="{StaticResource SecBtn}" VerticalAlignment="Center"
                            Click="BtnEditInvoiceDetails_Click"/>

                    <!-- Lookup helpers live here rather than per-group: they add to page-wide
                         catalogues (Category / Vendor / Cartridge Model), not to any one group. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Content="+ Cartridge Model" Style="{StaticResource InlineBtn}" Margin="0,0,6,0"
                                ToolTip="Add a cartridge model. Ink / Toner / Print Head models are added from the Add new… entry at the bottom of a line's own Model dropdown, since they belong to that line's category."
                                Click="BtnNewCartridgeModel_Click"/>
                        <Button Content="+ Vendor" Style="{StaticResource InlineBtn}" Margin="0,0,6,0"
                                ToolTip="Add a vendor, then pick it in any line's Vendor column."
                                Click="BtnNewVendor_Click"/>
                        <Button Content="+ Category" Style="{StaticResource InlineBtn}"
                                ToolTip="Add an item category, then pick it in any line's Category column."
                                Click="BtnNewCategory_Click"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="INVOICE DETAILS" Style="{StaticResource SectionCaption}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Document #:" FontSize="11" Foreground="#8A94A6"/>
                            <TextBlock x:Name="LblSummaryDocNumber" Text="(not set)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="4,0,16,0"/>
                            <TextBlock Text="Subject:" FontSize="11" Foreground="#8A94A6"/>
                            <TextBlock x:Name="LblSummaryCompany" Text="(not set)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="4,0,16,0"/>
                            <TextBlock Text="Document Date:" FontSize="11" Foreground="#8A94A6"/>
                            <TextBlock x:Name="LblSummaryDate" Text="(not set)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#374151" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ Workspace: left nav + right group editor ═══ -->
            <Grid Grid.Row="2" Background="#F0F2F6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ─── Left nav: one row per Sub-Type group ─── -->
                <Border Grid.Column="0" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,1,0">
                    <Grid Margin="12,14,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="SUB-TYPE GROUPS"
                                       Style="{StaticResource SectionCaption}" VerticalAlignment="Center" Margin="0"/>
                        </DockPanel>

                        <Button Grid.Row="0" Content="+ Add Group" Style="{StaticResource InlineBtn}"
                                HorizontalAlignment="Stretch" Margin="0,20,0,10"
                                Click="BtnAddGroup_Click"/>

                        <!-- Raised when changing a line's Category discarded a model that had
                             already been picked. Shown here (rather than inside one group's
                             editor) because it can happen to a line the user is not currently
                             looking at. -->
                        <Border x:Name="BannerModelWarning" Grid.Row="0" Visibility="Collapsed"
                                Background="#FFF8E6" BorderBrush="#F5C842" BorderThickness="1"
                                CornerRadius="6" Padding="10,7" Margin="0,44,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LblModelWarning" FontSize="10" Foreground="#7A5C00" TextWrapping="Wrap"/>
                                <Button Content="Dismiss" Style="{StaticResource InlineBtn}" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" Click="BtnDismissModelWarning_Click"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TabsHost">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="BtnSelectGroupTab_Click" Style="{StaticResource NavItem}">
                                            <DockPanel LastChildFill="True">
                                                <Border DockPanel.Dock="Right" Background="#22000000" CornerRadius="8"
                                                        Padding="6,1" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLines}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding LineCount}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding TabForeground}"/>
                                                </Border>
                                                <TextBlock Text="{Binding TabLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding TabForeground}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ─── Right: the selected group's editor. Not an ItemsControl — its DataContext
                     is set imperatively in InvoiceBuilderDialog.SelectGroup() to whichever
                     BuilderGroup is current, so exactly one editor ever exists in the visual
                     tree and a plain Grid.Row="*" can size the DataGrid correctly. ─── -->
                <Grid x:Name="GroupEditorRoot" Grid.Column="1" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Group Information -->
                    <Border Grid.Row="0" Background="White" CornerRadius="8" Margin="0,0,0,10"
                            BorderBrush="#DDE3EC" BorderThickness="1" Padding="14,10"
                            Visibility="{Binding GroupHeaderVisibility}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="9" Text="GROUP INFORMATION"
                                       Style="{StaticResource SectionCaption}" Margin="0,0,0,6"/>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="SUB-TYPE" Style="{StaticResource FL}"/>
                                <!-- "(none)" is first in SubTypeOptions — a deliberate way to keep
                                     this group's own line items, Reference Code/dates and Financial
                                     Details together as their own named nav entry, without tagging
                                     them with a Sub-Type on save. Different from the shared
                                     Ungrouped bucket, which merges everything untagged into one
                                     place with no financials of its own. -->
                                <ComboBox Style="{StaticResource FieldCombo}"
                                          ItemsSource="{Binding SubTypeOptions}"
                                          SelectedItem="{Binding SubType, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="REFERENCE CODE (contract / license / service ID)" Style="{StaticResource FL}"/>
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding ReferenceCode, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="BEGIN DATE" Style="{StaticResource FL}"/>
                                <DatePicker Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding BeginDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="6">
                                <TextBlock Text="END DATE" Style="{StaticResource FL}"/>
                                <DatePicker Style="{StaticResource FieldDate}"
                                            SelectedDate="{Binding EndDate}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="8" VerticalAlignment="Bottom">
                                <!-- Destructive action, de-emphasised: small and off to the side
                                     rather than sized or positioned like a primary action. -->
                                <Button Content="Remove group" Style="{StaticResource DangerBtn}"
                                        Click="BtnRemoveGroup_Click" Tag="{Binding}"
                                        Visibility="{Binding RemoveButtonVisibility}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,8,0,0">
                                <TextBlock Text="PARENT TAG (optional — e.g. &quot;Cisco&quot;)" Style="{StaticResource FL}"/>
                                <!-- Free-text, independent of Sub-Type above — not gated by
                                     "(none)"/Ungrouped; a group can carry its own Parent Tag
                                     regardless of its Sub-Type state. -->
                                <TextBox Style="{StaticResource FieldBox}"
                                         Text="{Binding ParentTagLabel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Grid.ColumnSpan="9" Margin="0,8,0,0"
                                       FontSize="10" Foreground="#8A94A6" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNoSubType}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="No Sub-Type selected — this group's items print as ordinary invoice lines, with no banner and no group subtotal on the report. Reference Code and dates above are not saved. Its own Financial Details below still apply."/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Ungrouped bucket explains itself instead of showing empty Group Information
                         fields. Styled as an actual caution banner — its editor no longer sits in
                         plain view among the others now that navigation is by nav row, so a line
                         landing here by accident (wrong nav item clicked) is easy to miss without
                         one. -->
                    <Border Grid.Row="0" Background="#FFF8E6" BorderBrush="#F5C842" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Margin="0,0,0,10"
                            Visibility="{Binding UngroupedNoticeVisibility}">
                        <TextBlock Text="⚠ These lines have no Sub-Type. They print as ordinary invoice lines — no banner, no group subtotal — and will not be covered by any Sub-Type group's contract, license or subscription period. Use only for items that genuinely have none."
                                   FontSize="10.5" Foreground="#8A5A00" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Items — the DataGrid is the primary visual focus of the whole page, so it
                         gets the Row="*" and everything else is sized to its own content around it.
                         Columns/bindings/behaviour below are unchanged from before this refactor. -->
                    <DockPanel Grid.Row="1" LastChildFill="True">
                        <!-- Legend for the orange "Existing?" column / row highlight below — a
                             color alone doesn't explain itself, so this spells it out once
                             rather than per-row. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="12" Height="12" Background="#FBE2C4" BorderBrush="#E8B96B"
                                    BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Check a row's orange &quot;Existing?&quot; box to pick an existing item for it — opens the item picker right away, and the whole row turns orange. Item details then lock; only Qty/Unit Price stay editable. &quot;+ Add line&quot;/&quot;+ 5 lines&quot; always add plain blank rows first."
                                       FontSize="10.5" Foreground="#8A94A6"/>
                        </StackPanel>

                        <Border Background="White" CornerRadius="8"
                                BorderBrush="#DDE3EC" BorderThickness="1" Margin="0,0,0,10">
                        <DataGrid x:Name="LinesGrid" ItemsSource="{Binding Lines}"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#EDF0F4"
                                  VerticalGridLinesBrush="#EDF0F4"
                                  BorderThickness="0"
                                  MinRowHeight="30"
                                  FontSize="11"
                                  ColumnHeaderStyle="{StaticResource GridCol}"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  PreviewMouseWheel="OnGridPreviewMouseWheel"
                                  BeginningEdit="LinesGrid_BeginningEdit">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExistingItem}" Value="True">
                                            <Setter Property="Background" Value="#FBE2C4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Resources>
                                <!-- Greys out a new-item-only cell once its row is switched to
                                     an existing item — paired with LinesGrid_BeginningEdit,
                                     which actually blocks the edit; this just makes that state
                                     visible instead of a cell that merely refuses input. -->
                                <Style x:Key="ExistingItemLockedCell" TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExistingItem}" Value="True">
                                            <Setter Property="Foreground" Value="#9AA5B1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- The orange cell IS the trigger: checking it opens the item
                                     picker immediately for just this one row (see
                                     BuilderLine.IsExistingItem's setter / OnLineExistingItemToggleRequested).
                                     "+ Add line"/"+ 5 lines" never open it themselves — they only
                                     ever add plain blank rows, so the full row count is visible
                                     before deciding which specific rows should become existing
                                     items. Once checked, the whole row turns the same orange
                                     (DataGrid.RowStyle above) as visual confirmation. -->
                                <DataGridCheckBoxColumn Header="Existing?" Width="60"
                                                         Binding="{Binding IsExistingItem, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridCheckBoxColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="#FBE2C4"/>
                                            <Setter Property="ToolTip" Value="Check to pick an existing item for this line — opens the item picker right away."/>
                                        </Style>
                                    </DataGridCheckBoxColumn.CellStyle>
                                </DataGridCheckBoxColumn>
                                <DataGridTextColumn Header="Item Name *" Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Width="180" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="180" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <DataGridComboBoxColumn Header="Category *" Width="130"
                                                        SelectedItemBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static local:InvoiceBuilderDialog.CategoryOptions}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExistingItem}" Value="True">
                                                    <Setter Property="Foreground" Value="#9AA5B1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="OnCategorySelectionChanged"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridComboBoxColumn Header="Item Type" Width="110"
                                                        SelectedItemBinding="{Binding ItemType, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static local:InvoiceBuilderDialog.ItemTypeOptions}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExistingItem}" Value="True">
                                                    <Setter Property="Foreground" Value="#9AA5B1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                </DataGridComboBoxColumn>
                                <!-- Serial #s — the grid-cell equivalent of Batch Add Items' Serial
                                     Numbers box. One dbo.Item is created per serial entered in the
                                     popup; Qty is ignored once any are given (see its own column). -->
                                <DataGridTemplateColumn Header="Serial #s" Width="150" SortMemberPath="SerialNumberSummary">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding SerialNumberSummary}"
                                                    Click="BtnEditSerialNumbers_Click"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="7,4" Cursor="Hand" FontSize="11">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="#374151"/>
                                                        <Style.Triggers>
                                                            <!-- Matches BuilderLine.NoSerialsPlaceholder — a literal here
                                                                 because a nested-type x:Static reference is fragile. -->
                                                            <DataTrigger Binding="{Binding SerialNumberSummary}" Value="+ Add serial #s">
                                                                <Setter Property="Foreground" Value="#3A8EF6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Model #" Binding="{Binding ModelNumber}" Width="110" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <!-- Vendor is a list rather than free text: the importer resolves a
                                     vendor by name, so a typo would silently save no vendor at all. -->
                                <DataGridComboBoxColumn Header="Vendor" Width="130"
                                                        SelectedItemBinding="{Binding Vendor, UpdateSourceTrigger=PropertyChanged}"
                                                        ItemsSource="{x:Static local:InvoiceBuilderDialog.VendorOptions}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExistingItem}" Value="True">
                                                    <Setter Property="Foreground" Value="#9AA5B1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <EventSetter Event="SelectionChanged" Handler="OnVendorSelectionChanged"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>

                                <!-- Model follows the row's Category: Cartridge draws from
                                     dbo.CartridgeModel, Ink / Toner / Print Head from their own
                                     slice of dbo.ConsumableModel. ItemsSource is bound per row
                                     rather than set on the column, which would force one shared
                                     list on every line. -->
                                <DataGridComboBoxColumn Header="Model" Width="150"
                                                        SelectedItemBinding="{Binding Model, UpdateSourceTrigger=PropertyChanged}">
                                    <DataGridComboBoxColumn.ElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding ModelOptions}"/>
                                            <Setter Property="IsEnabled" Value="{Binding SupportsModel}"/>
                                        </Style>
                                    </DataGridComboBoxColumn.ElementStyle>
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="ItemsSource" Value="{Binding ModelOptions}"/>
                                            <Setter Property="IsEnabled" Value="{Binding SupportsModel}"/>
                                            <EventSetter Event="SelectionChanged" Handler="OnModelSelectionChanged"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTextColumn Header="UoM" Binding="{Binding UnitOfMeasure}" Width="85" ElementStyle="{StaticResource WrapCellText}"/>
                                <!-- Ignored once Serial #s are entered — the serial count governs
                                     quantity then, exactly like Batch Add Items' "(ignored when
                                     serial numbers are provided)" note beside its own Quantity field. -->
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource WrapCellText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding QuantityEditable}" Value="False">
                                                    <Setter Property="Foreground" Value="#AAB2BD"/>
                                                    <Setter Property="ToolTip" Value="Ignored — quantity comes from the Serial #s entered on this line."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- Right-aligned numeric columns keep their own style rather than the
                                     shared one, but still wrap — a very large typed figure should grow
                                     the row instead of being clipped. -->
                                <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="7,5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Mode=OneWay, StringFormat=N2}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="7,5"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="License #" Binding="{Binding LicenseNumber}" Width="110" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <DataGridTextColumn Header="Part #" Binding="{Binding PartNumber}" Width="100" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <!-- Matches Batch Add Items' "Warranty (Years)" field under Purchase Details.
                                     Warranty Start is set automatically to the item's creation time when this
                                     is above zero, and Warranty End is computed from Start + this many years —
                                     the same auto-computed rule Batch Add Items uses; there is no separate
                                     Warranty Start/End input here or there. -->
                                <DataGridTextColumn Header="Warranty (Yrs)" Binding="{Binding WarrantyYears, UpdateSourceTrigger=PropertyChanged}" Width="100" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="120" ElementStyle="{StaticResource ExistingItemLockedCell}"/>
                                <!-- Date Purchased. A DataGridTemplateColumn rather than a text column,
                                     so the cell edits through the same DatePicker used everywhere else
                                     on this page instead of accepting typed, typo-prone text. -->
                                <DataGridTemplateColumn Header="Date Purchased" Width="115" SortMemberPath="DatePurchased">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DatePurchased, StringFormat=MM/dd/yyyy}"
                                                       Padding="7,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding DatePurchased, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        BorderThickness="0" Padding="2,0" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Warranty Start/End — manual override of the auto rule (Start = item
                                     creation time when Warranty (Yrs) is above zero, End = Start + Years),
                                     matching Edit Item's and Batch Add Items' ChkWarrantyStart/ChkWarrantyEnd
                                     pair. Left blank (the normal case) means "use the auto rule" — there is
                                     no checkbox here because a blank date already means exactly that.
                                     Replaces the earlier Line Start/Line End columns, which tracked when the
                                     item was actually put into or taken out of use — a different, usually
                                     blank field, not the same thing as the warranty period. Leaving them
                                     blank on every line here just means the line inherits the invoice's own
                                     Coverage Start/End, exactly as before. -->
                                <DataGridTemplateColumn Header="Warranty Start" Width="115" SortMemberPath="WarrantyStartDate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WarrantyStartDate, StringFormat=MM/dd/yyyy}"
                                                       Padding="7,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding WarrantyStartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        BorderThickness="0" Padding="2,0" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Warranty End" Width="115" SortMemberPath="WarrantyEndDate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WarrantyEndDate, StringFormat=MM/dd/yyyy}"
                                                       Padding="7,0" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding WarrantyEndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        BorderThickness="0" Padding="2,0" FontSize="11"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </Border>
                    </DockPanel>

                    <!-- Add Line / Add 5 Lines / Delete Selected Line, plus a glanceable group
                         total that stays visible even while Financial Details is collapsed. -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Content="+ Add line"
                                Style="{StaticResource InlineBtn}"
                                Click="BtnAddLine_Click" Tag="{Binding}"/>
                        <Button DockPanel.Dock="Left" Content="+ 5 lines"
                                Style="{StaticResource InlineBtn}" Margin="6,0,0,0"
                                Click="BtnAddFiveLines_Click" Tag="{Binding}"/>
                        <Button DockPanel.Dock="Left" Content="Remove selected line"
                                Style="{StaticResource DangerBtn}" Margin="6,0,0,0"
                                Click="BtnRemoveLine_Click" Tag="{Binding}"/>

                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding TotalDisplay}"
                                   FontSize="13" FontWeight="Bold" Foreground="#2E7D32"
                                   VerticalAlignment="Center" MinWidth="110"
                                   TextAlignment="Right"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalCaption}"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#8A94A6"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>

                    <!-- Financial Details — this group's OWN VAT/Discount/WHT, independent of the
                         invoice-level totals at the very bottom of the page. Collapsible so it does
                         not compete with the DataGrid for attention once reviewed, but expanded by
                         default (InvoiceBuilderDialog.AddGroup sets IsFinancialExpanded = true) so a
                         newly created group's numbers are visible immediately. -->
                    <Expander Grid.Row="3" Header="Financial Details" IsExpanded="{Binding IsFinancialExpanded}"
                              Visibility="{Binding FinancialsVisibility}"
                              Background="White" BorderBrush="#DDE3EC" BorderThickness="1"
                              Padding="4" FontSize="11" FontWeight="SemiBold" Foreground="#374151">
                        <Border Background="#FAFBFC" CornerRadius="6" Margin="0,8,0,0"
                                BorderBrush="#E5E9F0" BorderThickness="1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <StackPanel Width="120" Margin="0,0,10,0">
                                        <TextBlock Text="GROUP SUBTOTAL" Style="{StaticResource FL}"/>
                                        <TextBox Style="{StaticResource FieldBox}" TextAlignment="Right"
                                                 Text="{Binding SubtotalOverrideText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding SubtotalHint}" FontSize="9"
                                                   Foreground="#9AA3B0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Width="72" Margin="0,0,8,0">
                                        <TextBlock Text="VAT %" Style="{StaticResource FL}"/>
                                        <TextBox Style="{StaticResource FieldBox}" TextAlignment="Right"
                                                 Text="{Binding VatPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="72" Margin="0,0,8,0">
                                        <TextBlock Text="DISCOUNT %" Style="{StaticResource FL}"/>
                                        <TextBox Style="{StaticResource FieldBox}" TextAlignment="Right"
                                                 Text="{Binding DiscountPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Width="72">
                                        <TextBlock Text="WHT %" Style="{StaticResource FL}"/>
                                        <TextBox Style="{StaticResource FieldBox}" TextAlignment="Right"
                                                 Text="{Binding WhtPercentText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" VerticalAlignment="Bottom"
                                           Margin="14,0,14,6" TextWrapping="Wrap"
                                           FontSize="9" Foreground="#9AA3B0" FontWeight="Normal"
                                           Text="Blank percents fall back to the invoice header's. This group's total already nets out its own discount, VAT and WHT before it rolls into the invoice subtotal."/>

                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal" FontSize="9.5" FontWeight="Normal" Foreground="#8A94A6" Margin="0,0,14,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="9.5" FontWeight="Normal" Foreground="#374151" TextAlignment="Right" MinWidth="90" Margin="0,0,0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount" FontSize="9.5" FontWeight="Normal" Foreground="#8A94A6" Margin="0,0,14,2"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountDisplay}" FontSize="9.5" FontWeight="Normal" Foreground="#374151" TextAlignment="Right" Margin="0,0,0,2"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="VAT" FontSize="9.5" FontWeight="Normal" Foreground="#8A94A6" Margin="0,0,14,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VatDisplay}" FontSize="9.5" FontWeight="Normal" Foreground="#374151" TextAlignment="Right" Margin="0,0,0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="WHT" FontSize="9.5" FontWeight="Normal" Foreground="#8A94A6" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WhtDisplay}" FontSize="9.5" FontWeight="Normal" Foreground="#374151" TextAlignment="Right"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Expander>
                </Grid>
            </Grid>

            <!-- ═══ Bottom bar: invoice-level financial summary beside Cancel / Create Invoice ═══ -->
            <Border Grid.Row="3" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="16,10">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" x:Name="LblStatus"
                               FontSize="11" Foreground="#5B6472" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="150"/>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Cancel" Style="{StaticResource SecBtn}" Margin="0,0,8,0"
                                Click="BtnCancel_Click" IsCancel="True"/>
                        <Button x:Name="BtnCreate" Content="Create Invoice"
                                Style="{StaticResource PrimaryBtn}"
                                Click="BtnCreate_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Width="66" Margin="0,0,8,0">
                            <TextBlock Text="VAT %" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtVatPercent" Style="{StaticResource FieldBox}" Text="12"
                                     TextAlignment="Right" TextChanged="OnFinancialInputChanged"/>
                        </StackPanel>
                        <StackPanel Width="66" Margin="0,0,8,0">
                            <TextBlock Text="DISCOUNT %" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtDiscountPercent" Style="{StaticResource FieldBox}" Text="0"
                                     TextAlignment="Right" TextChanged="OnFinancialInputChanged"/>
                        </StackPanel>
                        <StackPanel Width="66" Margin="0,0,14,0">
                            <TextBlock Text="WHT %" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtWhtPercent" Style="{StaticResource FieldBox}" Text="0"
                                     TextAlignment="Right" TextChanged="OnFinancialInputChanged"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Subtotal" FontSize="10.5" Foreground="#5B6472" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="LblSubtotal" Text="0.00" FontSize="11" FontWeight="SemiBold" Foreground="#2A2F3A" TextAlignment="Right" MinWidth="64" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <TextBlock Text="VAT" FontSize="10.5" Foreground="#5B6472" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblVat" Text="0.00" FontSize="11" FontWeight="SemiBold" Foreground="#2A2F3A" TextAlignment="Right" MinWidth="54" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="Disc." FontSize="10.5" Foreground="#5B6472" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblDiscount" Text="0.00" FontSize="11" FontWeight="SemiBold" Foreground="#2A2F3A" TextAlignment="Right" MinWidth="54" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="WHT" FontSize="10.5" Foreground="#5B6472" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LblWht" Text="0.00" FontSize="11" FontWeight="SemiBold" Foreground="#2A2F3A" TextAlignment="Right" MinWidth="54" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <TextBlock Text="TOTAL DUE" FontSize="12" FontWeight="Bold" Foreground="#1F2430" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LblTotalDue" Text="0.00"
                                           FontSize="16" FontWeight="Bold" Foreground="#1B5E20" TextAlignment="Right"
                                           VerticalAlignment="Center" MinWidth="104" Margin="0,0,2,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
