<Window x:Class="Yakult.Inventory.App.Pages.Software.SoftwareServiceSetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sales Invoice Set"
        Width="1280" Height="760"
        MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ── Field TextBox ────────────────────────────────────────────────── -->
        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#C8D2DC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#3A8EF6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                                <Setter Property="Foreground"                 Value="#A0ADB9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox ──────────────────────────────────────────────────────── -->
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsTextSearchEnabled"      Value="True"/>
        </Style>

        <!-- ── DatePicker ────────────────────────────────────────────────────── -->
        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height"          Value="30"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#C8D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="8,0"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"/>
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="28" Height="26">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBd" Background="Transparent"
                                                    CornerRadius="3" Padding="4,3">
                                                <Path Data="M3,2 L3,0 M9,2 L9,0 M0,4 L12,4 M0,2 L0,12 L12,12 L12,2 Z M2,6 L4,6 M6,6 L8,6 M10,6 L12,6 M2,9 L4,9 M6,9 L8,9"
                                                      Stroke="#5A6A7A" StrokeThickness="1"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Background" Value="#E8ECF0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                                <Setter Property="Foreground" Value="#A0ADB9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Field label ───────────────────────────────────────────────────── -->
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11.5"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#4A5A6A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,10,0"/>
        </Style>

        <!-- ── Section title ─────────────────────────────────────────────────── -->
        <Style x:Key="ST" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3A8EF6"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- ── White card ────────────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                      Opacity="0.06" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Add Item button (green) ───────────────────────────────────────── -->
        <Style x:Key="AddBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#A9DFBF"/>
            <Setter Property="Foreground"      Value="#1A3C28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#82C9A0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Remove button (pink) ──────────────────────────────────────────── -->
        <Style x:Key="RemoveBtn" TargetType="Button" BasedOn="{StaticResource AddBtn}">
            <Setter Property="Background" Value="#FFB6C1"/>
            <Setter Property="Foreground" Value="#6A1020"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F08090"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Save button (sky blue) ────────────────────────────────────────── -->
        <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource AddBtn}">
            <Setter Property="Background" Value="#B0E0E6"/>
            <Setter Property="Foreground" Value="#1A3A50"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#85C8D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Print button (lavender) ───────────────────────────────────────── -->
        <Style x:Key="PrintBtn" TargetType="Button" BasedOn="{StaticResource AddBtn}">
            <Setter Property="Background" Value="#DDA0DD"/>
            <Setter Property="Foreground" Value="#4A1A60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C080C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Cancel / secondary button ────────────────────────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource AddBtn}">
            <Setter Property="Background" Value="#B0C4DE"/>
            <Setter Property="Foreground" Value="#1A2A4A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8AAAC8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- Outer shell — rounded corners + drop shadow                             -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5"
                              Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- Title bar       -->
                <RowDefinition Height="*"/>    <!-- Body            -->
                <RowDefinition Height="62"/>   <!-- Footer bar      -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- ROW 0 · TITLE BAR                                             -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#3A8EF6"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag"
                    Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <!-- Window chrome -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Cursor="Arrow">
                        <TextBlock Text="─" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnMinimizeClick"/>
                        <TextBlock x:Name="BtnMaximizeGlyph"
                                   Text="□" FontSize="13" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnMaximizeClick"/>
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnCloseClick"/>
                    </StackPanel>
                    <!-- Title -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sales Invoice Set Information"
                                   FontSize="13" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- ROW 1 · BODY                                                  -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Background="#F7F8FA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Form fields card  -->
                    <RowDefinition Height="*"/>      <!-- Items grid card   -->
                </Grid.RowDefinitions>

                <!-- ── Form Fields Card ──────────────────────────────────── -->
                <Border Grid.Row="0" Style="{StaticResource Card}"
                        Margin="12,12,12,6">
                    <StackPanel>
                        <TextBlock Text="SET INFORMATION" Style="{StaticResource ST}"/>

                        <!-- Two-column field layout -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left column -->
                            <StackPanel Grid.Column="0">

                                <!-- Document No. -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Document No.:" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtDocumentNumber" Grid.Column="1"
                                             Style="{StaticResource FormField}"/>
                                </Grid>

                                <!-- Document Date -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Document Date:" Style="{StaticResource FL}"/>
                                    <DatePicker x:Name="DtpDocumentDate" Grid.Column="1"
                                                Style="{StaticResource FormDate}"/>
                                </Grid>

                                <!-- Start Date -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Start Date:" Style="{StaticResource FL}"/>
                                    <DatePicker x:Name="DtpStartDate" Grid.Column="1"
                                                Style="{StaticResource FormDate}"/>
                                </Grid>

                                <!-- Contract period checkbox -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FL}"/>
                                    <CheckBox x:Name="ChkHasContractPeriod" Grid.Column="1"
                                              Content="Track contract period for this set"
                                              FontSize="12" Foreground="#4A5A6A"
                                              VerticalAlignment="Center"
                                              Checked="ChkContractPeriod_Changed"
                                              Unchecked="ChkContractPeriod_Changed"/>
                                </Grid>

                            </StackPanel>

                            <!-- Right column -->
                            <StackPanel Grid.Column="2">

                                <!-- Reference No. -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Reference No.:" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtReferenceNumber" Grid.Column="1"
                                             Style="{StaticResource FormField}"/>
                                </Grid>

                                <!-- Company -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Company:" Style="{StaticResource FL}"/>
                                    <ComboBox x:Name="CmbCompany" Grid.Column="1"
                                              Style="{StaticResource FormCombo}"/>
                                </Grid>

                                <!-- Distributor -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Distributor:" Style="{StaticResource FL}"/>
                                    <ComboBox x:Name="CmbDistributor" Grid.Column="1"
                                              Style="{StaticResource FormCombo}"/>
                                </Grid>

                                <!-- End Date -->
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="End Date:" Style="{StaticResource FL}"/>
                                    <DatePicker x:Name="DtpEndDate" Grid.Column="1"
                                                Style="{StaticResource FormDate}"/>
                                </Grid>

                                <!-- Status -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Status:" Style="{StaticResource FL}"/>
                                    <ComboBox x:Name="CmbStatus" Grid.Column="1"
                                              Style="{StaticResource FormCombo}">
                                        <ComboBoxItem Content="YES"/>
                                        <ComboBoxItem Content="NO"/>
                                    </ComboBox>
                                </Grid>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Items Grid Card ───────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource Card}"
                        Margin="12,0,12,12" Padding="16,12,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ITEMS IN THIS SET"
                                   Style="{StaticResource ST}"/>

                        <DataGrid x:Name="ItemsGrid" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#EEF0F4"
                                  VerticalGridLinesBrush="#EEF0F4"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F5F9FF"
                                  Background="White"
                                  BorderBrush="#DDE3EC"
                                  BorderThickness="1"
                                  MinRowHeight="52"
                                  FontSize="12"
                                  Foreground="#1A2333"
                                  SelectionChanged="ItemsGrid_SelectionChanged">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"               Value="#3498DB"/>
                                    <Setter Property="Foreground"               Value="White"/>
                                    <Setter Property="FontWeight"               Value="SemiBold"/>
                                    <Setter Property="FontSize"                 Value="12"/>
                                    <Setter Property="Padding"                  Value="8,0"/>
                                    <Setter Property="Height"                   Value="36"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    <Setter Property="SeparatorBrush"           Value="#2A7DC5"/>
                                    <Setter Property="SeparatorVisibility"      Value="Visible"/>
                                </Style>
                                <!-- Cell stretches to fill row — centering is on the TextBlock, not the cell -->
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#5DADE2"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsFocused" Value="True">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#5DADE2"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#EBF5FB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- Shared element styles for text cells — wraps instead of
                                     truncating so long values stay fully readable -->
                                <Style x:Key="CellText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin"            Value="8,4"/>
                                    <Setter Property="TextWrapping"      Value="Wrap"/>
                                </Style>
                                <Style x:Key="WrapCellText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin"            Value="8,4"/>
                                    <Setter Property="TextWrapping"      Value="Wrap"/>
                                </Style>
                                <!-- Centered column header (Sub-Type) -->
                                <Style x:Key="CenteredColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="CenteredCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                                <Style x:Key="GroupHeaderCell" TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#EEF0F4"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- Hidden ItemId -->
                                <DataGridTextColumn Header="Item ID"
                                                    Binding="{Binding ItemId}"
                                                    IsReadOnly="True" Width="60"
                                                    Visibility="Collapsed"/>

                                <!-- Part# (read-only) -->
                                <DataGridTextColumn Header="Part#"
                                                    Binding="{Binding PartNumber}"
                                                    IsReadOnly="True" Width="90"
                                                    ElementStyle="{StaticResource CellText}"/>

                                <!-- Item Name (read-only) -->
                                <DataGridTextColumn Header="Item Name"
                                                    Binding="{Binding ItemName}"
                                                    IsReadOnly="True" Width="1.6*"
                                                    MinWidth="140"
                                                    ElementStyle="{StaticResource WrapCellText}"/>

                                <!-- Item Code (read-only) -->
                                <DataGridTextColumn Header="Item Code"
                                                    Binding="{Binding ItemCode}"
                                                    IsReadOnly="True" Width="90"
                                                    ElementStyle="{StaticResource CellText}"/>

                                <!-- Sub-Type (read-only) — which Contract/Subscription/License/Service
                                     group this item came from, blank if it wasn't part of a group.
                                     Reference Code is not repeated per-row — it's shown once in the
                                     full-width group header row above each Sub-Type's items (see
                                     DataGrid.GroupStyle below). -->
                                <DataGridTextColumn Header="Sub-Type"
                                                    Binding="{Binding SubType}"
                                                    IsReadOnly="True" Width="90"
                                                    HeaderStyle="{StaticResource CenteredColumnHeader}"
                                                    ElementStyle="{StaticResource CenteredCellText}"/>

                                <!-- Description (read-only) -->
                                <DataGridTextColumn Header="Description"
                                                    Binding="{Binding Description}"
                                                    IsReadOnly="True" Width="2*"
                                                    MinWidth="160"
                                                    ElementStyle="{StaticResource WrapCellText}"/>

                                <!-- Qty (editable) -->
                                <DataGridTextColumn Header="Qty" Width="65"
                                                    ElementStyle="{StaticResource CellText}">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Quantity"
                                                 UpdateSourceTrigger="PropertyChanged"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>

                                <!-- Unit Price (editable) -->
                                <DataGridTextColumn Header="Unit Price" Width="85"
                                                    ElementStyle="{StaticResource CellText}">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="UnitPrice"
                                                 UpdateSourceTrigger="PropertyChanged"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>

                                <!-- UOM (editable) -->
                                <DataGridTextColumn Header="UOM" Width="65"
                                                    ElementStyle="{StaticResource CellText}">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Uom"
                                                 UpdateSourceTrigger="PropertyChanged"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>

                                <!-- Amount (computed, read-only) -->
                                <DataGridTextColumn Header="Amount"
                                                    Binding="{Binding Amount, StringFormat='{}{0:N2}'}"
                                                    IsReadOnly="True" Width="80"
                                                    ElementStyle="{StaticResource CellText}"/>

                                <!-- Start Date (template — DatePicker in edit mode) -->
                                <DataGridTemplateColumn Header="Start Date" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationStart, StringFormat='{}{0:dd MMM yyyy}'}"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding DurationStart,
                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- End Date (template — DatePicker in edit mode) -->
                                <DataGridTemplateColumn Header="End Date" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DurationEnd, StringFormat='{}{0:dd MMM yyyy}'}"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding DurationEnd,
                                                        UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                            <!-- Full-width group header rows (each spans every column) above each
                                 Sub-Type's items — "Contract: CT-0001", "No Sub-Type" for plain
                                 items — instead of a single line that could only ever show one
                                 group even when items came from several different groups. Start
                                 Date / End Date come from the same group (typed on the Items
                                 Page's "Add to ... Group" dialog), each on its own full-width row. -->
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <!-- Row 1: Sub-Type: Reference Code, in the Description cell -->
                                                <Grid Background="#EAF1FB">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="1.6*" MinWidth="140"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="2*" MinWidth="160"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="1" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="2" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="3" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="4" Style="{StaticResource GroupHeaderCell}" Padding="8,6">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                                   Foreground="#3498DB" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Border Grid.Column="5" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="6" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="7" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="8" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="9" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="10" Style="{StaticResource GroupHeaderCell}"/>
                                                </Grid>

                                                <!-- Row 2: Start Date, in the Description cell -->
                                                <Grid Background="#F5F9FF">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="1.6*" MinWidth="140"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="2*" MinWidth="160"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="1" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="2" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="3" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="4" Style="{StaticResource GroupHeaderCell}" Padding="8,4">
                                                        <TextBlock FontSize="11" Foreground="#5A6B7B" TextWrapping="Wrap">
                                                            <Run Text="Start Date: "/>
                                                            <Run Text="{Binding Items[0].DurationStart, StringFormat='{}{0:MM/dd/yyyy}'}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Grid.Column="5" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="6" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="7" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="8" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="9" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="10" Style="{StaticResource GroupHeaderCell}"/>
                                                </Grid>

                                                <!-- Row 3: End Date, in the Description cell -->
                                                <Grid Background="#F5F9FF">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="1.6*" MinWidth="140"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="2*" MinWidth="160"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="85"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="1" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="2" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="3" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="4" Style="{StaticResource GroupHeaderCell}" Padding="8,4">
                                                        <TextBlock FontSize="11" Foreground="#5A6B7B" TextWrapping="Wrap">
                                                            <Run Text="End Date: "/>
                                                            <Run Text="{Binding Items[0].DurationEnd, StringFormat='{}{0:MM/dd/yyyy}'}"/>
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Grid.Column="5" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="6" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="7" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="8" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="9" Style="{StaticResource GroupHeaderCell}"/>
                                                    <Border Grid.Column="10" Style="{StaticResource GroupHeaderCell}"/>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- ROW 2 · FOOTER                                                -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <DockPanel Margin="16,0" VerticalAlignment="Center"
                           LastChildFill="False">

                    <!-- Left: Add / Remove -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="BtnAddItem"
                                Content="+ Add Item"
                                Style="{StaticResource AddBtn}"
                                Margin="0,0,8,0"
                                Click="BtnAddItem_Click"/>
                        <Button x:Name="BtnRemoveItem"
                                Content="− Remove"
                                Style="{StaticResource RemoveBtn}"
                                IsEnabled="False"
                                Click="BtnRemoveItem_Click"/>
                    </StackPanel>

                    <!-- Right: Save / Print / Cancel -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Cancel"
                                Style="{StaticResource SecBtn}"
                                Margin="0,0,8,0"
                                Click="BtnCancel_Click"/>
                        <Button Content="Print"
                                Style="{StaticResource PrintBtn}"
                                Margin="0,0,8,0"
                                Click="BtnPrint_Click"/>
                        <Button Content="Save"
                                Style="{StaticResource SaveBtn}"
                                Click="BtnSave_Click"/>
                    </StackPanel>

                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
