<Window x:Class="Yakult.Inventory.App.Pages.Software.SelectedItemsReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Selected Items"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ── Card ──────────────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                      Opacity="0.06" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button (Close) ───────────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button (Remove All) ────────────────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>

        <!-- ── Row-remove button ─────────────────────────────────────────── -->
        <Style x:Key="RemoveBtn" TargetType="Button">
            <Setter Property="Height"          Value="26"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#FDEBEC"/>
            <Setter Property="Foreground"      Value="#D9534F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- Outer shell                                                          -->
    <!-- ════════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5"
                              Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- Title bar   -->
                <RowDefinition Height="*"/>    <!-- Body        -->
                <RowDefinition Height="62"/>   <!-- Footer      -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 0 · TITLE BAR                                           -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#3A8EF6"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag"
                    Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Cursor="Arrow">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnCloseClick"/>
                    </StackPanel>
                    <TextBlock Text="Selected Items"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 1 · BODY                                                 -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Background="#F7F8FA">
                <Border Style="{StaticResource Card}" Margin="12" Padding="16,12,16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" x:Name="TxtEmptyState"
                                   Text="No items selected."
                                   FontSize="12" Foreground="#7A8A9A"
                                   Margin="0,0,0,8"
                                   Visibility="Collapsed"/>

                        <DataGrid Grid.Row="1" x:Name="ItemsGrid"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEF0F4"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F5F9FF"
                                  Background="White"
                                  BorderBrush="#DDE3EC"
                                  BorderThickness="1"
                                  MinRowHeight="34"
                                  FontSize="12"
                                  Foreground="#1A2333"
                                  IsReadOnly="True"
                                  VirtualizingPanel.IsVirtualizing="False">

                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"                 Value="#3498DB"/>
                                    <Setter Property="Foreground"                 Value="White"/>
                                    <Setter Property="FontWeight"                 Value="SemiBold"/>
                                    <Setter Property="FontSize"                   Value="12"/>
                                    <Setter Property="Padding"                    Value="8,0"/>
                                    <Setter Property="Height"                     Value="36"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="0"/>
                                </Style>
                                <Style x:Key="CellText" TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin"            Value="8,0"/>
                                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID"
                                                    Binding="{Binding ItemId}"
                                                    Width="52"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="2*"
                                                    MinWidth="120"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="1*"
                                                    MinWidth="90"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTextColumn Header="Serial No."
                                                    Binding="{Binding SerialNumber}"
                                                    Width="1*"
                                                    MinWidth="100"
                                                    ElementStyle="{StaticResource CellText}"/>
                                <DataGridTemplateColumn Header="" Width="80" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove"
                                                    Style="{StaticResource RemoveBtn}"
                                                    Tag="{Binding ItemId}"
                                                    Click="BtnRemoveRow_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 2 · FOOTER                                              -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtCount"
                               Grid.Column="0"
                               FontSize="11.5" Foreground="#7A8A9A"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRemoveAll"
                                Content="Remove All"
                                Style="{StaticResource SecBtn}"
                                Margin="0,0,8,0"
                                Click="BtnRemoveAll_Click"/>
                        <Button Content="Close"
                                Style="{StaticResource PrimaryBtn}"
                                Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
