<Window x:Class="Yakult.Inventory.App.Pages.Software.SoftwareItemPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Items"
        Width="1020" Height="640"
        MinWidth="840" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ── TextBox ───────────────────────────────────────────────────── -->
        <Style x:Key="FilterField" TargetType="TextBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#C8D2DC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#3A8EF6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Filter label ─────────────────────────────────────────────── -->
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11.5"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="#4A5A6A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,6,0"/>
        </Style>

        <!-- ── Section title ────────────────────────────────────────────── -->
        <Style x:Key="ST" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3A8EF6"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- ── White card ───────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                      Opacity="0.06" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary button (OK / Search) ─────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Icon button (Refresh ⟳) ──────────────────────────────────── -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Cancel / secondary button ────────────────────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>

        <!-- ── Pagination nav button ─────────────────────────────────────── -->
        <Style x:Key="PageBtn" TargetType="Button">
            <Setter Property="Width"            Value="28"/>
            <Setter Property="Height"           Value="28"/>
            <Setter Property="FontSize"         Value="16"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Foreground"       Value="#3A8EF6"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="BorderBrush"      Value="#C8D2DC"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EBF3FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#DDE3EC"/>
                                <Setter Property="Foreground"                  Value="#B0BEC8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- Outer shell                                                          -->
    <!-- ════════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5"
                              Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- Title bar   -->
                <RowDefinition Height="*"/>    <!-- Body        -->
                <RowDefinition Height="62"/>   <!-- Footer      -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 0 · TITLE BAR                                           -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#3A8EF6"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag"
                    Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Cursor="Arrow">
                        <TextBlock Text="─" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnMinimizeClick"/>
                        <TextBlock x:Name="BtnMaximizeGlyph"
                                   Text="□" FontSize="13" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnMaximizeClick"/>
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center" Padding="8,0"
                                   MouseLeftButtonDown="OnCloseClick"/>
                    </StackPanel>
                    <TextBlock Text="Select Items"
                               FontSize="13" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 1 · BODY                                                 -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1" Background="#F7F8FA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Filter card  -->
                    <RowDefinition Height="*"/>      <!-- Grid card    -->
                </Grid.RowDefinitions>

                <!-- ── Filter Card ──────────────────────────────────────── -->
                <Border Grid.Row="0" Style="{StaticResource Card}"
                        Margin="12,12,12,6">
                    <StackPanel>
                        <TextBlock Text="SEARCH ITEMS" Style="{StaticResource ST}"/>

                        <!-- Filter row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="195"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Name:" Style="{StaticResource FL}"/>
                            <TextBox   Grid.Column="1" x:Name="TxtSearchName"
                                       Style="{StaticResource FilterField}"
                                       TextChanged="TxtFilter_TextChanged"/>

                            <TextBlock Grid.Column="3" Text="Category:" Style="{StaticResource FL}"/>
                            <TextBox   Grid.Column="4" x:Name="TxtSearchCategory"
                                       Style="{StaticResource FilterField}"
                                       TextChanged="TxtFilter_TextChanged"/>

                            <TextBlock Grid.Column="6" Text="Serial:" Style="{StaticResource FL}"/>
                            <TextBox   Grid.Column="7" x:Name="TxtSearchSerial"
                                       Style="{StaticResource FilterField}"
                                       TextChanged="TxtFilter_TextChanged"/>

                            <Button Grid.Column="9"
                                    Content="Search"
                                    Style="{StaticResource PrimaryBtn}"
                                    Click="BtnSearch_Click"/>

                            <Button Grid.Column="11"
                                    Content="⟳"
                                    Style="{StaticResource IconBtn}"
                                    ToolTip="Clear filters and refresh"
                                    Click="BtnRefresh_Click"/>
                        </Grid>

                        <!-- Show Inactive row -->
                        <CheckBox x:Name="ChkShowInactive"
                                  Content="Show Inactive Items"
                                  FontSize="12" Foreground="#4A5A6A"
                                  Margin="0,10,0,0"
                                  Checked="ChkShowInactive_Changed"
                                  Unchecked="ChkShowInactive_Changed"/>
                    </StackPanel>
                </Border>

                <!-- ── DataGrid Card ─────────────────────────────────────── -->
                <Border Grid.Row="1" Style="{StaticResource Card}"
                        Margin="12,0,12,12" Padding="16,12,16,12">
                    <DataGrid x:Name="ItemsGrid"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF0F4"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F9FF"
                              Background="White"
                              BorderBrush="#DDE3EC"
                              BorderThickness="1"
                              MinRowHeight="34"
                              FontSize="12"
                              Foreground="#1A2333"
                              VirtualizingPanel.IsVirtualizing="False">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"                 Value="#3498DB"/>
                                <Setter Property="Foreground"                 Value="White"/>
                                <Setter Property="FontWeight"                 Value="SemiBold"/>
                                <Setter Property="FontSize"                   Value="12"/>
                                <Setter Property="Padding"                    Value="8,0"/>
                                <Setter Property="Height"                     Value="36"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="SeparatorBrush"             Value="#2A7DC5"/>
                                <Setter Property="SeparatorVisibility"        Value="Visible"/>
                            </Style>
                            <!-- Cell stretches to fill row — centering is on the TextBlock, not the cell -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding"         Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#5DADE2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#5DADE2"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EBF5FB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Shared element styles for text cells -->
                            <Style x:Key="CellText" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin"            Value="8,0"/>
                                <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                            </Style>
                            <Style x:Key="WrapCellText" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin"            Value="8,4"/>
                                <Setter Property="TextWrapping"      Value="Wrap"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>

                            <!-- ── Select (checkbox + select-all header) ── -->
                            <DataGridTemplateColumn Width="40" CanUserSort="False">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Click="ChkSelectAll_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ── ID ──────────────────────────────────── -->
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding ItemId}"
                                                IsReadOnly="True"
                                                Width="52"
                                                ElementStyle="{StaticResource CellText}"/>

                            <!-- ── Name ────────────────────────────────── -->
                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding Name}"
                                                IsReadOnly="True"
                                                Width="1.8*"
                                                MinWidth="120"
                                                ElementStyle="{StaticResource WrapCellText}"/>

                            <!-- ── Description ─────────────────────────── -->
                            <DataGridTextColumn Header="Description"
                                                Binding="{Binding Description}"
                                                IsReadOnly="True"
                                                Width="2.2*"
                                                MinWidth="130"
                                                ElementStyle="{StaticResource WrapCellText}"/>

                            <!-- ── Category ────────────────────────────── -->
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding Category}"
                                                IsReadOnly="True"
                                                Width="100"
                                                ElementStyle="{StaticResource CellText}"/>

                            <!-- ── Serial Number ───────────────────────── -->
                            <DataGridTextColumn Header="Serial No."
                                                Binding="{Binding SerialNumber}"
                                                IsReadOnly="True"
                                                Width="120"
                                                ElementStyle="{StaticResource WrapCellText}"/>

                            <!-- ── Model Number ────────────────────────── -->
                            <DataGridTextColumn Header="Model No."
                                                Binding="{Binding ModelNumber}"
                                                IsReadOnly="True"
                                                Width="120"
                                                ElementStyle="{StaticResource WrapCellText}"/>

                            <!-- ── Unit ────────────────────────────────── -->
                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding UnitOfMeasure}"
                                                IsReadOnly="True"
                                                Width="60"
                                                ElementStyle="{StaticResource CellText}"/>

                            <!-- ── Stock ───────────────────────────────── -->
                            <DataGridTextColumn Header="Stock"
                                                Binding="{Binding StockOnHand}"
                                                IsReadOnly="True"
                                                Width="55"
                                                ElementStyle="{StaticResource CellText}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ════════════════════════════════════════════════════════════ -->
            <!-- ROW 2 · FOOTER                                              -->
            <!-- ════════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: selection hint -->
                    <TextBlock x:Name="TxtSelectionHint"
                               Grid.Column="0"
                               FontSize="11.5" Foreground="#7A8A9A"
                               VerticalAlignment="Center"
                               Text="Check items to select, then click OK"/>

                    <!-- Center: pagination -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnPrevPage"
                                Style="{StaticResource PageBtn}"
                                Content="‹"
                                Margin="0,0,4,0"
                                Click="BtnPrevPage_Click"/>
                        <TextBlock x:Name="TxtPageInfo"
                                   FontSize="12" Foreground="#4A5A6A"
                                   VerticalAlignment="Center"
                                   Margin="4,0"/>
                        <Button x:Name="BtnNextPage"
                                Style="{StaticResource PageBtn}"
                                Content="›"
                                Margin="4,0,12,0"
                                Click="BtnNextPage_Click"/>
                        <TextBlock Text="Per page:"
                                   FontSize="11.5" Foreground="#7A8A9A"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <ComboBox x:Name="CmbPageSize"
                                  Width="62" Height="26"
                                  FontSize="12"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="CmbPageSize_SelectionChanged">
                            <ComboBoxItem Content="25"/>
                            <ComboBoxItem Content="50"/>
                            <ComboBoxItem Content="100"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Right: selected count / Cancel / OK -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BdrSelectedCount"
                                Background="#EBF3FF"
                                CornerRadius="10"
                                Padding="10,4"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="Click to view and remove selected items"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="BdrSelectedCount_Click">
                            <TextBlock x:Name="TxtSelectedCount"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#3A8EF6"
                                       TextDecorations="Underline"/>
                        </Border>
                        <Button Content="✕  Cancel"
                                Style="{StaticResource SecBtn}"
                                Margin="0,0,8,0"
                                Click="BtnCancel_Click"/>
                        <Button Content="✔  OK"
                                Style="{StaticResource PrimaryBtn}"
                                Click="BtnOk_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
