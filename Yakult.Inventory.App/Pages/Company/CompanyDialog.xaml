<Window x:Class="Yakult.Inventory.App.Pages.Company.CompanyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Company"
        Width="760" Height="760"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!-- ── Base TextBlock ─────────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ── Editable TextBox with animated focus ring ─────────────────── -->
        <Style x:Key="FormField" TargetType="TextBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"               Value="#C8D2DC"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#3A8EF6"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                                <Setter Property="Foreground"                 Value="#A0ADB9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Multiline variant ─────────────────────────────────────────── -->
        <Style x:Key="MultiField" TargetType="TextBox" BasedOn="{StaticResource FormField}">
            <Setter Property="Height"                      Value="Auto"/>
            <Setter Property="MinHeight"                   Value="72"/>
            <Setter Property="AcceptsReturn"               Value="True"/>
            <Setter Property="TextWrapping"                Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment"    Value="Top"/>
            <Setter Property="Padding"                     Value="8,6"/>
        </Style>

        <!-- ── ComboBox ──────────────────────────────────────────────────── -->
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="Foreground"               Value="#1A2333"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Padding"                  Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsTextSearchEnabled"      Value="True"/>
            <!-- While closed, mouse wheel over the combo should scroll the dialog, not
                 change the selected value — users were accidentally changing dropdown
                 selections while scrolling through the form. -->
            <EventSetter Event="PreviewMouseWheel" Handler="FormCombo_PreviewMouseWheel"/>
        </Style>

        <!-- ── DatePicker — replaces "15" glyph with classic calendar icon ─── -->
        <Style x:Key="FormDate" TargetType="DatePicker">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#1A2333"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#C8D2DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Padding="8,0"
                                                   VerticalAlignment="Center"
                                                   VerticalContentAlignment="Center"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="28" Height="26">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBd" Background="Transparent"
                                                    CornerRadius="3" Padding="4,3">
                                                <Path Data="M3,2 L3,0 M9,2 L9,0 M0,4 L12,4 M0,2 L0,12 L12,12 L12,2 Z M2,6 L4,6 M6,6 L8,6 M10,6 L12,6 M2,9 L4,9 M6,9 L8,9"
                                                      Stroke="#5A6A7A" StrokeThickness="1"
                                                      Stretch="Uniform" Width="14" Height="14"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Background" Value="#E8ECF0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                                <Setter Property="Foreground" Value="#A0ADB9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Field label ───────────────────────────────────────────────── -->
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11.5"/>
            <Setter Property="Foreground"        Value="#4A5A6A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="0,0,12,0"/>
        </Style>

        <!-- ── Section title ─────────────────────────────────────────────── -->
        <Style x:Key="ST" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#3A8EF6"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- ── White card ────────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="Padding"         Value="18,12"/>
            <Setter Property="Margin"          Value="0,0,0,8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1"
                                      Opacity="0.06" Direction="270" Color="#0A1A2A"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary action button (Save) ──────────────────────────────── -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height"          Value="38"/>
            <Setter Property="Padding"         Value="26,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#3A8EF6"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary button (Cancel) ──────────────────────────────────── -->
        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>

        <!-- ── Small inline button (+Add) ────────────────────────────────── -->
        <Style x:Key="InlineBtn" TargetType="Button">
            <Setter Property="Height"          Value="32"/>
            <Setter Property="MinWidth"        Value="46"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="11.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"      Value="#E8F0FE"/>
            <Setter Property="Foreground"      Value="#3A8EF6"/>
            <Setter Property="Margin"          Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CDD9F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════════════ -->
    <!-- Outer shell — rounded corners + drop shadow                         -->
    <!-- ════════════════════════════════════════════════════════════════════ -->
    <Border CornerRadius="10" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5"
                              Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>    <!-- Header bar        -->
                <RowDefinition Height="*"/>     <!-- Scrollable body   -->
                <RowDefinition Height="66"/>    <!-- Footer bar        -->
            </Grid.RowDefinitions>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- ROW 0 · HEADER                                          -->
            <!-- ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="#3A8EF6"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="OnHeaderDrag"
                    Cursor="SizeAll">
                <DockPanel Margin="18,0,10,0" VerticalAlignment="Center">
                    <!-- Window chrome buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Cursor="Arrow">
                        <TextBlock Text="─" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center"
                                   Padding="8,0"
                                   MouseLeftButtonDown="OnMinimizeClick"/>
                        <TextBlock x:Name="BtnMaximizeGlyph"
                                   Text="□" FontSize="13" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center"
                                   Padding="8,0"
                                   MouseLeftButtonDown="OnMaximizeClick"/>
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"
                                   Foreground="#BDD9FF" Cursor="Hand"
                                   VerticalAlignment="Center"
                                   Padding="8,0"
                                   MouseLeftButtonDown="OnCloseClick"/>
                    </StackPanel>
                    <TextBlock x:Name="HeaderTitle" Text="Add Company"
                               VerticalAlignment="Center"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White"/>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- ROW 1 · SCROLLABLE BODY                                 -->
            <!-- ════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="1"
                          Background="#F0F2F6"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,10,16,2">
                <StackPanel>

                    <!-- Info banner ──────────────────────────────────── -->
                    <Border Background="#EEF4FF" BorderBrush="#BDD0F8"
                            BorderThickness="1" CornerRadius="6"
                            Padding="12,7" Margin="0,0,0,5">
                        <TextBlock x:Name="InfoBanner" FontSize="11" Foreground="#2A5BC8"
                                   TextWrapping="Wrap"
                                   Text="Enter company details. You may optionally add departments and branches, then click Save."/>
                    </Border>

                    <!-- ════════════════════════════════════════════════ -->
                    <!-- SECTION 1 · COMPANY INFORMATION                 -->
                    <!-- ════════════════════════════════════════════════ -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="COMPANY INFORMATION" Style="{StaticResource ST}"/>

                            <!-- Company Name -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Company Name *" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtCompanyName" Grid.Column="1"
                                         Style="{StaticResource FormField}"/>
                            </Grid>

                            <!-- Description -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Description" Style="{StaticResource FL}"
                                           VerticalAlignment="Top" Margin="0,6,12,0"/>
                                <TextBox x:Name="TxtCompanyDesc" Grid.Column="1"
                                         Style="{StaticResource MultiField}"/>
                            </Grid>

                            <!-- Date Created -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Date Created" Style="{StaticResource FL}"/>
                                <DatePicker x:Name="DpCreated" Grid.Column="1"
                                            Style="{StaticResource FormDate}"
                                            HorizontalAlignment="Left" Width="220"/>
                            </Grid>

                            <!-- Created By -->
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Created By" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtCreatedBy" Grid.Column="1"
                                         Style="{StaticResource FormField}"
                                         IsEnabled="False" IsTabStop="False"
                                         HorizontalAlignment="Left" Width="260"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════════ -->
                    <!-- SECTION 2 · STATUS (edit mode only)             -->
                    <!-- ════════════════════════════════════════════════ -->
                    <Border x:Name="SectionStatus" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="STATUS" Style="{StaticResource ST}"/>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ChkActive" Content="Active"
                                          IsChecked="True"
                                          Margin="0,0,24,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkIsArchived" Content="Is Archived"
                                          VerticalAlignment="Center"
                                          Checked="ChkIsArchived_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════════ -->
                    <!-- SECTION 3 · ADD DEPARTMENTS (create mode only)  -->
                    <!-- ════════════════════════════════════════════════ -->
                    <Border x:Name="SectionDepartments" Style="{StaticResource Card}" Visibility="Visible">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkAddDepartments"
                                          Content="Add Departments (optional)"
                                          VerticalAlignment="Center"
                                          Checked="ChkAddDepartments_CheckedChanged"
                                          Unchecked="ChkAddDepartments_CheckedChanged"/>
                                <Button x:Name="BtnAddDept" Grid.Column="1"
                                        Content="+ Add" Style="{StaticResource InlineBtn}"
                                        Visibility="Collapsed"
                                        Click="BtnAddDept_Click"/>
                            </Grid>

                            <StackPanel x:Name="PnlDepartmentRows" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- ════════════════════════════════════════════════ -->
                    <!-- SECTION 4 · ADD BRANCHES (create mode only)     -->
                    <!-- ════════════════════════════════════════════════ -->
                    <Border x:Name="SectionBranches" Style="{StaticResource Card}" Visibility="Visible">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkAddBranches"
                                          Content="Add Branches (optional)"
                                          VerticalAlignment="Center"
                                          Checked="ChkAddBranches_CheckedChanged"
                                          Unchecked="ChkAddBranches_CheckedChanged"/>
                                <Button x:Name="BtnAddBranch" Grid.Column="1"
                                        Content="+ Add" Style="{StaticResource InlineBtn}"
                                        Visibility="Collapsed"
                                        Click="BtnAddBranch_Click"/>
                            </Grid>

                            <StackPanel x:Name="PnlBranchRows" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Resize grip spacer -->
                    <Border Height="8" Background="Transparent"/>

                </StackPanel>
            </ScrollViewer>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- ROW 2 · FOOTER                                          -->
            <!-- ════════════════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="#DDE3EC" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <DockPanel Margin="20,0" VerticalAlignment="Center" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancel"
                                Style="{StaticResource SecBtn}" Margin="0,0,8,0"
                                Click="BtnCancel_Click" IsCancel="True"/>
                        <Button x:Name="BtnSave" Content="Save"
                                Style="{StaticResource PrimaryBtn}"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
