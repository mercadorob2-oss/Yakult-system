<Window x:Class="Yakult.Inventory.App.Pages.Invoice.ConvertToParentTagGroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Convert to Parent Tag Group"
        Width="1040" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E6F0FF" BorderBrush="#BBD6F5" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap"
                       Text="Check the items that belong together, type or pick their Parent Tag below, then Add to Group. Repeat for as many tags as this invoice needs. Parent Tag is a free-text label (e.g. &quot;Cisco&quot;) with no financial effect — it's a display grouping only, independent of Sub-Type."/>
        </Border>

        <!-- ── All invoice items, with a checkbox column for the current batch ─────── -->
        <DataGrid x:Name="Grid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F9FF"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="1"
                  RowHeight="32">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="6"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.HeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTemplateColumn.HeaderStyle>
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="ChkSelectAll" Click="ChkSelectAll_Click" ToolTip="Select all rows"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="SetItemId" Binding="{Binding SetItemId}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item/License Name" Binding="{Binding ItemName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Current Parent Tag" Binding="{Binding GroupLabel}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Parent Tag for the checked batch ─────────────────────────────── -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderBrush="#DDE3EC" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TxtSelectedCount" Text="0 item(s) checked" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Parent Tag * (type or pick an existing label)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbParentTag" Style="{StaticResource FieldBox}"
                                  IsEditable="True" IsTextSearchEnabled="True"/>
                    </StackPanel>

                    <Button x:Name="BtnAddToGroup" Grid.Column="2" Content="Add Checked Items to Group"
                            Width="220" Height="36" VerticalAlignment="Bottom"
                            Background="#2F6FED" Foreground="White" BorderThickness="0"
                            Click="BtnAddToGroup_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="#4A5568"/>
            <Button Grid.Column="1" x:Name="BtnClose" Content="Close" Width="110" Height="36" Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
