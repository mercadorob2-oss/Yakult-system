<Window x:Class="Yakult.Inventory.App.Pages.Invoice.BatchAddInvoiceItemsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Add Invoice Items"
        Width="1080" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#4A5568"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E6F0FF" BorderBrush="#BBD6F5" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <TextBlock Text="Check the items to add, then optionally add them to an existing Sub-Type Group on this invoice, or convert them into a brand new one."
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ── Sub-Type Group (optional, applies to all checked items) ─────────── -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#DDE3EC" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Convert to Sub-Type Group (optional)" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sub-Type" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbSubType" Style="{StaticResource FieldBox}" SelectionChanged="CmbSubType_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Group" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbExistingGroup" Style="{StaticResource FieldBox}" IsEnabled="False" SelectionChanged="CmbExistingGroup_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="LblReferenceCode" Text="Reference Code" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtReferenceCode" Style="{StaticResource FieldBox}" VerticalContentAlignment="Center" Padding="6,0" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Start Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DtpStart" Style="{StaticResource FieldBox}" IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="End Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DtpEnd" Style="{StaticResource FieldBox}" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <DataGrid x:Name="Grid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#F5F9FF"
                  Background="White"
                  BorderBrush="#DDE3EC"
                  BorderThickness="1"
                  RowHeight="32">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="6"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Add" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="Type" Binding="{Binding ItemType}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Item Name" Binding="{Binding ItemName}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Model" Binding="{Binding ModelNumber}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="UOM" Binding="{Binding UnitOfMeasure}" Width="70" IsReadOnly="True"/>
                <DataGridTextColumn Header="Unit Price" Binding="{Binding Amount, StringFormat=N2}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Filter Items" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtSearch" Grid.Column="1" Height="28" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" Margin="0,0,16,0"/>
                <TextBlock Text="Category:" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbCategory" Grid.Column="3" Width="160" Height="28" SelectionChanged="CmbCategory_SelectionChanged"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtSelectedCount" Text="0 item(s) selected" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="36" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Content="Add Selected" Width="130" Height="36" Background="#2F6FED" Foreground="White" BorderThickness="0" Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
