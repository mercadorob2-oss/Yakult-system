<Window x:Class="Yakult.Inventory.App.Pages.Invoice.DeleteInvoiceLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource YakultPageBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Yakult.Inventory.App;component/Wpf/Shared/Styles/YakultPalette.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


    <Border Background="White" Margin="16" CornerRadius="10" Padding="20" BorderBrush="{StaticResource YakultBorderBrush}" BorderThickness="1">
        <StackPanel>
            <Border Background="#FFF2CC" BorderBrush="#E0C36A" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <TextBlock x:Name="TxtTitle" TextWrapping="Wrap" FontWeight="Bold"/>
            </Border>
            <TextBlock x:Name="TxtNote" TextWrapping="Wrap" Foreground="#4A5568" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Cancel" Width="100" Height="34" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnDeleteGroup" Content="Delete Entire Group" Width="160" Height="34" Margin="0,0,8,0"
                        Background="#C0392B" Foreground="White" BorderThickness="0" Click="BtnDeleteGroup_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnDeleteRow" Content="Delete Row" Width="120" Height="34"
                        Background="{StaticResource YakultPrimaryBrush}" Foreground="White" BorderThickness="0" Click="BtnDeleteRow_Click" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
