<Window x:Class="Yakult.Inventory.App.Pages.Invoice.ViewInvoiceDetailPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Invoice Details"
        Width="1600" Height="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="#F0F2F6">

    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#4A5A6A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,10"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,16,10"/>
        </Style>
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE3EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A2333"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#3A8EF6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
        </Style>
        <Style x:Key="SmallActionBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#E8ECF0"/>
            <Setter Property="Foreground" Value="#3A4A5A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Top banner ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#007ACC" Padding="24,14">
            <StackPanel>
                <TextBlock Text="Invoice Details" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="LblCreatedBy" Text="Created By: -" FontSize="12" Foreground="White" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ══ Scrollable body ═════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">

                <!-- ── Invoice Details ────────────────────────────────────── -->
                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Invoice Details" Style="{StaticResource GroupHeader}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="BtnLinkReceiptSet" Content="Link Receipt Set" Style="{StaticResource SmallActionBtn}" Click="BtnLinkReceiptSet_Click"/>
                                <Button x:Name="BtnAttachReceipt" Content="Attach Receipt" Style="{StaticResource SmallActionBtn}" Margin="0" Click="BtnAttachReceipt_Click"/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Set Code" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtSetCode" IsReadOnly="True" Background="#F5F7FA"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Item Count" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtItemCount" IsReadOnly="True" Background="#F5F7FA"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Document Number" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtDocumentNumber"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Reference Number" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtReferenceNumber"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Invoice Date" Style="{StaticResource FL}"/>
                                <DatePicker x:Name="DtpDate"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Company" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbCompany" DisplayMemberPath="CompanyName" SelectedValuePath="ComId"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Distributor" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbDistributor" DisplayMemberPath="DistributorName" SelectedValuePath="DistributorId"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Status" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbStatus">
                                    <ComboBoxItem Content="Yes"/>
                                    <ComboBoxItem Content="No"/>
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Site" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtSite" Margin="0,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Requested By (Employee)" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbRequestedBy" IsEditable="True"
                                          DisplayMemberPath="Name" SelectedValuePath="EmpId"
                                          ToolTip="The employee this invoice is for. Defaults to the requester of the originating Set; change it here to override."/>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Company (Site)" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbSiteCompany" IsEditable="True" DisplayMemberPath="CompanyName" SelectedValuePath="ComId"
                                          SelectionChanged="SiteBuilder_SelectionChanged" LostFocus="SiteBuilder_LostFocus"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Branch" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbSiteBranch" IsEditable="True" DisplayMemberPath="BranchName" SelectedValuePath="BranchId"
                                          SelectionChanged="SiteBuilder_SelectionChanged" LostFocus="SiteBuilder_LostFocus"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Department" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbSiteDepartment" IsEditable="True" DisplayMemberPath="DepartmentName" SelectedValuePath="DeptId"
                                          SelectionChanged="SiteBuilder_SelectionChanged" LostFocus="SiteBuilder_LostFocus"/>
                            </StackPanel>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="License Start Date" Style="{StaticResource FL}"/>
                                <DatePicker x:Name="DtpStartDate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="License End Date" Style="{StaticResource FL}"/>
                                <DatePicker x:Name="DtpEndDate"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,14,0,0">
                                <CheckBox x:Name="ChkOverrideLineItemDates" Content="Sync line item dates (match header)"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Financial Details + License Expiry ─────────────────── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GroupCard}" Margin="0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Financial Details" Style="{StaticResource GroupHeader}"/>
                                <TextBlock x:Name="LblFinancialExample" Grid.Column="1" Text="ⓘ See worked example"
                                           Foreground="#0066CC" TextDecorations="Underline" Cursor="Help"
                                           MouseLeftButtonUp="LblFinancialExample_Click"/>
                            </Grid>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Subtotal" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtSubtotal" TextChanged="TxtSubtotal_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Discount Amount (%)" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtDiscountAmount" TextChanged="TxtDiscountAmount_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="VAT Amount (%)" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtVatAmount" TextChanged="TxtVatAmount_TextChanged"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Total Amount Due" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtTotalAmountDue" IsReadOnly="True" Background="#F5F7FA"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="WHT Amount (%)" Style="{StaticResource FL}"/>
                                    <TextBox x:Name="TxtWhtAmount" TextChanged="TxtWhtAmount_TextChanged"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button x:Name="BtnCalculateFinancials" Content="Calculate" Click="BtnCalculateFinancials_Click"
                                        Padding="16,6" Margin="0,0,8,0"/>
                                <Button x:Name="BtnSaveFinancials" Content="Save" Style="{StaticResource PrimaryBtn}"
                                        Visibility="Collapsed" Padding="16,6" Click="BtnSave_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GroupCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="License Expiry" Style="{StaticResource GroupHeader}"/>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Days Left" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtDaysLeft" IsReadOnly="True" Background="#F5F7FA" HorizontalContentAlignment="Center" Width="100" HorizontalAlignment="Left"/>
                            </StackPanel>
                            <TextBlock Text="Status" Style="{StaticResource FL}"/>
                            <TextBlock x:Name="LblExpiryWarning" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Invoice Items ───────────────────────────────────────── -->
                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>
                        <TextBlock Text="Invoice Items" Style="{StaticResource GroupHeader}"/>

                        <WrapPanel x:Name="GroupSummaryPanel" Margin="0,0,0,10"/>

                        <DataGrid x:Name="DgvItems"
                                  AutoGenerateColumns="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#EEF0F4"
                                  VerticalGridLinesBrush="#EEF0F4"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F5F9FF"
                                  Background="White"
                                  BorderBrush="#DDE3EC"
                                  BorderThickness="1"
                                  MinRowHeight="36"
                                  MaxHeight="500"
                                  FontSize="12"
                                  Foreground="#1A2333"
                                  AutoGeneratingColumn="DgvItems_AutoGeneratingColumn"
                                  PreviewMouseWheel="DgvItems_PreviewMouseWheel"
                                  SelectionChanged="DgvItems_SelectionChanged">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#3498DB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGrid.Resources>

                            <!-- One full-width header bar per Sub-Type Group (Sub-Type +
                                 Reference Code), grouping items the same way
                                 dbo.vw_SetItemSubTypeGroups does — see
                                 SubTypeGroupKeyConverter in the code-behind. -->
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <!-- The default GroupItem container has its own margin/indent that leaves a
                                         gap where clicks fall through to the row above instead of this header —
                                         zero it out so the header Border below covers the full clickable area. -->
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- Selectable (in edit mode) so the whole Sub-Type Group can be picked
                                                 for removal via the Delete Row button — see GroupHeader_Click. -->
                                            <Border Background="#EAF1FB" BorderBrush="#DDE3EC"
                                                    BorderThickness="0,0,0,1" Padding="10,6"
                                                    Cursor="Hand" PreviewMouseLeftButtonDown="GroupHeader_Click">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                           Foreground="#3498DB"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ── Remarks ──────────────────────────────────────────────── -->
                <Border Style="{StaticResource GroupCard}">
                    <StackPanel>
                        <TextBlock Text="Remarks" Style="{StaticResource GroupHeader}"/>
                        <TextBox x:Name="TxtRemarks" Height="80" Margin="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <!-- ── Action buttons ──────────────────────────────────────── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnEdit" Content="Edit" Style="{StaticResource PrimaryBtn}" Width="110" Click="BtnEdit_Click"/>
                    <Button x:Name="BtnBulkAddItems" Content="Bulk Add Items" Style="{StaticResource SecBtn}" Width="130" Visibility="Collapsed" Click="BtnBulkAddItems_Click"/>
                    <Button x:Name="BtnConvertToSubType" Content="Convert to Sub-Type" Style="{StaticResource SecBtn}" Width="150" Visibility="Collapsed" Click="BtnConvertToSubType_Click"/>
                    <Button x:Name="BtnConvertToParentTag" Content="Convert to Parent Tag" Style="{StaticResource SecBtn}" Width="160" Visibility="Collapsed" Click="BtnConvertToParentTag_Click"/>
                    <Button x:Name="BtnDeleteRow" Content="Delete Row" Style="{StaticResource SecBtn}" Width="110" Visibility="Collapsed" Click="BtnDeleteRow_Click"/>
                    <Button x:Name="BtnSave" Content="Save" Style="{StaticResource PrimaryBtn}" Width="110" Visibility="Collapsed" Click="BtnSave_Click"/>
                    <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecBtn}" Width="110" Visibility="Collapsed" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnClose" Content="Close" Style="{StaticResource SecBtn}" Width="110" Margin="0" Click="BtnClose_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
