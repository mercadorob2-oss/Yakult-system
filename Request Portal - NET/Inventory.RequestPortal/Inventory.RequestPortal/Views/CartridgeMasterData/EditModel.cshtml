@model Inventory.RequestPortal.Models.CartridgeModelDto
@{
    ViewData["Title"] = "Edit Cartridge Model";
}

@await Html.PartialAsync("_CartridgeManagementNav")

<div class="portal-header d-flex align-items-center gap-3">
    <button class="btn btn-link text-white p-0 lh-1" data-bs-toggle="offcanvas" data-bs-target="#navSidebar"
            style="font-size:1.4rem; text-decoration:none;" title="Menu">
        <i class="bi bi-list"></i>
    </button>
    <div>
        <h1>Edit Cartridge Model</h1>
        <p class="subtitle mb-0">@Model.ModelNumber</p>
    </div>
</div>

<div class="content-padded">
    <div class="card" style="max-width:520px;">
        <div class="card-body">
            <form method="post" asp-action="EditModel">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CartridgeModelId" />
                <input type="hidden" asp-for="IsActive" />
                <input type="hidden" asp-for="CreatedBy" />

                <div class="mb-3">
                    <label class="form-label">Model Number *</label>
                    <input asp-for="ModelNumber" class="form-control" required>
                </div>
                <div class="form-check mb-2">
                    <input asp-for="IsRequestable" class="form-check-input" id="chkRequestable">
                    <label class="form-check-label" for="chkRequestable">Is Requestable</label>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="IsRefillable" class="form-check-input" id="chkRefillable">
                    <label class="form-check-label" for="chkRefillable">Is Refillable</label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Save</button>
                    <a asp-action="Models" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
