@inject Microsoft.AspNetCore.Http.IHttpContextAccessor _HttpCtx
@using Inventory.RequestPortal.Extensions
@using Inventory.RequestPortal.Models
@using Inventory.RequestPortal.Controllers
@{
    var _notifSession = _HttpCtx.HttpContext?.Session.GetObject<UserSessionModel>(AccountController.SessionKeyUser);
    bool _notificationsEnabled = _notifSession?.NotificationsEnabled ?? true;
}
@* ── Desktop notification permission modal ── *@
<div id="notifPermModal" style="display:none;position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(2px);z-index:100000;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:36px 32px 28px;width:390px;max-width:calc(100vw - 32px);box-shadow:0 20px 60px rgba(0,0,0,.2);text-align:center;animation:notifPermIn .18s ease;">
        <div style="width:56px;height:56px;border-radius:50%;background:#eff6ff;color:#3b82f6;font-size:1.45rem;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">
            <i class="bi bi-bell-fill"></i>
        </div>
        <h6 style="font-size:1.05rem;font-weight:700;color:#0f172a;margin:0 0 10px;">Enable Notifications</h6>
        <p style="font-size:.85rem;color:#64748b;line-height:1.6;margin:0 0 24px;">
            Enable notifications to receive alerts for new requests, approvals, rejections, completions, and other request updates.
        </p>
        <div style="display:flex;flex-direction:column;gap:10px;">
            <button onclick="notifPermEnable()" style="padding:11px;border-radius:9px;border:none;background:#3b82f6;color:#fff;font-size:.9rem;font-weight:600;cursor:pointer;">
                <i class="bi bi-bell-fill"></i>&nbsp; Enable Notifications
            </button>
            <button onclick="notifPermLater()" style="padding:11px;border-radius:9px;border:none;background:#f1f5f9;color:#64748b;font-size:.9rem;font-weight:500;cursor:pointer;">
                Maybe Later
            </button>
        </div>
        <label style="display:flex;align-items:center;justify-content:center;gap:7px;font-size:.8rem;color:#64748b;margin:16px 0 0;cursor:pointer;">
            <input type="checkbox" id="notifPermDontAsk" style="cursor:pointer;">
            Don't show again
        </label>
    </div>
</div>
<style>
    @@keyframes notifPermIn {
        from { opacity: 0; transform: scale(.92) translateY(-10px); }
        to   { opacity: 1; transform: scale(1)  translateY(0); }
    }
</style>
<script>
// Exposed globally so the permission IIFE below can read it.
// Overridden client-side by localStorage so the icon updates immediately after
// the user saves settings without waiting for a full server-side re-render.
var NOTIFICATIONS_ENABLED = (function() {
    var stored = localStorage.getItem('yakult_notif_enabled');
    return stored !== null ? stored === 'true' : @(_notificationsEnabled ? "true" : "false");
})();

// Apply the correct bell icon immediately based on the resolved value.
(function() {
    function applyBellState(enabled) {
        var icon = document.querySelector('#notifBellBtn i');
        var btn  = document.getElementById('notifBellBtn');
        if (icon) icon.className = enabled ? 'bi bi-bell-fill' : 'bi bi-bell-slash-fill';
        if (btn)  btn.title      = enabled ? 'Notifications' : 'Notifications (Silent)';
        NOTIFICATIONS_ENABLED = enabled;
    }
    // Run on DOMContentLoaded and also on pageshow (handles browser back/forward cache).
    function sync() {
        var stored = localStorage.getItem('yakult_notif_enabled');
        if (stored !== null) applyBellState(stored === 'true');
    }
    document.addEventListener('DOMContentLoaded', sync);
    window.addEventListener('pageshow', sync);
})();
</script>
<script>
(function () {
    const PERM_LS_KEY  = 'yakult_notif_perm';   // localStorage:   'granted' | 'dismissed'
    const PERM_SS_KEY  = 'yakult_notif_later';   // sessionStorage: '1' = skip this session

    function shouldShowPermModal() {
        if (!('Notification' in window)) return false;
        if (Notification.permission === 'granted' || Notification.permission === 'denied') return false;
        if (localStorage.getItem(PERM_LS_KEY)) return false;
        if (sessionStorage.getItem(PERM_SS_KEY)) return false;
        return true;
    }

    window.notifPermEnable = function () {
        document.getElementById('notifPermModal').style.display = 'none';
        Notification.requestPermission().then(function (perm) {
            localStorage.setItem(PERM_LS_KEY, perm === 'granted' ? 'granted' : 'dismissed');
        });
    };

    window.notifPermLater = function () {
        var dontAsk = document.getElementById('notifPermDontAsk');
        if (dontAsk && dontAsk.checked) {
            // Permanent: shouldShowPermModal() bails when PERM_LS_KEY is set.
            localStorage.setItem(PERM_LS_KEY, 'dismissed');
        } else {
            // This browser session only.
            sessionStorage.setItem(PERM_SS_KEY, '1');
        }
        document.getElementById('notifPermModal').style.display = 'none';
    };

    document.addEventListener('DOMContentLoaded', function () {
        if (!NOTIFICATIONS_ENABLED) return;
        if (shouldShowPermModal()) {
            document.getElementById('notifPermModal').style.display = 'flex';
        }
    });
})();
</script>

@* ── Custom confirm modal used by notifClearAll ── *@
<div id="notifConfirmModal" class="notif-modal-backdrop">
    <div class="notif-modal-box" role="dialog" aria-modal="true">
        <div class="notif-modal-icon">
