        <div class="notif-modal-actions">
            <button class="notif-modal-btn notif-modal-btn--cancel" id="notifConfirmCancel">Cancel</button>
            <button class="notif-modal-btn notif-modal-btn--ok" id="notifConfirmOk">Clear all</button>
