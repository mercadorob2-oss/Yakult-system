@* Notification Bell — drop this partial anywhere inside a header.
   Requires: Bootstrap Icons, jQuery or vanilla fetch (site.js provides jQuery).
   The parent header must be position:relative or have a positioned ancestor for
   the dropdown to anchor correctly. *@

<style>
    /* ── Bell button ─────────────────────────────────────── */
    .notif-bell-wrap {
        position: relative;
        display: inline-flex;
        align-items: center;
    }

    .notif-bell-btn {
        position: relative;
        background: transparent;
        border: none;
        color: var(--text-strong, #33393f);
        border-radius: 6px;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.25rem;
        opacity: 0.8;
        transition: opacity 0.15s;
        flex-shrink: 0;
        padding: 0;
    }

    .notif-bell-btn:hover {
        opacity: 1;
    }

    .notif-bell-btn.notif-bell-open {
        opacity: 1;
    }

    /* ── Unread badge ────────────────────────────────────── */
    .notif-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        min-width: 18px;
        height: 18px;
        padding: 0 4px;
        background: #ff3b3b;
        color: #fff;
        border-radius: 9px;
        font-size: 0.68rem;
        font-weight: 700;
        text-align: center;
        pointer-events: none;
        display: none;
        box-shadow: 0 1px 4px rgba(0,0,0,0.3);
        border: 2px solid rgba(26,26,46,0.6);
    }

    .notif-badge.notif-badge--visible {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ── Dropdown panel ──────────────────────────────────── */
    /* position:fixed (not absolute) — the bell lives inside .portal-header, which has a
       deliberate height + overflow:hidden (keeps the red bottom border aligned across pages,
       see site.css). An absolutely-positioned dropdown gets clipped almost entirely by that
       ancestor; fixed positioning escapes it. top/right are set via JS (notifToggle) from the
       bell button's actual on-screen position each time the panel opens. */
    .notif-dropdown {
        display: none;
        position: fixed;
        width: 360px;
        max-width: calc(100vw - 24px);
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.18), 0 2px 8px rgba(0,0,0,0.1);
        z-index: 9000;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.08);
        animation: notifSlideIn 0.15s ease;
    }

    .notif-dropdown.notif-dropdown--open {
        display: block;
    }

    @@keyframes notifSlideIn {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* ── Panel header ────────────────────────────────────── */
    .notif-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px 10px;
        border-bottom: 1px solid #f0f0f0;
    }

    .notif-panel-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: #1a1a2e;
        letter-spacing: -0.2px;
    }

    .notif-mark-all-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 0.78rem;
        font-weight: 600;
        color: #d50032;
        padding: 0;
        transition: opacity 0.15s;
    }

    .notif-mark-all-btn:hover { opacity: 0.75; }

    /* ── Notification list ───────────────────────────────── */
    .notif-list {
        max-height: 420px;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .notif-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 40px 16px;
        color: #aaa;
        font-size: 0.88rem;
    }

    .notif-empty i { font-size: 2rem; }

    /* ── Notification item ───────────────────────────────── */
    .notif-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px 14px;
        text-decoration: none !important;
        color: inherit;
        border-bottom: 1px solid #f5f5f5;
        transition: background 0.1s;
        position: relative;
    }

    .notif-item:last-child { border-bottom: none; }

    .notif-item:hover {
        background: #f8f9fa;
        color: inherit;
    }

    .notif-item--unread {
        background: #fffaf5;
    }

    .notif-item--unread:hover { background: #fff4eb; }

    /* ── Icon circle ─────────────────────────────────────── */
    .notif-item-icon {
        flex-shrink: 0;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        margin-top: 1px;
    }

    .notif-icon--green  { background: #e8f5e9; color: #2e7d32; }
    .notif-icon--red    { background: #fdecea; color: #c62828; }
    .notif-icon--blue   { background: #e3f2fd; color: #1565c0; }
    .notif-icon--gray   { background: #f5f5f5; color: #757575; }
    .notif-icon--orange { background: #fff3e0; color: #e65100; }

    /* ── Text ────────────────────────────────────────────── */
    .notif-item-body { flex: 1; min-width: 0; }

    .notif-item-title {
        font-size: 0.85rem;
        font-weight: 600;
        color: #1a1a2e;
        line-height: 1.3;
        margin-bottom: 2px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .notif-item-msg {
        font-size: 0.78rem;
        color: #666;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .notif-item-time {
        font-size: 0.72rem;
        color: #aaa;
        margin-top: 4px;
    }

    /* ── Unread dot ──────────────────────────────────────── */
    .notif-unread-dot {
        flex-shrink: 0;
        width: 8px;
        height: 8px;
        background: #d50032;
        border-radius: 50%;
        margin-top: 6px;
    }

    /* ── Loading state ───────────────────────────────────── */
    .notif-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        color: #bbb;
        font-size: 0.88rem;
        gap: 8px;
    }
</style>

<div class="notif-bell-wrap" id="notifBellWrap">
    <button class="notif-bell-btn" id="notifBellBtn"
            title="@(_notificationsEnabled ? "Notifications" : "Notifications (Silent)")"
            type="button" onclick="notifToggle(event)">
        <i class="bi @(_notificationsEnabled ? "bi-bell-fill" : "bi-bell-slash-fill")"></i>
        <span class="notif-badge" id="notifBadge"></span>
    </button>

    <div class="notif-dropdown" id="notifDropdown">
        <div class="notif-loading" id="notifLoading">
            <span class="spinner-border spinner-border-sm" role="status"></span>
            Loading…
        </div>
        <div id="notifPanelContent"></div>
    </div>
</div>

<script>
(function () {
    const POLL_INTERVAL   = 60000; // 60 s
    const SHOWN_IDS_KEY   = 'yakult_notif_shown'; // localStorage: JSON array of shown notification IDs
    let panelLoaded = false;
    let panelOpen   = false;

    // ── Helpers ───────────────────────────────────────────
    function getShownIds() {
        try { return JSON.parse(localStorage.getItem(SHOWN_IDS_KEY) || '[]'); } catch { return []; }
    }
    function addShownId(id) {
        const ids = getShownIds();
        if (!ids.includes(id)) {
            ids.push(id);
            if (ids.length > 200) ids.splice(0, ids.length - 200); // cap at 200
            localStorage.setItem(SHOWN_IDS_KEY, JSON.stringify(ids));
        }
    }

    // ── Desktop notification dispatch ─────────────────────
    function showDesktopNotification(notif) {
        if (!('Notification' in window) || Notification.permission !== 'granted') return;
        const shown = getShownIds();
        if (shown.includes(notif.notificationId)) return;

        addShownId(notif.notificationId);

        const n = new Notification(notif.title, {
            body: notif.message,
            icon: '/favicon.ico'
        });
        n.onclick = function () {
            window.focus();
            const ref = notif.referenceId ? ('&referenceId=' + notif.referenceId) : '';
            window.location.href = '/Notification/Navigate?id=' + notif.notificationId
                + '&type=' + encodeURIComponent(notif.notificationType) + ref;
        };
    }

    function checkDesktopNotifications() {
        if (!('Notification' in window) || Notification.permission !== 'granted') return;
        fetch('/Notification/RecentUnread', { credentials: 'same-origin' })
            .then(r => r.ok ? r.json() : null)
            .then(function (list) {
                if (!list || !list.length) return;
                list.forEach(showDesktopNotification);
            })
            .catch(() => {});
    }

    // ── Badge polling ─────────────────────────────────────
    function pollUnreadCount() {
        if (!NOTIFICATIONS_ENABLED) return;
        fetch('/Notification/UnreadCount', { credentials: 'same-origin' })
            .then(r => r.ok ? r.json() : null)
            .then(data => {
                if (!data) return;
                const badge = document.getElementById('notifBadge');
                if (!badge) return;
                if (data.count > 0) {
                    badge.textContent = data.count > 99 ? '99+' : data.count;
                    badge.classList.add('notif-badge--visible');
                } else {
                    badge.classList.remove('notif-badge--visible');
                    badge.textContent = '';
                }
                if (data.count > 0) checkDesktopNotifications();
            })
            .catch(() => {});
    }

    if (NOTIFICATIONS_ENABLED) {
        pollUnreadCount();
        setInterval(pollUnreadCount, POLL_INTERVAL);
    }

    // Cross-tab nudge: the Notification Settings page (which has no bell of its own)
    // writes 'yakult_notif_ping' after a Test Notification or a save, so any other
    // open portal tab refreshes its badge immediately instead of waiting for the poll.
    window.addEventListener('storage', function (e) {
        if (e.key === 'yakult_notif_enabled') NOTIFICATIONS_ENABLED = e.newValue === 'true';
        if ((e.key === 'yakult_notif_ping' || e.key === 'yakult_notif_enabled') && NOTIFICATIONS_ENABLED) {
            pollUnreadCount();
        }
    });

    // ── Toggle panel ──────────────────────────────────────
    function positionDropdown() {
        const dropdown = document.getElementById('notifDropdown');
        const btn      = document.getElementById('notifBellBtn');
        if (!dropdown || !btn) return;
        const rect = btn.getBoundingClientRect();
        dropdown.style.top   = (rect.bottom + 10) + 'px';
        dropdown.style.right = (window.innerWidth - rect.right) + 'px';
    }

    function closeDropdown() {
        panelOpen = false;
        const dropdown = document.getElementById('notifDropdown');
        const btn      = document.getElementById('notifBellBtn');
        if (dropdown) dropdown.classList.remove('notif-dropdown--open');
        if (btn) btn.classList.remove('notif-bell-open');
    }

    window.notifToggle = function (e) {
        e.stopPropagation();
        const dropdown = document.getElementById('notifDropdown');
        const btn      = document.getElementById('notifBellBtn');
        panelOpen = !panelOpen;

        if (panelOpen) positionDropdown();
        dropdown.classList.toggle('notif-dropdown--open', panelOpen);
        btn.classList.toggle('notif-bell-open', panelOpen);

        if (panelOpen && !panelLoaded) {
            loadPanel();
        }
    };

    // position:fixed means the panel won't follow the page as it scrolls/resizes on its own
    // — simplest correct behavior is to close it rather than let it drift from the bell.
    window.addEventListener('scroll', function () { if (panelOpen) closeDropdown(); }, true);
    window.addEventListener('resize', function () { if (panelOpen) closeDropdown(); });

    function loadPanel() {
        fetch('/Notification/Panel', { credentials: 'same-origin' })
            .then(r => r.ok ? r.text() : '<div class="notif-loading">Failed to load.</div>')
            .then(html => {
                document.getElementById('notifLoading').style.display = 'none';
                document.getElementById('notifPanelContent').innerHTML = html;
                panelLoaded = true;
            })
            .catch(() => {
                document.getElementById('notifLoading').textContent = 'Failed to load.';
            });
    }

    // ── Click outside closes ──────────────────────────────
    document.addEventListener('click', function (e) {
        const wrap = document.getElementById('notifBellWrap');
        if (wrap && !wrap.contains(e.target) && panelOpen) {
            closeDropdown();
        }
    });

    // ── Mark all as read ──────────────────────────────────
    window.notifMarkAllRead = function (btn) {
        const token = document.querySelector('meta[name="csrf-token"]')?.content
                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        fetch('/Notification/MarkAllRead', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type':             'application/x-www-form-urlencoded',
                'RequestVerificationToken': token ?? '',
            },
            body: '',
        })
        .then(r => r.ok ? r.json() : null)
        .then(data => {
            if (!data?.success) return;
            // Remove unread styling from all items
            document.querySelectorAll('.notif-item--unread').forEach(el => {
                el.classList.remove('notif-item--unread');
            });
            document.querySelectorAll('.notif-unread-dot').forEach(el => el.remove());
            // Clear badge
            const badge = document.getElementById('notifBadge');
            if (badge) {
                badge.classList.remove('notif-badge--visible');
                badge.textContent = '';
            }
            // Hide mark-all button
            if (btn) btn.style.display = 'none';
        })
        .catch(() => {});
    };

    // ── Clear all notifications ───────────────────────────
    window.notifClearAll = function (btn) {
        notifConfirm('Clear all notifications?', 'This will permanently remove all notifications and cannot be undone.', function () {
            _doClearAll(btn);
        });
    };

    function _doClearAll(btn) {
        const token = document.querySelector('meta[name="csrf-token"]')?.content
                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        fetch('/Notification/ClearAll', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type':             'application/x-www-form-urlencoded',
                'RequestVerificationToken': token ?? '',
            },
            body: '',
        })
        .then(r => r.ok ? r.json() : null)
        .then(data => {
            if (!data?.success) return;
            // Replace the panel content with empty state
            const content = document.getElementById('notifPanelContent');
            if (content) {
                content.innerHTML =
                    '<div class="notif-panel-head"><span class="notif-panel-title">Notifications</span></div>' +
                    '<div class="notif-list"><div class="notif-empty">' +
                    '<i class="bi bi-bell-slash"></i><span>No notifications yet</span>' +
                    '</div></div>';
            }
            // Clear badge
            const badge = document.getElementById('notifBadge');
            if (badge) {
                badge.classList.remove('notif-badge--visible');
                badge.textContent = '';
            }
            panelLoaded = false; // allow reload next open
        })
        .catch(() => {});
    }

    // ── Custom confirm dialog ─────────────────────────────
    window.notifConfirm = function (title, message, onConfirm) {
        const modal = document.getElementById('notifConfirmModal');
        document.getElementById('notifConfirmTitle').textContent   = title;
        document.getElementById('notifConfirmMessage').textContent = message;

        modal.classList.add('notif-modal--open');

        const btnOk     = document.getElementById('notifConfirmOk');
        const btnCancel = document.getElementById('notifConfirmCancel');

        function cleanup() {
            modal.classList.remove('notif-modal--open');
            btnOk.removeEventListener('click', handleOk);
            btnCancel.removeEventListener('click', handleCancel);
            modal.removeEventListener('click', handleBackdrop);
        }
        function handleOk()       { cleanup(); onConfirm(); }
        function handleCancel()   { cleanup(); }
        function handleBackdrop(e){ if (e.target === modal) cleanup(); }

        btnOk.addEventListener('click', handleOk);
        btnCancel.addEventListener('click', handleCancel);
        modal.addEventListener('click', handleBackdrop);
    };

    // ── Item click → mark read, then navigate ─────────────
    window.notifItemClick = function (e, el) {
        // Let the href navigate; POST mark-read fire-and-forget
        const id    = el.dataset.id;
        const token = document.querySelector('meta[name="csrf-token"]')?.content
                   || document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        fetch('/Notification/MarkRead', {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
                'Content-Type':             'application/x-www-form-urlencoded',
                'RequestVerificationToken': token ?? '',
            },
            body: 'notificationId=' + encodeURIComponent(id),
        }).catch(() => {});
        // Navigation proceeds via href
    };
})();
</script>
