@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var cartridgeAreaControllers = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "CartridgeExchange", "CartridgeFulfillment" };
    var requestFulfillmentControllers = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "RequestFulfillment" };
    bool inCartridgeArea = cartridgeAreaControllers.Contains(currentController);
    bool inRequestFulfillmentArea = requestFulfillmentControllers.Contains(currentController);
    bool inConsumableHub = currentController.Equals("ConsumableManagement", StringComparison.OrdinalIgnoreCase);
    bool inConsumableArea = inCartridgeArea || inRequestFulfillmentArea || inConsumableHub;

    // On the Consumable Management hub itself, show both sub-areas' links (it's the picker
    // page for both). Inside a specific sub-area (e.g. Cartridge Exchange), only show that
    // sub-area's own pages — don't clutter the Cartridge pages' nav with ink/toner links.
    bool showCartridgeLinks = inCartridgeArea || inConsumableHub;
    bool showRequestFulfillmentLinks = inRequestFulfillmentArea || inConsumableHub;

    string LinkClass(string controller, string action)
        => currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) && currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)
            ? "d-flex align-items-center gap-3 px-4 py-3 text-decoration-none fw-bold border-bottom"
            : "d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-dark border-bottom";
    // Selected state uses the soft blue nav-highlight (not red) — red stays reserved
    // for the brand header accent and Logout, matching _CartridgeManagementNav.cshtml.
    string LinkStyle(string controller, string action)
        => currentController.Equals(controller, StringComparison.OrdinalIgnoreCase) && currentAction.Equals(action, StringComparison.OrdinalIgnoreCase)
            ? "color:var(--yakult-blue-hover); background:var(--yakult-blue-light); border-left:4px solid var(--yakult-blue);"
            : "border-left:4px solid transparent;";
}

@* ── Master offcanvas nav — shared across every Request Portal / Consumable Management page.
     One partial instead of 9 hand-copied offcanvas blocks (7 identical/near-identical Request
     Portal copies + 2 Consumable Management ones), so role gating (IsITStaff/IsApprover/
     IsITDepartment) only needs to be correct in one place. White/red-accent header + blue
     nav-highlight to match the rest of the redesigned portal (see root.css tokens). ── *@
<style>
    #navSidebar .offcanvas-body a:hover {
        background: var(--yakult-blue-light);
    }
</style>
<div class="offcanvas offcanvas-start" tabindex="-1" id="navSidebar">
    <div class="offcanvas-header" style="background:#fff; color:var(--yakult-red); border-bottom:3px solid var(--yakult-red); height:var(--header-height); overflow:hidden; box-sizing:border-box;">
        <h6 class="offcanvas-title fw-bold mb-0">Navigation</h6>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0 d-flex flex-column">
        <ul class="list-unstyled mb-0">
            <li>
                <a class="d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-dark border-bottom"
                   asp-controller="PortalHub" asp-action="Index">
                    <i class="bi bi-grid-fill fs-5"></i>
                    <span>Back to Hub</span>
                </a>
            </li>
            @if (inConsumableArea)
            {
                <li>
                    <a class="d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-dark border-bottom"
                       asp-controller="Authorization" asp-action="Landing">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                        <span>Switch to Request Portal</span>
                    </a>
                </li>
                <li>
                    <a class="@LinkClass("ConsumableManagement", "Index")" style="@LinkStyle("ConsumableManagement", "Index")"
                       asp-controller="ConsumableManagement" asp-action="Index">
                        <i class="bi bi-house-door fs-5"></i>
                        <span>Consumable Management</span>
                    </a>
                </li>
                @if (showCartridgeLinks)
                {
                    <li>
                        <a class="@LinkClass("CartridgeExchange", "Index")" style="@LinkStyle("CartridgeExchange", "Index")"
                           asp-controller="CartridgeExchange" asp-action="Index">
                            <i class="bi bi-box-seam fs-5"></i>
                            <span>Cartridge Exchange</span>
                        </a>
                    </li>
                    <li>
                        <a class="@LinkClass("CartridgeFulfillment", "Unfulfilled")" style="@LinkStyle("CartridgeFulfillment", "Unfulfilled")"
                           asp-controller="CartridgeFulfillment" asp-action="Unfulfilled">
                            <i class="bi bi-hourglass-split fs-5"></i>
                            <span>Unfulfilled Cartridges</span>
                        </a>
                    </li>
                    <li>
                        <a class="@LinkClass("CartridgeFulfillment", "PartiallyFulfilled")" style="@LinkStyle("CartridgeFulfillment", "PartiallyFulfilled")"
                           asp-controller="CartridgeFulfillment" asp-action="PartiallyFulfilled">
                            <i class="bi bi-hourglass-split fs-5"></i>
                            <span>Partially Fulfilled Cartridges</span>
                        </a>
                    </li>
                    <li>
                        <a class="@LinkClass("CartridgeExchange", "History")" style="@LinkStyle("CartridgeExchange", "History")"
                           asp-controller="CartridgeExchange" asp-action="History">
                            <i class="bi bi-clock-history fs-5"></i>
                            <span>Fulfilled Cartridges</span>
                        </a>
                    </li>
                }
                @if (showRequestFulfillmentLinks)
                {
                    <li>
                        <a class="@LinkClass("RequestFulfillment", "Unfulfilled")" style="@LinkStyle("RequestFulfillment", "Unfulfilled")"
                           asp-controller="RequestFulfillment" asp-action="Unfulfilled">
                            <i class="bi bi-hourglass-split fs-5"></i>
                            <span>Unfulfilled Requests</span>
                        </a>
                    </li>
                    <li>
                        <a class="@LinkClass("RequestFulfillment", "PartiallyFulfilled")" style="@LinkStyle("RequestFulfillment", "PartiallyFulfilled")"
                           asp-controller="RequestFulfillment" asp-action="PartiallyFulfilled">
                            <i class="bi bi-hourglass-split fs-5"></i>
                            <span>Partially Fulfilled Requests</span>
                        </a>
                    </li>
                }
            }
            else
            {
                @if (ViewBag.IsITDepartment == true)
                {
                    <li>
                        <a class="d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-dark border-bottom"
                           asp-controller="ConsumableManagement" asp-action="Index">
                            <i class="bi bi-arrow-left-right fs-5"></i>
                            <span>Switch to Consumable Management</span>
                        </a>
                    </li>
                }
                <li>
                    <a class="@LinkClass("Request", "Index")" style="@LinkStyle("Request", "Index")"
                       asp-controller="Request" asp-action="Index">
                        <i class="bi bi-plus-circle fs-5"></i>
                        <span>New Request</span>
                    </a>
                </li>
                <li>
                    <a class="@LinkClass("Request", "MyRequests")" style="@LinkStyle("Request", "MyRequests")"
                       asp-controller="Request" asp-action="MyRequests">
                        <i class="bi bi-clock-history fs-5"></i>
                        <span>My Submitted Requests</span>
                    </a>
                </li>
                @if (ViewBag.IsITStaff == true)
                {
                    <li>
                        <a class="@LinkClass("Request", "AssistedRequest")" style="@LinkStyle("Request", "AssistedRequest")"
                           asp-controller="Request" asp-action="AssistedRequest">
                            <i class="bi bi-person-fill-gear fs-5"></i>
                            <span>IT Assisted Request</span>
                        </a>
                    </li>
                }
                @if (ViewBag.IsDeveloper == true)
                {
                    <li>
                        <a class="@LinkClass("Authorization", "DevQueue")" style="@LinkStyle("Authorization", "DevQueue")"
                           asp-controller="Authorization" asp-action="DevQueue">
                            <i class="bi bi-check2-square fs-5"></i>
                            <span>Authorization Queue</span>
                        </a>
                    </li>
                }
                @if (ViewBag.IsApprover == true)
                {
                    <li>
                        <a class="@LinkClass("Authorization", "SupervisorQueue")" style="@LinkStyle("Authorization", "SupervisorQueue")"
                           asp-controller="Authorization" asp-action="SupervisorQueue">
                            <i class="bi bi-check2-square fs-5"></i>
                            <span>Authorize Requests</span>
                        </a>
                    </li>
                    <li>
                        <a class="@LinkClass("Authorization", "History")" style="@LinkStyle("Authorization", "History")"
                           asp-controller="Authorization" asp-action="History">
                            <i class="bi bi-clock-history fs-5"></i>
                            <span>Authorization History</span>
                        </a>
                    </li>
                }
                else
                {
                    <li>
                        <a class="@LinkClass("Authorization", "EmployeeStatus")" style="@LinkStyle("Authorization", "EmployeeStatus")"
                           asp-controller="Authorization" asp-action="EmployeeStatus">
                            <i class="bi bi-shield-check fs-5"></i>
                            <span>Authorization</span>
                        </a>
                    </li>
                }
            }
            <li>
                <a class="d-flex align-items-center gap-3 px-4 py-3 text-decoration-none text-dark border-bottom"
                   href="/Account/MyAccount">
                    <i class="bi bi-person-circle fs-5"></i>
                    <span>Account</span>
                </a>
            </li>
            <li>
                <a class="@LinkClass("NotificationSettings", "Index")" style="@LinkStyle("NotificationSettings", "Index")"
                   asp-controller="NotificationSettings" asp-action="Index">
                    <i class="bi bi-bell-fill fs-5"></i>
                    <span>Notification Settings</span>
                </a>
            </li>
        </ul>
        @if (ViewBag.IsLoggedIn == true)
        {
            <div class="mt-auto border-top px-4 py-3">
                <p class="text-muted small mb-1">Logged in as</p>
                <p class="fw-bold mb-2">@ViewBag.CurrentUserName</p>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </form>
            </div>
        }
    </div>
</div>
