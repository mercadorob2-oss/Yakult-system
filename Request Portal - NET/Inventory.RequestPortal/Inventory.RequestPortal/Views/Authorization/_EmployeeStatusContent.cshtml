@model List<Inventory.RequestPortal.Models.ViewModels.CartridgeAuthorizationViewModel>
@using System.Text.Json
@{
    List<JsonElement>? ParseModels(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw) || !raw.TrimStart().StartsWith("[")) return null;
        try { return JsonSerializer.Deserialize<List<JsonElement>>(raw); }
        catch { return null; }
    }

    var latest = Model.FirstOrDefault();
}

@* ── Current status banner ── *@
@if (latest != null && latest.IsApproved)
{
    <div id="empStatusBanner" class="alert alert-success d-flex align-items-center justify-content-between mb-4" role="alert">
        <span><i class="bi bi-printer me-2"></i>Out of cartridges? <strong>Submit a Request now</strong>, and wait for it to be authorized.</span>
        <a href="/Request/Index" class="btn btn-success btn-sm ms-3 text-nowrap">
            <i class="bi bi-plus-circle me-1"></i> Submit a Request
        </a>
    </div>
}
else if (latest != null && latest.IsPending)
{
    <div id="empStatusBanner" class="alert alert-warning mb-4" role="alert">
        <i class="bi bi-hourglass-split me-2"></i><strong>Pending</strong> — Your latest request is awaiting supervisor authorization.
    </div>
}
else if (latest != null && latest.IsRejected)
{
    <div id="empStatusBanner" class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-x-circle me-2"></i><strong>Rejected</strong> — Your latest authorization was declined. Please contact your supervisor.
    </div>
}

@* ── History table ── *@
@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-shield display-1 text-muted mb-3"></i>
            <h5 class="text-muted mb-3">No authorization history</h5>
            <p class="text-muted mb-4">Submit a cartridge request and your supervisor will be notified to authorize it.</p>
            <a href="/Request/Index" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Submit a Request
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm" id="empStatusCard">
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size:0.9rem;">
                <thead style="background:#f1f5f9;">
                    <tr id="empStatusHead">
                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">ID</th>
                        <th id="empStatusStatusTh" class="px-3 py-3" style="color:#64748b; font-weight:600;">Status</th>
                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Source</th>
                        <th class="px-3 py-3 d-none d-sm-table-cell" style="color:#64748b; font-weight:600;">Department</th>
                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Cartridge Models</th>
                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Signed By</th>
                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Date Signed</th>
                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Requested On</th>
                    </tr>
                </thead>
                <tbody id="empStatusTbody">
                    @foreach (var a in Model)
                    {
                        string badgeClass = a.Status switch
                        {
                            "Approved" => "bg-success",
                            "Pending"  => "bg-warning text-dark",
                            "Rejected" => "bg-danger",
                            "Used"     => "bg-secondary",
                            _          => "bg-secondary"
                        };
                        <tr data-auth-id="@a.AuthorizationId" data-status="@a.Status" style="cursor:pointer;"
                            onclick="showAuthDetail(@a.AuthorizationId, '#@a.AuthorizationId — @a.Status')">
                            <td class="px-3 py-2 text-muted d-none d-md-table-cell">#@a.AuthorizationId</td>
                            <td class="px-3 py-2"><span class="badge @badgeClass">@a.Status</span></td>
                            <td class="px-3 py-2 d-none d-md-table-cell">
                                @if (a.SubmissionSessionId.HasValue)
                                { <span class="badge rounded-pill" style="background:#e8f4fd; color:#1565c0; font-weight:600; font-size:0.72rem;"><i class="bi bi-globe me-1"></i>Web Portal</span> }
                                else
                                { <span class="badge rounded-pill" style="background:#f3f0ff; color:#5e35b1; font-weight:600; font-size:0.72rem;"><i class="bi bi-display me-1"></i>Desktop App</span> }
                            </td>
                            <td class="px-3 py-2 d-none d-sm-table-cell">@(a.DepartmentName ?? "—")</td>
                            <td class="px-3 py-2">
                                @{ var items = ParseModels(a.RequestedModels); }
                                @if (items != null && items.Count > 0)
                                {
                                    foreach (var item in items)
                                    { <div class="small">@item.GetProperty("model").GetString() (@item.GetProperty("qty").GetInt32())</div> }
                                }
                                else if (!string.IsNullOrWhiteSpace(a.RequestedModels))
                                {
                                    foreach (var part in a.RequestedModels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    { <div class="small">@part</div> }
                                }
                                else { <span class="text-muted fst-italic">—</span> }
                            </td>
                            <td class="px-3 py-2 d-none d-md-table-cell">@(a.SignedByName ?? "—")</td>
                            <td class="px-3 py-2 text-muted d-none d-md-table-cell">@(a.SignedDate.HasValue ? a.SignedDate.Value.ToString("MMM dd, yyyy  h:mm tt") : "—")</td>
                            <td class="px-3 py-2 text-muted">@a.CreatedDate.ToString("MMM dd, yyyy  h:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="empStatusPagination"></div>
    </div>
}
