@model List<Inventory.RequestPortal.Models.ViewModels.CartridgeAuthorizationViewModel>
@using System.Text.Json
@{
    ViewData["Title"] = "Authorization History";

    List<JsonElement>? ParseModels(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw) || !raw.TrimStart().StartsWith("[")) return null;
        try { return JsonSerializer.Deserialize<List<JsonElement>>(raw); }
        catch { return null; }
    }

    var signedApprovals = ViewBag.SignedApprovals as List<Inventory.RequestPortal.Models.ViewModels.CartridgeAuthorizationViewModel>
                          ?? new List<Inventory.RequestPortal.Models.ViewModels.CartridgeAuthorizationViewModel>();
    bool isApprover  = ViewBag.IsApprover  == true;
    bool isDeveloper = ViewBag.IsDeveloper == true;
    bool isITStaff   = ViewBag.IsITStaff   == true;
}

@await Html.PartialAsync("_MasterNav")

<div class="portal-header d-flex align-items-center gap-3">
    <button class="btn btn-link text-white p-0 lh-1" data-bs-toggle="offcanvas" data-bs-target="#navSidebar"
            style="font-size:1.4rem; text-decoration:none;" title="Menu">
        <i class="bi bi-list"></i>
    </button>
    <div>
        <h1>Requester Portal</h1>
        <p class="subtitle mb-0">Submit and track your cartridge requests</p>
    </div>
    <div class="ms-auto d-flex align-items-center gap-2">
        @if (!isDeveloper)
        {
            <button type="button"
                    id="approverQueueHelpBtn"
                    onclick="window.YakultTour && window.YakultTour.startTourForPage()"
                    class="btn btn-link text-white p-0 lh-1"
                    style="font-size:1.15rem; text-decoration:none; opacity:.85;"
                    title="Start guided tour">
                <i class="bi bi-question-circle"></i>
            </button>
        }
        @await Html.PartialAsync("_NotificationBell")
    </div>
</div>

<div class="content-padded">
    <div class="nav-tabs-container mb-4">
        @if (isApprover)
        {
            <ul class="nav nav-tabs mb-0">
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Authorization" asp-action="History">History</a>
                </li>
            </ul>
        }
        else
        {
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Request" asp-action="Index">New Request</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Request" asp-action="MyRequests">My Submitted Requests</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" asp-controller="Authorization" asp-action="History">Authorization History</a>
                </li>
            </ul>
        }
    </div>

    @if (isApprover)
    {
        @* ── Bootstrap in-page tabs for approvers ── *@
        <ul class="nav nav-tabs mb-4" id="historyTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="my-history-tab" data-bs-toggle="tab"
                        data-bs-target="#myHistoryPane" type="button" role="tab">
                    <i class="bi bi-clock-history me-1"></i> My Authorization History
                    <span class="badge bg-secondary ms-1">@Model.Count</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="signed-tab" data-bs-toggle="tab"
                        data-bs-target="#signedPane" type="button" role="tab">
                    <i class="bi bi-pen me-1"></i> Approvals I've Signed
                    @if (signedApprovals.Count > 0)
                    {
                        <span class="badge bg-secondary ms-1">@signedApprovals.Count</span>
                    }
                </button>
            </li>
        </ul>

        <div class="tab-content" id="historyTabsContent">

            @* ── My Authorization History pane ── *@
            <div class="tab-pane fade show active" id="myHistoryPane" role="tabpanel">
                @{
                    bool hasFilter = !string.IsNullOrWhiteSpace((string)ViewBag.SearchText) || !string.IsNullOrWhiteSpace((string)ViewBag.StatusFilter);
                }
                <div class="d-flex align-items-center mb-2 flex-wrap gap-3">
                    <form method="get" asp-action="History" class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0;">
                        <input type="text" name="search" value="@ViewBag.SearchText" class="form-control form-control-sm" style="max-width:240px;" placeholder="Search signed by, department...">
                        <select name="status" class="form-select form-select-sm flex-shrink-0" style="width:auto;" onchange="this.form.submit()">
                            <option value="">All statuses</option>
                            @foreach (var s in (List<string>)ViewBag.StatusOptions)
                            {
                                <option value="@s" selected="@(s == (string)ViewBag.StatusFilter)">@s</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary flex-shrink-0">Filter</button>
                        @if (hasFilter)
                        {
                            <a asp-action="History" class="btn btn-sm flex-shrink-0" style="background:#e2e8f0; color:#475569; border:none;">Clear</a>
                        }
                    </form>
                    @if ((int)ViewBag.TotalCount > 0)
                    {
                        <a asp-action="ExportHistoryCsv" asp-route-search="@ViewBag.SearchText" asp-route-status="@ViewBag.StatusFilter"
                           class="btn btn-sm flex-shrink-0" style="background:#e2e8f0; color:#475569; border:none;">
                            <i class="bi bi-download me-1"></i> Export CSV
                        </a>
                    }
                </div>
                @if ((int)ViewBag.TotalCount == 0 && hasFilter)
                {
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-search display-1 text-muted mb-3"></i>
                            <h5 class="text-muted mb-2">No authorization records match your filter</h5>
                        </div>
                    </div>
                }
                else if ((int)ViewBag.TotalCount == 0)
                {
                    <div class="card">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-clock-history display-1 text-muted mb-3"></i>
                            <h5 class="text-muted mb-2">No authorization records found</h5>
                            <p class="text-muted mb-0">Your authorization history will appear here once you submit a cartridge request.</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" style="font-size:0.9rem;">
                                <thead style="background:#f1f5f9;">
                                    <tr>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">ID</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Status</th>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Source</th>
                                        <th class="px-3 py-3 d-none d-sm-table-cell" style="color:#64748b; font-weight:600;">Department</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Cartridge Models</th>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Signed By</th>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Date Signed</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Requested On</th>
                                    </tr>
                                </thead>
                                <tbody id="myHistoryTbody">
                                    @foreach (var a in Model)
                                    {
                                        string badgeClass = a.Status switch
                                        {
                                            "Approved" => "bg-success",
                                            "Pending"  => "bg-warning text-dark",
                                            "Rejected" => "bg-danger",
                                            "Used"     => "bg-secondary",
                                            _          => "bg-secondary"
                                        };
                                        <tr data-auth-id="@a.AuthorizationId" style="cursor:pointer;"
                                            onclick="showAuthDetail(@a.AuthorizationId, '#@a.AuthorizationId — @a.Status')">
                                            <td class="px-3 py-2 text-muted d-none d-md-table-cell">#@a.AuthorizationId</td>
                                            <td class="px-3 py-2"><span class="badge @badgeClass">@a.Status</span></td>
                                            <td class="px-3 py-2 d-none d-md-table-cell">
                                                @if (a.SubmissionSessionId.HasValue)
                                                { <span class="badge rounded-pill" style="background:#e8f4fd; color:#1565c0; font-weight:600; font-size:0.72rem;"><i class="bi bi-globe me-1"></i>Web Portal</span> }
                                                else
                                                { <span class="badge rounded-pill" style="background:#f3f0ff; color:#5e35b1; font-weight:600; font-size:0.72rem;"><i class="bi bi-display me-1"></i>Desktop App</span> }
                                            </td>
                                            <td class="px-3 py-2 d-none d-sm-table-cell">@(a.DepartmentName ?? "—")</td>
                                            <td class="px-3 py-2">
                                                @{ var hItems = ParseModels(a.RequestedModels); }
                                                @if (hItems != null && hItems.Count > 0)
                                                {
                                                    foreach (var item in hItems)
                                                    { <div class="small">@item.GetProperty("model").GetString() (@item.GetProperty("qty").GetInt32())</div> }
                                                }
                                                else if (!string.IsNullOrWhiteSpace(a.RequestedModels))
                                                {
                                                    foreach (var part in a.RequestedModels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                    { <div class="small">@part</div> }
                                                }
                                                else { <span class="text-muted fst-italic">—</span> }
                                            </td>
                                            <td class="px-3 py-2 d-none d-md-table-cell">@(a.SignedByName ?? "—")</td>
                                            <td class="px-3 py-2 text-muted d-none d-md-table-cell">@(a.SignedDate.HasValue ? a.SignedDate.Value.ToString("MMM dd, yyyy  h:mm tt") : "—")</td>
                                            <td class="px-3 py-2 text-muted">@a.CreatedDate.ToString("MMM dd, yyyy  h:mm tt")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="myHistoryPagination" class="d-flex align-items-center justify-content-between px-3 py-2 border-top">
                            @{
                                int currentPage = (int)ViewBag.CurrentPage;
                                int totalPages  = (int)ViewBag.TotalPages;
                            }
                            <span class="small text-muted">Page @currentPage of @totalPages (@ViewBag.TotalCount total)</span>
                            @if (totalPages > 1)
                            {
                                <nav>
                                    <ul class="pagination pagination-sm mb-0">
                                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                            <a class="page-link" asp-action="History" asp-route-page="@(currentPage - 1)"
                                               asp-route-search="@ViewBag.SearchText" asp-route-status="@ViewBag.StatusFilter">&lsaquo;</a>
                                        </li>
                                        @{
                                            int startP = Math.Max(1, currentPage - 2);
                                            int endP   = Math.Min(totalPages, startP + 4);
                                            startP     = Math.Max(1, endP - 4);
                                        }
                                        @for (int p = startP; p <= endP; p++)
                                        {
                                            <li class="page-item @(p == currentPage ? "active" : "")">
                                                <a class="page-link" asp-action="History" asp-route-page="@p"
                                                   asp-route-search="@ViewBag.SearchText" asp-route-status="@ViewBag.StatusFilter">@p</a>
                                            </li>
                                        }
                                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                            <a class="page-link" asp-action="History" asp-route-page="@(currentPage + 1)"
                                               asp-route-search="@ViewBag.SearchText" asp-route-status="@ViewBag.StatusFilter">&rsaquo;</a>
                                        </li>
                                    </ul>
                                </nav>
                            }
                        </div>
                    </div>
                }
            </div>

            @* ── Approvals I've Signed pane ── *@
            <div class="tab-pane fade" id="signedPane" role="tabpanel">
                @if (!signedApprovals.Any())
                {
                    <div class="card">
                        <div class="card-body text-center py-5 text-muted">
                            <i class="bi bi-journal-check fs-2 d-block mb-2"></i>
                            You have not signed any authorizations yet.
                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0" style="font-size:0.9rem;">
                                <thead style="background:#f1f5f9;">
                                    <tr>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">#</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Status</th>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Source</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Employee</th>
                                        <th class="px-3 py-3 d-none d-sm-table-cell" style="color:#64748b; font-weight:600;">Department</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Model/s Requested</th>
                                        <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Submitted</th>
                                        <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Approved On</th>
                                    </tr>
                                </thead>
                                <tbody id="signedTbody">
                                    @foreach (var auth in signedApprovals)
                                    {
                                        string signedBadgeClass = auth.Status switch
                                        {
                                            "Approved" => "bg-success",
                                            "Rejected" => "bg-danger",
                                            "Used"     => "bg-secondary",
                                            _          => "bg-secondary"
                                        };
                                        <tr data-auth-id="@auth.AuthorizationId" style="cursor:pointer;"
                                            onclick="window.location='/Authorization/Details/@auth.AuthorizationId'">
                                            <td class="px-3 py-2 text-muted d-none d-md-table-cell">@auth.AuthorizationId</td>
                                            <td class="px-3 py-2"><span class="badge @signedBadgeClass">@auth.Status</span></td>
                                            <td class="px-3 py-2 d-none d-md-table-cell">
                                                @if (auth.SubmissionSessionId.HasValue)
                                                { <span class="badge rounded-pill" style="background:#e8f4fd; color:#1565c0; font-weight:600; font-size:0.72rem;"><i class="bi bi-globe me-1"></i>Web Portal</span> }
                                                else
                                                { <span class="badge rounded-pill" style="background:#f3f0ff; color:#5e35b1; font-weight:600; font-size:0.72rem;"><i class="bi bi-display me-1"></i>Desktop App</span> }
                                            </td>
                                            <td class="px-3 py-2 fw-semibold">@auth.EmployeeName</td>
                                            <td class="px-3 py-2 d-none d-sm-table-cell">@auth.DepartmentName</td>
                                            <td class="px-3 py-2">
                                                @{ var apItems = ParseModels(auth.RequestedModels); }
                                                @if (apItems != null && apItems.Count > 0)
                                                {
                                                    foreach (var item in apItems)
                                                    { <div class="small">@item.GetProperty("model").GetString() (@item.GetProperty("qty").GetInt32())</div> }
                                                }
                                                else if (!string.IsNullOrWhiteSpace(auth.RequestedModels))
                                                {
                                                    foreach (var part in auth.RequestedModels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                    { <div class="small">@part</div> }
                                                }
                                                else { <span class="text-muted fst-italic">—</span> }
                                            </td>
                                            <td class="px-3 py-2 text-muted small d-none d-md-table-cell">@auth.CreatedDate.ToString("MM/dd/yyyy")</td>
                                            <td class="px-3 py-2 text-muted small">@(auth.SignedDate.HasValue ? auth.SignedDate.Value.ToString("MM/dd/yyyy") : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div id="signedPagination"></div>
                    </div>
                }
            </div>

        </div>
    }
    else
    {
        @* ── Non-approver: original single-table view ── *@
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-bold" style="color:#1e293b;">
                <i class="bi bi-clock-history me-1"></i> Authorization History
            </h5>
            <span class="text-muted small">@Model.Count record(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="card">
                <div class="card-body text-center py-5">
                    <i class="bi bi-clock-history display-1 text-muted mb-3"></i>
                    <h5 class="text-muted mb-2">No authorization records found</h5>
                    <p class="text-muted mb-0">Your authorization history will appear here once you submit a cartridge request.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm" id="authHistoryCard">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.9rem;">
                        <thead style="background:#f1f5f9;">
                            <tr id="authHistoryHead">
                                <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">ID</th>
                                <th id="authHistoryStatusTh" class="px-3 py-3" style="color:#64748b; font-weight:600;">Status</th>
                                <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Source</th>
                                <th class="px-3 py-3 d-none d-sm-table-cell" style="color:#64748b; font-weight:600;">Department</th>
                                <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Cartridge Models</th>
                                <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Signed By</th>
                                <th class="px-3 py-3 d-none d-md-table-cell" style="color:#64748b; font-weight:600;">Date Signed</th>
                                <th class="px-3 py-3" style="color:#64748b; font-weight:600;">Requested On</th>
                            </tr>
                        </thead>
                        <tbody id="nonApproverTbody">
                            @foreach (var a in Model)
                            {
                                string badgeClass = a.Status switch
                                {
                                    "Approved" => "bg-success",
                                    "Pending"  => "bg-warning text-dark",
                                    "Rejected" => "bg-danger",
                                    "Used"     => "bg-secondary",
                                    _          => "bg-secondary"
                                };
                                <tr data-auth-id="@a.AuthorizationId" style="cursor:pointer;"
                                    onclick="showAuthDetail(@a.AuthorizationId, '#@a.AuthorizationId — @a.Status')">
                                    <td class="px-3 py-2 text-muted d-none d-md-table-cell">#@a.AuthorizationId</td>
                                    <td class="px-3 py-2"><span class="badge @badgeClass">@a.Status</span></td>
                                    <td class="px-3 py-2 d-none d-md-table-cell">
                                        @if (a.SubmissionSessionId.HasValue)
                                        { <span class="badge rounded-pill" style="background:#e8f4fd; color:#1565c0; font-weight:600; font-size:0.72rem;"><i class="bi bi-globe me-1"></i>Web Portal</span> }
                                        else
                                        { <span class="badge rounded-pill" style="background:#f3f0ff; color:#5e35b1; font-weight:600; font-size:0.72rem;"><i class="bi bi-display me-1"></i>Desktop App</span> }
                                    </td>
                                    <td class="px-3 py-2 d-none d-sm-table-cell">@(a.DepartmentName ?? "—")</td>
                                    <td class="px-3 py-2">
                                        @{ var hItems = ParseModels(a.RequestedModels); }
                                        @if (hItems != null && hItems.Count > 0)
                                        {
                                            foreach (var item in hItems)
                                            { <div class="small">@item.GetProperty("model").GetString() (@item.GetProperty("qty").GetInt32())</div> }
                                        }
                                        else if (!string.IsNullOrWhiteSpace(a.RequestedModels))
                                        {
                                            foreach (var part in a.RequestedModels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            { <div class="small">@part</div> }
                                        }
                                        else { <span class="text-muted fst-italic">—</span> }
                                    </td>
                                    <td class="px-3 py-2 d-none d-md-table-cell">@(a.SignedByName ?? "—")</td>
                                    <td class="px-3 py-2 text-muted d-none d-md-table-cell">@(a.SignedDate.HasValue ? a.SignedDate.Value.ToString("MMM dd, yyyy  h:mm tt") : "—")</td>
                                    <td class="px-3 py-2 text-muted">@a.CreatedDate.ToString("MMM dd, yyyy  h:mm tt")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div id="nonApproverPagination"></div>
            </div>
        }
    }
</div>

@* ── Authorization detail modal ── *@
<div class="modal fade" id="authDetailModal" tabindex="-1" aria-labelledby="authDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background:#f8fafc;">
                <h5 class="modal-title" id="authDetailModalLabel">
                    <i class="bi bi-shield-check me-2 text-danger"></i>
                    <span id="authDetailTitle">Authorization Details</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="authDetailBody">
                <div class="text-center py-4">
                    <span class="spinner-border text-danger" role="status"></span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<style>
    .row-highlight {
        background-color: #fff8e1 !important;
        outline: 2px solid #f59e0b;
        outline-offset: -2px;
    }

    /* ── In-page history tabs: keep side by side on all screen sizes ── */
    #historyTabs {
        flex-wrap: nowrap;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        -ms-overflow-style: none;
        border-bottom: none;
    }
    #historyTabs::-webkit-scrollbar { display: none; }
    #historyTabs .nav-link {
        white-space: nowrap;
        font-weight: 600;
    }

    @@media (max-width: 767.98px) {
        #historyTabs .nav-link i {
            display: none;
        }
        #historyTabs .nav-link {
            padding: 0.5rem 0.85rem;
            font-size: 0.85rem;
        }
    }
    /* ── Pagination — matches My Requests style ── */
    .auth-page-controls { gap: 3px; }
    .auth-page-controls .page-link {
        border: 1px solid #e2e8f0;
        color: #475569;
        border-radius: 6px !important;
        min-width: 34px;
        text-align: center;
        font-size: .83rem;
        padding: 5px 10px;
        line-height: 1.4;
        background: #fff;
        transition: background .15s, color .15s, border-color .15s;
    }
    .auth-page-controls .page-link:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #1e293b;
    }
    .auth-page-controls .page-item.active .page-link {
        background: #d50032;
        border-color: #d50032;
        color: #fff;
        font-weight: 600;
    }
    .auth-page-controls .page-item.disabled .page-link {
        background: #f8fafc;
        border-color: #e2e8f0;
        color: #b0bec5;
    }
</style>
@if (!isApprover && !isDeveloper)
{
    <script src="~/js/tours/user-auth-history.js" asp-append-version="true"></script>
}
@if (isApprover)
{
    <script src="~/js/tours/approver-history.js" asp-append-version="true"></script>
}
<script>
    function initTablePagination(tbodyId, controlsId, pageSize, highlightId) {
        var tbody = document.getElementById(tbodyId);
        if (!tbody) return;
        var rows = Array.from(tbody.querySelectorAll('tr'));

        var currentPage = 1;
        var totalPages = Math.max(1, Math.ceil(rows.length / pageSize));

        function showPage(page) {
            currentPage = page;
            var start = (page - 1) * pageSize;
            rows.forEach(function (row, i) {
                row.style.display = (i >= start && i < start + pageSize) ? '' : 'none';
            });
            renderControls();
        }

        function renderControls() {
            var el = document.getElementById(controlsId);
            if (!el) return;
            if (totalPages <= 1) { el.innerHTML = ''; return; }

            var start   = (currentPage - 1) * pageSize + 1;
            var showing = Math.min(currentPage * pageSize, rows.length);

            var html = '<div class="d-flex align-items-center justify-content-between px-3 py-2 border-top">';
            html += '<span style="font-size:.82rem; color:#64748b;">Showing ' + start + '–' + showing + ' of ' + rows.length + '</span>';
            html += '<nav><ul class="pagination mb-0 d-flex flex-wrap auth-page-controls">';

            html += '<li class="page-item' + (currentPage === 1 ? ' disabled' : '') + '">'
                  + '<a class="page-link" href="#" data-page="' + (currentPage - 1) + '">&lsaquo;</a></li>';

            var startP = Math.max(1, currentPage - 2);
            var endP   = Math.min(totalPages, startP + 4);
            if (endP - startP < 4) startP = Math.max(1, endP - 4);
            for (var p = startP; p <= endP; p++) {
                html += '<li class="page-item' + (p === currentPage ? ' active' : '') + '">'
                      + '<a class="page-link" href="#" data-page="' + p + '">' + p + '</a></li>';
            }

            html += '<li class="page-item' + (currentPage === totalPages ? ' disabled' : '') + '">'
                  + '<a class="page-link" href="#" data-page="' + (currentPage + 1) + '">&rsaquo;</a></li>';
            html += '</ul></nav></div>';

            el.innerHTML = html;
            el.querySelectorAll('[data-page]').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    var p = parseInt(a.dataset.page);
                    if (p >= 1 && p <= totalPages) showPage(p);
                });
            });
        }

        // Jump to the page containing the highlighted row
        var startPage = 1;
        if (highlightId) {
            var hlIdx = rows.findIndex(function (r) {
                return parseInt(r.dataset.authId) === highlightId;
            });
            if (hlIdx >= 0) startPage = Math.floor(hlIdx / pageSize) + 1;
        }

        showPage(startPage);

        if (highlightId) {
            rows.forEach(function (r) {
                if (parseInt(r.dataset.authId) === highlightId) {
                    r.classList.add('row-highlight');
                    setTimeout(function () { r.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 150);
                }
            });
        }
    }

    window.showAuthDetail = function (authId, title) {
        var modal = new bootstrap.Modal(document.getElementById('authDetailModal'));
        document.getElementById('authDetailTitle').textContent = title || 'Authorization Details';
        document.getElementById('authDetailBody').innerHTML =
            '<div class="text-center py-4"><span class="spinner-border text-danger" role="status"></span></div>';
        modal.show();
        fetch('/Authorization/EmployeeView/' + authId, { credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.text() : '<p class="text-danger p-3">Failed to load details.</p>'; })
            .then(function (html) { document.getElementById('authDetailBody').innerHTML = html; })
            .catch(function () { document.getElementById('authDetailBody').innerHTML = '<p class="text-danger p-3">Failed to load details.</p>'; });
    };

    document.addEventListener('DOMContentLoaded', function () {
        var highlightId = parseInt(new URLSearchParams(window.location.search).get('highlight') || '0') || null;
        initTablePagination('myHistoryTbody',  'myHistoryPagination',   10, highlightId);
        initTablePagination('signedTbody',     'signedPagination',      10);
        initTablePagination('nonApproverTbody','nonApproverPagination', 10, highlightId);
    });
</script>
}
