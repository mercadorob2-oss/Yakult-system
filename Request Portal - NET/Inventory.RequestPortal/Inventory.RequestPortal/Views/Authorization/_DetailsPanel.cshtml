@model Inventory.RequestPortal.Models.ViewModels.AuthorizationDetailsViewModel
@using System.Text.Json
@{
    Layout = null;
    var a = Model.Authorization;
    string signerName     = ViewBag.CurrentUserName  ?? "";
    string signerFullName = ViewBag.SignerFullName   ?? "";
    string signerPos      = ViewBag.SignerPosition   ?? "";
    string signerCo       = ViewBag.SignerCompany    ?? "";
    string signerBr       = ViewBag.SignerBranch     ?? "";
    string signerDept     = ViewBag.SignerDepartment ?? "";

    List<(string Model, int Qty, int Good, int Damaged)>? requestedItems = null;
    if (!string.IsNullOrWhiteSpace(a.RequestedModels) && a.RequestedModels.TrimStart().StartsWith("["))
    {
        try
        {
            var parsed = JsonSerializer.Deserialize<List<JsonElement>>(a.RequestedModels);
            requestedItems = parsed?.Select(e => (
                Model:   e.GetProperty("model").GetString() ?? "",
                Qty:     e.GetProperty("qty").GetInt32(),
                Good:    e.GetProperty("good").GetInt32(),
                Damaged: e.GetProperty("damaged").GetInt32()
            )).ToList();
        }
        catch { }
    }
    bool isStructured = requestedItems?.Count > 0;
}

@* ── Employee info ── *@
<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h5 class="mb-1 fw-bold">@a.EmployeeName</h5>
                <span class="text-muted small">@a.DepartmentName</span>
            </div>
            <span class="badge fs-6 @(a.IsPending ? "bg-warning text-dark" : a.IsApproved ? "bg-success" : "bg-danger")">
                @a.Status
            </span>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-sm-6">
                <small class="text-muted d-block">Requested On</small>
                <span>@a.CreatedDate.ToString("MMMM dd, yyyy  h:mm tt")</span>
            </div>
            <div class="col-sm-6">
                <small class="text-muted d-block">Authorization #</small>
                <span class="text-muted">#@a.AuthorizationId</span>
            </div>
        </div>
    </div>
</div>

@if (a.IsPending)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-white">
            <h6 class="mb-0"> Sign &amp; Authorize</h6>
        </div>
        <div class="card-body">

            <form id="approveForm-@a.AuthorizationId" asp-controller="Authorization" asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AuthorizationId"  value="@a.AuthorizationId" />
                <input type="hidden" name="SignatureData"     id="hdnSignatureData" />
                <input type="hidden" name="SignatureSource"   id="hdnSignatureSource" value="draw" />
                <input type="hidden" name="SignatureFileName" id="hdnSignatureFileName" />
    
                @* Cartridge Details *@
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">
                        <span class="badge bg-danger me-1">1</span> Cartridge Details
                    </label>
                    @if (isStructured && requestedItems != null)
                    {
                        <input type="hidden" name="RequestedModels" id="hdnRequestedModels" value="@a.RequestedModels" />
                        <div class="table-responsive">
                            <table class="table table-bordered table-sm mb-1">
                                <thead class="table-light">
                                    <tr>
                                        <th>Model</th>
                                        <th class="text-center">Qty</th>
                                        <th class="text-center">Returned Cartridges (Good)</th>
                                        <th class="text-center">Returned Cartridges (Damaged)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in requestedItems)
                                    {
                                        <tr>
                                            <td><strong>@item.Model</strong></td>
                                            <td class="text-center">@item.Qty</td>
                                            <td class="text-center">@item.Good</td>
                                            <td class="text-center">@item.Damaged</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Review before signing.</small>
                    }
                    else
                    {
                        <input type="text" name="RequestedModels" id="inputModels"
                               class="form-control form-control-sm"
                               placeholder="e.g. HP 85A, Canon 337"
                               value="@(a.RequestedModels ?? "")" required />
                        <small class="text-muted">Separate multiple models with commas.</small>
                    }
                </div>

                @* Authorization Statement Preview *@
                <div class="mb-3" style="background:#f9f9fb; border:1px dashed #ccc; border-radius:10px; font-size:.92rem; padding:20px 24px 24px 24px;">
                    <p class="text-muted small mb-1 fw-bold text-uppercase" style="letter-spacing:.4px;">
                        <i class="bi bi-file-text"></i> Cartridge Request Preview
                    </p>
                    <p class="mb-1" style="font-style:italic; color:#333; line-height:1.7;">
                        @{
                            var stmtOrgParts = new[] { signerCo, signerDept }.Where(s => !string.IsNullOrWhiteSpace(s));
                            var stmtOrg      = string.Join(" – ", stmtOrgParts);
                        }
                        I, <strong>@signerFullName</strong>, <strong>@signerPos</strong>
                        @if (!string.IsNullOrWhiteSpace(stmtOrg)) { <text>of <strong>@stmtOrg</strong></text> }
                        @if (!string.IsNullOrWhiteSpace(signerBr)) { <text>, based at the <strong>@signerBr</strong></text> },
                        hereby authorize the cartridge refill request(s)
                        submitted and facilitated by <strong>@a.EmployeeName</strong>.
                    </p>
                    <p class="mb-1" style="font-style:italic; color:#333; line-height:1.7;">
                        The items listed below have been reviewed and are approved for processing in
                        accordance with company policies and operational requirements.
                    </p>
                    @if (isStructured && requestedItems != null)
                    {
                        <div class="table-responsive mb-1">
                            <table class="table table-bordered table-sm mb-0" style="background:#fff; font-size:.88rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Model</th><th class="text-center">Qty</th>
                                        <th class="text-center">Returned Cartridges (Good)</th><th class="text-center">Returned Cartridges (Damaged)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in requestedItems)
                                    {
                                        <tr>
                                            <td><strong>@item.Model</strong></td>
                                            <td class="text-center">@item.Qty</td>
                                            <td class="text-center">@item.Good</td>
                                            <td class="text-center">@item.Damaged</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mb-1" style="font-style:italic; color:#333;">
                            Model/s: <strong><span id="previewModels" style="color:#d50032;">@(string.IsNullOrWhiteSpace(a.RequestedModels) ? "(fill in above)" : a.RequestedModels)</span></strong>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(a.FulfillmentMethod))
                    {
                        <p class="mb-1 mt-2" style="font-style:italic; color:#333; line-height:1.7;">
                            Mode of Distribution: <strong>@a.FulfillmentMethod</strong>
                            @if (a.FulfillmentMethod == "Pickup" && !string.IsNullOrWhiteSpace(a.ReceivedByName))
                            {
                                <span> &mdash; To Be Received by: <strong>@a.ReceivedByName</strong></span>
                            }
                        </p>
                    }
                    <div class="mt-4 pt-3" style="border-top:1px solid #e0e0e0;">
                        <p style="font-size:.75rem; color:#999; margin-bottom:8px;">Noted by:</p>
                        <div id="previewSigBox" style="min-height:60px; max-width:320px; color:#ccc; font-style:italic; font-size:.85rem; padding:4px 2px;">
                            (signature will appear here)
                        </div>
                        <div style="margin-top:8px; max-width:360px;">
                            <strong style="font-size:.92rem; color:#111; display:block; line-height:1.5; margin-bottom:4px;">@signerFullName</strong>
                            @if (!string.IsNullOrWhiteSpace(signerPos))
                            {
                                <span style="font-size:.8rem; color:#555; font-style:italic; display:block; line-height:1.5; margin-bottom:3px;">@signerPos</span>
                            }
                            @{
                                var subParts = new[] { signerDept, signerBr, signerCo }.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
                            }
                            @if (subParts.Any())
                            {
                                <span style="font-size:.77rem; color:#777; display:block; line-height:1.5;">@string.Join(" · ", subParts)</span>
                            }
                        </div>
                        <small class="text-muted d-block mt-3">Date Signed: @DateTime.Now.ToString("MMMM dd, yyyy")</small>
                    </div>
                </div>

                @* Signature Input *@
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">
                        <span class="badge bg-danger me-1">2</span> Your Signature
                    </label>
                    <div class="btn-group mb-2 d-flex" style="max-width:min(280px, 100%);" role="group">
                        <button type="button" id="btnTabDraw" class="btn btn-danger btn-sm flex-fill"
                                onclick="switchSigTab('draw')">
                            <i class="bi bi-pencil-square"></i> Draw
                        </button>
                        <button type="button" id="btnTabUpload" class="btn btn-outline-secondary btn-sm flex-fill"
                                onclick="switchSigTab('upload')">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                    </div>

                    <div id="panelDraw">
                        <div style="max-width:min(520px, 100%); position:relative;">
                            <div style="border:1.5px solid #d0d0d0; border-radius:8px; overflow:hidden; background:#fafafa; touch-action:none; cursor:crosshair; position:relative;">
                                <canvas id="sigCanvas" height="150" style="display:block; width:100%; touch-action:none;"></canvas>
                                <div style="position:absolute; bottom:28px; left:16px; right:16px; border-bottom:1.5px solid #c0c0c0; pointer-events:none;"></div>
                                <div style="position:absolute; bottom:10px; left:16px; font-size:.7rem; color:#bbb; pointer-events:none; letter-spacing:.5px;">SIGN ABOVE</div>
                            </div>
                            <div class="mt-1 d-flex gap-2 align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearCanvas()">
                                    <i class="bi bi-trash"></i> Clear
                                </button>
                                <small class="text-muted">Draw with mouse or finger</small>
                            </div>
                        </div>
                    </div>

                    <div id="panelUpload" style="display:none;">
                        <div style="max-width:min(520px, 100%);">
                            <input type="file" id="sigFileInput" class="form-control form-control-sm mb-2"
                                   accept="image/*,.pdf" />
                            <div id="uploadPreview" style="display:none; margin-top:6px; border:1.5px solid #d0d0d0; border-radius:8px; background:#fafafa; padding:12px; text-align:center;">
                                <img id="previewImg" src="" alt="Signature preview"
                                     style="max-height:110px; max-width:100%; border-radius:4px; display:none;" />
                                <embed id="previewPdf" src="" type="application/pdf"
                                       style="width:100%; height:160px; border-radius:4px; display:none;" />
                                <p id="previewFileName" class="text-muted small mt-1 mb-1"></p>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteUpload()">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                @* Actions *@
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <button type="submit" class="btn btn-success px-4" style="border-radius:8px; font-weight:700;">
                        <i class="bi bi-check-circle-fill"></i> Sign &amp; Approve
                    </button>
                    <small class="text-muted">This action cannot be undone.</small>
                </div>
            </form>

            <hr class="my-3" />

            <form asp-controller="Authorization" asp-action="Reject" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="authorizationId" value="@a.AuthorizationId" />
                <button type="submit" class="btn btn-sm btn-outline-danger"
                        onclick="return confirm('Reject this authorization for @Html.Raw(a.EmployeeName)?')">
                    <i class="bi bi-x-circle"></i> Reject Request
                </button>
            </form>
        </div>
    </div>
}
else if (a.SignatureSource == "IT_MANUAL")
{
    @* IT-Assisted Manual Authorization — no digital signature, records offline/verbal auth *@
    <div class="card shadow-sm mb-3"
         style="border:2px solid @(a.IsApproved ? "#4CAF50" : "#f44336");">
        <div class="card-header" style="background:@(a.IsApproved ? "rgba(76,175,80,0.08)" : "rgba(244,67,54,0.08)"); border:none;">
            <h6 class="mb-0">
                <i class="bi @(a.IsApproved ? "bi-patch-check-fill text-success" : "bi-x-circle-fill text-danger") me-1"></i>
                IT-Assisted Manual Authorization — @a.Status
            </h6>
        </div>
        <div class="card-body">
            @* Models table *@
            @if (isStructured && requestedItems != null)
            {
                <div class="mb-3">
                    <p class="text-muted small mb-1 fw-bold">CARTRIDGE DETAILS</p>
                    <table class="table table-bordered table-sm mb-0" style="font-size:.88rem;">
                        <thead class="table-light">
                            <tr><th>Model</th><th class="text-center">Qty</th><th class="text-center">Returned (Good)</th><th class="text-center">Returned (Damaged)</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var item in requestedItems)
                            {
                                <tr>
                                    <td><strong>@item.Model</strong></td>
                                    <td class="text-center">@item.Qty</td>
                                    <td class="text-center">@item.Good</td>
                                    <td class="text-center">@item.Damaged</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @* Decision badge + details *@
            <div class="row g-2 mb-3">
                <div class="col-sm-4">
                    <small class="text-muted d-block">Authorization Decision</small>
                    <span class="badge fs-6 @(a.IsApproved ? "bg-success" : "bg-danger")">@a.Status</span>
                </div>
                <div class="col-sm-4">
                    <small class="text-muted d-block">Authorized By</small>
                    <strong>@(a.SignedByName ?? "—")</strong>
                </div>
                <div class="col-sm-4">
                    <small class="text-muted d-block">Decision Date</small>
                    <strong>@(a.SignedDate?.ToString("MMM dd, yyyy  h:mm tt") ?? "—")</strong>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(a.Remarks))
            {
                <div class="mb-3 p-3" style="background:#f9f9fb; border:1px dashed #ccc; border-radius:8px;">
                    <small class="text-muted fw-bold d-block mb-1">REMARKS</small>
                    <span style="white-space:pre-wrap; font-size:.92rem;">@a.Remarks</span>
                </div>
            }
            @* Audit trail — who submitted vs who authorized *@
            <div class="pt-2" style="border-top:1px solid #e0e0e0;">
                <small class="text-muted fw-bold d-block mb-2">AUDIT TRAIL</small>
                <div class="row g-2">
                    @if (!string.IsNullOrWhiteSpace(a.SubmittedByName))
                    {
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Request Created By (IT User)</small>
                            <strong>@a.SubmittedByName</strong>
                        </div>
                    }
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Request Created For</small>
                        <strong>@a.EmployeeName</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Authorizing Approver</small>
                        <strong>@(a.SignedByName ?? "—")</strong>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Authorization Type</small>
                        <span class="badge bg-warning text-dark">IT Manual (Offline)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm mb-3"
         style="border:2px solid @(a.IsApproved ? "#4CAF50" : "#f44336");">
        <div class="card-header" style="background:@(a.IsApproved ? "rgba(76,175,80,0.08)" : "rgba(244,67,54,0.08)"); border:none;">
            <h6 class="mb-0">
                <i class="bi @(a.IsApproved ? "bi-patch-check-fill text-success" : "bi-x-circle-fill text-danger")"></i>
                @(a.IsApproved ? "Signed Authorization Document" : "Rejected")
            </h6>
        </div>
        <div class="card-body">
            @if (a.IsApproved)
            {
                <div class="p-3 mb-3" style="background:#fafafa; border:1px solid #e0e0e0; border-radius:10px; font-size:.92rem;">
                    <p style="font-style:italic; line-height:1.8; color:#333; margin:0 0 6px 0;">
                        I, <strong>@(a.SignedByName ?? "")</strong>, <strong>@(a.SignerPosition ?? "")</strong> of
                        <strong>@(a.SignerCompany ?? "")</strong>
                        @if (!string.IsNullOrWhiteSpace(a.DepartmentName)) { <span>&#8211; <strong>@a.DepartmentName</strong></span> },
                        based at the <strong>@(a.SignerBranch ?? "")</strong>, hereby authorize the cartridge refill request(s)
                        submitted and facilitated by <strong>@a.EmployeeName</strong>.
                    </p>
                    <p style="font-style:italic; line-height:1.8; color:#333; margin:0 0 10px 0;">
                        The items listed below have been reviewed and are approved for processing in
                        accordance with company policies and operational requirements.
                    </p>
                    @if (isStructured && requestedItems != null)
                    {
                        <table class="table table-bordered table-sm mb-2" style="background:#fff; font-size:.88rem;">
                            <thead class="table-light">
                                <tr><th>Model</th><th class="text-center">Qty</th><th class="text-center">Returned Cartridges (Good)</th><th class="text-center">Returned Cartridges (Damaged)</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in requestedItems)
                                {
                                    <tr>
                                        <td><strong>@item.Model</strong></td>
                                        <td class="text-center">@item.Qty</td>
                                        <td class="text-center">@item.Good</td>
                                        <td class="text-center">@item.Damaged</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p style="font-style:italic; color:#333; margin:0 0 10px 0;">
                            Model/s: <strong style="color:#d50032;">@(a.RequestedModels ?? "—")</strong>
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(a.FulfillmentMethod))
                    {
                        <p style="font-style:italic; line-height:1.8; color:#333; margin:0 0 6px 0;">
                            Mode of Distribution: <strong>@a.FulfillmentMethod</strong>
                            @if (a.FulfillmentMethod == "Pickup" && !string.IsNullOrWhiteSpace(a.ReceivedByName))
                            {
                                <span> &mdash; To Be Received by: <strong>@a.ReceivedByName</strong></span>
                            }
                        </p>
                    }
                </div>
                @if (!string.IsNullOrEmpty(a.SignatureData))
                {
                    <div class="mb-3">
                        <p class="text-muted small mb-1 fw-bold">SIGNATURE</p>
                        @if (a.SignatureSource == "upload" && !string.IsNullOrEmpty(a.SignatureFileName)
                             && a.SignatureFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                        {
                            <embed src="@a.SignatureData" type="application/pdf"
                                   style="width:100%; height:240px; border:1px solid #e0e0e0; border-radius:8px;" />
                        }
                        else
                        {
                            <img src="@a.SignatureData" alt="Signature"
                                 style="max-height:110px; max-width:360px; border:1px solid #e0e0e0; border-radius:8px; background:#fff; padding:6px;" />
                        }
                    </div>
                }
                <div class="row g-2 pt-2" style="border-top:1px solid #e0e0e0;">
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Signed By</small>
                        <strong>@a.SignedByName</strong>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Date Signed</small>
                        <strong>@(a.SignedDate?.ToString("MMM dd, yyyy  h:mm tt") ?? "—")</strong>
                    </div>
                    <div class="col-sm-4">
                        <small class="text-muted d-block">Method</small>
                        <span class="badge bg-secondary">
                            @(a.SignatureSource == "draw" ? "Drawn" : a.SignatureSource == "upload" ? "Uploaded" : "—")
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-0">
                    <i class="bi bi-x-circle-fill"></i>
                    This authorization was <strong>rejected</strong>
                    @if (a.SignedDate.HasValue) { <span> on @a.SignedDate.Value.ToString("MMM dd, yyyy")</span> }
                    @if (!string.IsNullOrEmpty(a.SignedByName)) { <span> by <strong>@a.SignedByName</strong></span> }.
                </div>
            }
        </div>
    </div>
}

<script>
(function () {
    /* ── Legacy plain-text model preview ── */
    const inputModels   = document.getElementById('inputModels');
    const previewModels = document.getElementById('previewModels');
    if (inputModels && previewModels) {
        if (inputModels.value.trim()) previewModels.textContent = inputModels.value.trim();
        inputModels.addEventListener('input', function () {
            previewModels.textContent = this.value.trim() || '(fill in above)';
        });
    }

    /* ── Tab switching ── */
    window.switchSigTab = function (tab) {
        const drawPanel   = document.getElementById('panelDraw');
        const uploadPanel = document.getElementById('panelUpload');
        const btnDraw     = document.getElementById('btnTabDraw');
        const btnUpload   = document.getElementById('btnTabUpload');
        const hdnSource   = document.getElementById('hdnSignatureSource');
        if (tab === 'draw') {
            drawPanel.style.display = ''; uploadPanel.style.display = 'none';
            btnDraw.className = 'btn btn-danger btn-sm flex-fill';
            btnUpload.className = 'btn btn-outline-secondary btn-sm flex-fill';
            hdnSource.value = 'draw';
        } else {
            drawPanel.style.display = 'none'; uploadPanel.style.display = '';
            btnDraw.className = 'btn btn-outline-secondary btn-sm flex-fill';
            btnUpload.className = 'btn btn-danger btn-sm flex-fill';
            hdnSource.value = 'upload';
        }
    };

    /* ── Canvas drawing ── */
    const canvas = document.getElementById('sigCanvas');
    if (canvas) {
        function resizeCanvas() {
            const w = canvas.offsetWidth;
            const tmp = canvas.toDataURL();
            canvas.width = w; canvas.height = 150;
            const img = new Image();
            img.onload = () => ctx.drawImage(img, 0, 0);
            img.src = tmp;
            styleCtx();
        }
        const ctx = canvas.getContext('2d');
        function styleCtx() {
            ctx.strokeStyle = '#1a1a2e'; ctx.lineWidth = 2.5;
            ctx.lineCap = 'round'; ctx.lineJoin = 'round';
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        let drawing = false, lx = 0, ly = 0;
        function pos(e) {
            const r = canvas.getBoundingClientRect();
            const sx = canvas.width / r.width, sy = canvas.height / r.height;
            let cx, cy;
            if (e.touches && e.touches.length) {
                cx = (e.touches[0].clientX - r.left) * sx;
                cy = (e.touches[0].clientY - r.top)  * sy;
            } else {
                cx = (e.clientX - r.left) * sx;
                cy = (e.clientY - r.top)  * sy;
            }
            return { x: Math.max(0, Math.min(canvas.width,  cx)),
                     y: Math.max(0, Math.min(canvas.height, cy)) };
        }
        canvas.addEventListener('mousedown',  e => { e.preventDefault(); drawing = true; const p = pos(e); lx = p.x; ly = p.y; });
        canvas.addEventListener('mousemove',  e => {
            if (!drawing) return; e.preventDefault();
            const p = pos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p.x, p.y); ctx.stroke();
            lx = p.x; ly = p.y;
        });
        canvas.addEventListener('mouseup',    e => { e.preventDefault(); drawing = false; updateSigPreview(); });
        canvas.addEventListener('mouseleave', () => { drawing = false; updateSigPreview(); });
        canvas.addEventListener('touchstart', e => { e.preventDefault(); drawing = true; const p = pos(e); lx = p.x; ly = p.y; }, { passive: false });
        canvas.addEventListener('touchmove',  e => {
            e.preventDefault(); if (!drawing) return;
            const touch = e.touches[0];
            const r = canvas.getBoundingClientRect();
            if (touch.clientX < r.left || touch.clientX > r.right ||
                touch.clientY < r.top  || touch.clientY > r.bottom) {
                drawing = false; updateSigPreview(); return;
            }
            const p = pos(e); ctx.beginPath(); ctx.moveTo(lx, ly); ctx.lineTo(p.x, p.y); ctx.stroke();
            lx = p.x; ly = p.y;
        }, { passive: false });
        canvas.addEventListener('touchend',    () => { drawing = false; updateSigPreview(); });
        canvas.addEventListener('touchcancel', () => { drawing = false; updateSigPreview(); });

        function getCroppedDataURL() {
            const w = canvas.width, h = canvas.height;
            const data = ctx.getImageData(0, 0, w, h).data;
            let minX = w, maxX = 0, minY = h, maxY = 0, found = false;
            for (let y = 0; y < h; y++) {
                for (let x = 0; x < w; x++) {
                    if (data[(y * w + x) * 4 + 3] > 10) {
                        if (x < minX) minX = x;
                        if (x > maxX) maxX = x;
                        if (y < minY) minY = y;
                        if (y > maxY) maxY = y;
                        found = true;
                    }
                }
            }
            if (!found) return canvas.toDataURL('image/png');
            const pad = 4;
            const sx = Math.max(0, minX - pad);
            const sy = Math.max(0, minY - pad);
            const sw = Math.min(w, maxX + pad + 1) - sx;
            const sh = Math.min(h, maxY + pad + 1) - sy;
            const tmp = document.createElement('canvas');
            tmp.width = sw; tmp.height = sh;
            tmp.getContext('2d').drawImage(canvas, -sx, -sy);
            return tmp.toDataURL('image/png');
        }

        window.clearCanvas = function () { ctx.clearRect(0, 0, canvas.width, canvas.height); updateSigPreview(); };

        function isBlank() {
            const b = document.createElement('canvas');
            b.width = canvas.width; b.height = canvas.height;
            return canvas.toDataURL() === b.toDataURL();
        }
        function updateSigPreview() {
            const box = document.getElementById('previewSigBox');
            if (!box || document.getElementById('hdnSignatureSource').value !== 'draw') return;
            box.innerHTML = isBlank()
                ? '<span style="color:#aaa;font-style:italic;">(signature will appear here)</span>'
                : '<img src="' + getCroppedDataURL() + '" style="max-height:55px; max-width:300px;" />';
        }
        window._isCanvasBlank = isBlank;
        window._getCanvasData = getCroppedDataURL;
    }

    /* ── File upload ── */
    const fileInput = document.getElementById('sigFileInput');
    if (fileInput) {
        fileInput.addEventListener('change', function () {
            const file = this.files[0]; if (!file) return;
            if (file.size > 5 * 1024 * 1024) { alert('Max 5 MB.'); this.value = ''; return; }
            const reader = new FileReader();
            reader.onload = function (e) {
                const dataUrl = e.target.result;
                document.getElementById('hdnSignatureFileName').value = file.name;
                const preview = document.getElementById('uploadPreview');
                const img = document.getElementById('previewImg');
                const pdf = document.getElementById('previewPdf');
                const fname = document.getElementById('previewFileName');
                preview.style.display = ''; fname.textContent = file.name;
                if (file.type === 'application/pdf') {
                    img.style.display = 'none'; pdf.src = dataUrl; pdf.style.display = '';
                } else {
                    pdf.style.display = 'none'; img.src = dataUrl; img.style.display = '';
                }
                const box = document.getElementById('previewSigBox');
                if (box) box.innerHTML = file.type === 'application/pdf'
                    ? '<small class="text-muted"><i class="bi bi-file-earmark-pdf text-danger"></i> ' + file.name + '</small>'
                    : '<img src="' + dataUrl + '" style="max-height:55px; max-width:300px;" />';
            };
            reader.readAsDataURL(file);
        });
    }

    /* ── Upload delete ── */
    window.deleteUpload = function () {
        const fi = document.getElementById('sigFileInput'); if (fi) fi.value = '';
        const pv = document.getElementById('uploadPreview'); if (pv) pv.style.display = 'none';
        const pi = document.getElementById('previewImg'); if (pi) { pi.src = ''; pi.style.display = 'none'; }
        const pp = document.getElementById('previewPdf'); if (pp) { pp.src = ''; pp.style.display = 'none'; }
        const pn = document.getElementById('previewFileName'); if (pn) pn.textContent = '';
        const hd = document.getElementById('hdnSignatureData'); if (hd) hd.value = '';
        const hf = document.getElementById('hdnSignatureFileName'); if (hf) hf.value = '';
        const box = document.getElementById('previewSigBox');
        if (box) box.innerHTML = '<span style="color:#aaa;font-style:italic;">(signature will appear here)</span>';
    };

    /* ── Form submit validation ── */
    const formId = 'approveForm-@a.AuthorizationId';
    const form = document.getElementById(formId);
    if (form) {
        form.addEventListener('submit', function (e) {
            const source = document.getElementById('hdnSignatureSource').value;
            const hdnData = document.getElementById('hdnSignatureData');
            if (source === 'draw') {
                if (window._isCanvasBlank && window._isCanvasBlank()) {
                    e.preventDefault(); alert('Please draw your signature before approving.'); return;
                }
                hdnData.value = window._getCanvasData ? window._getCanvasData() : '';
            } else {
                const pi = document.getElementById('previewImg');
                const pp = document.getElementById('previewPdf');
                const src = (pi && pi.style.display !== 'none' && pi.src)
                          || (pp && pp.style.display !== 'none' && pp.src) || '';
                if (!src || src.startsWith('http')) {
                    e.preventDefault(); alert('Please upload a signature file before approving.'); return;
                }
                hdnData.value = src;
            }
            const mf = document.getElementById('hdnRequestedModels') || document.getElementById('inputModels');
            if (!mf || !mf.value.trim()) {
                e.preventDefault(); alert('Please fill in the cartridge model/s.'); mf && mf.focus();
            }
        });
    }
})();
</script>
