<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df"
        xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
        xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="DataSource1">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>a1b2c3d4-e5f6-4a7b-8c9d-000000000001</rd:DataSourceID>
    </DataSource>
    <DataSource Name="SignatoryDS">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
      <rd:DataSourceID>a1b2c3d4-e5f6-4a7b-8c9d-000000000004</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="RenewalsData">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
SELECT
  [Year], MonthNumber, MonthName,
  SetId, SetCode, SetType, RenewalOfSetId, ChainPositionLabel, DocumentDate,
  DocumentNumber, CompanyName, SiteName,
  ExpiryStatus, SetLevelStatus,
  StartDate, EndDate, DaysUntilExpiry,
  TotalAmountDue, Subtotal, VatAmount, WhtAmount, DiscountAmount, ItemNo,
  SetItemId, ItemName, ItemDescription, ModelNumber, SerialNumber, ItemType, Category,
  Quantity, UnitPrice, ItemAmount,
  LineStartDate, LineEndDate, ItemRenewalStatus
FROM dbo.vw_Report_RenewalsWithItems
ORDER BY [Year] ASC, MonthNumber ASC, SetId ASC, ItemNo ASC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Year">              <DataField>Year</DataField>              <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="MonthNumber">       <DataField>MonthNumber</DataField>       <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="MonthName">         <DataField>MonthName</DataField>         <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetId">             <DataField>SetId</DataField>             <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="SetCode">           <DataField>SetCode</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetType">           <DataField>SetType</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="RenewalOfSetId">    <DataField>RenewalOfSetId</DataField>    <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="ChainPositionLabel"><DataField>ChainPositionLabel</DataField><rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="DocumentDate">      <DataField>DocumentDate</DataField>      <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="DocumentNumber">    <DataField>DocumentNumber</DataField>    <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="CompanyName">       <DataField>CompanyName</DataField>       <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SiteName">          <DataField>SiteName</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ExpiryStatus">      <DataField>ExpiryStatus</DataField>      <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetLevelStatus">    <DataField>SetLevelStatus</DataField>    <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="StartDate">         <DataField>StartDate</DataField>         <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="EndDate">           <DataField>EndDate</DataField>           <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="DaysUntilExpiry">   <DataField>DaysUntilExpiry</DataField>   <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="TotalAmountDue">    <DataField>TotalAmountDue</DataField>    <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="Subtotal">         <DataField>Subtotal</DataField>          <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="VatAmount">        <DataField>VatAmount</DataField>         <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="WhtAmount">        <DataField>WhtAmount</DataField>         <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="DiscountAmount">   <DataField>DiscountAmount</DataField>    <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="ItemNo">            <DataField>ItemNo</DataField>            <rd:TypeName>System.Int64</rd:TypeName>    </Field>
        <Field Name="SetItemId">         <DataField>SetItemId</DataField>         <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="ItemName">          <DataField>ItemName</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ItemDescription">   <DataField>ItemDescription</DataField>   <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ModelNumber">       <DataField>ModelNumber</DataField>       <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SerialNumber">      <DataField>SerialNumber</DataField>      <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ItemType">          <DataField>ItemType</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Category">          <DataField>Category</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Quantity">          <DataField>Quantity</DataField>          <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="UnitPrice">         <DataField>UnitPrice</DataField>         <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="ItemAmount">        <DataField>ItemAmount</DataField>        <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="LineStartDate">     <DataField>LineStartDate</DataField>     <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="LineEndDate">       <DataField>LineEndDate</DataField>       <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="ItemRenewalStatus"> <DataField>ItemRenewalStatus</DataField> <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ChainSortKey">      <DataField>ChainSortKey</DataField>      <rd:TypeName>System.Int64</rd:TypeName>    </Field>
              <Field Name="SubTypeGroupId">    <DataField>SubTypeGroupId</DataField>    <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="SubType">           <DataField>SubType</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="GroupReferenceCode"><DataField>GroupReferenceCode</DataField><rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="GroupBeginDate">    <DataField>GroupBeginDate</DataField>    <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="GroupEndDate">      <DataField>GroupEndDate</DataField>      <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="GroupSubtotal">     <DataField>GroupSubtotal</DataField>     <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="ParentTagGroupId">  <DataField>ParentTagGroupId</DataField>  <rd:TypeName>System.Int32</rd:TypeName>    </Field>

        <Field Name="ParentTagLabel">    <DataField>ParentTagLabel</DataField>    <rd:TypeName>System.String</rd:TypeName>   </Field>

</Fields>
    </DataSet>
    <DataSet Name="SignatoryData">
      <Query>
        <DataSourceName>SignatoryDS</DataSourceName>
        <CommandText>/* Provided at runtime via ReportDataSource */</CommandText>
      </Query>
      <Fields>
        <Field Name="PairIndex"><DataField>PairIndex</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="LeftName"><DataField>LeftName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LeftTitle"><DataField>LeftTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="RightName"><DataField>RightName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="RightTitle"><DataField>RightTitle</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LeftPrefix"><DataField>LeftPrefix</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="RightPrefix"><DataField>RightPrefix</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportParameters>
    <ReportParameter Name="ShowRowNum">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Row Number</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowSetCode">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Set Code</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowType">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Type</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowDocNum">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Document Number</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowCompany">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Company</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowSite">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Site</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowSetStatus">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Set Status</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowItemName">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Item Name</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowDescription">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Description</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowModel">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Model</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowSerial">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Serial Number</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowQty">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Quantity</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowStartDate">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Show Start Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowExpiryDate">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show End Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowItemStatus">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Item Status</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowAmount">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Amount</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowSubtotal">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Subtotal Row</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowVat">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show VAT Row</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowWht">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show WHT Row</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowDiscount">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Discount Row</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowTotalAmount">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Total Amount Row</Prompt>
    </ReportParameter>
    <ReportParameter Name="ShowChainLabels">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Chain Position Labels</Prompt>
    </ReportParameter>
    <ReportParameter Name="ChainOrderDescending">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>false</Value></Values></DefaultValue>
      <Prompt>Chain Order Descending</Prompt>
    </ReportParameter>
      <ReportParameter Name="ShowSubTypeGroups">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Sub-Type Group Rows</Prompt>
    </ReportParameter>
      <ReportParameter Name="ShowParentTagGroups">
      <DataType>Boolean</DataType>
      <DefaultValue><Values><Value>true</Value></Values></DefaultValue>
      <Prompt>Show Parent Tag Group Rows</Prompt>
    </ReportParameter>
</ReportParameters>

  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>

          <Textbox Name="ReportTitle">
            <CanGrow>true</CanGrow>
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>Renewals Report</Value>
              <Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style>
            </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
            <Top>0mm</Top><Left>0mm</Left><Height>8mm</Height><Width>190mm</Width>
            <Style><Border><Style>None</Style></Border></Style>
          </Textbox>

          <!--
            ════════════════════════════════════════════════════════════════
            FLAT REPORT — 15 columns, 4 TablixRows, NO SetGroup.
            One row per SetItem. Set-level fields shown once via ItemNo = 1.

            TablixRowHierarchy — 4 leaves = 4 TablixRows:
              Leaf 1  static in YearGroup    → year banner     (CornflowerBlue)
              Leaf 2  static in MonthGroup   → month banner    (LightGreen)
              Leaf 3  static in MonthGroup   → column headers  (once per month)
              Leaf 4  Details in MonthGroup  → one row per item
            ════════════════════════════════════════════════════════════════

            16 columns — all-16 = exactly 190mm (portrait-safe, no overflow ever).
            Priority widths: Site(30) > ItemName(39) > Model(17) > DocNum(14) > …
            Minimum widths: Qty(5) | StartDate(11) | ExpiryDate(11) | Amount(7+7)
            Non-default cols compressed: Row#(5) SetCode(8) Type(6) Company(10) SetStatus(6) Serial(8) ItemStatus(6)
            Default 8 visible: DocNum+Site+ItemName+Model+Qty+StartDate+ExpiryDate+Amount = 141mm (74%).
          -->
          <Tablix Name="Tablix1">
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>##COLW_0##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_1##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_2##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_3##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_4##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_5##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_6##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_7##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_8##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_9##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_10##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_11##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_12##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_13##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_14##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_15##</Width></TablixColumn>
                <TablixColumn><Width>##COLW_16##</Width></TablixColumn>
              </TablixColumns>

              <TablixRows>

                <!-- ROW 1 — year banner -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="YearBanner">
                          <CanGrow>true</CanGrow>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>=Fields!Year.Value</Value>
                            <Style><FontWeight>Bold</FontWeight><FontSize>9pt</FontSize><Color>White</Color></Style>
                          </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                            <BackgroundColor>CornflowerBlue</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>17</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 2 — month banner -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="MonthBanner">
                          <CanGrow>true</CanGrow>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>=Fields!MonthName.Value</Value>
                            <Style><FontWeight>Bold</FontWeight><FontSize>8.5pt</FontSize></Style>
                          </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                            <BackgroundColor>LightGreen</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>17</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 3 — Old/Renewed set label (once per Set) -->
                <TablixRow>
                  <Height>5mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="SetBanner">
                          <CanGrow>true</CanGrow>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>=Fields!ChainPositionLabel.Value</Value>
                            <Style><FontWeight>Bold</FontWeight><FontSize>7pt</FontSize><Color>#4A5568</Color></Style>
                          </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                            <BackgroundColor>#F0F0F0</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                            <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>17</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 3b — column headers (once per set) -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>

                    <TablixCell><CellContents><Textbox Name="H_Num">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>#</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_SetCode">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Set Code</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Type">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Type</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_DocNum">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Doc Num</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Company">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Company</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Site">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Site</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
