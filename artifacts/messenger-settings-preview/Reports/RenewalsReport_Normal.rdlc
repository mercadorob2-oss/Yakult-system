                        <Value>=FORMAT(Fields!ItemAmount.Value, "#,##0.00")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
                    <TablixCell />

                  </TablixCells>
                </TablixRow>

                                

<!-- ROW 5 — Subtotal -->
                <TablixRow>
                  <Height>5mm</Height>
                  <TablixCells>
