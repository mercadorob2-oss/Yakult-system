                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=FORMAT(Fields!DiscountAmount.Value, "#,##0.00")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 9 — Total Amount -->
                <TablixRow>
                  <Height>5mm</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="SummaryLbl_Total">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Total Amount</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#D9E1F2</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox><ColSpan>15</ColSpan></CellContents></TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell />
                    <TablixCell><CellContents><Textbox Name="SummaryVal_Total">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=FORMAT(Fields!TotalAmountDue.Value, "#,##0.00")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#D9E1F2</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 10 — empty row between sets -->
                <TablixRow>
                  <Height>3mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="SetSpacer">
                          <CanGrow>true</CanGrow>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value></Value>
                          </TextRun></TextRuns></Paragraph></Paragraphs>
                          <Style><Border><Style>None</Style></Border></Style>
                        </Textbox>
                        <ColSpan>17</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember><Visibility><Hidden>=Parameters!ShowRowNum.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowSetCode.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowType.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowDocNum.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowCompany.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowSite.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowSetStatus.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowItemName.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowDescription.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowModel.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowSerial.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowQty.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowStartDate.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowExpiryDate.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowItemStatus.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowAmount.Value = false</Hidden></Visibility></TablixMember>
                <TablixMember><Visibility><Hidden>=Parameters!ShowAmount.Value = false</Hidden></Visibility></TablixMember>
              </TablixMembers>
            </TablixColumnHierarchy>

            <TablixRowHierarchy>
              <TablixMembers>

                <!-- YearGroup -->
                <TablixMember>
                  <Group Name="YearGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Year.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression><Value>=Min(Fields!ChainSortKey.Value)</Value></SortExpression>
                  </SortExpressions>
                  <TablixMembers>

                    <!-- Leaf 1: year banner -->
                    <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>

                    <!-- MonthGroup -->
                    <TablixMember>
                      <Group Name="MonthGroup">
                        <GroupExpressions>
                          <GroupExpression>=Fields!MonthNumber.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression><Value>=Min(Fields!ChainSortKey.Value)</Value></SortExpression>
                      </SortExpressions>
                      <TablixMembers>

                        <!-- Leaf 2: month banner -->
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>

                        <!-- SetGroup — one group per set, with empty spacer footer -->
                        <TablixMember>
                          <Group Name="SetGroup">
                            <GroupExpressions>
                              <GroupExpression>=Fields!SetId.Value</GroupExpression>
                            </GroupExpressions>
                          </Group>
                          <SortExpressions>
                            <SortExpression>
                              <Value>=Min(Fields!ChainSortKey.Value)</Value>
                            </SortExpression>
                          </SortExpressions>
                          <TablixMembers>
                            <!-- Chain position label (Original / Renewal #N), once per Set -->
                            <TablixMember><KeepWithGroup>After</KeepWithGroup><Visibility><Hidden>=Parameters!ShowChainLabels.Value = false</Hidden></Visibility></TablixMember>
                            <!-- Column headers (once per Set) -->
                            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
                            <!-- Details — one row per SetItem -->
                            <!-- Sub-Type Group (Contract / Subscription / License / Services):
                                 one banner row plus a Begin/End date row before the items, one subtotal row after. -->
                            <TablixMember>
                              <Group Name="SubTypeGroup">
                                <GroupExpressions>
                                  <GroupExpression>=Fields!SubTypeGroupId.Value</GroupExpression>
                                </GroupExpressions>
                              </Group>
                              <SortExpressions>
                                <SortExpression><Value>=Min(IIF(Fields!SubTypeGroupId.Value = 0, 2147483647, Fields!SubTypeGroupId.Value))</Value></SortExpression>
                              </SortExpressions>
                              <TablixMembers>
                                <TablixMember><KeepWithGroup>After</KeepWithGroup><Visibility><Hidden>=Parameters!ShowSubTypeGroups.Value = false OR First(Fields!SubType.Value, "SubTypeGroup") = ""</Hidden></Visibility></TablixMember>
                                <TablixMember>

  <Group Name="ParentTagGroup">

    <GroupExpressions>

      <GroupExpression>=Fields!ParentTagGroupId.Value</GroupExpression>

    </GroupExpressions>

  </Group>

  <SortExpressions>

    <SortExpression><Value>=Min(IIF(Fields!ParentTagGroupId.Value = 0, 2147483647, Fields!ParentTagGroupId.Value))</Value></SortExpression>

  </SortExpressions>

  <TablixMembers>

    <TablixMember><KeepWithGroup>After</KeepWithGroup><Visibility><Hidden>=Parameters!ShowParentTagGroups.Value = false OR First(Fields!ParentTagLabel.Value, "ParentTagGroup") = ""</Hidden></Visibility></TablixMember>

    <TablixMember>
                              <Group Name="Details" />
                              <SortExpressions>
                                <SortExpression><Value>=Fields!ItemNo.Value</Value></SortExpression>
                              </SortExpressions>
                            </TablixMember>

  </TablixMembers>

</TablixMember>
                              </TablixMembers>
                            </TablixMember>
                            <!-- Summary footer rows -->
                            <TablixMember><KeepWithGroup>Before</KeepWithGroup><Visibility><Hidden>=Parameters!ShowSubtotal.Value = false</Hidden></Visibility></TablixMember>
                            <TablixMember><KeepWithGroup>Before</KeepWithGroup><Visibility><Hidden>=Parameters!ShowVat.Value = false</Hidden></Visibility></TablixMember>
                            <TablixMember><KeepWithGroup>Before</KeepWithGroup><Visibility><Hidden>=Parameters!ShowWht.Value = false</Hidden></Visibility></TablixMember>
                            <TablixMember><KeepWithGroup>Before</KeepWithGroup><Visibility><Hidden>=Parameters!ShowDiscount.Value = false</Hidden></Visibility></TablixMember>
                            <TablixMember><KeepWithGroup>Before</KeepWithGroup><Visibility><Hidden>=Parameters!ShowTotalAmount.Value = false</Hidden></Visibility></TablixMember>
                            <!-- Empty spacer row after each set -->
                            <TablixMember />
                          </TablixMembers>
                        </TablixMember>

                      </TablixMembers>
                    </TablixMember>

                  </TablixMembers>
                </TablixMember>

              </TablixMembers>
            </TablixRowHierarchy>

            <DataSetName>RenewalsData</DataSetName>
            <Top>10mm</Top><Left>0mm</Left>
            <Height>31mm</Height><Width>190mm</Width>
            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

