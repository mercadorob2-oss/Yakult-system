<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Body>
    <ReportItems>
      <Tablix Name="tblMain">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>1.0in</Width></TablixColumn>
            <TablixColumn><Width>1.4in</Width></TablixColumn>
            <TablixColumn><Width>0.9in</Width></TablixColumn>
            <TablixColumn><Width>2.4in</Width></TablixColumn>
            <TablixColumn><Width>0.6in</Width></TablixColumn>
            <TablixColumn><Width>1.1in</Width></TablixColumn>
            <TablixColumn><Width>3.09in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>

            <!-- Row 1 : Year group header -->
            <TablixRow>
              <Height>0.3in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="gYear">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Year(Fields!DecidedAt.Value)</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>10pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>White</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>gYear</rd:DefaultName>
                      <Style>
                        <Border><Color>#AAAAAA</Color><Style>Solid</Style></Border>
                        <BackgroundColor>CornflowerBlue</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>4pt</PaddingRight>
                      </Style>
                    </Textbox>
                    <ColSpan>7</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell />
              </TablixCells>
            </TablixRow>

            <!-- Row 2 : Month group header -->
            <TablixRow>
              <Height>0.28in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="gMonth">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Format(Fields!DecidedAt.Value, "MMMM")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>gMonth</rd:DefaultName>
                      <Style>
                        <Border><Color>#AAAAAA</Color><Style>Solid</Style></Border>
                        <BackgroundColor>LightGreen</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>4pt</PaddingRight>
                      </Style>
                    </Textbox>
                    <ColSpan>7</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell /><TablixCell />
              </TablixCells>
            </TablixRow>

            <!-- Row 3 : Column headers -->
            <TablixRow>
              <Height>0.32in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox2">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Batch Id</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox2</rd:DefaultName>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hDate">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Date</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hType">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Type</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hCartridge">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Cartridge Model</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hQty">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Qty</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hCond">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Condition</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="hRecipient">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Recipient / Company</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Row 4 : Data row (inside BatchModel group — one row per unique BatchId+CartridgeModel) -->
            <TablixRow>
              <Height>0.28in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="BatchId1">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(IsNothing(First(Fields!BatchId.Value)), "—", CStr(First(Fields!BatchId.Value)))</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>BatchId1</rd:DefaultName>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="dDate">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Format(First(Fields!DecidedAt.Value), "MM/dd/yyyy")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="dType">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=First(Fields!DecisionTypeName.Value)</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>=IIF(First(Fields!DecisionTypeName.Value) = "SELL", "#059669", "#7C3AED")</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="dCartridge">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(
  NOT IsNothing(First(Fields!CartridgeModelNumber.Value)) AND First(Fields!CartridgeModelNumber.Value) &lt;&gt; "",
  IIF(NOT IsNothing(First(Fields!CartridgeBrand.Value)) AND First(Fields!CartridgeBrand.Value) &lt;&gt; "",
      First(Fields!CartridgeBrand.Value) &amp; " " &amp; First(Fields!CartridgeModelNumber.Value),
      First(Fields!CartridgeModelNumber.Value)),
  IIF(IsNothing(First(Fields!ItemModelNumber.Value)), "—", First(Fields!ItemModelNumber.Value)))</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="dQty">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Sum(Fields!Quantity.Value)</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Center</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="dCond">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(IsNothing(First(Fields!ConditionName.Value)), "—", First(Fields!ConditionName.Value))</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="dRecipient">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(NOT IsNothing(First(Fields!RecipientName.Value)) AND First(Fields!RecipientName.Value) &lt;&gt; "",
  First(Fields!RecipientName.Value),
  IIF(NOT IsNothing(First(Fields!DisposalCompanyName.Value)) AND First(Fields!DisposalCompanyName.Value) &lt;&gt; "",
      First(Fields!DisposalCompanyName.Value),
      IIF(NOT IsNothing(First(Fields!VendorName.Value)) AND First(Fields!VendorName.Value) &lt;&gt; "",
          First(Fields!VendorName.Value),
          "—")))</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style><TextAlign>Left</TextAlign></Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

            <!-- Row 5 : Monthly summary footer -->
            <TablixRow>
              <Height>0.3in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox6">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value />
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#64748b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <rd:DefaultName>Textbox6</rd:DefaultName>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="fDateBlank">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="fTypeBlank">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="fSummary">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>="Total: " &amp; CountRows("Month") &amp; "   |   Disposed: " &amp; Count(IIF(Fields!DecisionTypeName.Value = "DISPOSE", 1, Nothing), "Month") &amp; "   |   Sold: " &amp; Count(IIF(Fields!DecisionTypeName.Value = "SELL", 1, Nothing), "Month")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#1e293b</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="fQtyBlank">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="fCondBlank">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="fRecpBlank">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun><Value /><Style><FontSize>8pt</FontSize></Style></TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>

          </TablixRows>
        </TablixBody>

        <TablixColumnHierarchy>
          <TablixMembers>
            <TablixMember /><TablixMember /><TablixMember /><TablixMember />
            <TablixMember /><TablixMember /><TablixMember />
          </TablixMembers>
        </TablixColumnHierarchy>

        <TablixRowHierarchy>
          <TablixMembers>

            <!-- ── Year group (ascending: oldest year first) ──────── -->
            <TablixMember>
              <Group Name="Year">
                <GroupExpressions>
                  <GroupExpression>=Year(Fields!DecidedAt.Value)</GroupExpression>
                </GroupExpressions>
              </Group>
              <SortExpressions>
                <SortExpression>
                  <Value>=Year(Fields!DecidedAt.Value)</Value>
                  <Direction>Ascending</Direction>
                </SortExpression>
              </SortExpressions>
              <TablixMembers>

                <!-- Row 1: Year header (static inside Year group) -->
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                </TablixMember>

                <!-- ── Month group (ascending: Jan → Dec) ────────── -->
                <TablixMember>
                  <Group Name="Month">
                    <GroupExpressions>
                      <GroupExpression>=Month(Fields!DecidedAt.Value)</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Year(Fields!DecidedAt.Value) * 100 + Month(Fields!DecidedAt.Value)</Value>
                      <Direction>Ascending</Direction>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>

                    <!-- Row 2: Month header (static inside Month group) -->
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                    </TablixMember>

                    <!-- Row 3: Column headers (static inside Month group) -->
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                    </TablixMember>

                    <!-- ── BatchModel group: one row per unique BatchId+CartridgeModel ── -->
                    <TablixMember>
                      <Group Name="BatchModel">
                        <GroupExpressions>
                          <GroupExpression>=IIF(
  NOT IsNothing(Fields!BatchId.Value) AND NOT IsNothing(Fields!CartridgeModelNumber.Value),
  CStr(Fields!BatchId.Value) &amp; "|" &amp; Fields!CartridgeModelNumber.Value,
  IIF(IsNothing(Fields!DecisionId.Value),
      Format(Fields!DecidedAt.Value, "yyyyMMddHHmmss") &amp; "|" &amp; IIF(IsNothing(Fields!CartridgeModelNumber.Value), CStr(Fields!Quantity.Value), Fields!CartridgeModelNumber.Value),
      CStr(Fields!DecisionId.Value)))</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!DecidedAt.Value</Value>
                          <Direction>Ascending</Direction>
                        </SortExpression>
                      </SortExpressions>
                      <TablixMembers>
                        <!-- Row 4: Data row (one per BatchModel group instance) -->
                        <TablixMember />
                      </TablixMembers>
                    </TablixMember>

                    <!-- Row 5: Monthly footer (static inside Month group) -->
                    <TablixMember>
                      <KeepWithGroup>Before</KeepWithGroup>
                    </TablixMember>

                  </TablixMembers>
                </TablixMember>

              </TablixMembers>
            </TablixMember>

          </TablixMembers>
        </TablixRowHierarchy>

        <DataSetName>DisposedSoldDataSet</DataSetName>
        <Height>1.48in</Height>
        <Width>10.49in</Width>
        <Style>
          <Border><Style>None</Style></Border>
        </Style>
      </Tablix>
    </ReportItems>
    <!-- Body height kept small — the Tablix grows dynamically, preventing a blank 2nd page -->
    <Height>1.5in</Height>
    <Style />
