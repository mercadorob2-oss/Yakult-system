<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df"
        xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
        xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=192.168.12.9,1433;Initial Catalog=YIMS;Encrypt=False;TrustServerCertificate=True</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="RenewalsData">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
SELECT
  [Year], MonthNumber, MonthName,
  SetId, SetCode, SetType, DocumentDate,
  DocumentNumber, CompanyName, SiteName,
  ExpiryStatus, SetLevelStatus,
  StartDate, EndDate, DaysUntilExpiry,
  TotalAmountDue, ItemNo,
  SetItemId, ItemName, ModelNumber, SerialNumber, ItemType, Category,
  Quantity, UnitPrice, ItemAmount,
  LineStartDate, LineEndDate, ItemRenewalStatus
FROM dbo.vw_Report_RenewalsWithItems
ORDER BY [Year] ASC, MonthNumber ASC, SetId ASC, ItemNo ASC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Year">              <DataField>Year</DataField>              <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="MonthNumber">       <DataField>MonthNumber</DataField>       <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="MonthName">         <DataField>MonthName</DataField>         <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetId">             <DataField>SetId</DataField>             <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="SetCode">           <DataField>SetCode</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetType">           <DataField>SetType</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="DocumentDate">      <DataField>DocumentDate</DataField>      <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="DocumentNumber">    <DataField>DocumentNumber</DataField>    <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="CompanyName">       <DataField>CompanyName</DataField>       <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SiteName">          <DataField>SiteName</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ExpiryStatus">      <DataField>ExpiryStatus</DataField>      <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetLevelStatus">    <DataField>SetLevelStatus</DataField>    <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="StartDate">         <DataField>StartDate</DataField>         <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="EndDate">           <DataField>EndDate</DataField>           <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="DaysUntilExpiry">   <DataField>DaysUntilExpiry</DataField>   <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="TotalAmountDue">    <DataField>TotalAmountDue</DataField>    <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="ItemNo">            <DataField>ItemNo</DataField>            <rd:TypeName>System.Int64</rd:TypeName>    </Field>
        <Field Name="SetItemId">         <DataField>SetItemId</DataField>         <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="ItemName">          <DataField>ItemName</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ModelNumber">       <DataField>ModelNumber</DataField>       <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SerialNumber">      <DataField>SerialNumber</DataField>      <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ItemType">          <DataField>ItemType</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Category">          <DataField>Category</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Quantity">          <DataField>Quantity</DataField>          <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="UnitPrice">         <DataField>UnitPrice</DataField>         <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="ItemAmount">        <DataField>ItemAmount</DataField>        <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="LineStartDate">     <DataField>LineStartDate</DataField>     <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="LineEndDate">       <DataField>LineEndDate</DataField>       <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="ItemRenewalStatus"> <DataField>ItemRenewalStatus</DataField> <rd:TypeName>System.String</rd:TypeName>   </Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>

          <Textbox Name="ReportTitle">
            <CanGrow>true</CanGrow>
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>Renewals Report</Value>
              <Style><FontFamily>Segoe UI</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style>
            </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
            <Top>0mm</Top><Left>0mm</Left><Height>8mm</Height><Width>389mm</Width>
            <Style><Border><Style>None</Style></Border></Style>
          </Textbox>

          <!--
            ════════════════════════════════════════════════════════════════
            FLAT REPORT — 15 columns, 4 TablixRows, NO SetGroup.
            One row per SetItem. Set-level fields shown once via ItemNo = 1.

            TablixRowHierarchy — 4 leaves = 4 TablixRows:
              Leaf 1  static in YearGroup    → year banner     (CornflowerBlue)
              Leaf 2  static in MonthGroup   → month banner    (LightGreen)
              Leaf 3  static in MonthGroup   → column headers  (once per month)
              Leaf 4  Details in MonthGroup  → one row per item
            ════════════════════════════════════════════════════════════════

            14 columns — total 389 mm:
            SetCode(22) | Type(22) | Doc#(25) | Company(38) | Site(38) |
            SetStatus(22) | #(7) | ItemName(95) |
            Model(22) | Serial#(22) | Qty(9) | ExpiryDate(23) | ItemStatus(22) | Amount(22)
          -->
          <Tablix Name="Tablix1">
            <TablixBody>

              <TablixColumns>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>25mm</Width></TablixColumn>
                <TablixColumn><Width>38mm</Width></TablixColumn>
                <TablixColumn><Width>38mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>7mm</Width></TablixColumn>
                <TablixColumn><Width>95mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>9mm</Width></TablixColumn>
                <TablixColumn><Width>23mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
              </TablixColumns>

              <TablixRows>

                <!-- ROW 1 — year banner -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="YearBanner">
                          <CanGrow>true</CanGrow>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>=Fields!Year.Value</Value>
                            <Style><FontWeight>Bold</FontWeight><FontSize>9pt</FontSize><Color>White</Color></Style>
                          </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                            <BackgroundColor>CornflowerBlue</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>14</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 2 — month banner -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="MonthBanner">
                          <CanGrow>true</CanGrow>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>=Fields!MonthName.Value</Value>
                            <Style><FontWeight>Bold</FontWeight><FontSize>8.5pt</FontSize></Style>
                          </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                            <BackgroundColor>LightGreen</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>14</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 3 — column headers (once per month) -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>

                    <TablixCell><CellContents><Textbox Name="H_SetCode">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Set Code</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Type">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Type</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_DocNum">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Document #</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Company">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Company</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Site">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Site</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_SetStatus">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Set Status</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Num">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>#</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_ItemName">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Item Name</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Model">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Model</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Serial">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Serial #</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Qty">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Qty</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_LineEnd">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Expiry Date</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_ItemStatus">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Item Status</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="H_Amount">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>Amount</Value>
                        <Style><FontWeight>ExtraBold</FontWeight><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                  </TablixCells>
                </TablixRow>

                <!-- ROW 4 — detail row (one per SetItem) -->
                <TablixRow>
                  <Height>5mm</Height>
                  <TablixCells>

                    <!-- Set-level fields: shown only on first item of each set -->
                    <TablixCell><CellContents><Textbox Name="D_SetCode">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SetCode.Value, "")</Value>
                        <Style><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Type">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SetType.Value, "")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_DocNum">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!DocumentNumber.Value, "")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Company">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!CompanyName.Value, "")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Site">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SiteName.Value, "")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_SetStatus">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SetLevelStatus.Value, "")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Item-level fields: shown on every row -->
                    <TablixCell><CellContents><Textbox Name="D_ItemNo">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ItemNo.Value</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_ItemName">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ItemName.Value</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Model">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ModelNumber.Value</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Serial">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!SerialNumber.Value</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Qty">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=FORMAT(Fields!Quantity.Value, "0.##")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_LineEnd">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(IsNothing(Fields!LineEndDate.Value), "—", FORMAT(Fields!LineEndDate.Value, "yyyy-MM-dd"))</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_ItemStatus">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ItemRenewalStatus.Value</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="D_Amount">
                      <CanGrow>true</CanGrow>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=FORMAT(Fields!ItemAmount.Value, "#,##0.00")</Value>
                        <Style><FontSize>7.5pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>3pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>

            <TablixRowHierarchy>
              <TablixMembers>

                <!-- YearGroup -->
                <TablixMember>
                  <Group Name="YearGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Year.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression><Value>=Fields!Year.Value</Value></SortExpression>
                  </SortExpressions>
                  <TablixMembers>

                    <!-- Leaf 1: year banner -->
                    <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>

                    <!-- MonthGroup -->
                    <TablixMember>
                      <Group Name="MonthGroup">
                        <GroupExpressions>
                          <GroupExpression>=Fields!MonthNumber.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression><Value>=Fields!MonthNumber.Value</Value></SortExpression>
                      </SortExpressions>
                      <TablixMembers>

                        <!-- Leaf 2: month banner -->
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>

                        <!-- Leaf 3: column headers (static, once per month) -->
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>

                        <!-- Leaf 4: Details — one row per SetItem -->
                        <TablixMember>
                          <Group Name="Details" />
                          <SortExpressions>
                            <SortExpression><Value>=Fields!SetId.Value</Value></SortExpression>
                            <SortExpression><Value>=Fields!ItemNo.Value</Value></SortExpression>
                          </SortExpressions>
                        </TablixMember>

                      </TablixMembers>
                    </TablixMember>

                  </TablixMembers>
                </TablixMember>

              </TablixMembers>
            </TablixRowHierarchy>

            <DataSetName>RenewalsData</DataSetName>
            <Top>10mm</Top><Left>0mm</Left>
            <Height>31mm</Height><Width>389mm</Width>
            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

        </ReportItems>
        <Height>1mm</Height>
        <Style><Border><Style>None</Style></Border></Style>
      </Body>

      <Width>40cm</Width>
      <Page>
        <PageFooter>
          <Height>8mm</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="PageNumber">
              <CanGrow>true</CanGrow>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>=Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>Gray</Color></Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Top>1mm</Top><Left>297mm</Left><Height>5mm</Height><Width>80mm</Width>
              <Style><Border><Style>None</Style></Border></Style>
            </Textbox>
            <Textbox Name="ReportFooter">
              <CanGrow>true</CanGrow>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Renewals Report  |  Generated: " &amp; FORMAT(Globals!ExecutionTime, "yyyy-MM-dd HH:mm")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>Gray</Color></Style>
              </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
              <Top>1mm</Top><Left>0mm</Left><Height>5mm</Height><Width>200mm</Width>
              <Style><Border><Style>None</Style></Border></Style>
            </Textbox>
          </ReportItems>
          <Style><Border><Style>None</Style></Border></Style>
        </PageFooter>
        <PageHeight>21cm</PageHeight>
        <PageWidth>44cm</PageWidth>
        <LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin>
        <TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
