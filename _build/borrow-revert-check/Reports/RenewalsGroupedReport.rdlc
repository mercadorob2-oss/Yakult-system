<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df"
        xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
        xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>

  <DataSources>
    <DataSource Name="DataSource1">
      <rd:SecurityType>DataBase</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=192.168.12.9,1433;Initial Catalog=YIMS;Encrypt=False;TrustServerCertificate=True</ConnectString>
        <Prompt>Specify a user name and password for data source DataSource1:</Prompt>
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="RenewalGroupsData">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
SELECT
  [Year], MonthNumber, MonthName,
  RootSetId, RootSetCode, RenewalCount,
  SetId, SetCode, SetType, DocumentDate,
  DocumentNumber, RenewedFromSetCode,
  CompanyName, SiteName,
  ExpiryStatus, SetLevelStatus,
  StartDate, EndDate, DaysUntilExpiry,
  TotalAmountDue, ItemNo,
  SetItemId, ItemName, ModelNumber, SerialNumber, ItemType, Category,
  Quantity, ItemAmount, LineStartDate, LineEndDate, ItemRenewalStatus
FROM dbo.vw_Report_RenewalGroupsLatest
ORDER BY [Year] ASC, MonthNumber ASC, SetId ASC, ItemNo ASC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Year">               <DataField>Year</DataField>               <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="MonthNumber">        <DataField>MonthNumber</DataField>        <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="MonthName">          <DataField>MonthName</DataField>          <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="RootSetId">          <DataField>RootSetId</DataField>          <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="RootSetCode">        <DataField>RootSetCode</DataField>        <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="RenewalCount">       <DataField>RenewalCount</DataField>       <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="SetId">              <DataField>SetId</DataField>              <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="SetCode">            <DataField>SetCode</DataField>            <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetType">            <DataField>SetType</DataField>            <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="DocumentDate">       <DataField>DocumentDate</DataField>       <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="DocumentNumber">     <DataField>DocumentNumber</DataField>     <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="RenewedFromSetCode"> <DataField>RenewedFromSetCode</DataField> <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="CompanyName">        <DataField>CompanyName</DataField>        <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SiteName">           <DataField>SiteName</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ExpiryStatus">       <DataField>ExpiryStatus</DataField>       <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SetLevelStatus">     <DataField>SetLevelStatus</DataField>     <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="StartDate">          <DataField>StartDate</DataField>          <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="EndDate">            <DataField>EndDate</DataField>            <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="DaysUntilExpiry">    <DataField>DaysUntilExpiry</DataField>    <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="TotalAmountDue">     <DataField>TotalAmountDue</DataField>     <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="ItemNo">             <DataField>ItemNo</DataField>             <rd:TypeName>System.Int64</rd:TypeName>    </Field>
        <Field Name="SetItemId">          <DataField>SetItemId</DataField>          <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="ItemName">           <DataField>ItemName</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ModelNumber">        <DataField>ModelNumber</DataField>        <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="SerialNumber">       <DataField>SerialNumber</DataField>       <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="ItemType">           <DataField>ItemType</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Category">           <DataField>Category</DataField>           <rd:TypeName>System.String</rd:TypeName>   </Field>
        <Field Name="Quantity">           <DataField>Quantity</DataField>           <rd:TypeName>System.Int32</rd:TypeName>    </Field>
        <Field Name="ItemAmount">         <DataField>ItemAmount</DataField>         <rd:TypeName>System.Decimal</rd:TypeName>  </Field>
        <Field Name="LineStartDate">      <DataField>LineStartDate</DataField>      <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="LineEndDate">        <DataField>LineEndDate</DataField>        <rd:TypeName>System.DateTime</rd:TypeName> </Field>
        <Field Name="ItemRenewalStatus">  <DataField>ItemRenewalStatus</DataField>  <rd:TypeName>System.String</rd:TypeName>   </Field>
      </Fields>
    </DataSet>
  </DataSets>

  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>

          <Tablix Name="Tablix1">
            <TablixBody>
              <!--
                Column widths (15 cols, total 393mm)
                Col  0: Set Code       22mm
                Col  1: Renewed From   24mm
                Col  2: Type           22mm
                Col  3: Document #     25mm
                Col  4: Company        38mm
                Col  5: Site           38mm
                Col  6: Set Status     22mm
                Col  7: #               7mm
                Col  8: Item Name      95mm
                Col  9: Model          22mm
                Col 10: Serial #       22mm
                Col 11: Qty             9mm
                Col 12: Expiry Date    23mm
                Col 13: Item Status    22mm
                Col 14: Amount         22mm
                                      ─────
                                      393mm
              -->
              <TablixColumns>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>24mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>25mm</Width></TablixColumn>
                <TablixColumn><Width>38mm</Width></TablixColumn>
                <TablixColumn><Width>38mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>7mm</Width></TablixColumn>
                <TablixColumn><Width>95mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>9mm</Width></TablixColumn>
                <TablixColumn><Width>23mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
                <TablixColumn><Width>22mm</Width></TablixColumn>
              </TablixColumns>

              <TablixRows>

                <!-- ROW 0: Year Banner -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="YearBanner">
                          <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>="Year: " &amp; Fields!Year.Value</Value>
                            <Style><FontFamily>Segoe UI</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style>
                          </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>#AAAAAA</Color><Style>Solid</Style></Border>
                            <BackgroundColor>CornflowerBlue</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>15</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 1: Month Banner -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="MonthBanner">
                          <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value>=Fields!MonthName.Value</Value>
                            <Style><FontFamily>Segoe UI</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight></Style>
                          </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                          <Style>
                            <Border><Color>#AAAAAA</Color><Style>Solid</Style></Border>
                            <BackgroundColor>LightGreen</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                        <ColSpan>15</ColSpan>
                      </CellContents>
                    </TablixCell>
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell /><TablixCell /><TablixCell />
                    <TablixCell /><TablixCell />
                  </TablixCells>
                </TablixRow>

                <!-- ROW 2: Column Headers -->
                <TablixRow>
                  <Height>7mm</Height>
                  <TablixCells>

                    <TablixCell><CellContents><Textbox Name="HdrSetCode">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Set Code</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrRenewedFrom">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Renewed From</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrType">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Type</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrDocNum">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Document #</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrCompany">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Company</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrSite">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Site</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrSetStatus">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Set Status</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrItemNo">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>#</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrItemName">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Item Name</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrModel">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Model</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrSerial">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Serial #</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrQty">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Qty</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrExpiryDate">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Expiry Date</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrItemStatus">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Item Status</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <TablixCell><CellContents><Textbox Name="HdrAmount">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>Amount</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#CCCCCC</Color><Style>Solid</Style></Border>
                        <BackgroundColor>#E8EAED</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                        <PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                  </TablixCells>
                </TablixRow>

                <!-- ROW 3: Detail rows (one per item) -->
                <TablixRow>
                  <Height>6mm</Height>
                  <TablixCells>

                    <!-- Set Code — shown once per set (IIF ItemNo=1) -->
                    <TablixCell><CellContents><Textbox Name="DtlSetCode">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SetCode.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Renewed From — shown once per set in gray -->
                    <TablixCell><CellContents><Textbox Name="DtlRenewedFrom">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!RenewedFromSetCode.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#1a56db</Color></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>3pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Type — once per set -->
                    <TablixCell><CellContents><Textbox Name="DtlType">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SetType.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Document # — once per set -->
                    <TablixCell><CellContents><Textbox Name="DtlDocNum">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!DocumentNumber.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Company — once per set -->
                    <TablixCell><CellContents><Textbox Name="DtlCompany">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!CompanyName.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Site — once per set -->
                    <TablixCell><CellContents><Textbox Name="DtlSite">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SiteName.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Set Status — once per set -->
                    <TablixCell><CellContents><Textbox Name="DtlSetStatus">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(Fields!ItemNo.Value = 1, Fields!SetLevelStatus.Value, "")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Item # -->
                    <TablixCell><CellContents><Textbox Name="DtlItemNo">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ItemNo.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Item Name -->
                    <TablixCell><CellContents><Textbox Name="DtlItemName">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ItemName.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>4pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Model -->
                    <TablixCell><CellContents><Textbox Name="DtlModel">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ModelNumber.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Serial # -->
                    <TablixCell><CellContents><Textbox Name="DtlSerial">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!SerialNumber.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Qty -->
                    <TablixCell><CellContents><Textbox Name="DtlQty">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!Quantity.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Expiry Date (LineEndDate per item) -->
                    <TablixCell><CellContents><Textbox Name="DtlExpiryDate">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=IIF(IsNothing(Fields!LineEndDate.Value), "", FORMAT(Fields!LineEndDate.Value, "yyyy-MM-dd"))</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Item Status -->
                    <TablixCell><CellContents><Textbox Name="DtlItemStatus">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=Fields!ItemRenewalStatus.Value</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                    <!-- Amount -->
                    <TablixCell><CellContents><Textbox Name="DtlAmount">
                      <CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
                      <Paragraphs><Paragraph><TextRuns><TextRun>
                        <Value>=FORMAT(Fields!ItemAmount.Value, "#,##0.00")</Value>
                        <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize></Style>
                      </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style><Border><Color>#DDDDDD</Color><Style>Solid</Style></Border>
                        <BackgroundColor>White</BackgroundColor><VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>2pt</PaddingLeft><PaddingRight>4pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style>
                    </Textbox></CellContents></TablixCell>

                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember /><TablixMember />
                <TablixMember /><TablixMember /><TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>

            <!--
              Row hierarchy — 4 leaves must match 4 TablixRows:
                Row 0 → YearBanner   (leaf inside YearGroup)
                Row 1 → MonthBanner  (leaf inside MonthGroup)
                Row 2 → Col headers  (leaf inside MonthGroup)
                Row 3 → Details      (Details group)
            -->
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="YearGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!Year.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression><Value>=Fields!Year.Value</Value></SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <!-- Leaf 1 — Year banner -->
                    <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
                    <!-- MonthGroup -->
                    <TablixMember>
                      <Group Name="MonthGroup">
                        <GroupExpressions>
                          <GroupExpression>=Fields!MonthNumber.Value</GroupExpression>
                        </GroupExpressions>
                      </Group>
                      <SortExpressions>
                        <SortExpression><Value>=Fields!MonthNumber.Value</Value></SortExpression>
                      </SortExpressions>
                      <TablixMembers>
                        <!-- Leaf 2 — Month banner -->
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
                        <!-- Leaf 3 — Column headers -->
                        <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
                        <!-- Leaf 4 — Details (one row per item) -->
                        <TablixMember><Group Name="Details" /></TablixMember>
                      </TablixMembers>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

            <DataSetName>RenewalGroupsData</DataSetName>
            <Top>0mm</Top><Left>0mm</Left>
            <Height>25mm</Height><Width>393mm</Width>
            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

        </ReportItems>
        <Height>1mm</Height>
        <Style><Border><Style>None</Style></Border></Style>
      </Body>

      <Width>44cm</Width>
      <Page>
        <PageFooter>
          <Height>8mm</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="PageNumber">
              <CanGrow>true</CanGrow>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>=Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>Gray</Color></Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Top>1mm</Top><Left>313mm</Left><Height>5mm</Height><Width>60mm</Width>
              <Style><Border><Style>None</Style></Border></Style>
            </Textbox>
            <Textbox Name="ReportFooter">
              <CanGrow>true</CanGrow>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Renewals Report (Grouped)  |  Generated: " &amp; FORMAT(Globals!ExecutionTime, "yyyy-MM-dd HH:mm")</Value>
                <Style><FontFamily>Segoe UI</FontFamily><FontSize>8pt</FontSize><Color>Gray</Color></Style>
              </TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
              <Top>1mm</Top><Left>0mm</Left><Height>5mm</Height><Width>280mm</Width>
              <Style><Border><Style>None</Style></Border></Style>
            </Textbox>
          </ReportItems>
          <Style><Border><Style>None</Style></Border></Style>
        </PageFooter>
        <PageHeight>21cm</PageHeight>
        <PageWidth>44cm</PageWidth>
        <LeftMargin>1cm</LeftMargin><RightMargin>1cm</RightMargin>
        <TopMargin>1cm</TopMargin><BottomMargin>1cm</BottomMargin>
        <Style />
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
