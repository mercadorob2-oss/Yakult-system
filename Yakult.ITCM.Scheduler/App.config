<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    =========================================================================
    Yakult.ITCM.Scheduler — Connection String Configuration
    =========================================================================
    Edit the connectionString value below to match your SQL Server environment.

    RECOMMENDED (Windows Integrated Security for service accounts):
        Server=MYSERVER\SQLEXPRESS;Database=YIMS;Integrated Security=true;

    SQL Authentication (restrict file permissions if used):
        Server=MYSERVER;Database=YIMS;User Id=yakult_svc;Password=YOUR_PASSWORD;

    IMPORTANT: Do not commit real credentials to source control.
    Deploy-time values should be injected via a deployment script, environment
    variable, or managed through file ACLs on App.config for the service account.
    =========================================================================
  -->
  <connectionStrings>
    <add name="Yakult_Inventory_System"
         connectionString="Server=CHANGE_ME;Database=YIMS;Integrated Security=true;TrustServerCertificate=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

</configuration>
