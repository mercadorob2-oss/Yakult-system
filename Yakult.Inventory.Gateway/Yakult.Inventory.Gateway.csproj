<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <!-- The example file documents the secrets; it is never published. -->
  <ItemGroup>
    <Content Update="appsettings.Local.example.json" CopyToPublishDirectory="Never" />
    <!-- Dev machines: copy beside the exe so dotnet run finds it. Never published;
         the server keeps its own copy in the site folder. -->
    <Content Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
