<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="AuthTokenSecret" value="DEV_YAKULT_SECRET_7326_ABC123XYZ789" />
    <add key="AuthTokenExpiryHours" value="12" />
  </appSettings>
  <connectionStrings>
    <add name="Yakult_Inventory_System" connectionString="Data Source=192.168.100.186,50301;Initial Catalog=Yakult_Inventory_System_DEV;User ID=remote_user;Password=Yakult-ITD;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.Runtime.Caching, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
        <add assembly="System.Security, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>
    <!-- maxRequestLength is in KB and defaults to 4096 (4MB) if unset, which is far too small for a
         base64-encoded multi-page PDF from full-resolution camera captures. Raised to align with
         the existing IIS-level requestLimits/maxAllowedContentLength (30000000 bytes) below.
         executionTimeout is also raised so larger uploads over a mobile connection don't time out. -->
    <httpRuntime targetFramework="4.7.2" maxRequestLength="30000" executionTimeout="300" />
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="30000000" maxQueryString="32768" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
      </customHeaders>
    </httpProtocol>
    <!-- IIS's own httpErrors module replaces ANY response with status >= 400 with its generic
         HTML error page by default, separate from and in addition to ASP.NET's customErrors
         (already Off above). Without existingResponse="PassThrough", every JSON error body our
         handlers write (with the actual message/error code) gets silently discarded and replaced
         with IIS's generic "500 - Internal server error." page, hiding the real cause from both
         the mobile client and anyone debugging via the raw HTTP response. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>