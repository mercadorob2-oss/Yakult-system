<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="ApiFolderForwarder" path="*" verb="*" type="Yakult.Inventory.Api2Local.ApiRouteForwarder, Yakult.Inventory.Api2Local.RouteForwarder" resourceType="Unspecified" preCondition="integratedMode" />
    </handlers>
  </system.webServer>
</configuration>
